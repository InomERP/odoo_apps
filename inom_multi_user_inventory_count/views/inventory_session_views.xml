<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_stock_inventory_count_session_form" model="ir.ui.view">
        <field name="name">stock.inventory.count.session.form</field>
        <field name="model">stock.inventory.count.session</field>
        <field name="arch" type="xml">
            <form string="Inventory Count Session">
                <header>
                    <button name="action_start" string="Start" type="object"
                            class="btn-primary"
                            invisible="state == 'done' or (state == 'in_progress' and is_running)"/>
                    <button name="action_pause" string="Pause" type="object"
                            invisible="not (state == 'in_progress' and is_running)"/>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary"
                            invisible="state not in ('draft', 'in_progress')"
                            confirm="Submit this session? Counted quantities cannot be changed afterwards."/>
                    <button name="action_open_scan_wizard"
                            string="Scan &amp; Count" type="object"
                            icon="fa-camera"
                            invisible="state == 'done'"/>
                    <button name="action_approve_all_lines"
                            string="Approve Session Lines" type="object"
                            class="btn-primary"
                            groups="stock.group_stock_manager"
                            invisible="state != 'done' or lines_validated"
                            confirm="Approve all session lines? Even rejected lines will be approved."/>
                    <button name="action_reject_pending_lines"
                            string="Reject Session Lines" type="object"
                            groups="stock.group_stock_manager"
                            invisible="state != 'done' or lines_validated or pending_line_count == 0"/>
                    <button name="action_validate_lines" string="Validate"
                            type="object" class="btn-primary"
                            groups="stock.group_stock_manager"
                            invisible="state != 'done' or lines_validated"/>
                    <button name="action_create_re_session"
                            string="Create Re-Session" type="object"
                            groups="stock.group_stock_manager"
                            invisible="state != 'done' or rejected_line_count == 0 or re_session_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_re_session" type="object"
                                class="oe_stat_button" icon="fa-refresh"
                                invisible="not re_session_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Re-Session</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="inventory_count_id" readonly="1"/>
                            <field name="user_id"
                                   readonly="state == 'done'"/>
                            <field name="approver_id" readonly="1"/>
                            <field name="session_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="warehouse_id" readonly="1"/>
                            <field name="location_id" readonly="1"/>
                            <field name="use_barcode_scanner" readonly="1"/>
                            <field name="time_consumed_display"/>
                            <field name="submit_date"
                                   invisible="state != 'done'"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="total_products"/>
                            <field name="total_scanned_products"/>
                            <field name="to_be_scanned"/>
                        </group>
                        <group invisible="not use_barcode_scanner">
                            <field name="barcode_scan"
                                   readonly="state != 'in_progress'"
                                   placeholder="Scan or type a barcode..."/>
                        </group>
                    </group>
                    <field name="is_running" invisible="1"/>
                    <field name="lines_validated" invisible="1"/>
                    <field name="pending_line_count" invisible="1"/>
                    <field name="rejected_line_count" invisible="1"/>
                    <field name="re_session_id" invisible="1"/>
                    <notebook>
                        <page string="Counting Lines" name="counting_lines">
                            <field name="session_line_ids">
                                <tree editable="bottom" create="0" delete="0"
                                      decoration-warning="state == 'reject'"
                                      decoration-success="state == 'approve'">
                                    <field name="product_id" readonly="1"/>
                                    <field name="default_code"
                                           string="Internal Reference"/>
                                    <field name="barcode"/>
                                    <field name="location_id" readonly="1"/>
                                    <field name="counted_qty"
                                           readonly="parent.state == 'done'"/>
                                    <field name="user_calculation_mistake"
                                           readonly="parent.state == 'done'"/>
                                    <field name="scanned"
                                           widget="boolean_toggle"
                                           readonly="1"/>
                                    <field name="state" widget="badge"
                                           decoration-warning="state == 'reject'"
                                           decoration-success="state == 'approve'"/>
                                    <button name="action_scan" type="object"
                                            string="Scan" icon="fa-barcode"
                                            invisible="scanned or parent.state == 'done'"/>
                                    <button name="action_unscan" type="object"
                                            string="Unscan" icon="fa-undo"
                                            invisible="not scanned or parent.state == 'done'"/>
                                    <button name="action_approve" type="object"
                                            string="Approve" icon="fa-check"
                                            groups="stock.group_stock_manager"
                                            invisible="parent.state != 'done' or state == 'approve'"/>
                                    <button name="action_reject" type="object"
                                            string="Reject" icon="fa-times"
                                            groups="stock.group_stock_manager"
                                            invisible="parent.state != 'done' or state == 'reject'"/>
                                    <field name="company_id"
                                           column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_stock_inventory_count_session_kanban" model="ir.ui.view">
        <field name="name">stock.inventory.count.session.kanban</field>
        <field name="model">stock.inventory.count.session</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column"
                    group_create="false">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_content">
                            <div class="o_kanban_record_top mb-1">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div>
                                <i class="fa fa-file-text-o me-1"
                                   title="Inventory Count"/>
                                <field name="inventory_count_id"/>
                            </div>
                            <div>
                                <i class="fa fa-user me-1" title="Assigned User"/>
                                <field name="user_id"/>
                            </div>
                            <div>
                                <i class="fa fa-map-marker me-1"
                                   title="Location"/>
                                <field name="location_id"/>
                            </div>
                            <div>
                                <i class="fa fa-check-square-o me-1"
                                   title="Approver"/>
                                <field name="approver_id"/>
                            </div>
                            <div class="mt-1">
                                <span class="badge text-bg-secondary me-1">
                                    Products: <field name="total_products"/>
                                </span>
                                <span class="badge text-bg-success me-1">
                                    Scanned: <field name="total_scanned_products"/>
                                </span>
                                <span class="badge text-bg-warning">
                                    Remaining: <field name="to_be_scanned"/>
                                </span>
                            </div>
                            <div class="mt-1">
                                <i class="fa fa-clock-o me-1"
                                   title="Time Consumed"/>
                                <field name="time_consumed_display"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_stock_inventory_count_session_list" model="ir.ui.view">
        <field name="name">stock.inventory.count.session.list</field>
        <field name="model">stock.inventory.count.session</field>
        <field name="arch" type="xml">
            <tree string="Sessions">
                <field name="name"/>
                <field name="inventory_count_id"/>
                <field name="user_id"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="total_products"/>
                <field name="total_scanned_products"/>
                <field name="to_be_scanned"/>
                <field name="time_consumed_display"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
                <field name="company_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_stock_inventory_count_session_search" model="ir.ui.view">
        <field name="name">stock.inventory.count.session.search</field>
        <field name="model">stock.inventory.count.session</field>
        <field name="arch" type="xml">
            <search string="Sessions">
                <field name="name"/>
                <field name="inventory_count_id"/>
                <field name="user_id"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_in_progress" string="In Progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_submitted" string="Submitted"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_my_sessions" string="My Sessions"
                        domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_count" string="Inventory Count"
                            context="{'group_by': 'inventory_count_id'}"/>
                    <filter name="group_user" string="Assigned User"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_stock_inventory_count_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">stock.inventory.count.session</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id"
               ref="view_stock_inventory_count_session_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No counting sessions yet
            </p>
            <p>
                Sessions are created from an inventory count using the
                Create Session action.
            </p>
        </field>
    </record>

</odoo>
