<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_stock_inventory_count" model="ir.sequence">
            <field name="name">Inventory Count</field>
            <field name="code">stock.inventory.count</field>
            <field name="prefix">INV/C/</field>
            <field name="padding">7</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_stock_inventory_count_session" model="ir.sequence">
            <field name="name">Inventory Count Session</field>
            <field name="code">stock.inventory.count.session</field>
            <field name="prefix">INV/S/</field>
            <field name="padding">7</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
