<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_certificate" model="ir.sequence">
            <field name="name">Certificate</field>
            <field name="code">univ.certificate</field>
            <field name="prefix">%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_id_card" model="ir.sequence">
            <field name="name">ID Card</field>
            <field name="code">univ.id.card</field>
            <field name="prefix">IDC/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="tmpl_bonafide" model="univ.certificate.template">
            <field name="name">Bonafide Certificate</field>
            <field name="cert_type">bonafide</field>
            <field name="prefix">BON/</field>
            <field name="body_html"><![CDATA[<p>This is to certify that <strong>{student}</strong> is a bonafide student of the program <strong>{program}</strong>, batch <strong>{batch}</strong>. Certificate No: {number}. Issued on {date}.</p>]]></field>
            <field name="signatory">Registrar</field>
        </record>
        <record id="tmpl_character" model="univ.certificate.template">
            <field name="name">Character Certificate</field>
            <field name="cert_type">character</field>
            <field name="prefix">CHR/</field>
            <field name="body_html"><![CDATA[<p>This is to certify that <strong>{student}</strong> of program <strong>{program}</strong> bears a good moral character. Certificate No: {number}. Issued on {date}.</p>]]></field>
            <field name="signatory">Registrar</field>
        </record>
    </data>
</odoo>
