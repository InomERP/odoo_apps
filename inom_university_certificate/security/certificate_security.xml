<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_univ_certificate_officer" model="res.groups">
            <field name="name">Certificate Officer</field>
            <field name="sequence">54</field>
            <field name="privilege_id" ref="inom_university_core.res_groups_privilege_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Manage certificate templates, generation and issuance.</field>
        </record>
        <record id="inom_university_core.group_univ_admin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_univ_certificate_officer'))]"/>
        </record>

        <record id="rule_certificate_company" model="ir.rule">
            <field name="name">Certificate multi-company</field>
            <field name="model_id" ref="model_univ_certificate"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_certificate_portal" model="ir.rule">
            <field name="name">Certificate: portal own</field>
            <field name="model_id" ref="model_univ_certificate"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('inom_university_core.group_univ_portal_student')), (4, ref('inom_university_core.group_univ_portal_parent'))]"/>
            <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_idcard_portal" model="ir.rule">
            <field name="name">ID Card: portal own</field>
            <field name="model_id" ref="model_univ_id_card"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('inom_university_core.group_univ_portal_student')), (4, ref('inom_university_core.group_univ_portal_parent'))]"/>
            <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
