<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_stock_adjust" model="ir.module.category">
        <field name="name">Inventory Adjustment Control</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_stock_adjust" model="res.groups.privilege">
        <field name="name">Inventory Adjustment Control</field>
        <field name="category_id" ref="module_category_stock_adjust"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_stock_adjust_approver" model="res.groups">
        <field name="name">Inventory Adjustment Approver</field>
        <field name="privilege_id" ref="privilege_stock_adjust"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Members of this group can approve or reject inventory
            adjustments that exceed the configured thresholds, and their own
            adjustments are applied without approval.</field>
    </record>

</odoo>