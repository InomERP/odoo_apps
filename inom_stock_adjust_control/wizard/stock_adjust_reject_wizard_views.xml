<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_adjust_reject_wizard_form" model="ir.ui.view">
        <field name="name">stock.adjust.reject.wizard.form</field>
        <field name="model">stock.adjust.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Inventory Adjustment">
                <group>
                    <field name="quant_ids" invisible="1"/>
                    <field name="reason"
                           placeholder="Explain why these adjustments are rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Reject" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
