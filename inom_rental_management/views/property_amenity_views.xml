<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="property_amenity_view_list" model="ir.ui.view">
        <field name="name">property.amenity.list</field>
        <field name="model">property.amenity</field>
        <field name="arch" type="xml">
            <list string="Amenities" editable="bottom">
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="property_amenity_view_search" model="ir.ui.view">
        <field name="name">property.amenity.search</field>
        <field name="model">property.amenity</field>
        <field name="arch" type="xml">
            <search string="Amenities">
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_property_amenity" model="ir.actions.act_window">
        <field name="name">Amenities</field>
        <field name="res_model">property.amenity</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an amenity</p>
            <p>Amenities such as Parking, Lift or Swimming Pool describe what a property offers.</p>
        </field>
    </record>
</odoo>
