<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="property_rent_schedule_view_list" model="ir.ui.view">
        <field name="name">property.rent.schedule.list</field>
        <field name="model">property.rent.schedule</field>
        <field name="arch" type="xml">
            <list string="Billing Schedule" create="0" edit="0" delete="0" sample="1"
                  decoration-muted="state in ('paid', 'cancelled')">
                <field name="contract_id"/>
                <field name="property_id" optional="show"/>
                <field name="tenant_id" optional="show"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="date_due"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total Rent"/>
                <field name="move_id" optional="show"/>
                <field name="invoice_date_due" optional="hide"/>
                <field name="amount_residual" optional="show" sum="Total Due"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('pending', 'draft')"
                       decoration-warning="state == 'invoiced'"
                       decoration-success="state == 'paid'"/>
                <button name="action_create_invoice" type="object" string="Invoice" icon="fa-pencil-square-o"
                        invisible="state != 'pending'" groups="account.group_account_invoice"/>
                <button name="action_create_invoice" type="object" string="Invoice Again" icon="fa-repeat"
                        invisible="state != 'cancelled'" groups="account.group_account_invoice"/>
            </list>
        </field>
    </record>

    <record id="property_rent_schedule_view_search" model="ir.ui.view">
        <field name="name">property.rent.schedule.search</field>
        <field name="model">property.rent.schedule</field>
        <field name="arch" type="xml">
            <search string="Billing Schedule">
                <field name="contract_id"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <filter name="rent_due" string="Rent Due"
                        domain="[('date_due', '&lt;=', 'today'), ('state', 'in', ('pending', 'draft', 'invoiced'))]"/>
                <filter name="due_30" string="Due in 30 Days"
                        domain="[('date_due', '&gt;', 'today'), ('date_due', '&lt;=', 'today +30d'), ('state', '!=', 'cancelled')]"/>
                <separator/>
                <filter name="to_invoice" string="To Invoice" domain="[('state', '=', 'pending')]"/>
                <filter name="draft" string="Draft Invoice" domain="[('state', '=', 'draft')]"/>
                <filter name="unpaid" string="Invoiced, Unpaid" domain="[('state', '=', 'invoiced')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_date_due" string="Due Date" date="date_due"/>
                <group>
                    <filter name="group_by_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                    <filter name="group_by_property" string="Property" context="{'group_by': 'property_id'}"/>
                    <filter name="group_by_tenant" string="Tenant" context="{'group_by': 'tenant_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_due" string="Due Month" context="{'group_by': 'date_due:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="property_rent_schedule_view_pivot" model="ir.ui.view">
        <field name="name">property.rent.schedule.pivot</field>
        <field name="model">property.rent.schedule</field>
        <field name="arch" type="xml">
            <pivot string="Rent Due" sample="1">
                <field name="property_id" type="row"/>
                <field name="date_due" interval="month" type="col"/>
                <field name="amount" type="measure"/>
                <field name="amount_residual" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>
