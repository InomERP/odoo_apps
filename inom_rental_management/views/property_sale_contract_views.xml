<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="property_sale_contract_view_list" model="ir.ui.view">
        <field name="name">property.sale.contract.list</field>
        <field name="model">property.sale.contract</field>
        <field name="arch" type="xml">
            <list string="Sale Contracts" sample="1">
                <field name="name"/>
                <field name="property_id"/>
                <field name="buyer_id"/>
                <field name="owner_id" optional="show"/>
                <field name="booking_date"/>
                <field name="date_sold" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="sale_price" sum="Total Sale Price"/>
                <field name="booking_amount" optional="hide"/>
                <field name="amount_invoiced" optional="show" sum="Total Invoiced"/>
                <field name="amount_due" optional="show" sum="Total Due"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="invoice_status" widget="badge" optional="show"
                       decoration-warning="invoice_status == 'partial'"
                       decoration-info="invoice_status == 'invoiced'"
                       decoration-success="invoice_status == 'paid'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'booked'"
                       decoration-success="state == 'sold'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="property_sale_contract_view_form" model="ir.ui.view">
        <field name="name">property.sale.contract.form</field>
        <field name="model">property.sale.contract</field>
        <field name="arch" type="xml">
            <form string="Sale Contract">
                <header>
                    <button name="action_book" type="object" string="Confirm Booking"
                            class="btn-primary" invisible="state != 'draft'"
                            confirm="Booking reserves the property for this buyer. Continue?"/>
                    <button name="action_create_booking_invoice" type="object" string="Invoice Booking Amount"
                            class="btn-primary" invisible="state != 'booked' or not booking_amount or invoice_count"
                            groups="account.group_account_invoice"/>
                    <button name="action_create_balance_invoice" type="object" string="Invoice Balance"
                            invisible="state != 'booked' or invoice_status in ('invoiced', 'paid')"
                            groups="account.group_account_invoice"/>
                    <button name="action_sell" type="object" string="Mark as Sold"
                            class="btn-primary" invisible="state != 'booked' or invoice_status not in ('invoiced', 'paid')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'booked')"
                            confirm="Cancelling cancels draft invoices and creates draft credit notes for posted ones. Continue?"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,booked,sold"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not invoice_count" groups="account.group_account_invoice">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-files-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                        <button name="action_view_lead" type="object" class="oe_stat_button" icon="fa-star"
                                string="Enquiry" invisible="not lead_id" groups="sales_team.group_sale_salesman"/>
                    </div>
                    <widget name="web_ribbon" title="Sold" bg_color="text-bg-success" invisible="state != 'sold'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group name="parties">
                            <field name="property_id" readonly="state != 'draft'"/>
                            <field name="owner_id"/>
                            <field name="buyer_id" readonly="state != 'draft'"
                                   context="{'default_is_property_buyer': True}"/>
                            <field name="lead_id" readonly="1" invisible="not lead_id" groups="sales_team.group_sale_salesman"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group name="terms">
                            <field name="booking_date" readonly="state != 'draft'"/>
                            <field name="sale_price" readonly="state != 'draft'"/>
                            <field name="booking_amount" readonly="state != 'draft'"/>
                            <field name="payment_term_id" readonly="state not in ('draft', 'booked')"/>
                            <field name="date_sold" invisible="not date_sold"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoicing" name="invoicing">
                            <group>
                                <group>
                                    <field name="invoice_status" widget="badge"/>
                                    <field name="amount_invoiced"/>
                                </group>
                                <group>
                                    <field name="amount_paid"/>
                                    <field name="amount_due"/>
                                </group>
                            </group>
                            <field name="invoice_ids" readonly="1" groups="account.group_account_invoice">
                                <list>
                                    <field name="name"/>
                                    <field name="move_type"/>
                                    <field name="invoice_date"/>
                                    <field name="invoice_date_due"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount_total_signed" string="Total"/>
                                    <field name="amount_residual_signed" string="Amount Due"/>
                                    <field name="state" widget="badge"/>
                                    <field name="payment_state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Terms and Conditions" name="terms_conditions">
                            <field name="note" placeholder="Terms and conditions of this sale..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="property_sale_contract_view_search" model="ir.ui.view">
        <field name="name">property.sale.contract.search</field>
        <field name="model">property.sale.contract</field>
        <field name="arch" type="xml">
            <search string="Sale Contracts">
                <field name="name"/>
                <field name="property_id"/>
                <field name="buyer_id"/>
                <field name="owner_id"/>
                <filter name="my_contracts" string="My Contracts" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="booked" string="Booked" domain="[('state', '=', 'booked')]"/>
                <filter name="sold" string="Sold" domain="[('state', '=', 'sold')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="not_fully_invoiced" string="Not Fully Invoiced"
                        domain="[('state', '=', 'booked'), ('invoice_status', 'in', ('not_invoiced', 'partial'))]"/>
                <filter name="amount_due" string="With Amount Due" domain="[('amount_due', '&gt;', 0)]"/>
                <separator/>
                <filter name="filter_booking_date" string="Booking Date" date="booking_date"/>
                <filter name="filter_date_sold" string="Sold On" date="date_sold"/>
                <group>
                    <filter name="group_by_property" string="Property" context="{'group_by': 'property_id'}"/>
                    <filter name="group_by_buyer" string="Buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter name="group_by_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_invoice_status" string="Invoice Status" context="{'group_by': 'invoice_status'}"/>
                    <filter name="group_by_agent" string="Responsible" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_booking_date" string="Booking Date" context="{'group_by': 'booking_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="property_sale_contract_view_pivot" model="ir.ui.view">
        <field name="name">property.sale.contract.pivot</field>
        <field name="model">property.sale.contract</field>
        <field name="arch" type="xml">
            <pivot string="Sales Analysis" sample="1">
                <field name="property_id" type="row"/>
                <field name="state" type="col"/>
                <field name="sale_price" type="measure"/>
                <field name="amount_invoiced" type="measure"/>
                <field name="amount_paid" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="property_sale_contract_view_graph" model="ir.ui.view">
        <field name="name">property.sale.contract.graph</field>
        <field name="model">property.sale.contract</field>
        <field name="arch" type="xml">
            <graph string="Sales Analysis" type="bar" sample="1">
                <field name="booking_date" interval="month"/>
                <field name="sale_price" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_property_sale_contract" model="ir.actions.act_window">
        <field name="name">Sale Contracts</field>
        <field name="res_model">property.sale.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="property_sale_contract_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a sale contract</p>
            <p>A sale contract records the booking and sale of a property to a buyer.</p>
        </field>
    </record>

    <record id="action_property_sale_contract_analysis" model="ir.actions.act_window">
        <field name="name">Sales Analysis</field>
        <field name="res_model">property.sale.contract</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="property_sale_contract_view_search"/>
    </record>
</odoo>
