<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_univ_applicant_reject_wizard_form" model="ir.ui.view">
        <field name="name">univ.applicant.reject.wizard.form</field>
        <field name="model">univ.applicant.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Applicant">
                <sheet>
                    <field name="applicant_id" invisible="1"/>
                    <group>
                        <field name="reason" placeholder="State the reason for rejection / withdrawal..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Reject"
                            class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
