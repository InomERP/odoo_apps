<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_doc_pending">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Document Verification Pending</h2>
                    <p class="text-muted">
                        Applicants whose document checklist is not yet fully verified.
                    </p>
                    <table class="table table-sm o_main_table mt-3">
                        <thead>
                            <tr>
                                <th>Application No</th>
                                <th>Applicant</th>
                                <th>Program</th>
                                <th>Stage</th>
                                <th class="text-end">Docs Verified %</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="applicant">
                                <td><span t-field="applicant.application_no"/></td>
                                <td><span t-field="applicant.name"/></td>
                                <td><span t-field="applicant.program_id.name"/></td>
                                <td><span t-field="applicant.stage_id.name"/></td>
                                <td class="text-end"><span t-field="applicant.document_progress"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
