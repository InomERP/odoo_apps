<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_offer_letter_document">
        <t t-call="web.external_layout">
            <t t-set="applicant" t-value="o.applicant_id"/>
            <t t-set="base_url" t-value="o.get_base_url()"/>
            <t t-set="qr_value" t-value="base_url + '/admission/offer/verify/' + (o.verify_token or '')"/>
            <div class="page">
                <div class="row">
                    <div class="col-8">
                        <h2>Provisional Admission Offer</h2>
                        <p>
                            <strong>Offer No: </strong>
                            <span t-field="o.name"/>
                        </p>
                        <p>
                            <strong>Date: </strong>
                            <span t-field="o.issued_on"/>
                        </p>
                    </div>
                    <div class="col-4 text-end">
                        <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=180&amp;height=180' % qr_value"
                             style="width:120px;height:120px;" alt="QR"/>
                        <div><small>Scan to verify</small></div>
                    </div>
                </div>
                <hr/>
                <p>Dear <span t-field="applicant.name"/>,</p>
                <p>
                    We are pleased to offer you provisional admission to the program
                    <strong t-field="applicant.program_id.name"/> for the admission
                    round <strong t-field="o.round_id.name"/>.
                </p>
                <table class="table table-sm o_main_table mt-3">
                    <tbody>
                        <tr>
                            <td><strong>Application No</strong></td>
                            <td><span t-field="applicant.application_no"/></td>
                        </tr>
                        <tr>
                            <td><strong>Program</strong></td>
                            <td><span t-field="applicant.program_id.name"/></td>
                        </tr>
                        <tr>
                            <td><strong>Quota</strong></td>
                            <td><span t-field="applicant.quota_id.name"/></td>
                        </tr>
                        <tr>
                            <td><strong>Admission Fee</strong></td>
                            <td><span t-field="o.fee_amount"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td><strong>Offer Valid Until</strong></td>
                            <td><span t-field="o.expiry_date"/></td>
                        </tr>
                    </tbody>
                </table>
                <p class="mt-3">
                    To confirm your seat, please accept this offer and complete the
                    admission fee payment from your applicant portal before the
                    validity date above. This offer is provisional and subject to
                    verification of original documents.
                </p>
                <p class="mt-4">Warm regards,<br/>
                    <strong>Admissions Office</strong><br/>
                    <span t-field="o.company_id.name"/>
                </p>
            </div>
        </t>
    </template>

    <template id="report_offer_letter">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="inom_university_admission.report_offer_letter_document"
                   t-lang="o.applicant_id.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
