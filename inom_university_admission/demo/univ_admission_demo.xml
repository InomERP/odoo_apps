<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="demo_round_fall_2026" model="univ.admission.round">
            <field name="name">Fall 2026 - Round 1</field>
            <field name="code">F26R1</field>
            <field name="program_id" ref="inom_university_core.demo_program_btech_cse"/>
            <field name="start_date" eval="(datetime.datetime.now()).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(datetime.datetime.now() + relativedelta(months=3)).strftime('%Y-%m-%d')"/>
            <field name="state">open</field>
            <field name="capacity">60</field>
            <field name="allow_waitlist">True</field>
        </record>

        <record id="demo_seat_gen" model="univ.quota.seat">
            <field name="program_id" ref="inom_university_core.demo_program_btech_cse"/>
            <field name="quota_id" ref="quota_general"/>
            <field name="round_id" ref="demo_round_fall_2026"/>
            <field name="capacity">30</field>
        </record>

        <record id="demo_seat_obc" model="univ.quota.seat">
            <field name="program_id" ref="inom_university_core.demo_program_btech_cse"/>
            <field name="quota_id" ref="quota_obc"/>
            <field name="round_id" ref="demo_round_fall_2026"/>
            <field name="capacity">15</field>
        </record>

        <record id="demo_applicant_aarav" model="univ.applicant">
            <field name="name">Aarav Mehta</field>
            <field name="email">aarav.mehta@example.com</field>
            <field name="phone">9876500011</field>
            <field name="program_id" ref="inom_university_core.demo_program_btech_cse"/>
            <field name="round_id" ref="demo_round_fall_2026"/>
            <field name="quota_id" ref="quota_general"/>
            <field name="category">general</field>
            <field name="gender">male</field>
            <field name="source">website</field>
            <field name="admission_fee">25000.0</field>
            <field name="stage_id" ref="stage_application"/>
        </record>

        <record id="demo_applicant_diya" model="univ.applicant">
            <field name="name">Diya Sharma</field>
            <field name="email">diya.sharma@example.com</field>
            <field name="phone">9876500022</field>
            <field name="program_id" ref="inom_university_core.demo_program_btech_cse"/>
            <field name="round_id" ref="demo_round_fall_2026"/>
            <field name="quota_id" ref="quota_obc"/>
            <field name="category">obc</field>
            <field name="gender">female</field>
            <field name="source">walk_in</field>
            <field name="admission_fee">25000.0</field>
            <field name="stage_id" ref="stage_document_verification"/>
        </record>

        <record id="demo_merit_aarav" model="univ.applicant.merit">
            <field name="applicant_id" ref="demo_applicant_aarav"/>
            <field name="source">entrance_exam</field>
            <field name="reference">CET-2026</field>
            <field name="score">88.0</field>
            <field name="max_score">100.0</field>
            <field name="weight">100.0</field>
        </record>


        <!-- Req 4 demo: course-wise required documents on B.Tech CSE -->
        <record id="program_doc_req_btech_aadhaar" model="univ.program.document.requirement">
            <field name="program_id" ref="inom_university_core.demo_program_btech_cse"/>
            <field name="sequence">10</field>
            <field name="doc_type">aadhaar</field>
            <field name="mandatory" eval="True"/>
        </record>
        <record id="program_doc_req_btech_tenth" model="univ.program.document.requirement">
            <field name="program_id" ref="inom_university_core.demo_program_btech_cse"/>
            <field name="sequence">20</field>
            <field name="doc_type">tenth</field>
            <field name="mandatory" eval="True"/>
        </record>
        <record id="program_doc_req_btech_twelfth" model="univ.program.document.requirement">
            <field name="program_id" ref="inom_university_core.demo_program_btech_cse"/>
            <field name="sequence">30</field>
            <field name="doc_type">twelfth</field>
            <field name="mandatory" eval="True"/>
        </record>
        <record id="program_doc_req_btech_transfer" model="univ.program.document.requirement">
            <field name="program_id" ref="inom_university_core.demo_program_btech_cse"/>
            <field name="sequence">40</field>
            <field name="doc_type">transfer</field>
            <field name="mandatory" eval="True"/>
        </record>
        <record id="program_doc_req_btech_photo" model="univ.program.document.requirement">
            <field name="program_id" ref="inom_university_core.demo_program_btech_cse"/>
            <field name="sequence">50</field>
            <field name="doc_type">photo</field>
            <field name="mandatory" eval="True"/>
        </record>

    </data>
</odoo>
