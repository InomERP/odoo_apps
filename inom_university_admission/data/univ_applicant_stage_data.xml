<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="stage_enquiry" model="univ.applicant.stage">
            <field name="name">Enquiry</field>
            <field name="code">enquiry</field>
            <field name="sequence">10</field>
            <field name="is_default">True</field>
        </record>

        <record id="stage_application" model="univ.applicant.stage">
            <field name="name">Application Submitted</field>
            <field name="code">application</field>
            <field name="sequence">20</field>
        </record>

        <record id="stage_document_verification" model="univ.applicant.stage">
            <field name="name">Document Verification</field>
            <field name="code">document_verification</field>
            <field name="sequence">30</field>
        </record>

        <record id="stage_merit" model="univ.applicant.stage">
            <field name="name">Merit / Entrance</field>
            <field name="code">merit</field>
            <field name="sequence">40</field>
        </record>

        <record id="stage_offer" model="univ.applicant.stage">
            <field name="name">Offer</field>
            <field name="code">offer</field>
            <field name="sequence">50</field>
        </record>

        <record id="stage_fee" model="univ.applicant.stage">
            <field name="name">Admission Fee</field>
            <field name="code">fee</field>
            <field name="sequence">60</field>
        </record>

        <record id="stage_enrolled" model="univ.applicant.stage">
            <field name="name">Enrolled</field>
            <field name="code">enrolled</field>
            <field name="sequence">70</field>
            <field name="is_won">True</field>
            <field name="fold">True</field>
        </record>

        <record id="stage_rejected" model="univ.applicant.stage">
            <field name="name">Rejected / Withdrawn</field>
            <field name="code">rejected</field>
            <field name="sequence">80</field>
            <field name="is_rejected">True</field>
            <field name="fold">True</field>
        </record>

    </data>
</odoo>
