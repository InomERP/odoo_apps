<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_univ_applicant_application" model="ir.sequence">
            <field name="name">University Application Number</field>
            <field name="code">univ.applicant.application</field>
            <field name="prefix">%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <record id="seq_univ_applicant_offer" model="ir.sequence">
            <field name="name">University Admission Offer</field>
            <field name="code">univ.applicant.offer</field>
            <field name="prefix">OFFER/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

    </data>
</odoo>
