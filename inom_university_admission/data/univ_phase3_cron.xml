<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_draft_reminders" model="ir.cron">
            <field name="name">Admission: Incomplete application reminders</field>
            <field name="model_id" ref="model_univ_applicant"/>
            <field name="state">code</field>
            <field name="code">model._cron_draft_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_deadline_alerts" model="ir.cron">
            <field name="name">Admission: Application deadline alerts</field>
            <field name="model_id" ref="model_univ_applicant"/>
            <field name="state">code</field>
            <field name="code">model._cron_deadline_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_registration_open_notify" model="ir.cron">
            <field name="name">Admission: Registration opening notifications</field>
            <field name="model_id" ref="model_univ_admission_round"/>
            <field name="state">code</field>
            <field name="code">model._cron_registration_open_notify()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
