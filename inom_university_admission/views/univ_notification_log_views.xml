<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_univ_notification_log_list" model="ir.ui.view">
        <field name="name">univ.notification.log.list</field>
        <field name="model">univ.notification.log</field>
        <field name="arch" type="xml">
            <tree string="Notification Log" create="0"
                  decoration-success="delivery_status == 'sent'"
                  decoration-danger="delivery_status == 'failed'"
                  decoration-muted="delivery_status == 'skipped'">
                <field name="sent_on"/>
                <field name="notif_type"/>
                <field name="channel"/>
                <field name="applicant_id" optional="show"/>
                <field name="student_id" optional="show"/>
                <field name="round_id" optional="hide"/>
                <field name="recipient" optional="show"/>
                <field name="reminder_day" optional="hide"/>
                <field name="delivery_status"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_univ_notification_log_form" model="ir.ui.view">
        <field name="name">univ.notification.log.form</field>
        <field name="model">univ.notification.log</field>
        <field name="arch" type="xml">
            <form string="Notification Log" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="notif_type"/>
                            <field name="channel"/>
                            <field name="delivery_status"/>
                            <field name="reminder_day"/>
                            <field name="sent_on"/>
                        </group>
                        <group>
                            <field name="applicant_id"/>
                            <field name="student_id"/>
                            <field name="round_id"/>
                            <field name="partner_id"/>
                            <field name="recipient"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Note" invisible="not note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_univ_notification_log_search" model="ir.ui.view">
        <field name="name">univ.notification.log.search</field>
        <field name="model">univ.notification.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="applicant_id"/>
                <field name="student_id"/>
                <field name="round_id"/>
                <field name="recipient"/>
                <filter name="sent" string="Sent" domain="[('delivery_status', '=', 'sent')]"/>
                <filter name="failed" string="Failed" domain="[('delivery_status', '=', 'failed')]"/>
                <filter name="skipped" string="Skipped" domain="[('delivery_status', '=', 'skipped')]"/>
                <separator/>
                <filter name="t_draft" string="Draft Reminders" domain="[('notif_type', '=', 'draft_reminder')]"/>
                <filter name="t_deadline" string="Deadline Alerts" domain="[('notif_type', '=', 'deadline_alert')]"/>
                <filter name="t_registration" string="Registration Opening" domain="[('notif_type', '=', 'registration_open')]"/>
                <group>
                    <filter name="g_type" string="Type" context="{'group_by': 'notif_type'}"/>
                    <filter name="g_channel" string="Channel" context="{'group_by': 'channel'}"/>
                    <filter name="g_status" string="Status" context="{'group_by': 'delivery_status'}"/>
                    <filter name="g_date" string="Sent Date" context="{'group_by': 'sent_on:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_univ_notification_log" model="ir.actions.act_window">
        <field name="name">Notification Log</field>
        <field name="res_model">univ.notification.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_g_type': 1}</field>
    </record>

    <menuitem id="menu_univ_notification_log" name="Notification Log"
              parent="menu_univ_admission_tools"
              action="action_univ_notification_log" sequence="50"/>

</odoo>
