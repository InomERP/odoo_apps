<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_univ_quota_list" model="ir.ui.view">
        <field name="name">univ.quota.list</field>
        <field name="model">univ.quota</field>
        <field name="arch" type="xml">
            <list string="Quotas" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_univ_quota_form" model="ir.ui.view">
        <field name="name">univ.quota.form</field>
        <field name="model">univ.quota</field>
        <field name="arch" type="xml">
            <form string="Quota">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Management"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="sequence"/>
                    </group>
                    <field name="description" placeholder="Quota description..."/>
                    <notebook>
                        <page string="Seat Caps" name="seats">
                            <field name="seat_ids">
                                <list editable="bottom">
                                    <field name="program_id"/>
                                    <field name="round_id"/>
                                    <field name="capacity"/>
                                    <field name="used_seats"/>
                                    <field name="available_seats"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_univ_quota" model="ir.actions.act_window">
        <field name="name">Quotas</field>
        <field name="res_model">univ.quota</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define admission quotas</p>
            <p>Quotas drive category-based seat reservation per program and round.</p>
        </field>
    </record>

</odoo>
