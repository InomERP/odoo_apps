<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_univ_applicant_graph" model="ir.ui.view">
        <field name="name">univ.applicant.graph</field>
        <field name="model">univ.applicant</field>
        <field name="arch" type="xml">
            <graph string="Admission Funnel" type="bar" sample="1">
                <field name="stage_id"/>
                <field name="program_id"/>
            </graph>
        </field>
    </record>

    <record id="view_univ_applicant_pivot" model="ir.ui.view">
        <field name="name">univ.applicant.pivot</field>
        <field name="model">univ.applicant</field>
        <field name="arch" type="xml">
            <pivot string="Admission Funnel" sample="1">
                <field name="program_id" type="row"/>
                <field name="stage_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_univ_admission_dashboard" model="ir.actions.act_window">
        <field name="name">Admission Funnel</field>
        <field name="res_model">univ.applicant</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{'search_default_group_stage': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Admission funnel analytics</p>
            <p>Track conversion across stages by program and round.</p>
        </field>
    </record>

</odoo>
