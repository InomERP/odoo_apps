<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============ GROUPS ============ -->
        <record id="group_univ_admission_officer" model="res.groups">
            <field name="name">Admission Officer</field>
            <field name="category_id" ref="inom_university_core.module_category_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Full CRUD on applicants, stages and offers; cannot delete enrolled applicants.</field>
        </record>

        <record id="group_univ_admission_reviewer" model="res.groups">
            <field name="name">Admission Reviewer</field>
            <field name="category_id" ref="inom_university_core.module_category_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Read access with document-approval rights for verification.</field>
        </record>

        <record id="group_univ_portal_applicant" model="res.groups">
            <field name="name">University Portal Applicant</field>
            <field name="category_id" ref="inom_university_core.module_category_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_portal')])]"/>
            <field name="comment">Public portal access scoped to the applicant's own application.</field>
        </record>

        <!-- Admin inherits the admission officer rights out of the box -->
        <record id="inom_university_core.group_univ_admin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_univ_admission_officer'))]"/>
        </record>

        <!-- Registrar gains review rights over the admission pipeline -->
        <record id="inom_university_core.group_univ_registrar" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_univ_admission_reviewer'))]"/>
        </record>

        <!-- ============ MULTI-COMPANY RECORD RULES ============ -->
        <record id="rule_univ_applicant_company" model="ir.rule">
            <field name="name">Applicant multi-company</field>
            <field name="model_id" ref="model_univ_applicant"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_univ_round_company" model="ir.rule">
            <field name="name">Admission round multi-company</field>
            <field name="model_id" ref="model_univ_admission_round"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_univ_quota_seat_company" model="ir.rule">
            <field name="name">Quota seat multi-company</field>
            <field name="model_id" ref="model_univ_quota_seat"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_univ_offer_company" model="ir.rule">
            <field name="name">Offer multi-company</field>
            <field name="model_id" ref="model_univ_applicant_offer"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_univ_applicant_document_company" model="ir.rule">
            <field name="name">Applicant document multi-company</field>
            <field name="model_id" ref="model_univ_applicant_document"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- ============ PORTAL APPLICANT SCOPING ============ -->
        <record id="rule_univ_applicant_portal_own" model="ir.rule">
            <field name="name">Applicant: portal own application</field>
            <field name="model_id" ref="model_univ_applicant"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_univ_portal_applicant'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_univ_applicant_document_portal_own" model="ir.rule">
            <field name="name">Applicant document: portal own</field>
            <field name="model_id" ref="model_univ_applicant_document"/>
            <field name="domain_force">[('applicant_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_univ_portal_applicant'))]"/>
        </record>

        <record id="rule_univ_applicant_offer_portal_own" model="ir.rule">
            <field name="name">Offer: portal own</field>
            <field name="model_id" ref="model_univ_applicant_offer"/>
            <field name="domain_force">[('applicant_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_univ_portal_applicant'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_univ_applicant_merit_portal_own" model="ir.rule">
            <field name="name">Merit: portal own</field>
            <field name="model_id" ref="model_univ_applicant_merit"/>
            <field name="domain_force">[('applicant_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_univ_portal_applicant'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
