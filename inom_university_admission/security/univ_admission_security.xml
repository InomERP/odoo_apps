<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============ GROUPS ============ -->
        <record id="group_univ_admission_officer" model="res.groups">
            <field name="name">Admission Officer</field>
            <field name="sequence">25</field>
            <field name="privilege_id"
                   ref="inom_university_core.res_groups_privilege_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Full CRUD on applicants, stages and offers; cannot delete enrolled applicants.</field>
        </record>

        <record id="group_univ_admission_reviewer" model="res.groups">
            <field name="name">Admission Reviewer</field>
            <field name="sequence">24</field>
            <field name="privilege_id"
                   ref="inom_university_core.res_groups_privilege_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Read access with document-approval rights for verification.</field>
        </record>

        <record id="group_univ_portal_applicant" model="res.groups">
            <field name="name">University Portal Applicant</field>
            <field name="sequence">26</field>
            <field name="privilege_id"
                   ref="inom_university_core.res_groups_privilege_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_portal')])]"/>
            <field name="comment">Public portal access scoped to the applicant's own application.</field>
        </record>

        <!-- Admin inherits the admission officer rights out of the box -->
        <record id="inom_university_core.group_univ_admin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_univ_admission_officer'))]"/>
        </record>

        <!-- Registrar gains review rights over the admission pipeline -->
        <record id="inom_university_core.group_univ_registrar" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_univ_admission_reviewer'))]"/>
        </record>

    </data>
</odoo>
