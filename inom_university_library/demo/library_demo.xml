<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_cat_cs" model="univ.library.category">
            <field name="name">Computer Science</field><field name="code">CS</field>
        </record>
        <record id="demo_author_1" model="univ.library.author">
            <field name="name">Thomas H. Cormen</field>
        </record>
        <record id="demo_pub_1" model="univ.library.publisher">
            <field name="name">MIT Press</field><field name="city">Cambridge</field>
        </record>
        <record id="demo_book_clrs" model="univ.library.book">
            <field name="name">Introduction to Algorithms</field>
            <field name="isbn">9780262033848</field>
            <field name="category_id" ref="demo_cat_cs"/>
            <field name="author_ids" eval="[(6,0,[ref('demo_author_1')])]"/>
            <field name="publisher_id" ref="demo_pub_1"/>
        </record>
        <record id="demo_copy_1" model="univ.library.copy">
            <field name="book_id" ref="demo_book_clrs"/><field name="barcode">CLRS-001</field>
        </record>
        <record id="demo_copy_2" model="univ.library.copy">
            <field name="book_id" ref="demo_book_clrs"/><field name="barcode">CLRS-002</field>
        </record>
        <record id="demo_member_rahul" model="univ.library.member">
            <field name="member_type">student</field>
            <field name="student_id" ref="inom_university_core.demo_student_rahul"/>
            <field name="max_books">4</field>
        </record>
    </data>
</odoo>
