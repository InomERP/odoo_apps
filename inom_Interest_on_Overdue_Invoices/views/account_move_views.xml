<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inom_interest" model="ir.ui.view">
        <field name="name">account.move.form.inom.interest</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_inom_interest" type="object"
                        class="oe_stat_button" icon="fa-percent"
                        invisible="move_type != 'out_invoice' or inom_interest_count == 0">
                    <field name="inom_interest_count" widget="statinfo" string="Interest"/>
                </button>
            </xpath>

            <!-- Header buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_inom_preview_interest" type="object"
                        string="Preview Interest"
                        invisible="move_type != 'out_invoice' or state != 'posted'"/>
                <button name="action_inom_apply_interest" type="object"
                        string="Apply Interest" class="btn-secondary"
                        invisible="move_type != 'out_invoice' or state != 'posted'"/>
            </xpath>

            <!-- Overdue Interest tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Overdue Interest" name="inom_overdue_interest"
                      invisible="move_type != 'out_invoice'">
                    <group>
                        <group string="INTEREST SETTINGS">
                            <field name="inom_interest_exclude"/>
                            <field name="inom_interest_rule_id"
                                   invisible="inom_interest_exclude"/>
                            <field name="inom_interest_status" widget="badge"
                                   decoration-warning="inom_interest_status == 'no_interest'"
                                   decoration-info="inom_interest_status == 'overdue'"
                                   decoration-success="inom_interest_status == 'applied'"/>
                        </group>
                        <group string="OVERDUE STATUS">
                            <field name="invoice_date_due" string="Due Date" readonly="1"/>
                            <field name="amount_residual" string="Amount Due" readonly="1"/>
                            <field name="inom_days_overdue"/>
                        </group>
                    </group>

<!--                    <separator string="INTEREST HISTORY"/>-->
<!--                    <field name="inom_interest_history_ids" readonly="1">-->
<!--                        <list>-->
<!--                            <field name="name"/>-->
<!--                            <field name="calculation_date"/>-->
<!--                            <field name="rule_id"/>-->
<!--                            <field name="days_overdue"/>-->
<!--                            <field name="base_amount"/>-->
<!--                            <field name="final_interest"/>-->
<!--                            <field name="move_id"/>-->
<!--                            <field name="status" widget="badge"-->
<!--                                   decoration-success="status == 'applied'"-->
<!--                                   decoration-warning="status == 'draft'"-->
<!--                                   decoration-danger="status == 'cancelled'"/>-->
<!--                            <field name="currency_id" column_invisible="1"/>-->
<!--                        </list>-->
<!--                    </field>-->
                </page>
            </xpath>

        </field>
    </record>

</odoo>