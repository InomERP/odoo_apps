<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_overdue_interest" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.overdue.interest</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='default_taxes_setting_container']" position="before">
                <block title="Overdue Interest on Invoices" id="overdue_interest_settings">
                    <setting string="Interest on Overdue Invoices"
                             help="Calculate interest on overdue customer invoices.">
                        <field name="enable_overdue_interest"/>
                        <div class="content-group" invisible="not enable_overdue_interest">
                            <div class="row mt16">
                                <div class="col-12 col-lg-6">
                                    <label for="interest_rule_id" string="Default Interest Rule"/>
                                    <field name="interest_rule_id"/>
                                </div>
                            </div>
                            <div class="row mt16">
                                <div class="col-12 col-lg-6">
                                    <label for="interest_account_id" string="Interest Income Account"/>
                                    <field name="interest_account_id"/>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <label for="interest_journal_id" string="Interest Journal"/>
                                    <field name="interest_journal_id"/>
                                </div>
                            </div>
                            <div class="row mt16">
                                <div class="col-12 col-lg-6">
                                    <label for="interest_product_id" string="Interest Product"/>
                                    <field name="interest_product_id"/>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <label for="overdue_output_type" string="Default Output Type"/>
                                    <field name="overdue_output_type" widget="radio"/>
                                </div>
                            </div>
                            <div class="row mt16">
                                <div class="col-12 col-lg-6">
                                    <field name="auto_compute_interest"/>
                                    <label for="auto_compute_interest" string="Auto-Compute Interest"/>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <field name="auto_apply_interest"/>
                                    <label for="auto_apply_interest" string="Auto-Apply Interest"/>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>

</odoo>