<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record id="pmodel_course" model="inom.portal.model">
      <field name="model_name">inom.course</field>
      <field name="label">Online course</field>
      <field name="allow_create" eval="True"/>
      <field name="allow_write" eval="True"/>
      <field name="allow_unlink" eval="True"/>
      <field name="module">inom_lms</field>
    </record>

    <record id="pmodel_lesson" model="inom.portal.model">
      <field name="model_name">inom.lesson</field>
      <field name="label">Lesson</field>
      <field name="allow_create" eval="True"/>
      <field name="allow_write" eval="True"/>
      <field name="allow_unlink" eval="True"/>
      <field name="module">inom_lms</field>
    </record>

    <record id="pmodel_assignment" model="inom.portal.model">
      <field name="model_name">inom.assignment</field>
      <field name="label">Assignment</field>
      <field name="allow_create" eval="True"/>
      <field name="allow_write" eval="True"/>
      <field name="allow_unlink" eval="True"/>
      <field name="module">inom_lms</field>
    </record>

    <record id="pmodel_submission" model="inom.portal.model">
      <field name="model_name">inom.submission</field>
      <field name="label">Submission</field>
      <field name="allow_create" eval="True"/>
      <field name="allow_write" eval="True"/>
      <field name="module">inom_lms</field>
    </record>

    <record id="view_course_list" model="inom.portal.view">
      <field name="key">course.list</field>
      <field name="name">Course</field>
      <field name="model_name">inom.course</field>
      <field name="order">name</field>
      <field name="search_field_ids">name,code</field>
      <field name="can_create" eval="True"/>
      <field name="can_write" eval="True"/>
      <field name="can_unlink" eval="True"/>
    </record>
    <record id="vf_code_course_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_course_list"/>
      <field name="sequence">10</field>
      <field name="name">code</field>
      <field name="label">Code</field>
      <field name="widget">mono</field>
      <field name="required" eval="True"/>
    </record>
    <record id="vf_name_course_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_course_list"/>
      <field name="sequence">20</field>
      <field name="name">name</field>
      <field name="label">Course</field>
      <field name="required" eval="True"/>
      <field name="span">2</field>
    </record>
    <record id="vf_faculty_id_course_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_course_list"/>
      <field name="sequence">30</field>
      <field name="name">faculty_id</field>
      <field name="label">Taught by</field>
      <field name="widget">many2one</field>
    </record>
    <record id="vf_department_id_course_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_course_list"/>
      <field name="sequence">40</field>
      <field name="name">department_id</field>
      <field name="label">Department</field>
      <field name="widget">many2one</field>
      <field name="required" eval="True"/>
    </record>
    <record id="vf_lesson_count_course_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_course_list"/>
      <field name="sequence">50</field>
      <field name="name">lesson_count</field>
      <field name="label">Lessons</field>
      <field name="widget">mono</field>
      <field name="readonly" eval="True"/>
      <field name="in_form" eval="False"/>
    </record>
    <record id="vf_duration_hours_course_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_course_list"/>
      <field name="sequence">60</field>
      <field name="name">duration_hours</field>
      <field name="label">Hours</field>
      <field name="widget">mono</field>
    </record>
    <record id="vf_published_course_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_course_list"/>
      <field name="sequence">70</field>
      <field name="name">published</field>
      <field name="label">Published</field>
      <field name="widget">boolean</field>
      <field name="readonly" eval="True"/>
      <field name="help_text">Draft courses are invisible to students.</field>
    </record>
    <record id="vf_summary_course_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_course_list"/>
      <field name="sequence">80</field>
      <field name="name">summary</field>
      <field name="label">Summary</field>
      <field name="span">2</field>
      <field name="in_list" eval="False"/>
    </record>

    <record id="view_lesson_list" model="inom.portal.view">
      <field name="key">lesson.list</field>
      <field name="name">Lesson</field>
      <field name="model_name">inom.lesson</field>
      <field name="order">course_id, sequence</field>
      <field name="chip_field">content_type</field>
      <field name="search_field_ids">name</field>
      <field name="can_create" eval="True"/>
      <field name="can_write" eval="True"/>
      <field name="can_unlink" eval="True"/>
    </record>
    <record id="vf_sequence_lesson_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_lesson_list"/>
      <field name="sequence">10</field>
      <field name="name">sequence</field>
      <field name="label">Order</field>
      <field name="widget">mono</field>
    </record>
    <record id="vf_name_lesson_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_lesson_list"/>
      <field name="sequence">20</field>
      <field name="name">name</field>
      <field name="label">Lesson</field>
      <field name="required" eval="True"/>
      <field name="span">2</field>
    </record>
    <record id="vf_course_id_lesson_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_lesson_list"/>
      <field name="sequence">30</field>
      <field name="name">course_id</field>
      <field name="label">Course</field>
      <field name="widget">many2one</field>
      <field name="required" eval="True"/>
    </record>
    <record id="vf_content_type_lesson_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_lesson_list"/>
      <field name="sequence">40</field>
      <field name="name">content_type</field>
      <field name="label">Type</field>
      <field name="widget">selection</field>
      <field name="required" eval="True"/>
    </record>
    <record id="vf_duration_minutes_lesson_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_lesson_list"/>
      <field name="sequence">50</field>
      <field name="name">duration_minutes</field>
      <field name="label">Minutes</field>
      <field name="widget">mono</field>
    </record>
    <record id="vf_url_lesson_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_lesson_list"/>
      <field name="sequence">60</field>
      <field name="name">url</field>
      <field name="label">Link</field>
      <field name="span">2</field>
      <field name="in_list" eval="False"/>
    </record>
    <record id="vf_file_lesson_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_lesson_list"/>
      <field name="sequence">62</field>
      <field name="name">file_data</field>
      <field name="label">File</field>
      <field name="widget">file</field>
      <field name="span">2</field>
      <field name="in_list" eval="False"/>
      <field name="help_text">Upload the document instead of linking to it. Up to 25 MB. Shown in the lesson rather than downloaded.</field>
    </record>
    <record id="vf_filename_lesson_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_lesson_list"/>
      <field name="sequence">63</field>
      <field name="name">file_name</field>
      <field name="label">File name</field>
      <field name="readonly" eval="True"/>
      <field name="in_list" eval="False"/>
    </record>
    <record id="vf_body_lesson_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_lesson_list"/>
      <field name="sequence">64</field>
      <field name="name">body</field>
      <field name="label">Reading</field>
      <field name="span">2</field>
      <field name="in_list" eval="False"/>
      <field name="help_text">Shown under the video, or on its own for a reading lesson.</field>
    </record>

    <record id="view_assignment_list" model="inom.portal.view">
      <field name="key">assignment.list</field>
      <field name="name">Assignment</field>
      <field name="model_name">inom.assignment</field>
      <field name="order">due_on desc</field>
      <field name="search_field_ids">name</field>
      <field name="can_create" eval="True"/>
      <field name="can_write" eval="True"/>
      <field name="can_unlink" eval="True"/>
    </record>
    <record id="vf_name_assignment_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_assignment_list"/>
      <field name="sequence">10</field>
      <field name="name">name</field>
      <field name="label">Assignment</field>
      <field name="required" eval="True"/>
      <field name="span">2</field>
    </record>
    <record id="vf_course_id_assignment_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_assignment_list"/>
      <field name="sequence">20</field>
      <field name="name">course_id</field>
      <field name="label">Course</field>
      <field name="widget">many2one</field>
      <field name="required" eval="True"/>
    </record>
    <record id="vf_issued_on_assignment_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_assignment_list"/>
      <field name="sequence">30</field>
      <field name="name">issued_on</field>
      <field name="label">Issued</field>
      <field name="widget">date</field>
    </record>
    <record id="vf_due_on_assignment_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_assignment_list"/>
      <field name="sequence">40</field>
      <field name="name">due_on</field>
      <field name="label">Due</field>
      <field name="widget">date</field>
      <field name="required" eval="True"/>
    </record>
    <record id="vf_max_marks_assignment_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_assignment_list"/>
      <field name="sequence">50</field>
      <field name="name">max_marks</field>
      <field name="label">Out of</field>
      <field name="widget">mono</field>
      <field name="required" eval="True"/>
    </record>
    <record id="vf_submitted_count_assignment_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_assignment_list"/>
      <field name="sequence">60</field>
      <field name="name">submitted_count</field>
      <field name="label">Submitted</field>
      <field name="widget">mono</field>
      <field name="readonly" eval="True"/>
      <field name="in_form" eval="False"/>
    </record>
    <record id="vf_graded_count_assignment_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_assignment_list"/>
      <field name="sequence">70</field>
      <field name="name">graded_count</field>
      <field name="label">Graded</field>
      <field name="widget">mono</field>
      <field name="readonly" eval="True"/>
      <field name="in_form" eval="False"/>
    </record>

    <record id="view_submission_list" model="inom.portal.view">
      <field name="key">submission.list</field>
      <field name="name">Submission</field>
      <field name="model_name">inom.submission</field>
      <field name="order">submitted_on desc</field>
      <field name="chip_field">state</field>
      <field name="search_field_ids">student_id</field>
      <field name="can_create" eval="True"/>
      <field name="can_write" eval="True"/>
    </record>
    <record id="vf_student_id_submission_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_submission_list"/>
      <field name="sequence">10</field>
      <field name="name">student_id</field>
      <field name="label">Student</field>
      <field name="widget">person</field>
      <field name="required" eval="True"/>
      <field name="span">2</field>
    </record>
    <record id="vf_assignment_id_submission_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_submission_list"/>
      <field name="sequence">20</field>
      <field name="name">assignment_id</field>
      <field name="label">Assignment</field>
      <field name="widget">many2one</field>
      <field name="required" eval="True"/>
    </record>
    <record id="vf_submitted_on_submission_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_submission_list"/>
      <field name="sequence">30</field>
      <field name="name">submitted_on</field>
      <field name="label">Submitted</field>
      <field name="readonly" eval="True"/>
      <field name="in_form" eval="False"/>
    </record>
    <record id="vf_late_submission_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_submission_list"/>
      <field name="sequence">40</field>
      <field name="name">late</field>
      <field name="label">Late</field>
      <field name="widget">boolean</field>
      <field name="readonly" eval="True"/>
      <field name="in_form" eval="False"/>
    </record>
    <record id="vf_marks_submission_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_submission_list"/>
      <field name="sequence">50</field>
      <field name="name">marks</field>
      <field name="label">Marks</field>
      <field name="widget">mono</field>
    </record>
    <record id="vf_max_marks_submission_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_submission_list"/>
      <field name="sequence">60</field>
      <field name="name">max_marks</field>
      <field name="label">Out of</field>
      <field name="widget">mono</field>
      <field name="readonly" eval="True"/>
      <field name="in_form" eval="False"/>
    </record>
    <record id="vf_state_submission_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_submission_list"/>
      <field name="sequence">70</field>
      <field name="name">state</field>
      <field name="label">Stage</field>
      <field name="widget">tag</field>
      <field name="readonly" eval="True"/>
    </record>
    <record id="vf_feedback_submission_list" model="inom.portal.view.field">
      <field name="view_id" ref="view_submission_list"/>
      <field name="sequence">80</field>
      <field name="name">feedback</field>
      <field name="label">Feedback</field>
      <field name="span">2</field>
      <field name="in_list" eval="False"/>
      <field name="help_text">Required with a mark. A number with no explanation just generates a query.</field>
    </record>

    <record id="module_lms" model="inom.portal.module">
      <field name="code">lms</field>
      <field name="name">Learning</field>
      <field name="icon">play</field>
      <field name="color">#5B3DF5</field>
      <field name="section">deliver</field>
      <field name="sequence">30</field>
    </record>

    <record id="page_lms_dash" model="inom.portal.page">
      <field name="code">dash</field>
      <field name="name">Dashboard</field>
      <field name="module_id" ref="module_lms"/>
      <field name="sequence">10</field>
      <field name="page_type">dashboard</field>
      <field name="dashboard_key">lms</field>
      <field name="group_ids" eval="[(6, 0, [ref('inom_base.group_inom_registrar'), ref('inom_base.group_inom_dean'), ref('inom_base.group_inom_hod'), ref('inom_base.group_inom_faculty')])]"/>
    </record>

    <record id="page_lms_courses" model="inom.portal.page">
      <field name="code">courses</field>
      <field name="name">Courses</field>
      <field name="module_id" ref="module_lms"/>
      <field name="sequence">20</field>
      <field name="page_type">list</field>
      <field name="view_id" ref="view_course_list"/>
    </record>

    <record id="page_lms_lessons" model="inom.portal.page">
      <field name="code">lessons</field>
      <field name="name">Lessons</field>
      <field name="module_id" ref="module_lms"/>
      <field name="sequence">30</field>
      <field name="page_type">list</field>
      <field name="view_id" ref="view_lesson_list"/>
    </record>

    <record id="page_lms_assignments" model="inom.portal.page">
      <field name="code">assignments</field>
      <field name="name">Assignments</field>
      <field name="module_id" ref="module_lms"/>
      <field name="sequence">40</field>
      <field name="page_type">list</field>
      <field name="view_id" ref="view_assignment_list"/>
    </record>

    <record id="page_lms_submissions" model="inom.portal.page">
      <field name="code">submissions</field>
      <field name="name">Submissions</field>
      <field name="module_id" ref="module_lms"/>
      <field name="sequence">50</field>
      <field name="page_type">list</field>
      <field name="view_id" ref="view_submission_list"/>
    </record>

    <record id="action_course_publish" model="inom.portal.action">
      <field name="key">course.publish</field>
      <field name="name">Publish the course</field>
      <field name="model_name">inom.course</field>
      <field name="method">_inom_action_publish</field>
      <field name="done_message">Published. Students can see it now.</field>
      <field name="icon">check</field>
      <field name="group_ids" eval="[(6, 0, [ref('inom_base.group_inom_registrar'), ref('inom_base.group_inom_dean'), ref('inom_base.group_inom_hod'), ref('inom_base.group_inom_faculty')])]"/>
      <field name="condition">not record.published</field>
      <field name="primary" eval="True"/>
    </record>

    <record id="action_course_unpublish" model="inom.portal.action">
      <field name="key">course.unpublish</field>
      <field name="name">Unpublish</field>
      <field name="model_name">inom.course</field>
      <field name="method">_inom_action_unpublish</field>
      <field name="done_message">Back to draft. Students can no longer see it.</field>
      <field name="icon">moon</field>
      <field name="confirm" eval="True"/>
      <field name="group_ids" eval="[(6, 0, [ref('inom_base.group_inom_registrar'), ref('inom_base.group_inom_dean'), ref('inom_base.group_inom_hod'), ref('inom_base.group_inom_faculty')])]"/>
      <field name="condition">record.published</field>
    </record>

    <record id="action_submission_grade" model="inom.portal.action">
      <field name="key">submission.grade</field>
      <field name="name">Record the mark</field>
      <field name="model_name">inom.submission</field>
      <field name="method">_inom_action_grade</field>
      <field name="done_message">Marked and returned to the student.</field>
      <field name="icon">award</field>
      <field name="group_ids" eval="[(6, 0, [ref('inom_base.group_inom_registrar'), ref('inom_base.group_inom_dean'), ref('inom_base.group_inom_hod'), ref('inom_base.group_inom_faculty')])]"/>
      <field name="condition">record.state != 'graded'</field>
      <field name="primary" eval="True"/>
    </record>

    <record id="action_submission_rework" model="inom.portal.action">
      <field name="key">submission.rework</field>
      <field name="name">Return for rework</field>
      <field name="model_name">inom.submission</field>
      <field name="method">_inom_action_return_for_rework</field>
      <field name="done_message">Returned for rework.</field>
      <field name="icon">clip</field>
      <field name="group_ids" eval="[(6, 0, [ref('inom_base.group_inom_registrar'), ref('inom_base.group_inom_dean'), ref('inom_base.group_inom_hod'), ref('inom_base.group_inom_faculty')])]"/>
      <field name="condition">record.state in ('submitted', 'grading')</field>
    </record>


    <record id="rel_student_submissions" model="inom.portal.related">
      <field name="view_id" ref="inom_student.view_student_list"/>
      <field name="sequence">45</field>
      <field name="name">Assignments</field>
      <field name="icon">play</field>
      <field name="related_view_id" ref="view_submission_list"/>
      <field name="inverse_field">student_id</field>
      <field name="limit">10</field>
    </record>

    <record id="rel_course_lessons" model="inom.portal.related">
      <field name="view_id" ref="view_course_list"/>
      <field name="sequence">10</field>
      <field name="name">Lessons</field>
      <field name="icon">play</field>
      <field name="related_view_id" ref="view_lesson_list"/>
      <field name="inverse_field">course_id</field>
      <field name="limit">20</field>
    </record>

    <record id="rel_course_assignments" model="inom.portal.related">
      <field name="view_id" ref="view_course_list"/>
      <field name="sequence">20</field>
      <field name="name">Assignments</field>
      <field name="icon">clip</field>
      <field name="related_view_id" ref="view_assignment_list"/>
      <field name="inverse_field">course_id</field>
      <field name="limit">12</field>
    </record>

    <record id="rel_assignment_submissions" model="inom.portal.related">
      <field name="view_id" ref="view_assignment_list"/>
      <field name="sequence">10</field>
      <field name="name">Submissions</field>
      <field name="icon">users</field>
      <field name="related_view_id" ref="view_submission_list"/>
      <field name="inverse_field">assignment_id</field>
      <field name="limit">20</field>
    </record>

    <record id="action_submission_grade_in_marks" model="inom.portal.action.input">
      <field name="action_id" ref="action_submission_grade"/>
      <field name="sequence">10</field>
      <field name="name">marks</field>
      <field name="label">Marks</field>
      <field name="input_type">number</field>
    </record>

    <record id="action_submission_grade_in_feedback" model="inom.portal.action.input">
      <field name="action_id" ref="action_submission_grade"/>
      <field name="sequence">20</field>
      <field name="name">feedback</field>
      <field name="label">Feedback for the student</field>
      <field name="input_type">textarea</field>
      <field name="required" eval="False"/>
      <field name="help_text">Optional, but it is the part they learn from.</field>
    </record>
    <record id="action_lesson_open" model="inom.portal.action">
      <field name="key">lesson.open</field>
      <field name="name">Open this lesson</field>
      <field name="model_name">inom.lesson</field>
      <field name="method">_inom_action_open</field>
      <field name="done_message">Opening\u2026</field>
      <field name="icon">play</field>
      <field name="group_ids" eval="[(6, 0, [ref('inom_base.group_inom_registrar'), ref('inom_base.group_inom_dean'), ref('inom_base.group_inom_hod'), ref('inom_base.group_inom_faculty'), ref('inom_base.group_inom_student')])]"/>
      <field name="primary" eval="True"/>
    </record>

  </data>
</odoo>
