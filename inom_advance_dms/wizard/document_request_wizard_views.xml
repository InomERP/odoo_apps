<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_edm_document_request_wizard_form" model="ir.ui.view">
        <field name="name">edm.document.request.wizard.form</field>
        <field name="model">edm.document.request.wizard</field>
        <field name="arch" type="xml">
            <form string="New File Request">
                <group>
                    <field name="requested_to"/>
                    <field name="workspace_id"/>
                    <field name="document_id" domain="[('workspace_id', '=', workspace_id)]"/>
                    <field name="deadline"/>
                    <field name="note" placeholder="Document Needed..."/>
                </group>
                <footer>
                    <button name="action_create_request"
                            string="Request"
                            type="object"
                            class="btn-primary"/>
                    <button string="Discard"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_edm_document_request_wizard" model="ir.actions.act_window">
        <field name="name">New File Request</field>
        <field name="res_model">edm.document.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_edm_document_request_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
