    <!-- Direct (no dialog) bulk download -->
    <record id="action_edm_bulk_download" model="ir.actions.server">
        <field name="name">Download Selected</field>
        <field name="model_id" ref="model_edm_document"/>
        <field name="binding_model_id" ref="model_edm_document"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_bulk_download()</field>
    </record>

    <!-- Replace file wizard action (post-upload management) -->
    <record id="action_edm_document_version_wizard" model="ir.actions.act_window">
