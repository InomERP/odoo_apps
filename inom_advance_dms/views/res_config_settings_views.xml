<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_edm"
            model="ir.ui.view">

        <field name="name">res.config.settings.edm</field>
        <field name="model">res.config.settings</field>

        <field name="inherit_id"
               ref="base.res_config_settings_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <group string="Advanced DMS Settings">

                    <field name="edm_trash_auto_delete_days"/>

                </group>

            </xpath>

        </field>

    </record>

</odoo>