<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_edm_tag_list" model="ir.ui.view">
        <field name="name">edm.tag.list</field>
        <field name="model">edm.tag</field>
        <field name="arch" type="xml">
            <list string="Tags">
                <field name="name"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <record id="view_edm_tag_form" model="ir.ui.view">
        <field name="name">edm.tag.form</field>
        <field name="model">edm.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_edm_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">edm.tag</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>