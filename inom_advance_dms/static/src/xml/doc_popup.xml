<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="inom_advance_dms.DocPopupWidget">
        <a class="edm-kb-open" href="#" style="display:flex; align-items:center; gap:14px; flex:1 1 0; min-width:0; max-width:100%; overflow:hidden; cursor:pointer; text-decoration:none; color:inherit;" t-on-click.stop.prevent="(ev) => this.open(ev)">
            <div t-attf-style="flex-shrink:0; width:46px; height:46px; min-width:46px; display:flex; align-items:center; justify-content:center; border-radius:11px; background:{{this.iconColor()}}1a; overflow:hidden;">
                <i class="oi" t-att-data-icon="this.iconClass()" t-attf-style="font-size:20px; line-height:1; color:{{this.iconColor()}}; cursor:pointer;"/>
            </div>
            <div style="flex:1 1 0; min-width:0; overflow:hidden;">
                <div style="font-size:15px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:220px; cursor:pointer; user-select:none;" t-out="this.rec.name"/>
                <div style="font-size:12px; color:#8a90a2; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:220px; cursor:pointer; user-select:none;"><t t-out="this.rec.owner_id and this.rec.owner_id[1]"/> · <t t-out="this.rec.create_date"/></div>
            </div>
        </a>
    </t>

    <t t-name="inom_advance_dms.DocPopupBody">
        <Dialog title="this.props.name" size="'lg'">
            <div class="edm-docpop2-body">
                <t t-if="this.state.preview and this.props.isPdf">
                    <iframe t-att-src="this.previewUrl" style="width:100%; height:60vh; border:0; border-radius:8px;"/>
                </t>
                <t t-else="">
                    <div style="text-align:center; padding:48px 0; color:#9aa1b2;">
                        <i class="oi" t-att-data-icon="this.props.isPdf ? 'file' : 'file'" style="font-size:66px;"/>
                        <div style="margin-top:12px; text-transform:uppercase; font-size:12px; letter-spacing:.5px;" t-out="this.props.ext or 'file'"/>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button t-if="this.props.isPdf" class="btn btn-secondary" t-on-click="this.togglePreview"><i class="oi me-1" data-icon="eye"/><t t-out="this.state.preview ? 'Hide preview' : 'Preview'"/></button>
                <button t-if="this.props.isPdf" class="btn btn-primary" t-on-click="this.annotate"><i class="oi me-1" data-icon="edit"/>Annotate</button>
            </t>
        </Dialog>
    </t>

</templates>
