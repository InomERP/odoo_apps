<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="inom_advance_dms.UploadDropzone">
        <div class="edm-uploader">

            <div class="edm-up-header">
                <div class="edm-up-title">
                    <i class="oi me-2" data-icon="upload"/>
                    <span>Upload Documents</span>
                </div>
                <button class="btn btn-sm btn-light" t-on-click="this.openDocuments">
                    <i class="oi me-1" data-icon="folder"/> Go to Documents
                </button>
            </div>

            <!-- OPTIONS -->
            <div class="edm-up-options">
                <div class="edm-up-field">
                    <label>Document Name</label>
                    <input type="text" t-model="this.documentName" class="form-control" placeholder="Enter document name"/>
                </div>
                <div class="edm-up-field">
                    <label>File Name</label>
                    <input type="text" t-model="this.fileName" class="form-control" placeholder="Enter file name"/>
                </div>
                <div class="edm-up-field">
                    <label>Workspace</label>
                    <select t-model="this.workspaceId" class="edm-up-select">
                        <option value="">— None —</option>
                        <option t-foreach="state.workspaces" t-as="ws" t-key="ws.id"
                                t-att-value="ws.id" t-out="ws.name"/>
                    </select>
                </div>
                <div class="edm-up-field edm-up-fav">
                    <label class="edm-up-check">
                        <input type="checkbox" t-model="this.isFavorite"/>
                        <span>Mark as favorite</span>
                    </label>
                </div>
            </div>

            <!-- DROP ZONE -->
            <div class="edm-dropzone"
                 t-att-class="this.state.dragging ? 'dragging' : ''"
                 t-on-dragover="this.onDragOver"
                 t-on-dragleave="this.onDragLeave"
                 t-on-drop="this.onDrop"
                 t-on-click="this.onBrowseClick">

                <input type="file" multiple="multiple" t-ref="this.fileInput"
                       class="edm-hidden-input"
                       t-att-accept="this.acceptAttr"
                       t-on-change="this.onFileInputChange"/>

                <div class="edm-dropzone-inner">
                    <div class="edm-dropzone-icon">
                        <i class="oi" data-icon="upload"/>
                    </div>
                    <div class="edm-dropzone-text">
                        <strong>Drag &amp; drop files here</strong>
                        <span>or click to browse</span>
                    </div>
                    <div class="edm-dropzone-hint">
                        PDF, DOC, DOCX, XLS, XLSX, PNG, JPG, JPEG, TXT, ZIP · up to 25&#160;MB each
                    </div>
                </div>
            </div>

            <!-- SUMMARY BAR -->
            <div t-if="this.state.files.length" class="edm-up-summary">
                <span><i class="oi me-1" data-icon="file"/><t t-out="this.state.files.length"/> file(s)</span>
                <span t-if="this.state.done" class="text-success">
                    <i class="oi me-1" data-icon="check"/><t t-out="this.state.done"/> done
                </span>
                <span t-if="this.state.failed" class="text-danger">
                    <i class="oi me-1" data-icon="close"/><t t-out="this.state.failed"/> failed
                </span>
                <div class="edm-up-summary-actions">
                    <button class="btn btn-sm btn-light" t-att-disabled="this.state.uploading" t-on-click="this.clearAll">Clear</button>
                    <button class="btn btn-sm btn-primary" t-att-disabled="!this.hasPending || this.state.uploading" t-on-click="this.uploadAll">
                        <t t-if="this.state.uploading"><span class="edm-mini-spinner"/> Uploading...</t>
                        <t t-else=""><i class="oi me-1" data-icon="upload"/> Upload All</t>
                    </button>
                </div>
            </div>

            <!-- FILE PREVIEW CARDS -->
            <div t-if="this.state.files.length" class="edm-file-list">
                <div class="edm-file-card" t-foreach="state.files" t-as="f" t-key="f.uid"
                     t-att-class="{'is-done': f.status === 'done', 'is-error': f.status === 'error' || f.status === 'invalid', 'is-uploading': f.status === 'uploading'}">
                    <div class="edm-file-icon"><i class="oi" t-att-data-icon="this.iconFor(f.ext)"/></div>
                    <div class="edm-file-info">
                        <div class="edm-file-name" t-out="f.name"/>
                        <div class="edm-file-sub">
                            <span t-out="this.humanSize(f.size)"/>
                            <span t-if="f.status === 'done' &amp;&amp; f.duplicate" class="edm-file-warn">· duplicate name</span>
                            <span t-if="f.error" class="edm-file-err" t-out="' · ' + f.error"/>
                        </div>
                        <div t-if="f.status === 'uploading' || f.status === 'done'" class="edm-progress">
                            <div class="edm-progress-bar" t-att-style="'width:' + f.progress + '%'"/>
                        </div>
                    </div>
                    <div class="edm-file-status">
                        <t t-if="f.status === 'pending'"><i class="oi text-muted" data-icon="clock" title="Ready"/></t>
                        <t t-elif="f.status === 'uploading'"><span t-out="f.progress + '%'" class="edm-pct"/></t>
                        <t t-elif="f.status === 'done'"><i class="oi text-success" data-icon="check"/></t>
                        <t t-else=""><i class="oi text-danger" data-icon="warning"/></t>
                        <button t-if="f.status !== 'uploading'" class="edm-file-remove" title="Remove" t-on-click.stop="() => this.removeFile(f.uid)">
                            <i class="oi" data-icon="close"/>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </t>

</templates>
