<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================= -->
    <!-- Module category and group privilege (Odoo 19)                 -->
    <!-- ============================================================= -->
    <record id="module_category_university" model="ir.module.category">
        <field name="name">University Management</field>
        <field name="description">Access rights for the University Management System.</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_university" model="res.groups.privilege">
        <field name="name">University Management</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_university"/>
    </record>

    <!-- ============================================================= -->
    <!-- Security groups                                               -->
    <!-- ============================================================= -->
    <record id="group_univ_faculty" model="res.groups">
        <field name="name">Faculty</field>
        <field name="privilege_id" ref="res_groups_privilege_university"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Self-service on own profile; read access to students and subjects.</field>
    </record>

    <record id="group_univ_hod" model="res.groups">
        <field name="name">Head of Department</field>
        <field name="privilege_id" ref="res_groups_privilege_university"/>
        <field name="implied_ids" eval="[(4, ref('group_univ_faculty'))]"/>
        <field name="comment">Department-scoped create/read/update on faculty and subjects.</field>
    </record>

    <record id="group_univ_dean" model="res.groups">
        <field name="name">Dean</field>
        <field name="privilege_id" ref="res_groups_privilege_university"/>
        <field name="implied_ids" eval="[(4, ref('group_univ_faculty'))]"/>
        <field name="comment">Department-scoped read/approve on students and faculty.</field>
    </record>

    <record id="group_univ_registrar" model="res.groups">
        <field name="name">Registrar</field>
        <field name="privilege_id" ref="res_groups_privilege_university"/>
        <field name="implied_ids" eval="[(4, ref('group_univ_faculty'))]"/>
        <field name="comment">Owns academic operations: full control on students and masters.</field>
    </record>

    <record id="group_univ_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_university"/>
        <field name="implied_ids" eval="[(4, ref('group_univ_registrar'))]"/>
        <field name="comment">Full administrative control across all University modules.</field>
    </record>

    <!-- Portal groups -->
    <record id="group_univ_portal_student" model="res.groups">
        <field name="name">University Portal: Student</field>
        <field name="privilege_id" ref="res_groups_privilege_university"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Portal access to the student's own record.</field>
    </record>

    <record id="group_univ_portal_parent" model="res.groups">
        <field name="name">University Portal: Parent</field>
        <field name="privilege_id" ref="res_groups_privilege_university"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Portal access scoped to linked ward(s).</field>
    </record>

    <!-- Make the admin user a University Administrator out of the box -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_univ_admin'))]"/>
    </record>

</odoo>
