<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_univ_student_enrolment" model="ir.sequence">
            <field name="name">University Student Enrolment</field>
            <field name="code">univ.student.enrolment</field>
            <field name="prefix">%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <record id="seq_univ_faculty_code" model="ir.sequence">
            <field name="name">University Faculty Code</field>
            <field name="code">univ.faculty.code</field>
            <field name="prefix">%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

    </data>
</odoo>
