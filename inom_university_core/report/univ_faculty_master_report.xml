<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_univ_faculty_master">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="mb-3">Faculty Master List</h2>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Designation</th>
                                <th>Department</th>
                                <th>Staff Type</th>
                                <th>Subjects</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="faculty">
                                <td><span t-field="faculty.code"/></td>
                                <td><span t-field="faculty.name"/></td>
                                <td><span t-field="faculty.designation"/></td>
                                <td><span t-field="faculty.department_id"/></td>
                                <td><span t-field="faculty.faculty_type"/></td>
                                <td><span t-field="faculty.subject_count"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="text-muted mt-3">
                        Total faculty: <span t-esc="len(docs)"/>
                    </p>
                </div>
            </t>
        </t>
    </template>

</odoo>
