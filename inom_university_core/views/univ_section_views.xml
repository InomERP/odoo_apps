<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_univ_section_list" model="ir.ui.view">
        <field name="name">univ.section.list</field>
        <field name="model">univ.section</field>
        <field name="arch" type="xml">
            <tree string="Sections">
                <field name="code"/>
                <field name="name"/>
                <field name="batch_id"/>
                <field name="semester_id"/>
                <field name="program_id"/>
                <field name="capacity"/>
                <field name="student_count" string="Students"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_univ_section_form" model="ir.ui.view">
        <field name="name">univ.section.form</field>
        <field name="model">univ.section</field>
        <field name="arch" type="xml">
            <form string="Section">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Section A"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="batch_id"/>
                            <field name="semester_id"/>
                        </group>
                        <group>
                            <field name="program_id"/>
                            <field name="capacity"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_univ_section_search" model="ir.ui.view">
        <field name="name">univ.section.search</field>
        <field name="model">univ.section</field>
        <field name="arch" type="xml">
            <search string="Sections">
                <field name="name"/>
                <field name="code"/>
                <field name="batch_id"/>
                <field name="semester_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_batch" string="Batch"
                            context="{'group_by': 'batch_id'}"/>
                    <filter name="group_semester" string="Semester"
                            context="{'group_by': 'semester_id'}"/>
                    <filter name="group_program" string="Program"
                            context="{'group_by': 'program_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_univ_section" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">univ.section</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first section</p>
            <p>Sections are class sub-groups of a batch for a semester.</p>
        </field>
    </record>

</odoo>
