<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_univ_student_list" model="ir.ui.view">
        <field name="name">univ.student.list</field>
        <field name="model">univ.student</field>
        <field name="arch" type="xml">
            <tree string="Students"
                  decoration-muted="state == 'dropped'"
                  decoration-success="state == 'active'"
                  decoration-info="state == 'enrolled'"
                  decoration-primary="state == 'graduated'">
                <field name="enrolment_no"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="batch_id"/>
                <field name="section_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'enrolled'"
                       decoration-muted="state == 'dropped'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_univ_student_form" model="ir.ui.view">
        <field name="name">univ.student.form</field>
        <field name="model">univ.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <header>
                    <button name="action_enroll" type="object" string="Enroll"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_activate" type="object" string="Activate"
                            class="oe_highlight" invisible="state != 'enrolled'"/>
                    <button name="action_graduate" type="object" string="Graduate"
                            invisible="state != 'active'"/>
                    <button name="action_drop" type="object" string="Drop"
                            invisible="state not in ('enrolled', 'active')"
                            confirm="Are you sure you want to mark this student as dropped?"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Applicant"
                            invisible="state == 'draft'" groups="inom_university_core.group_univ_registrar"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,enrolled,active,graduated"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Student full name"/></h1>
                        <h3>
                            <field name="enrolment_no" readonly="1"
                                   placeholder="Enrolment number (auto)"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Academic">
                            <field name="program_id"/>
                            <field name="batch_id"/>
                            <field name="semester_id"/>
                            <field name="section_id"/>
                            <field name="roll_number"/>
                            <field name="category"/>
                        </group>
                        <group string="Profile">
                            <field name="partner_id" readonly="1"/>
                            <field name="admission_date"/>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="blood_group"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Personal &amp; Contact" name="personal">
                            <group>
                                <group string="Contact">
                                    <field name="email" widget="email"/>
                                    <field name="phone" widget="phone"/>
                                    <field name="mobile" widget="phone"/>
                                </group>
                                <group string="Address">
                                    <field name="street"/>
                                    <field name="city"/>
                                    <field name="state_id"/>
                                    <field name="zip"/>
                                    <field name="country_id"/>
                                </group>
                            </group>
                            <group string="Medical">
                                <field name="medical_notes" nolabel="1"
                                       placeholder="Allergies, conditions, emergency notes..."/>
                            </group>
                        </page>
                        <page string="Guardians" name="guardians">
                            <field name="guardian_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="relationship"/>
                                    <field name="mobile"/>
                                    <field name="email"/>
                                    <field name="occupation"/>
                                    <field name="is_primary"/>
                                </tree>
                            </field>
                            <field name="primary_guardian_id" readonly="1"/>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="document_complete" invisible="1"/>
                            <field name="document_ids">
                                <tree editable="bottom" decoration-success="state == 'verified'"
                                      decoration-danger="state == 'rejected'">
                                    <field name="doc_type"/>
                                    <field name="name"/>
                                    <field name="version" readonly="1"/>
                                    <field name="file" filename="file_name" widget="binary"/>
                                    <field name="file_name" column_invisible="1"/>
                                    <field name="issue_date"/>
                                    <field name="expiry_date"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'verified'"
                                           decoration-danger="state == 'rejected'"/>
                                    <button name="action_verify" type="object" string="Verify"
                                            icon="fa-check" invisible="state == 'verified'"/>
                                    <button name="action_reject" type="object" string="Reject"
                                            icon="fa-times" invisible="state == 'rejected'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_univ_student_kanban" model="ir.ui.view">
        <field name="name">univ.student.kanban</field>
        <field name="model">univ.student</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_top mb8">
                            <div class="o_kanban_image me-2">
                                <img t-att-src="kanban_image('univ.student', 'image_1920', record.id.raw_value)"
                                     alt="Photo" class="o_image_64_cover"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted">
                                    <field name="enrolment_no"/>
                                </div>
                                <div>
                                    <span class="badge text-bg-info">
                                        <field name="program_id"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_univ_student_search" model="ir.ui.view">
        <field name="name">univ.student.search</field>
        <field name="model">univ.student</field>
        <field name="arch" type="xml">
            <search string="Students">
                <field name="name"/>
                <field name="enrolment_no"/>
                <field name="roll_number"/>
                <field name="program_id"/>
                <field name="batch_id"/>
                <field name="section_id"/>
                <filter name="applicant" string="Applicants" domain="[('state', '=', 'draft')]"/>
                <filter name="enrolled" string="Enrolled" domain="[('state', '=', 'enrolled')]"/>
                <filter name="active_students" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="graduated" string="Graduated" domain="[('state', '=', 'graduated')]"/>
                <filter name="dropped" string="Dropped" domain="[('state', '=', 'dropped')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_program" string="Program"
                            context="{'group_by': 'program_id'}"/>
                    <filter name="group_batch" string="Batch"
                            context="{'group_by': 'batch_id'}"/>
                    <filter name="group_semester" string="Semester"
                            context="{'group_by': 'semester_id'}"/>
                    <filter name="group_section" string="Section"
                            context="{'group_by': 'section_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_gender" string="Gender"
                            context="{'group_by': 'gender'}"/>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_univ_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">univ.student</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first student</p>
            <p>Student master records cover the full applicant-to-graduate lifecycle.</p>
        </field>
    </record>

</odoo>
