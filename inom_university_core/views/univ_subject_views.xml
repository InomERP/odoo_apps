<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_univ_subject_list" model="ir.ui.view">
        <field name="name">univ.subject.list</field>
        <field name="model">univ.subject</field>
        <field name="arch" type="xml">
            <tree string="Subjects">
                <field name="code"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="semester_id"/>
                <field name="subject_type"/>
                <field name="credit_hours"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_univ_subject_form" model="ir.ui.view">
        <field name="name">univ.subject.form</field>
        <field name="model">univ.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Data Structures"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="program_id"/>
                            <field name="semester_id"/>
                        </group>
                        <group>
                            <field name="subject_type"/>
                            <field name="credit_hours"/>
                            <field name="elective_group_id"
                                   invisible="subject_type != 'elective'"
                                   required="subject_type == 'elective'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Faculty" name="faculty">
                            <field name="faculty_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_univ_subject_search" model="ir.ui.view">
        <field name="name">univ.subject.search</field>
        <field name="model">univ.subject</field>
        <field name="arch" type="xml">
            <search string="Subjects">
                <field name="name"/>
                <field name="code"/>
                <field name="program_id"/>
                <field name="semester_id"/>
                <filter name="core" string="Core" domain="[('subject_type', '=', 'core')]"/>
                <filter name="elective" string="Elective" domain="[('subject_type', '=', 'elective')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_program" string="Program"
                            context="{'group_by': 'program_id'}"/>
                    <filter name="group_semester" string="Semester"
                            context="{'group_by': 'semester_id'}"/>
                    <filter name="group_type" string="Subject Type"
                            context="{'group_by': 'subject_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_univ_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">univ.subject</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first subject</p>
            <p>Subjects are the course catalogue items with credit hours.</p>
        </field>
    </record>

</odoo>
