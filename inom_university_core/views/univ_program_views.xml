<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_univ_program_list" model="ir.ui.view">
        <field name="name">univ.program.list</field>
        <field name="model">univ.program</field>
        <field name="arch" type="xml">
            <tree string="Programs">
                <field name="code"/>
                <field name="name"/>
                <field name="degree_type"/>
                <field name="department_id"/>
                <field name="duration_years"/>
                <field name="total_semesters"/>
                <field name="student_count" string="Students"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_univ_program_form" model="ir.ui.view">
        <field name="name">univ.program.form</field>
        <field name="model">univ.program</field>
        <field name="arch" type="xml">
            <form string="Program">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_students" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="student_count" widget="statinfo" string="Students"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. B.Tech Computer Science"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="degree_type"/>
                            <field name="department_id"/>
                            <field name="faculty_school_id"/>
                        </group>
                        <group>
                            <field name="duration_years"/>
                            <field name="total_semesters"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Batches" name="batches">
                            <field name="batch_ids">
                                <tree>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="start_year"/>
                                    <field name="end_year"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Semesters" name="semesters">
                            <field name="semester_ids">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Subjects" name="subjects">
                            <field name="subject_ids">
                                <tree>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="semester_id"/>
                                    <field name="subject_type"/>
                                    <field name="credit_hours"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_univ_program_search" model="ir.ui.view">
        <field name="name">univ.program.search</field>
        <field name="model">univ.program</field>
        <field name="arch" type="xml">
            <search string="Programs">
                <field name="name"/>
                <field name="code"/>
                <field name="department_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_degree" string="Degree Type"
                            context="{'group_by': 'degree_type'}"/>
                    <filter name="group_company" string="Campus"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_univ_program" model="ir.actions.act_window">
        <field name="name">Programs</field>
        <field name="res_model">univ.program</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first program</p>
            <p>Programs are degrees or courses of study offered by a department.</p>
        </field>
    </record>

</odoo>
