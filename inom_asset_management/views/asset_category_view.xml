<odoo>

    <record id="view_category_form" model="ir.ui.view">
        <field name="name">asset.category.form</field>
        <field name="model">asset.category.custom</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                    </group>

                    <group>
                        <group string="Journal Entries">
                            <field name="journal_id"/>
                            <field name="asset_account_id"/>
                            <field name="depreciation_account_id"/>
                            <field name="expense_account_id"/>
                        </group>

                        <group string="Periodicity">
                            <field name="method"/>
                            <field name="method_number"/>
                            <field name="method_period"/>
                            <field name="method_end"/>
                        </group>
                    </group>

                   <group col="2">
    
    <group string="Additional Options">
        <field name="auto_confirm"/>
        <field name="group_entries"/>
        <field name="method_time"/>
    </group>

    <group string="Depreciation Method">
        <field name="method"/>
        <field name="method_progress_factor"/>
    </group>

</group>

                </sheet>
            </form>
        </field>
    </record>


    <record id="view_category_list" model="ir.ui.view">
        <field name="name">asset.category.list</field>
        <field name="model">asset.category.custom</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="method"/>
            </list>
        </field>
    </record>


    <record id="action_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">asset.category.custom</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="action_asset_depreciation" model="ir.actions.act_window">
        <field name="name">Depreciation Lines</field>
        <field name="res_model">asset.depreciation.line</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>