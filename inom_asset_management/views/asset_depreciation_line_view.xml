<odoo>
    <record id="view_depreciation_line_tree" model="ir.ui.view">
        <field name="name">depreciation.line.tree</field>
        <field name="model">asset.depreciation.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="asset_id"/>
                <field name="depreciation_date"/>
                <field name="amount"/>
                <field name="cumulative_value"/>
                <field name="remaining_value"/>
            </list>
        </field>
    </record>


    <record id="view_depreciation_line_form" model="ir.ui.view">
        <field name="name">depreciation.line.form</field>
        <field name="model">asset.depreciation.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="asset_id"/>
                        <field name="depreciation_date"/>
                        <field name="amount"/>
                        <field name="cumulative_value"/>
                        <field name="remaining_value"/>
                    </group>
                </sheet>
            </form>

        </field>
    </record>
</odoo>