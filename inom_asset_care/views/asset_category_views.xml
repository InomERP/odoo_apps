<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inom_asset_category_form" model="ir.ui.view">
        <field name="name">inom.asset.category.form</field>
        <field name="model">inom.asset.category</field>
        <field name="arch" type="xml">
            <form string="Asset Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="asset_count" widget="statinfo" string="Assets"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Machinery"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="parent_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Depreciation Defaults">
                            <field name="depreciation_method"/>
                            <field name="depreciation_years"/>
                            <field name="declining_factor" invisible="depreciation_method != 'declining'"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes about this category..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_inom_asset_category_list" model="ir.ui.view">
        <field name="name">inom.asset.category.list</field>
        <field name="model">inom.asset.category</field>
        <field name="arch" type="xml">
            <list string="Asset Categories">
                <field name="complete_name"/>
                <field name="code"/>
                <field name="asset_count"/>
                <field name="depreciation_method"/>
            </list>
        </field>
    </record>

    <record id="action_inom_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">inom.asset.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
