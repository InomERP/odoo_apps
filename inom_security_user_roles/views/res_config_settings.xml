<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inom_roles" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inom.roles</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.action_general_configuration"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block"
                     data-string="Security Roles"
                     data-key="inom_security_user_roles"
                     string="Security Roles">
                    <h2>Security Roles</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="show_technical_groups_without_devmode"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="show_technical_groups_without_devmode"/>
                                <div class="text-muted">
                                    All technical groups will be displayed on the Role form
                                    without requiring Developer Mode to be enabled.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>