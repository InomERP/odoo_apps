<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_inherit_roles" model="ir.ui.view">
        <field name="name">res.users.form.inherit.roles</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='access_rights']" position="after">
                <page string="Roles" name="security_roles">
                    <p class="text-muted mb-3">
                        Assign one or more roles to this user. All permissions and groups
                        defined in the assigned roles will be applied automatically.
                    </p>
                    <field name="role_ids"
                           widget="many2many_tags"
                           placeholder="Assign roles..."/>
                    <p class="text-info mt-3">
                        <i class="fa fa-info-circle"/>
                        Changing roles will automatically update
                        this user's access groups.
                    </p>

                    <!-- Feature 3: Create Role from this User -->

                    <div class="mt-4">
                        <button name="action_open_create_role_wizard"
                                type="object"
                                string="Create Role from this User"
                                class="btn btn-secondary"
                                icon="fa-shield"/>
                        <span class="text-muted ms-2">
                            Creates a new role with all current permissions of this user pre-filled.
                        </span>
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_res_users_feature7_warning" model="ir.ui.view">
        <field name="name">res.users.feature7.warning</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='role_ids']" position="after">

                <div class="alert alert-warning mb-0 mt-2"
                     role="alert"
                     invisible="not role_ids">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    <strong>WARNING:</strong>
                        If this user has assigned Roles, do <strong>not manually add Security Groups</strong>.
                        Whenever a Role is assigned, removed, or updated, any manually assigned groups
                        may be <strong>automatically removed</strong>.
                        Always manage permissions <strong>through Roles</strong> to ensure consistency.
                </div>

            </xpath>
        </field>
    </record>

    <!-- Feature 3: Wizard View — Create Role from User -->
    <record id="view_create_role_from_user_wizard_form" model="ir.ui.view">
        <field name="name">create.role.from.user.wizard.form</field>
        <field name="model">create.role.from.user.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Role from User">
                <sheet>
                    <div class="oe_title">
                        <h2>Create Role from User: <field name="source_user_id" readonly="1"/></h2>
                    </div>
                    <group>
                        <field name="role_name" placeholder="e.g. Senior Accountant"/>
                        <field name="description" placeholder="Describe what this role is for..."/>
                    </group>
                    <group string="Permissions to be Copied">
                        <field name="group_ids" widget="many2many_tags" readonly="1" nolabel="1"/>
                        <p class="text-muted mt-1">
                            <i class="fa fa-info-circle me-1"/>
                            All current permissions of this user will be copied into the new role.
                        </p>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_role"
                            type="object"
                            string="Create Role"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
</odoo>