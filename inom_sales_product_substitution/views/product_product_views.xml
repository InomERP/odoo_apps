<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_normal_form_view_inom_alternative" model="ir.ui.view">
        <field name="name">product.product.form.inherit.inom.alternative.products</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Alternatives"
                      name="inom_alternatives"
                      invisible="not inom_show_alternative_products or type == 'combo'">
                    <field name="inom_show_alternative_products" invisible="1"/>
                    <group>
                        <field name="inom_alternative_product_ids"
                               widget="many2many_tags"
                               domain="[('id', '!=', id)]"
                               options="{'no_create_edit': True}"
                               placeholder="Add substitute products..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
