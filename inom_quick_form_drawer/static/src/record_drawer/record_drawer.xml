<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="inom_quick_form_drawer.RecordDrawer">
        <div>
            <div t-if="state.isOpen"
                 class="o_record_drawer_backdrop"
                 t-on-click="onBackdropClick"/>

            <div class="o_record_drawer"
                 t-att-class="{ 'o_record_drawer_open': state.isOpen }">

                <div class="o_record_drawer_header">
                    <span class="o_record_drawer_title">Quick View</span>
                    <button class="btn btn-link o_record_drawer_close_btn"
                            t-on-click="onClose"
                            title="Close (Esc)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>

                <div class="o_record_drawer_body"
                     t-if="state.resModel and state.resId">
                    <View t-props="viewProps" t-key="state.instanceKey"/>
                </div>
            </div>
        </div>
    </t>

</templates>
