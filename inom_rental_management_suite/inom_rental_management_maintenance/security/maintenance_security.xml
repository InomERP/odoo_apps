<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Group rules add to the standard "own requests" rule of internal users. -->
        <record id="maintenance_request_rule_property_agent" model="ir.rule">
            <field name="name">Maintenance request: agents see the requests of their properties</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="domain_force">[('property_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('inom_rental_management.group_rental_agent'))]"/>
        </record>

        <record id="maintenance_request_rule_property_manager" model="ir.rule">
            <field name="name">Maintenance request: property managers see all property requests</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="domain_force">[('property_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('inom_rental_management.group_rental_manager'))]"/>
        </record>

        <record id="maintenance_request_rule_property_accountant" model="ir.rule">
            <field name="name">Maintenance request: real estate accountants read all property requests</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="domain_force">[('property_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('inom_rental_management.group_rental_accountant'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
