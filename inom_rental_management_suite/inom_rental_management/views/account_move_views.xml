<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form_rental_management" model="ir.ui.view">
        <field name="name">account.move.form.rental.management</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <group name="sale_info_group" position="inside">
                <field name="property_sale_contract_id" invisible="not property_sale_contract_id"/>
                <field name="property_id" invisible="not property_id"/>
                <field name="property_rental_contract_id" invisible="not property_rental_contract_id"/>
                <field name="property_rent_schedule_id" invisible="not property_rent_schedule_id"/>
                <field name="property_rental_move_kind" invisible="not property_rental_move_kind"/>
            </group>
        </field>
    </record>

    <record id="account_move_view_search_rental_management" model="ir.ui.view">
        <field name="name">account.move.search.rental.management</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="property_id"/>
                <field name="property_sale_contract_id"/>
                <field name="property_rental_contract_id"/>
                <filter name="property_sale_invoices" string="Property Sales" domain="[('property_sale_contract_id', '!=', False)]"/>
                <filter name="rental_rent" string="Rent" domain="[('property_rental_move_kind', '=', 'rent')]"/>
                <filter name="rental_deposit" string="Deposits" domain="[('property_rental_move_kind', 'in', ('deposit', 'deposit_settlement'))]"/>
                <filter name="rental_paid" string="Paid" domain="[('state', '=', 'posted'), ('payment_state', 'in', ('paid', 'in_payment'))]"/>
            </xpath>
        </field>
    </record>
</odoo>
