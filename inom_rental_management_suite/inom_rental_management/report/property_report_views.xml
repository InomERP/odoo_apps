<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rental income: property-wise, owner-wise, tenant outstanding -->
    <record id="property_rent_invoice_report_view_list" model="ir.ui.view">
        <field name="name">property.rent.invoice.report.list</field>
        <field name="model">property.rent.invoice.report</field>
        <field name="arch" type="xml">
            <list string="Rental Income" create="0" edit="0" delete="0" decoration-danger="is_overdue">
                <field name="move_id"/>
                <field name="move_type" optional="hide"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due"/>
                <field name="property_id"/>
                <field name="owner_id" optional="show"/>
                <field name="tenant_id"/>
                <field name="contract_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_invoiced" sum="Total"/>
                <field name="amount_paid" sum="Total"/>
                <field name="amount_due" sum="Total"/>
                <field name="days_overdue" optional="show"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="payment_state" widget="badge" optional="show"/>
            </list>
        </field>
    </record>

    <record id="property_rent_invoice_report_view_pivot" model="ir.ui.view">
        <field name="name">property.rent.invoice.report.pivot</field>
        <field name="model">property.rent.invoice.report</field>
        <field name="arch" type="xml">
            <pivot string="Rental Income" sample="1">
                <field name="property_id" type="row"/>
                <field name="invoice_date" interval="month" type="col"/>
                <field name="amount_invoiced" type="measure"/>
                <field name="amount_paid" type="measure"/>
                <field name="amount_due" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="property_rent_invoice_report_view_graph" model="ir.ui.view">
        <field name="name">property.rent.invoice.report.graph</field>
        <field name="model">property.rent.invoice.report</field>
        <field name="arch" type="xml">
            <graph string="Rental Income" type="bar" sample="1">
                <field name="invoice_date" interval="month"/>
                <field name="amount_invoiced" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="property_rent_invoice_report_view_search" model="ir.ui.view">
        <field name="name">property.rent.invoice.report.search</field>
        <field name="model">property.rent.invoice.report</field>
        <field name="arch" type="xml">
            <search string="Rental Income">
                <field name="property_id"/>
                <field name="owner_id"/>
                <field name="tenant_id"/>
                <field name="contract_id"/>
                <filter name="outstanding" string="Outstanding" domain="[('amount_due', '>', 0)]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="paid" string="Paid" domain="[('payment_state', 'in', ('paid', 'in_payment'))]"/>
                <separator/>
                <filter name="filter_invoice_date" string="Invoice Date" date="invoice_date"/>
                <filter name="filter_due_date" string="Due Date" date="invoice_date_due"/>
                <group>
                    <filter name="group_by_property" string="Property" context="{'group_by': 'property_id'}"/>
                    <filter name="group_by_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_by_tenant" string="Tenant" context="{'group_by': 'tenant_id'}"/>
                    <filter name="group_by_contract" string="Rental Contract" context="{'group_by': 'contract_id'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter name="group_by_month" string="Invoice Month" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_report_rental_income_property" model="ir.actions.act_window">
        <field name="name">Rental Income by Property</field>
        <field name="res_model">property.rent.invoice.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="property_rent_invoice_report_view_search"/>
        <field name="context">{'search_default_filter_invoice_date': 1, 'pivot_row_groupby': ['property_id']}</field>
    </record>

    <record id="action_report_rental_income_owner" model="ir.actions.act_window">
        <field name="name">Rental Income by Owner</field>
        <field name="res_model">property.rent.invoice.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="property_rent_invoice_report_view_search"/>
        <field name="context">{'search_default_filter_invoice_date': 1, 'pivot_row_groupby': ['owner_id', 'property_id']}</field>
    </record>

    <record id="action_report_tenant_outstanding" model="ir.actions.act_window">
        <field name="name">Tenant Outstanding Invoices</field>
        <field name="res_model">property.rent.invoice.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="property_rent_invoice_report_view_search"/>
        <field name="context">{'search_default_outstanding': 1, 'search_default_group_by_tenant': 1, 'pivot_row_groupby': ['tenant_id']}</field>
    </record>

    <!-- Contract expiry -->
    <record id="action_report_contract_expiry" model="ir.actions.act_window">
        <field name="name">Contract Expiry</field>
        <field name="res_model">property.rental.contract</field>
        <field name="view_mode">list,calendar,pivot,form</field>
        <field name="domain">[('state', 'in', ('running', 'expired'))]</field>
        <field name="context">{'search_default_group_by_date_end': 1}</field>
        <field name="search_view_id" ref="property_rental_contract_view_search"/>
    </record>

    <!-- Occupancy -->
    <record id="property_property_view_pivot_occupancy" model="ir.ui.view">
        <field name="name">property.property.pivot.occupancy</field>
        <field name="model">property.property</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <pivot string="Occupancy" sample="1">
                <field name="type_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="property_property_view_graph_occupancy" model="ir.ui.view">
        <field name="name">property.property.graph.occupancy</field>
        <field name="model">property.property</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <graph string="Occupancy" type="pie" sample="1">
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="action_report_occupancy" model="ir.actions.act_window">
        <field name="name">Property Occupancy</field>
        <field name="res_model">property.property</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('property_for', '=', 'rent')]</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'pivot', 'view_id': ref('property_property_view_pivot_occupancy')}),
            Command.create({'view_mode': 'graph', 'view_id': ref('property_property_view_graph_occupancy')})]"/>
        <field name="search_view_id" ref="property_property_view_search"/>
    </record>

    <!-- Sale transactions -->
    <record id="action_report_sale_transactions" model="ir.actions.act_window">
        <field name="name">Sale Transactions</field>
        <field name="res_model">property.sale.contract</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[('state', 'in', ('booked', 'sold'))]</field>
        <field name="search_view_id" ref="property_sale_contract_view_search"/>
    </record>

    <!-- Dashboard -->
    <record id="action_rental_dashboard" model="ir.actions.client">
        <field name="name">Real Estate Dashboard</field>
        <field name="tag">inom_rental_management.dashboard</field>
    </record>
</odoo>
