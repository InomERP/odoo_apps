<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_rental_contract_status" model="ir.cron">
            <field name="name">Real Estate: Update Lease Expiry</field>
            <field name="model_id" ref="model_property_rental_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_lease_status()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="ir_cron_rental_notifications" model="ir.cron">
            <field name="name">Real Estate: Notifications</field>
            <field name="model_id" ref="model_property_notification"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_notifications()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="ir_cron_rent_invoices" model="ir.cron">
            <field name="name">Real Estate: Generate Rent Invoices</field>
            <field name="model_id" ref="model_property_rent_schedule"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_rent_invoices()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
