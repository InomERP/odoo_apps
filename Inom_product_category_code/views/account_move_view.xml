<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_customer_ref_required" model="ir.ui.view">
        <field name="name">account.move.form.customer.ref.required</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Odoo 20 keeps Reference visible for vendor bills/journal entries,
                 but does not show it on customer invoices. Add the customer-facing
                 reference field explicitly and make it mandatory only there. -->
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <label for="ref"
                       string="Customer Reference"
                       invisible="move_type != 'out_invoice'"/>
                <field name="ref"
                       invisible="move_type != 'out_invoice'"
                       required="move_type == 'out_invoice'"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
