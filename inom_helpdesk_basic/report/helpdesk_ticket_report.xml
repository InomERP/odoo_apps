    <template id="report_helpdesk_ticket_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2 style="color:#6f42c1; border-bottom:2px solid #6f42c1; padding-bottom:8px;">
                                    Helpdesk Ticket Report
                                </h2>
                            </div>
                        </div>
                        <table class="table table-bordered">
                            <thead style="background-color:#6f42c1; color:white;">
                                <tr>
                                    <th colspan="2" class="text-center">
                                        Ticket Information
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="width:35%; font-weight:bold; background-color:#f8f9fa;">Ticket Number</td>
                                    <td><t t-out="doc.ticket_number"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold; background-color:#f8f9fa;">Subject</td>
                                    <td><t t-out="doc.subject"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold; background-color:#f8f9fa;">Assigned To</td>
                                    <td><t t-out="doc.assigned_to.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold; background-color:#f8f9fa;">Priority</td>
                                    <td>
                                        <t t-if="doc.priority == 'high'">
                                            <span style="background:#dc3545; color:white; padding:3px 10px; border-radius:4px;">High</span>
                                        </t>
                                        <t t-elif="doc.priority == 'medium'">
                                            <span style="background:#ffc107; color:black; padding:3px 10px; border-radius:4px;">Medium</span>
                                        </t>
                                        <t t-else="">
                                            <span style="background:#198754; color:white; padding:3px 10px; border-radius:4px;">Low</span>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold; background-color:#f8f9fa;">Current Status</td>
                                    <td>
                                        <t t-if="doc.state == 'new'">
                                            <span style="background:#0d6efd; color:white; padding:3px 10px; border-radius:4px;">New</span>
                                        </t>
                                        <t t-elif="doc.state == 'in_process'">
                                            <span style="background:#ffc107; color:black; padding:3px 10px; border-radius:4px;">In Process</span>
                                        </t>
                                        <t t-elif="doc.state == 'resolved'">
                                            <span style="background:#198754; color:white; padding:3px 10px; border-radius:4px;">Resolved</span>
                                        </t>
                                        <t t-else="">
                                            <span style="background:#6c757d; color:white; padding:3px 10px; border-radius:4px;">Closed</span>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold; background-color:#f8f9fa;">Description</td>
                                    <td><t t-out="doc.description"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row mt-4">
                            <div class="col-12 text-center text-muted">
                                <small>Generated by Helpdesk Ticket System</small>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>