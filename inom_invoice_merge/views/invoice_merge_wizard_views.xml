<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_invoice_merge_wizard_form" model="ir.ui.view">
        <field name="name">invoice.merge.wizard.form</field>
        <field name="model">invoice.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge Invoices">
                <sheet>

                    <group>
                        <field name="invoice_ids"
                               widget="many2many_tags"
                               readonly="1"/>
                        <field name="partner_id"
                               readonly="1"/>
                    </group>

                    <group>
                        <field name="merge_action"/>
                    </group>

                    <group string="Merge To">
                        <field name="merge_to_existing"/>

                        <field name="target_invoice_id"
                               invisible="not merge_to_existing"
                               required="merge_to_existing"/>
                    </group>

                </sheet>

                <footer>
                    <button name="action_merge_invoices"
                            type="object"
                            string="Merge"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
