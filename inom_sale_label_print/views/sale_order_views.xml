<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_inom_label_print" model="ir.ui.view">
        <field name="name">sale.order.form.inom.label.print</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_inom_labels"
                        type="object"
                        string="Print Labels"
                        icon="fa-tags"
                        help="Print product labels for every item on this order"/>
            </xpath>
        </field>
    </record>
</odoo>
