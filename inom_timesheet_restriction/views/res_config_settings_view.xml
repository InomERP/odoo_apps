<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_timesheet_restriction_view" model="ir.ui.view">
        <field name="name">res.config.settings.timesheet.restriction</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">

            <xpath expr="//block[@name='performance']" position="before">
                <block title="Timesheet Restriction" name="timesheet_restriction_setting_container">
                    <setting id="restrict_backdate_setting"
                             help="Prevent users from creating or editing backdated timesheets.">
                        <field name="restrict_backdate" />
                    </setting>
                </block>
            </xpath>

        </field>
    </record>
</odoo>
