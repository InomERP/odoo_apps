<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_hostel_allotment" model="ir.actions.report">
        <field name="name">Allotment Letter</field>
        <field name="model">univ.hostel.allotment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">inom_university_hostel.report_hostel_allotment</field>
        <field name="report_file">inom_university_hostel.report_hostel_allotment</field>
        <field name="binding_model_id" ref="model_univ_hostel_allotment"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_hostel_allotment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Hostel Allotment Letter</h2>
                        <table class="table table-sm mt-3">
                            <tr><th>Reference</th><td><span t-field="doc.name"/></td>
                                <th>Student</th><td><span t-field="doc.student_id.display_name"/></td></tr>
                            <tr><th>Hostel</th><td><span t-field="doc.hostel_id.display_name"/></td>
                                <th>Room / Bed</th><td><span t-field="doc.room_id.name"/> / <span t-field="doc.bed_id.name"/></td></tr>
                            <tr><th>Deposit</th><td><span t-field="doc.deposit_amount"/></td>
                                <th>Hostel Fee</th><td><span t-field="doc.hostel_fee"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
