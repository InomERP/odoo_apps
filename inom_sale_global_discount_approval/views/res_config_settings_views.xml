<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_discount_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.discount.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <group string="Discount Configuration">

                    <!-- Percentage Limit -->
                    <field name="max_discount_limit"/>

                    <!-- Amount Limit (ADD THIS) -->
                    <field name="max_discount_amount"/>

                    <!-- Accounting -->
                    <field name="discount_account_id"/>

                </group>

            </xpath>

        </field>
    </record>

</odoo>




