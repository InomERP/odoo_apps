<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_combo_pack_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.combo.pack</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="Combo Pack" id="combo_pack_block">
                    <setting id="allow_pack_on_purchase_setting"
                             string="Allow Combo Pack on Purchase"
                             help="Allow adding combo packs on purchase orders.">
                        <field name="allow_pack_on_purchase"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
