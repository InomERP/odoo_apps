<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_combo_pack_form" model="ir.ui.view">
        <field name="name">purchase.order.form.combo.pack</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <button name="action_open_pack_wizard" type="object"
                        string="Add Combo Pack" class="btn-secondary"
                        invisible="state not in ('draft', 'sent')"/>
                <button name="action_open_exploded_pack_wizard"
                        type="object" string="Add Exploded Pack"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'sent')"/>
            </xpath>
        </field>
    </record>

</odoo>
