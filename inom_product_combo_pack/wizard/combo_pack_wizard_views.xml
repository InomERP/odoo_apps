<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="combo_pack_wizard_form" model="ir.ui.view">
        <field name="name">combo.pack.wizard.form</field>
        <field name="model">combo.pack.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Combo Pack">
                <group>
                    <group>
                        <field name="order_model" invisible="1"/>
                        <field name="order_id" invisible="1"/>
                        <field name="explode" invisible="1"/>
                        <field name="pack_id"/>
                        <field name="quantity"/>
                    </group>
                    <group>
                        <field name="price_unit" invisible="explode"/>
                    </group>
                </group>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                        <field name="price_unit"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_add_pack" type="object" string="Add"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
