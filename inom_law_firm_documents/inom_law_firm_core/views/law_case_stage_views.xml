<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_law_case_stage_list" model="ir.ui.view">
        <field name="name">law.case.stage.list</field>
        <field name="model">law.case.stage</field>
        <field name="arch" type="xml">
            <tree string="Case Stages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_closing"/>
                <field name="fold"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_law_case_stage_form" model="ir.ui.view">
        <field name="name">law.case.stage.form</field>
        <field name="model">law.case.stage</field>
        <field name="arch" type="xml">
            <form string="Case Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_closing"/>
                            <field name="fold"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_law_case_stage" model="ir.actions.act_window">
        <field name="name">Case Stages</field>
        <field name="res_model">law.case.stage</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your case lifecycle stages</p>
            <p>Stages drive the case kanban pipeline. A default lifecycle is shipped and fully editable.</p>
        </field>
    </record>
</odoo>
