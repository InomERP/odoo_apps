<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root application menu -->
    <menuitem id="menu_law_firm_root"
              name="Law Firm"
              sequence="15"
              groups="group_law_firm_user"
              web_icon="inom_law_firm_core,static/description/icon.png"/>

    <!-- ============================================================
         Enterprise navigation sections. Each module parents its own
         menus into the appropriate section below. Sections with no
         visible children are hidden automatically by Odoo.
         ============================================================ -->
    <menuitem id="menu_law_sec_clients" name="Clients"
              parent="menu_law_firm_root" sequence="10"
              groups="group_law_firm_user"/>
    <menuitem id="menu_law_sec_matters" name="Matters"
              parent="menu_law_firm_root" sequence="20"
              groups="group_law_firm_user"/>
    <menuitem id="menu_law_sec_team" name="Lawyers &amp; Team"
              parent="menu_law_firm_root" sequence="30"
              groups="group_law_firm_user"/>
    <menuitem id="menu_law_sec_court" name="Hearings &amp; Court"
              parent="menu_law_firm_root" sequence="40"
              groups="group_law_firm_user"/>
    <menuitem id="menu_law_sec_calendar" name="Calendar &amp; Activities"
              parent="menu_law_firm_root" sequence="50"
              groups="group_law_firm_user"/>
    <menuitem id="menu_law_sec_time" name="Time &amp; Expenses"
              parent="menu_law_firm_root" sequence="60"
              groups="group_law_firm_user"/>
    <menuitem id="menu_law_sec_billing" name="Billing &amp; Payments"
              parent="menu_law_firm_root" sequence="70"
              groups="group_law_firm_user"/>
    <menuitem id="menu_law_sec_documents" name="Documents"
              parent="menu_law_firm_root" sequence="90"
              groups="group_law_firm_user"/>
    <menuitem id="menu_law_sec_reports" name="Reports"
              parent="menu_law_firm_root" sequence="120"
              groups="group_law_firm_user"/>

    <!-- Configuration (admin) -->
    <menuitem id="menu_law_firm_configuration"
              name="Configuration"
              parent="menu_law_firm_root"
              sequence="900"
              groups="group_law_firm_admin"/>

    <menuitem id="menu_law_practice_area"
              name="Practice Areas"
              parent="menu_law_firm_configuration"
              action="action_law_practice_area"
              groups="group_law_firm_admin"
              sequence="10"/>

    <menuitem id="menu_law_case_type"
              name="Case Types"
              parent="menu_law_firm_configuration"
              action="action_law_case_type"
              groups="group_law_firm_admin"
              sequence="20"/>

    <menuitem id="menu_law_case_stage"
              name="Case Stages"
              parent="menu_law_firm_configuration"
              action="action_law_case_stage"
              groups="group_law_firm_admin"
              sequence="30"/>

    <menuitem id="menu_law_case_tag"
              name="Case Tags"
              parent="menu_law_firm_configuration"
              action="action_law_case_tag"
              groups="group_law_firm_admin"
              sequence="40"/>

    <menuitem id="menu_law_branch"
              name="Branches"
              parent="menu_law_firm_configuration"
              action="action_law_branch"
              groups="group_law_firm_admin"
              sequence="50"/>

    <menuitem id="menu_law_firm_settings"
              name="Settings"
              parent="menu_law_firm_configuration"
              action="action_law_firm_config_settings"
              sequence="999"
              groups="group_law_firm_admin"/>
</odoo>
