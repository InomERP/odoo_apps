<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_law_evidence_list" model="ir.ui.view">
        <field name="name">law.evidence.list</field>
        <field name="model">law.evidence</field>
        <field name="arch" type="xml">
            <list string="Evidence">
                <field name="reference"/>
                <field name="name"/>
                <field name="case_id"/>
                <field name="evidence_type"/>
                <field name="current_custodian" optional="show"/>
                <field name="collected_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_law_evidence_kanban" model="ir.ui.view">
        <field name="name">law.evidence.kanban</field>
        <field name="model">law.evidence</field>
        <field name="arch" type="xml">
            <kanban default_group_by="evidence_type" string="Evidence">
                <field name="evidence_type"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <div class="text-muted"><field name="reference"/></div>
                            <div><field name="case_id"/></div>
                            <div t-if="record.current_custodian.raw_value">
                                <i class="fa fa-user me-1"/><field name="current_custodian"/>
                            </div>
                            <div t-if="record.collected_date.raw_value">
                                <i class="fa fa-calendar me-1"/><field name="collected_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_law_evidence_activity" model="ir.ui.view">
        <field name="name">law.evidence.activity</field>
        <field name="model">law.evidence</field>
        <field name="arch" type="xml">
            <activity string="Evidence">
                <templates>
                    <div t-name="activity-box">
                        <field name="name" display="full"/>
                        <field name="case_id" muted="1"/>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="view_law_evidence_form" model="ir.ui.view">
        <field name="name">law.evidence.form</field>
        <field name="model">law.evidence</field>
        <field name="arch" type="xml">
            <form string="Evidence">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Evidence title..."/></h1>
                        <h3><field name="reference" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="case_id"/>
                            <field name="evidence_type"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="collected_date"/>
                            <field name="collected_by"/>
                            <field name="current_custodian"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                    <notebook>
                        <page string="Files" name="files">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Related Documents" name="docs">
                            <field name="related_document_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Chain of Custody" name="custody">
                            <p class="text-muted">This log is append-only: once saved, entries cannot be edited or deleted. Use "Add a line" to record a new custody event.</p>
                            <field name="custody_log_ids">
                                <list create="1" edit="0" delete="0">
                                    <field name="log_date"/>
                                    <field name="action"/>
                                    <field name="from_custodian"/>
                                    <field name="to_custodian"/>
                                    <field name="user_id"/>
                                    <field name="note"/>
                                </list>
                                <form string="Custody Entry">
                                    <group>
                                        <group>
                                            <field name="action"/>
                                            <field name="from_custodian"/>
                                            <field name="to_custodian"/>
                                        </group>
                                        <group>
                                            <field name="log_date"/>
                                            <field name="user_id"/>
                                        </group>
                                    </group>
                                    <field name="note" placeholder="Note..."/>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_law_evidence_search" model="ir.ui.view">
        <field name="name">law.evidence.search</field>
        <field name="model">law.evidence</field>
        <field name="arch" type="xml">
            <search string="Evidence">
                <field name="name"/>
                <field name="reference"/>
                <field name="case_id"/>
                <field name="evidence_type"/>
                <group>
                    <filter name="g_case" string="Case" context="{'group_by': 'case_id'}"/>
                    <filter name="g_type" string="Type" context="{'group_by': 'evidence_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_law_evidence" model="ir.actions.act_window">
        <field name="name">Evidence</field>
        <field name="res_model">law.evidence</field>
        <field name="view_mode">kanban,list,activity,form</field>
        <field name="search_view_id" ref="view_law_evidence_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first piece of evidence</p>
            <p>Log physical/digital evidence with source and an append-only chain of custody.</p>
        </field>
    </record>

    <menuitem id="menu_law_evidence" name="Evidence"
              parent="inom_law_firm_core.menu_law_firm_root"
              action="action_law_evidence" sequence="100"
              groups="inom_law_firm_core.group_law_firm_user"/>
</odoo>
