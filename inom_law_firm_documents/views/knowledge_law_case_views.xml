<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_law_case_form_knowledge" model="ir.ui.view">
        <field name="name">law.case.form.knowledge</field>
        <field name="model">law.case</field>
        <field name="inherit_id" ref="inom_law_firm_core.view_law_case_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Legal References" name="law_references">
                    <group>
                        <field name="cited_case_law_ids" widget="many2many_tags"/>
                        <field name="referenced_act_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
