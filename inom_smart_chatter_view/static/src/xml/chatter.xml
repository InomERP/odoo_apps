<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t name="mail.ChatterAdvanced"
       t-inherit="mail.Chatter"
       t-inherit-mode="extension"
       owl="1">

        <xpath expr="//div[hasclass('o-mail-Chatter')]" position="replace">

            <div t-if="state.thread"
                 class="position-relative flex-grow-1 d-flex w-100 custom_chatter_root">

                <!-- 🔵 SIDE ICON BAR -->
                <div class="o-mail-Form-chatter">
                    <button class="icon" t-on-click="_onClickSendMessage">💬</button>
                    <button class="icon" t-on-click="_onClickLogNote">📝</button>
                    <button class="icon" t-on-click="_onClickActive">⏰</button>
                </div>

                <!-- 🔵 CHATTER PANEL -->
                <div class="o_ChatterContainer chatter_v2_body hide custom_chatter_panel"
                     t-attf-class="o_ChatterContainer chatter_v2_body hide custom_chatter_panel {{ props.className }}">

                    <!-- 🔴 CLOSE BUTTON -->
                    <div class="d-flex justify-content-end p-2">
                        <button class="chatter-close-btn btn btn-sm btn-light d-none"
                                t-on-click="_onClickCross">
                            ✖
                        </button>
                    </div>

                    <!-- 🔵 TOP BAR -->
                    <div class="o-mail-Chatter-top position-sticky top-0 bg-white z-1">

                        <div class="o-mail-Chatter-topbar d-flex flex-wrap gap-2 p-2">

                            <button id="header_message"
                                    class="btn btn-primary d-none"
                                    t-on-click="_onClickHeaderMessage">
                                Send message
                            </button>

                            <button id="header_note"
                                    class="btn btn-success d-none"
                                    t-on-click="_onClickHeaderNote">
                                Log note
                            </button>

                        </div>

                        <!-- 🔵 COMPOSER -->
                        <t t-if="state.composerType">
                            <Composer
                                composer="state.thread.composer"
                                autofocus="true"
                                mode="'extended'"
                                type="state.composerType"/>
                        </t>
                    </div>

                    <!-- 🔵 CONTENT -->
                    <div class="o-mail-Chatter-content chatter_content p-2">

                        <div class="o-mail-ActivityList d-none">
                            <t t-if="props.has_activities and activities.length">
                                <t t-call="mail.ActivityList"/>
                            </t>
                        </div>

                        <Thread
                            thread="state.thread"
                            t-key="state.thread.localId"
                            order="'desc'"/>
                    </div>

                </div>

            </div>

        </xpath>
    </t>

</templates>