<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_inherit_lot" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.lot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="after">
                <block title="Lot &amp; Serial Number (POS)" id="pos_lot_serial_section">
                    <setting string="Enable Lot/Serial Scanning">
                        <field name="pos_iml_enable_lot_scanning"/>
                    </setting>
                    <setting string="Show Lot Selection Popup">
                        <field name="pos_iml_enable_lot_popup"/>
                    </setting>
                    <setting string="Strict Quantity Validation">
                        <field name="pos_iml_strict_qty_validation"/>
                    </setting>
                    <setting string="Block Duplicate Serials">
                        <field name="pos_iml_check_duplicate_serial"/>
                    </setting>
                    <setting string="Allow Lot Creation from POS">
                        <field name="pos_iml_allow_create_lot"/>
                    </setting>
                    <setting string="Allow Offline Lot Creation">
                        <field name="pos_iml_allow_offline_lot_create"/>
                    </setting>
                    <setting string="Print Lot/Serial on Receipt">
                        <field name="pos_iml_print_lot_on_receipt"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>








