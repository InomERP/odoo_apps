<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Feature 8: add Purchase Requisition Settings tab with the
         destination stock location field on the employee form. -->
    <record id="view_employee_form_requisition" model="ir.ui.view">
        <field name="name">hr.employee.form.requisition</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Purchase Requisition Settings" name="requisition_settings">
                    <group>
                        <field name="requisition_stock_location_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>