<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_material_requisition_reject_wizard" model="ir.ui.view">
        <field name="name">material.requisition.reject.wizard.form</field>
        <field name="model">material.requisition.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason For Rejection">
                <group>
                    <field name="rejection_reason"
                           placeholder="Enter reason for rejection..."
                           nolabel="1"/>
                    <field name="requisition_id" invisible="1"/>
                    <field name="reject_type" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>