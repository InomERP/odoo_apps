<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Feature 9: add the destination stock location field on the
         department form. -->
    <record id="view_department_form_requisition" model="ir.ui.view">
        <field name="name">hr.department.form.requisition</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='manager_id']" position="after">
                <field name="requisition_stock_location_id"/>
            </xpath>
        </field>
    </record>
</odoo>