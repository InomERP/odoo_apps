<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Feature 1: sequence used to auto-generate material.requisition name -->
    <record id="seq_material_requisition" model="ir.sequence">
        <field name="name">Material Requisition</field>
        <field name="code">material.requisition</field>
        <field name="prefix">MR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>