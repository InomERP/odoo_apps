<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Feature 19: report action -->
    <record id="action_report_material_requisition" model="ir.actions.report">
        <field name="name">Material Requisition</field>
        <field name="model">material.requisition</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">inom_material_purchase_requisition.report_material_requisition_document</field>
        <field name="report_file">inom_material_purchase_requisition.report_material_requisition_document</field>
        <field name="binding_model_id" ref="model_material_requisition"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Feature 19: QWeb report template -->
    <template id="report_material_requisition_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            Material Requisition
                            <span t-field="doc.name"/>
                        </h2>
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Employee:</strong>
                                <span t-field="doc.employee_id"/><br/>
                                <strong>Department:</strong>
                                <span t-field="doc.department_id"/><br/>
                                <strong>Requisition Responsible:</strong>
                                <span t-field="doc.requisition_responsible_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Requisition Date:</strong>
                                <span t-field="doc.request_date"/><br/>
                                <strong>Deadline:</strong>
                                <span t-field="doc.requisition_deadline"/><br/>
                                <strong>Status:</strong>
                                <span t-field="doc.state"/>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table mt-4">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Product</th>
                                    <th>Description</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Unit of Measure</th>
                                    <th>Vendor</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.requisition_line_ids" t-as="line">
                                    <td><span t-field="line.requisition_action"/></td>
                                    <td><span t-field="line.product_id"/></td>
                                    <td><span t-field="line.description"/></td>
                                    <td class="text-end">
                                        <span t-field="line.product_uom_qty"/>
                                    </td>
                                    <td><span t-field="line.product_uom_id"/></td>
                                    <td><span t-field="line.vendor_id"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>