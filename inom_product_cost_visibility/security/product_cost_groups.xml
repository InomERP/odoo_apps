<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_cost_visibility" model="ir.module.category">
        <field name="name">Product Cost Visibility</field>
        <field name="description">Controls who may see the product Cost field.</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_product_cost_visibility" model="res.groups">
        <field name="name">View Product Cost</field>
        <field name="category_id" ref="module_category_cost_visibility"/>
        <field name="comment">Users in this group can see the product Cost field.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_product_cost_visibility'))]"/>
    </record>

</odoo>
