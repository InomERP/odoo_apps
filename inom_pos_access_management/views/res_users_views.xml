<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add 'POS Management Permission' to the Users form -->
    <record id="view_users_form_pos_access" model="ir.ui.view">
        <field name="name">res.users.form.pos.access.management</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="POS Access Management" name="pos_access_management">
                    <group>
                        <group string="Permissions">
                            <field name="pos_management_permission"
                                   widget="boolean_toggle"
                                   help="Enable to allow this user to manage POS access rights."/>
                        </group>
                    </group>
                    <separator string="POS Access Rules"/>
                    <!--
                        In Odoo 17 the embedded list view of a one2many
                        field uses the <tree> tag (the <list> tag is
                        Odoo 18+). Behaviour is identical.
                    -->
                    <field name="pos_access_rights_ids" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
