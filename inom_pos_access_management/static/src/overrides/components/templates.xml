<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Customer Note / internal Note buttons share this template -->
    <t t-name="inom_pos_access_management.NoteButton" t-inherit="point_of_sale.NoteButton" t-inherit-mode="extension">
        <xpath expr="//button" position="attributes">
            <attribute name="t-if">!this.pos.accessRule.hide_customer_note_button</attribute>
        </xpath>
    </t>

    <!-- Restricted payment methods may leave no method to show here -->
    <t t-name="inom_pos_access_management.PaymentScreenValidate" t-inherit="point_of_sale.PaymentScreenValidate" t-inherit-mode="extension">
        <xpath expr="//span[@t-out='this.payment_methods_from_config[0].name']" position="attributes">
            <attribute name="t-out">this.payment_methods_from_config[0]?.name</attribute>
        </xpath>
    </t>

</templates>
