<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Odoo 18 security group model.
            In Odoo 18 there is NO `res.groups.privilege` model — that was
            introduced only in Odoo 19. In Odoo 18 security groups point
            directly at an `ir.module.category` record via `category_id`.
            Behaviour, visibility and access semantics are exactly the
            same as the Odoo 19 privilege-based wiring; only the field
            name and the indirection layer differ.
        -->

        <!-- Security group: POS Access Manager -->
        <record id="group_pos_access_manager" model="res.groups">
            <field name="name">POS Access Manager</field>
            <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
            <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
            <field name="comment">Users in this group can create and manage POS access rules.</field>
        </record>

        <!--
            Multi-company record rule.
            In Odoo 18 a rule with no `groups` is automatically global,
            same semantics as Odoo 19's computed `global` field, so no
            extra change is needed here.
        -->
        <record id="pos_access_rights_company_rule" model="ir.rule">
            <field name="name">POS Access Rights: multi-company</field>
            <field name="model_id" ref="model_pos_access_rights"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
