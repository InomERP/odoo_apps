<odoo>
    <record id="view_sale_credit_limit_wizard_form" model="ir.ui.view">
        <field name="name">sale.credit.limit.wizard.form</field>
        <field name="model">sale.credit.limit.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Credit Limit - Approval Request">
                <div class="alert alert-warning" role="alert">
                    This customer's credit exposure exceeds their credit limit.
                    Submit this order for credit approval to proceed.
                </div>
                <group>
                    <group string="Customer">
                        <field name="partner_id" string="Customer" readonly="1"/>
                        <field name="credit_limit" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Credit Exposure">
                        <field name="total_receivable" readonly="1"/>
                        <field name="sale_orders_worth" readonly="1"/>
                        <field name="current_quotation" readonly="1"/>
                        <field name="available_credit" readonly="1"/>
                        <field name="exceeded_amount" readonly="1"/>
                    </group>
                </group>
                <group string="Reason / Notes">
                    <field name="reason" nolabel="1"
                           placeholder="Explain why this order should be approved (optional)."/>
                </group>
                <footer>
                    <button name="action_submit_for_approval" type="object"
                            string="Submit for Approval" class="btn-primary"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>