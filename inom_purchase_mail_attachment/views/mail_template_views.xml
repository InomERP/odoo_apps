<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_form_inherit_purchase_mail" model="ir.ui.view">
        <field name="name">email.template.form.inherit.purchase.mail</field>
        <field name="model">mail.template</field>
        <field name="inherit_id" ref="mail.email_template_form"/>
        <field name="arch" type="xml">
            <field name="attachment_ids" position="before">
                <field name="attach_purchase_documents"
                       invisible="model != 'purchase.order'"/>
            </field>
        </field>
    </record>
</odoo>
