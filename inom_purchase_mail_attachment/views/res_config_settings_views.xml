<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_purchase_mail" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.mail</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_settings_container']" position="after">
                <block title="Email Document Attachments"
                       name="purchase_mail_attachment_container">
                    <setting id="purchase_mail_attachment_enabled_setting"
                             help="Automatically attach product and vendor documents to RFQ / PO emails">
                        <field name="purchase_mail_attachment_enabled"/>
                        <div class="content-group"
                             invisible="not purchase_mail_attachment_enabled">
                            <div class="mt16">
                                <label for="purchase_mail_attachment_mode"
                                       string="Product documents"
                                       class="o_light_label"/>
                                <field name="purchase_mail_attachment_mode"
                                       class="oe_inline"/>
                            </div>
                            <div class="mt16">
                                <field name="purchase_mail_attachment_vendor_docs"
                                       class="oe_inline"/>
                                <label for="purchase_mail_attachment_vendor_docs"
                                       string="Include vendor documents"
                                       class="o_light_label"/>
                            </div>
                            <div class="mt16">
                                <label for="purchase_mail_attachment_max_count"
                                       string="Max attachment count"
                                       class="o_light_label"/>
                                <field name="purchase_mail_attachment_max_count"
                                       class="oe_inline"/>
                            </div>
                            <div class="mt16">
                                <label for="purchase_mail_attachment_max_mb"
                                       string="Max total size (MB)"
                                       class="o_light_label"/>
                                <field name="purchase_mail_attachment_max_mb"
                                       class="oe_inline"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
