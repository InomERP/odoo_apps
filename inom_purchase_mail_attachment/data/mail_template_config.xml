<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Turn the auto-attachment behaviour ON by default for the standard
        Odoo purchase email templates. noupdate="1" keeps user changes safe
        across module updates.
    -->
    <data noupdate="1">
        <record id="purchase.email_template_edi_purchase" model="mail.template">
            <field name="attach_purchase_documents" eval="True"/>
        </record>

        <record id="purchase.email_template_edi_purchase_done" model="mail.template">
            <field name="attach_purchase_documents" eval="True"/>
        </record>
    </data>
</odoo>