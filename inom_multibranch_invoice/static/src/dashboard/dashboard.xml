<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="inom_multibranch_invoice.Dashboard">
        <div class="o_inom_dash">

            <!-- Loading -->
            <div t-if="this.state.loading" class="o_inom_dash_loading">
                <i class="oi oi-spin" data-icon="progress_activity"/>
                <span>Loading branch data...</span>
            </div>

            <div t-else="">

                <!-- Hero header -->
                <div class="o_inom_hero">
                    <div class="o_inom_hero_text">
                        <div class="o_inom_hero_eyebrow">MULTI BRANCH ANALYTICS</div>
                        <h1>Branch Performance</h1>
                        <p>Sales, purchase and activity across all your operating units.</p>
                    </div>
                    <button class="o_inom_refresh" t-on-click="() => this.loadData()" title="Refresh">
                        <i class="oi" data-icon="refresh"/>
                    </button>
                </div>

                <!-- KPI row -->
                <div class="o_inom_kpis">
                    <div class="o_inom_kpi kpi_sales">
                        <div class="o_inom_kpi_icon"><i class="oi" data-icon="arrow_upward"/></div>
                        <div class="o_inom_kpi_body">
                            <div class="o_inom_kpi_label">Total Sales</div>
                            <div class="o_inom_kpi_value"><t t-out="this.formatAmount(this.state.data.total_sales)"/></div>
                        </div>
                    </div>
                    <div class="o_inom_kpi kpi_purchase">
                        <div class="o_inom_kpi_icon"><i class="oi" data-icon="arrow_downward"/></div>
                        <div class="o_inom_kpi_body">
                            <div class="o_inom_kpi_label">Total Purchase</div>
                            <div class="o_inom_kpi_value"><t t-out="this.formatAmount(this.state.data.total_purchase)"/></div>
                        </div>
                    </div>
                    <div class="o_inom_kpi kpi_net">
                        <div class="o_inom_kpi_icon"><i class="oi" data-icon="balance"/></div>
                        <div class="o_inom_kpi_body">
                            <div class="o_inom_kpi_label">Net (Sales - Purchase)</div>
                            <div class="o_inom_kpi_value"><t t-out="this.formatAmount(this.netTotal)"/></div>
                        </div>
                    </div>
                    <div class="o_inom_kpi kpi_branches">
                        <div class="o_inom_kpi_icon"><i class="oi" data-icon="fork_right"/></div>
                        <div class="o_inom_kpi_body">
                            <div class="o_inom_kpi_label">Active Branches</div>
                            <div class="o_inom_kpi_value"><t t-out="this.state.data.total_branches"/></div>
                        </div>
                    </div>
                </div>

                <!-- Empty state -->
                <div t-if="!this.state.data.branches.length" class="o_inom_empty">
                    <i class="oi" data-icon="pie_chart"/>
                    <p>No branch data yet. Create branches and post some invoices to see analytics here.</p>
                </div>

                <div t-else="" class="o_inom_grid">

                    <!-- Comparison bars -->
                    <div class="o_inom_panel o_inom_compare">
                        <div class="o_inom_panel_head">
                            <h2>Branch Comparison</h2>
                            <div class="o_inom_legend">
                                <span><i class="dot dot_sales"/> Sales</span>
                                <span><i class="dot dot_purchase"/> Purchase</span>
                            </div>
                        </div>
                        <div class="o_inom_bars">
                            <div class="o_inom_bar_row" t-foreach="this.state.data.branches" t-as="b" t-key="b.id">
                                <div class="o_inom_bar_name" t-out="b.name"/>
                                <div class="o_inom_bar_track">
                                    <div class="o_inom_bar bar_sales" t-att-style="'width:' + this.barWidth(b.sales)">
                                        <span class="o_inom_bar_val" t-out="this.formatAmount(b.sales)"/>
                                    </div>
                                    <div class="o_inom_bar bar_purchase" t-att-style="'width:' + this.barWidth(b.purchase)">
                                        <span class="o_inom_bar_val" t-out="this.formatAmount(b.purchase)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Branch cards -->
                    <div class="o_inom_panel o_inom_cards_panel">
                        <div class="o_inom_panel_head">
                            <h2>Branches</h2>
                        </div>
                        <div class="o_inom_cards">
                            <div class="o_inom_card"
                                 t-foreach="this.state.data.branches" t-as="b" t-key="b.id"
                                 t-on-click="() => this.openBranchInvoices(b.id)">
                                <div class="o_inom_card_top">
                                    <div class="o_inom_card_avatar" t-out="b.name.substring(0,1).toUpperCase()"/>
                                    <div class="o_inom_card_title" t-out="b.name"/>
                                    <i class="oi o_inom_card_go" data-icon="chevron_right"/>
                                </div>
                                <div class="o_inom_card_metric">
                                    <span class="o_inom_card_metric_label">Sales</span>
                                    <span class="o_inom_card_metric_val" t-out="this.formatAmount(b.sales)"/>
                                </div>
                                <div class="o_inom_card_metric">
                                    <span class="o_inom_card_metric_label">Purchase</span>
                                    <span class="o_inom_card_metric_val" t-out="this.formatAmount(b.purchase)"/>
                                </div>
                                <div class="o_inom_card_pills">
                                    <span class="o_inom_pill pill_inv"><t t-out="b.invoice_count"/> invoices</span>
                                    <span class="o_inom_pill pill_bill"><t t-out="b.bill_count"/> bills</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </t>

</templates>