<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inom_view_users_form_branch" model="ir.ui.view">
        <field name="name">res.users.form.inom.branch</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="inom_branches" string="Branches"
                      groups="inom_multibranch_invoice.group_inom_branch_user">
                    <group>
                        <group string="Branch Assignment">
                            <field name="inom_default_branch_id"/>
                        </group>
                        <group string="Allowed Branches">
                            <field name="inom_allowed_branch_ids"
                                   widget="many2many_tags" nolabel="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
