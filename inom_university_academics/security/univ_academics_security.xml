<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================= GROUPS ================= -->
        <record id="group_univ_exam_cell" model="res.groups">
            <field name="name">Examination Cell</field>
            <field name="sequence">40</field>
            <field name="privilege_id"
                   ref="inom_university_core.res_groups_privilege_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Full CRUD on exam scheduling, halls and invigilators.</field>
        </record>

        <record id="group_univ_controller_examinations" model="res.groups">
            <field name="name">Controller of Examinations</field>
            <field name="sequence">41</field>
            <field name="privilege_id"
                   ref="inom_university_core.res_groups_privilege_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Approves result publication and re-evaluation.</field>
        </record>

        <record id="group_univ_academic_admin" model="res.groups">
            <field name="name">Academic Administrator</field>
            <field name="sequence">42</field>
            <field name="privilege_id"
                   ref="inom_university_core.res_groups_privilege_university"/>
            <field name="implied_ids" eval="[(6, 0, [
                ref('base.group_user'),
                ref('group_univ_exam_cell'),
                ref('group_univ_controller_examinations')])]"/>
            <field name="comment">Full academic operations administration.</field>
        </record>

        <!-- Core admin inherits academic admin -->
        <record id="inom_university_core.group_univ_admin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_univ_academic_admin'))]"/>
        </record>

        <!-- ================= MULTI-COMPANY (global) ================= -->
        <record id="rule_session_company" model="ir.rule">
            <field name="name">Timetable session multi-company</field>
            <field name="model_id" ref="model_univ_timetable_session"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_attendance_sheet_company" model="ir.rule">
            <field name="name">Attendance sheet multi-company</field>
            <field name="model_id" ref="model_univ_attendance_sheet"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_exam_company" model="ir.rule">
            <field name="name">Exam multi-company</field>
            <field name="model_id" ref="model_univ_exam"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_result_semester_company" model="ir.rule">
            <field name="name">Semester result multi-company</field>
            <field name="model_id" ref="model_univ_result_semester"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- ================= PORTAL OWN-ONLY (students & parents) ================= -->
        <record id="rule_attendance_summary_portal" model="ir.rule">
            <field name="name">Attendance summary: portal own</field>
            <field name="model_id" ref="model_univ_attendance_summary"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('inom_university_core.group_univ_portal_student')), (4, ref('inom_university_core.group_univ_portal_parent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_attendance_line_portal" model="ir.rule">
            <field name="name">Attendance line: portal own</field>
            <field name="model_id" ref="model_univ_attendance_line"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('inom_university_core.group_univ_portal_student')), (4, ref('inom_university_core.group_univ_portal_parent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_result_semester_portal" model="ir.rule">
            <field name="name">Semester result: portal own</field>
            <field name="model_id" ref="model_univ_result_semester"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('inom_university_core.group_univ_portal_student')), (4, ref('inom_university_core.group_univ_portal_parent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_result_transcript_portal" model="ir.rule">
            <field name="name">Transcript: portal own</field>
            <field name="model_id" ref="model_univ_result_transcript"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('inom_university_core.group_univ_portal_student')), (4, ref('inom_university_core.group_univ_portal_parent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
