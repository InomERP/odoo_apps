<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================= GROUPS ================= -->
        <record id="group_univ_exam_cell" model="res.groups">
            <field name="name">Examination Cell</field>
            <field name="sequence">40</field>
            <field name="privilege_id"
                   ref="inom_university_core.res_groups_privilege_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Full CRUD on exam scheduling, halls and invigilators.</field>
        </record>

        <record id="group_univ_controller_examinations" model="res.groups">
            <field name="name">Controller of Examinations</field>
            <field name="sequence">41</field>
            <field name="privilege_id"
                   ref="inom_university_core.res_groups_privilege_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Approves result publication and re-evaluation.</field>
        </record>

        <record id="group_univ_academic_admin" model="res.groups">
            <field name="name">Academic Administrator</field>
            <field name="sequence">42</field>
            <field name="privilege_id"
                   ref="inom_university_core.res_groups_privilege_university"/>
            <field name="implied_ids" eval="[(6, 0, [
                ref('base.group_user'),
                ref('group_univ_exam_cell'),
                ref('group_univ_controller_examinations')])]"/>
            <field name="comment">Full academic operations administration.</field>
        </record>

        <!-- Core admin inherits academic admin -->
        <record id="inom_university_core.group_univ_admin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_univ_academic_admin'))]"/>
        </record>

        <!-- ========================================================= -->
        <!-- ODOO 20 RECORD ACCESS                                     -->
        <!-- ir.access replaces both ir.model.access and ir.rule.     -->
        <!-- A record without group_id is a restriction applied       -->
        <!-- globally; grouped records are permission records.        -->
        <!-- ========================================================= -->

        <!-- Global multi-company restrictions -->
        <record id="access_rule_session_company" model="ir.access">
            <field name="name">Timetable session multi-company</field>
            <field name="model_id" ref="model_univ_timetable_session"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="access_rule_attendance_sheet_company" model="ir.access">
            <field name="name">Attendance sheet multi-company</field>
            <field name="model_id" ref="model_univ_attendance_sheet"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="access_rule_exam_company" model="ir.access">
            <field name="name">Exam multi-company</field>
            <field name="model_id" ref="model_univ_exam"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="access_rule_result_semester_company" model="ir.access">
            <field name="name">Semester result multi-company</field>
            <field name="model_id" ref="model_univ_result_semester"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Portal own-only permissions -->
        <record id="access_portal_attendance_summary" model="ir.access">
            <field name="name">Attendance summary: portal own</field>
            <field name="model_id" ref="model_univ_attendance_summary"/>
            <field name="group_id" ref="inom_university_core.group_univ_portal_student"/>
            <field name="operation">r</field>
            <field name="domain">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        </record>
        <record id="access_parent_attendance_summary" model="ir.access">
            <field name="name">Attendance summary: parent own</field>
            <field name="model_id" ref="model_univ_attendance_summary"/>
            <field name="group_id" ref="inom_university_core.group_univ_portal_parent"/>
            <field name="operation">r</field>
            <field name="domain">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        </record>

        <record id="access_portal_attendance_line" model="ir.access">
            <field name="name">Attendance line: portal own</field>
            <field name="model_id" ref="model_univ_attendance_line"/>
            <field name="group_id" ref="inom_university_core.group_univ_portal_student"/>
            <field name="operation">r</field>
            <field name="domain">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        </record>
        <record id="access_parent_attendance_line" model="ir.access">
            <field name="name">Attendance line: parent own</field>
            <field name="model_id" ref="model_univ_attendance_line"/>
            <field name="group_id" ref="inom_university_core.group_univ_portal_parent"/>
            <field name="operation">r</field>
            <field name="domain">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        </record>

        <record id="access_portal_result_semester" model="ir.access">
            <field name="name">Semester result: portal own</field>
            <field name="model_id" ref="model_univ_result_semester"/>
            <field name="group_id" ref="inom_university_core.group_univ_portal_student"/>
            <field name="operation">r</field>
            <field name="domain">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        </record>
        <record id="access_parent_result_semester" model="ir.access">
            <field name="name">Semester result: parent own</field>
            <field name="model_id" ref="model_univ_result_semester"/>
            <field name="group_id" ref="inom_university_core.group_univ_portal_parent"/>
            <field name="operation">r</field>
            <field name="domain">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        </record>

        <record id="access_portal_result_transcript" model="ir.access">
            <field name="name">Transcript: portal own</field>
            <field name="model_id" ref="model_univ_result_transcript"/>
            <field name="group_id" ref="inom_university_core.group_univ_portal_student"/>
            <field name="operation">r</field>
            <field name="domain">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        </record>
        <record id="access_parent_result_transcript" model="ir.access">
            <field name="name">Transcript: parent own</field>
            <field name="model_id" ref="model_univ_result_transcript"/>
            <field name="group_id" ref="inom_university_core.group_univ_portal_parent"/>
            <field name="operation">r</field>
            <field name="domain">[('student_id.partner_id', '=', user.partner_id.id)]</field>
        </record>

    </data>
</odoo>
