<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_attendance_lock" model="ir.cron">
            <field name="name">Academics: Lock attendance sheets (24h)</field>
            <field name="model_id" ref="model_univ_attendance_sheet"/>
            <field name="state">code</field>
            <field name="code">model._cron_lock_sheets()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_attendance_shortage" model="ir.cron">
            <field name="name">Academics: Compute attendance shortage</field>
            <field name="model_id" ref="model_univ_attendance_summary"/>
            <field name="state">code</field>
            <field name="code">model._cron_compute_shortage()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
