<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_absence_alert" model="mail.template">
            <field name="name">Academics: Absence Alert</field>
            <field name="model_id" ref="model_univ_attendance_line"/>
            <field name="subject">Absence recorded - {{ object.subject_id.display_name }}</field>
            <field name="email_to">{{ object.student_id.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin:0px;padding:0px;font-size:14px;">
                    <p>Dear <t t-out="object.student_id.name or 'Student'"/>,</p>
                    <p>You were marked <strong>absent</strong> for
                        <t t-out="object.subject_id.display_name or ''"/>
                        on <t t-out="object.date or ''"/>.</p>
                    <p>Please ensure your attendance stays above the required threshold.</p>
                    <p>Regards,<br/>Academic Office</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
