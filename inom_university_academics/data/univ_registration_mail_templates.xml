<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_waitlist_promoted" model="mail.template">
            <field name="name">Registration: Waitlist Promotion</field>
            <field name="model_id" ref="model_univ_course_registration_line"/>
            <field name="subject">You are now registered for {{ object.subject_id.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.student_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin:0px;padding:0px;font-size:14px;">
                    <p>Dear <t t-out="object.student_id.name or 'Student'"/>,</p>
                    <p>Good news! A seat opened up and you have been promoted from
                        the waitlist. You are now registered for
                        <strong t-out="object.subject_id.name or ''"/>
                        (<t t-out="object.credit_hours or 0"/> credits).</p>
                    <p>You can review your registration from your student portal.</p>
                    <p>Regards,<br/>Registrar Office</p>
                </div>
            </field>
            <field name="lang">{{ object.student_id.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
