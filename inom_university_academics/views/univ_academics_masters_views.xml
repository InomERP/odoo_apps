<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ROOM -->
    <record id="view_univ_room_list" model="ir.ui.view">
        <field name="name">univ.room.list</field>
        <field name="model">univ.room</field>
        <field name="arch" type="xml">
            <tree string="Rooms" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="room_type"/>
                <field name="capacity"/>
                <field name="building"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>
    <record id="action_univ_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">univ.room</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- TIMESLOT -->
    <record id="view_univ_timeslot_list" model="ir.ui.view">
        <field name="name">univ.timeslot.list</field>
        <field name="model">univ.timeslot</field>
        <field name="arch" type="xml">
            <tree string="Time Slots" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="is_break"/>
            </tree>
        </field>
    </record>
    <record id="action_univ_timeslot" model="ir.actions.act_window">
        <field name="name">Time Slots</field>
        <field name="res_model">univ.timeslot</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ACADEMIC CALENDAR -->
    <record id="view_univ_academic_calendar_list" model="ir.ui.view">
        <field name="name">univ.academic.calendar.list</field>
        <field name="model">univ.academic.calendar</field>
        <field name="arch" type="xml">
            <tree string="Academic Calendar" editable="bottom">
                <field name="date"/>
                <field name="date_to"/>
                <field name="name"/>
                <field name="event_type"/>
                <field name="academic_year_id"/>
                <field name="program_id"/>
            </tree>
        </field>
    </record>
    <record id="action_univ_academic_calendar" model="ir.actions.act_window">
        <field name="name">Academic Calendar</field>
        <field name="res_model">univ.academic.calendar</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- EXAM TYPE -->
    <record id="view_univ_exam_type_list" model="ir.ui.view">
        <field name="name">univ.exam.type.list</field>
        <field name="model">univ.exam.type</field>
        <field name="arch" type="xml">
            <tree string="Exam Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="weightage"/>
            </tree>
        </field>
    </record>
    <record id="action_univ_exam_type" model="ir.actions.act_window">
        <field name="name">Exam Types</field>
        <field name="res_model">univ.exam.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- GRADE SCALE -->
    <record id="view_univ_grade_scale_form" model="ir.ui.view">
        <field name="name">univ.grade.scale.form</field>
        <field name="model">univ.grade.scale</field>
        <field name="arch" type="xml">
            <form string="Grade Scale">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="is_default"/>
                        <field name="pass_grade_point"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="min_percent"/>
                            <field name="grade_point"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_univ_grade_scale_list" model="ir.ui.view">
        <field name="name">univ.grade.scale.list</field>
        <field name="model">univ.grade.scale</field>
        <field name="arch" type="xml">
            <tree string="Grade Scales">
                <field name="name"/>
                <field name="is_default"/>
                <field name="pass_grade_point"/>
            </tree>
        </field>
    </record>
    <record id="action_univ_grade_scale" model="ir.actions.act_window">
        <field name="name">Grade Scales</field>
        <field name="res_model">univ.grade.scale</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- PLO -->
    <record id="view_univ_plo_list" model="ir.ui.view">
        <field name="name">univ.plo.list</field>
        <field name="model">univ.plo</field>
        <field name="arch" type="xml">
            <tree string="Program Learning Outcomes" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="program_id"/>
            </tree>
        </field>
    </record>
    <record id="action_univ_plo" model="ir.actions.act_window">
        <field name="name">Program Outcomes</field>
        <field name="res_model">univ.plo</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- CLO -->
    <record id="view_univ_clo_list" model="ir.ui.view">
        <field name="name">univ.clo.list</field>
        <field name="model">univ.clo</field>
        <field name="arch" type="xml">
            <tree string="Course Learning Outcomes" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="subject_id"/>
                <field name="plo_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>
    <record id="action_univ_clo" model="ir.actions.act_window">
        <field name="name">Course Outcomes</field>
        <field name="res_model">univ.clo</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
