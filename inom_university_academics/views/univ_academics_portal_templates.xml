<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal home: academic cards -->
    <template id="portal_my_home_academics"
              name="Academics portal entries"
              inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div class="o_portal_category row g-2 mt-3">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/inom_university_academics/static/description/icon.png'"/>
                    <t t-set="title">Subjects</t>
                    <t t-set="text">My subjects this semester</t>
                    <t t-set="url" t-value="'/my/timetable'"/>
                    <t t-set="config_card" t-value="True"/>
                    <t t-set="placeholder_count" t-value="'subject_count'"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Results</t>
                    <t t-set="text">My published results</t>
                    <t t-set="url" t-value="'/my/results'"/>
                    <t t-set="config_card" t-value="True"/>
                    <t t-set="placeholder_count" t-value="'result_count'"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Exams</t>
                    <t t-set="text">My exam schedule</t>
                    <t t-set="url" t-value="'/my/exams'"/>
                    <t t-set="config_card" t-value="True"/>
                    <t t-set="placeholder_count" t-value="'exam_count'"/>
                </t>
            </div>
        </xpath>
    </template>

    <!-- TIMETABLE -->
    <template id="portal_my_timetable" name="My Timetable">
        <t t-call="portal.portal_layout">
            <div class="container mt-3">
                <h3>My Timetable</h3>
                <t t-if="not sessions">
                    <p class="text-muted">No timetable published yet.</p>
                </t>
                <table t-if="sessions" class="table table-sm table-hover">
                    <thead>
                        <tr><th>Date</th><th>Slot</th><th>Subject</th><th>Faculty</th><th>Room</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="sessions" t-as="s">
                            <td><span t-out="s.date"/></td>
                            <td><span t-out="s.slot_id.name"/></td>
                            <td><span t-out="s.subject_id.display_name"/></td>
                            <td><span t-out="s.faculty_id.display_name"/></td>
                            <td><span t-out="s.room_id.display_name"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- ATTENDANCE -->
    <template id="portal_my_attendance" name="My Attendance">
        <t t-call="portal.portal_layout">
            <div class="container mt-3">
                <h3>My Attendance</h3>
                <t t-if="not summaries">
                    <p class="text-muted">No attendance records yet.</p>
                </t>
                <table t-if="summaries" class="table table-sm">
                    <thead>
                        <tr><th>Subject</th><th>Held</th><th>Attended</th><th>%</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="summaries" t-as="row">
                            <td><span t-out="row.subject_id.display_name"/></td>
                            <td><span t-out="row.held"/></td>
                            <td><span t-out="row.attended"/></td>
                            <td><span t-out="row.percent"/></td>
                            <td>
                                <span t-if="row.shortage_band in ('w75','w65')"
                                      class="badge text-bg-danger">Shortage</span>
                                <span t-elif="row.shortage_band == 'w85'"
                                      class="badge text-bg-warning">Watch</span>
                                <span t-else="" class="badge text-bg-success">OK</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- EXAMS -->
    <template id="portal_my_exams" name="My Exams">
        <t t-call="portal.portal_layout">
            <div class="container mt-3">
                <h3>My Exam Schedule</h3>
                <t t-if="not schedules">
                    <p class="text-muted">No exams scheduled.</p>
                </t>
                <table t-if="schedules" class="table table-sm">
                    <thead>
                        <tr><th>Exam</th><th>Subject</th><th>Date</th><th>Hall</th><th>Max Marks</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="schedules" t-as="sc">
                            <td><span t-out="sc.exam_id.name"/></td>
                            <td><span t-out="sc.subject_id.display_name"/></td>
                            <td><span t-out="sc.date"/></td>
                            <td><span t-out="sc.room_id.display_name"/></td>
                            <td><span t-out="sc.max_marks"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- RESULTS -->
    <template id="portal_my_results" name="My Results">
        <t t-call="portal.portal_layout">
            <div class="container mt-3">
                <h3>My Results</h3>
                <p t-if="student">
                    <a href="/my/transcript" class="btn btn-sm btn-primary">
                        View Transcript
                    </a>
                </p>
                <t t-if="not results">
                    <p class="text-muted">No results published yet.</p>
                </t>
                <table t-if="results" class="table table-sm">
                    <thead>
                        <tr><th>Semester</th><th>SGPA</th><th>Credits</th><th>Backlogs</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="results" t-as="r">
                            <td><span t-out="r.semester_id.display_name"/></td>
                            <td><span t-out="r.sgpa"/></td>
                            <td><span t-out="r.total_credits"/></td>
                            <td><span t-out="r.backlog_count"/></td>
                            <td><span t-out="r.status"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- TRANSCRIPT -->
    <template id="portal_my_transcript" name="My Transcript">
        <t t-call="portal.portal_layout">
            <div class="container mt-3">
                <h3>My Transcript</h3>
                <t t-if="not transcript">
                    <p class="text-muted">No transcript generated yet.</p>
                </t>
                <t t-if="transcript">
                    <p>
                        <strong>CGPA: </strong><span t-out="transcript.cgpa"/> ·
                        <strong>Total Credits: </strong>
                        <span t-out="transcript.total_credits"/>
                    </p>
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Semester</th><th>SGPA</th><th>Credits</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="transcript.semester_result_ids" t-as="sem">
                                <td><span t-out="sem.semester_id.display_name"/></td>
                                <td><span t-out="sem.sgpa"/></td>
                                <td><span t-out="sem.total_credits"/></td>
                                <td><span t-out="sem.status"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <!-- FACULTY TEACHING -->
    <template id="portal_my_teaching" name="My Teaching">
        <t t-call="portal.portal_layout">
            <div class="container mt-3">
                <h3>My Teaching</h3>
                <t t-if="not faculty">
                    <p class="text-muted">No faculty profile linked to your account.</p>
                </t>
                <t t-if="faculty">
                    <p>
                        <strong>Weekly Sessions: </strong>
                        <span t-out="faculty.weekly_session_count"/>
                    </p>
                    <table t-if="sessions" class="table table-sm">
                        <thead>
                            <tr><th>Date</th><th>Slot</th><th>Section</th><th>Subject</th><th>Room</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="sessions" t-as="s">
                                <td><span t-out="s.date"/></td>
                                <td><span t-out="s.slot_id.name"/></td>
                                <td><span t-out="s.section_id.display_name"/></td>
                                <td><span t-out="s.subject_id.display_name"/></td>
                                <td><span t-out="s.room_id.display_name"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

</odoo>
