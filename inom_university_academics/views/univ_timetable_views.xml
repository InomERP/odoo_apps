<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SESSION -->
    <record id="view_univ_timetable_session_list" model="ir.ui.view">
        <field name="name">univ.timetable.session.list</field>
        <field name="model">univ.timetable.session</field>
        <field name="arch" type="xml">
            <list string="Sessions">
                <field name="date"/>
                <field name="weekday"/>
                <field name="slot_id"/>
                <field name="section_id"/>
                <field name="subject_id"/>
                <field name="faculty_id"/>
                <field name="room_id"/>
                <field name="is_substituted"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>
    <record id="view_univ_timetable_session_form" model="ir.ui.view">
        <field name="name">univ.timetable.session.form</field>
        <field name="model">univ.timetable.session</field>
        <field name="arch" type="xml">
            <form string="Session">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_open_attendance" string="Attendance"
                            type="object" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="section_id"/>
                            <field name="subject_id"/>
                            <field name="faculty_id"/>
                            <field name="is_substituted" readonly="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="slot_id"/>
                            <field name="room_id"/>
                            <field name="weekday" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_univ_timetable_session_kanban" model="ir.ui.view">
        <field name="name">univ.timetable.session.kanban</field>
        <field name="model">univ.timetable.session</field>
        <field name="arch" type="xml">
            <kanban default_group_by="weekday" class="o_kanban_small_column">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="slot_id"/></strong>
                            <div><field name="subject_id"/></div>
                            <div><field name="faculty_id"/></div>
                            <div class="text-muted">
                                <field name="section_id"/> · <field name="room_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_univ_timetable_session_search" model="ir.ui.view">
        <field name="name">univ.timetable.session.search</field>
        <field name="model">univ.timetable.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="section_id"/>
                <field name="subject_id"/>
                <field name="faculty_id"/>
                <field name="room_id"/>
                <field name="date"/>
                <filter name="confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="today" string="Today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="g_section" string="Section"
                            context="{'group_by': 'section_id'}"/>
                    <filter name="g_faculty" string="Faculty"
                            context="{'group_by': 'faculty_id'}"/>
                    <filter name="g_date" string="Date"
                            context="{'group_by': 'date'}"/>
                    <filter name="g_weekday" string="Weekday"
                            context="{'group_by': 'weekday'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_univ_timetable_session" model="ir.actions.act_window">
        <field name="name">Timetable Sessions</field>
        <field name="res_model">univ.timetable.session</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- SUBSTITUTION -->
    <record id="view_univ_substitution_list" model="ir.ui.view">
        <field name="name">univ.timetable.substitution.list</field>
        <field name="model">univ.timetable.substitution</field>
        <field name="arch" type="xml">
            <list string="Substitutions">
                <field name="date"/>
                <field name="session_id"/>
                <field name="original_faculty_id"/>
                <field name="substitute_faculty_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>
    <record id="view_univ_substitution_form" model="ir.ui.view">
        <field name="name">univ.timetable.substitution.form</field>
        <field name="model">univ.timetable.substitution</field>
        <field name="arch" type="xml">
            <form string="Substitution">
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_apply" string="Apply" type="object"
                            class="oe_highlight" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="session_id"/>
                        <field name="original_faculty_id"/>
                        <field name="substitute_faculty_id"/>
                        <field name="reason"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_univ_substitution" model="ir.actions.act_window">
        <field name="name">Substitutions</field>
        <field name="res_model">univ.timetable.substitution</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
