<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ATTENDANCE DASHBOARD (graph + pivot on summary) -->
    <record id="view_univ_attendance_summary_graph" model="ir.ui.view">
        <field name="name">univ.attendance.summary.graph</field>
        <field name="model">univ.attendance.summary</field>
        <field name="arch" type="xml">
            <graph string="Attendance %" type="bar" sample="1">
                <field name="subject_id"/>
                <field name="percent" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_univ_attendance_summary_pivot" model="ir.ui.view">
        <field name="name">univ.attendance.summary.pivot</field>
        <field name="model">univ.attendance.summary</field>
        <field name="arch" type="xml">
            <pivot string="Attendance %" sample="1">
                <field name="program_id" type="row"/>
                <field name="subject_id" type="row"/>
                <field name="percent" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_univ_attendance_dashboard" model="ir.actions.act_window">
        <field name="name">Attendance Dashboard</field>
        <field name="res_model">univ.attendance.summary</field>
        <field name="view_mode">graph,pivot,tree</field>
    </record>

    <!-- EXAMINATION DASHBOARD (exam by state) -->
    <record id="view_univ_exam_graph" model="ir.ui.view">
        <field name="name">univ.exam.graph</field>
        <field name="model">univ.exam</field>
        <field name="arch" type="xml">
            <graph string="Exams by Status" type="bar" sample="1">
                <field name="state"/>
                <field name="program_id"/>
            </graph>
        </field>
    </record>
    <record id="action_univ_examination_dashboard" model="ir.actions.act_window">
        <field name="name">Examination Dashboard</field>
        <field name="res_model">univ.exam</field>
        <field name="view_mode">graph,kanban,tree</field>
    </record>

    <!-- RESULT DASHBOARD (pass %, GPA distribution) -->
    <record id="view_univ_result_semester_graph" model="ir.ui.view">
        <field name="name">univ.result.semester.graph</field>
        <field name="model">univ.result.semester</field>
        <field name="arch" type="xml">
            <graph string="Results" type="bar" sample="1">
                <field name="semester_id"/>
                <field name="status"/>
                <field name="sgpa" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_univ_result_semester_pivot" model="ir.ui.view">
        <field name="name">univ.result.semester.pivot</field>
        <field name="model">univ.result.semester</field>
        <field name="arch" type="xml">
            <pivot string="Results" sample="1">
                <field name="program_id" type="row"/>
                <field name="semester_id" type="col"/>
                <field name="sgpa" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_univ_result_dashboard" model="ir.actions.act_window">
        <field name="name">Result Dashboard</field>
        <field name="res_model">univ.result.semester</field>
        <field name="view_mode">graph,pivot,tree</field>
    </record>

    <!-- ACADEMIC DASHBOARD (faculty workload via sessions) -->
    <record id="view_univ_session_graph" model="ir.ui.view">
        <field name="name">univ.timetable.session.graph</field>
        <field name="model">univ.timetable.session</field>
        <field name="arch" type="xml">
            <graph string="Faculty Workload" type="bar" sample="1">
                <field name="faculty_id"/>
            </graph>
        </field>
    </record>
    <record id="view_univ_session_pivot" model="ir.ui.view">
        <field name="name">univ.timetable.session.pivot</field>
        <field name="model">univ.timetable.session</field>
        <field name="arch" type="xml">
            <pivot string="Faculty Workload" sample="1">
                <field name="faculty_id" type="row"/>
                <field name="weekday" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="action_univ_academic_dashboard" model="ir.actions.act_window">
        <field name="name">Academic Dashboard</field>
        <field name="res_model">univ.timetable.session</field>
        <field name="view_mode">graph,pivot,tree</field>
    </record>

</odoo>
