<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SEMESTER RESULT -->
    <record id="view_univ_result_semester_form" model="ir.ui.view">
        <field name="name">univ.result.semester.form</field>
        <field name="model">univ.result.semester</field>
        <field name="arch" type="xml">
            <form string="Semester Result">
                <header>
                    <button name="action_recompute" string="Recompute" type="object"/>
                    <button name="action_publish" string="Publish" type="object"
                            class="oe_highlight" invisible="published"/>
                    <button name="action_unpublish" string="Unpublish" type="object"
                            invisible="not published"/>
                    <field name="published" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="semester_id"/>
                            <field name="program_id"/>
                            <field name="academic_year_id"/>
                        </group>
                        <group>
                            <field name="sgpa"/>
                            <field name="total_credits"/>
                            <field name="earned_credits"/>
                            <field name="backlog_count"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'pass'"
                                   decoration-danger="status == 'fail'"
                                   decoration-warning="status == 'backlog'"/>
                            <field name="version"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree>
                            <field name="subject_id"/>
                            <field name="credit_hours"/>
                            <field name="percent"/>
                            <field name="grade"/>
                            <field name="grade_point"/>
                            <field name="is_pass"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_univ_result_semester_list" model="ir.ui.view">
        <field name="name">univ.result.semester.list</field>
        <field name="model">univ.result.semester</field>
        <field name="arch" type="xml">
            <tree string="Semester Results">
                <field name="student_id"/>
                <field name="semester_id"/>
                <field name="sgpa"/>
                <field name="backlog_count"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'pass'"
                       decoration-danger="status == 'fail'"
                       decoration-warning="status == 'backlog'"/>
                <field name="published"/>
            </tree>
        </field>
    </record>
    <record id="view_univ_result_semester_search" model="ir.ui.view">
        <field name="name">univ.result.semester.search</field>
        <field name="model">univ.result.semester</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="semester_id"/>
                <field name="program_id"/>
                <filter name="published" string="Published"
                        domain="[('published', '=', True)]"/>
                <filter name="backlog" string="Has Backlog"
                        domain="[('backlog_count', '>', 0)]"/>
                <group>
                    <filter name="g_program" string="Program"
                            context="{'group_by': 'program_id'}"/>
                    <filter name="g_sem" string="Semester"
                            context="{'group_by': 'semester_id'}"/>
                    <filter name="g_status" string="Result"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_univ_result_semester" model="ir.actions.act_window">
        <field name="name">Semester Results</field>
        <field name="res_model">univ.result.semester</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- TRANSCRIPT -->
    <record id="view_univ_transcript_form" model="ir.ui.view">
        <field name="name">univ.result.transcript.form</field>
        <field name="model">univ.result.transcript</field>
        <field name="arch" type="xml">
            <form string="Transcript">
                <header>
                    <button name="action_generate" string="Generate" type="object"
                            class="oe_highlight"/>
                    <button name="action_new_version" string="New Version"
                            type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="program_id"/>
                        </group>
                        <group>
                            <field name="cgpa"/>
                            <field name="total_credits"/>
                            <field name="version"/>
                            <field name="generated_on"/>
                        </group>
                    </group>
                    <field name="integrity_hash" readonly="1"/>
                    <field name="semester_result_ids">
                        <tree>
                            <field name="semester_id"/>
                            <field name="sgpa"/>
                            <field name="total_credits"/>
                            <field name="status"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_univ_transcript_list" model="ir.ui.view">
        <field name="name">univ.result.transcript.list</field>
        <field name="model">univ.result.transcript</field>
        <field name="arch" type="xml">
            <tree string="Transcripts">
                <field name="student_id"/>
                <field name="program_id"/>
                <field name="cgpa"/>
                <field name="version"/>
                <field name="generated_on"/>
            </tree>
        </field>
    </record>
    <record id="action_univ_transcript" model="ir.actions.act_window">
        <field name="name">Transcripts</field>
        <field name="res_model">univ.result.transcript</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- RE-EVALUATION -->
    <record id="view_univ_reevaluation_form" model="ir.ui.view">
        <field name="name">univ.exam.reevaluation.form</field>
        <field name="model">univ.exam.reevaluation</field>
        <field name="arch" type="xml">
            <form string="Re-evaluation">
                <header>
                    <button name="action_review" string="Start Review" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_apply_revised" string="Apply Revised Result"
                            type="object" class="oe_highlight"
                            invisible="state != 'review'"/>
                    <button name="action_refuse" string="Refuse" type="object"
                            invisible="state in ('done', 'refused')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="result_line_id"/>
                            <field name="student_id"/>
                            <field name="subject_id"/>
                            <field name="fee_paid"/>
                        </group>
                        <group>
                            <field name="max_marks"/>
                            <field name="original_marks"/>
                            <field name="evaluator2_marks"/>
                            <field name="needs_third"/>
                            <field name="evaluator3_marks"
                                   invisible="not needs_third"/>
                            <field name="revised_marks"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_univ_reevaluation_list" model="ir.ui.view">
        <field name="name">univ.exam.reevaluation.list</field>
        <field name="model">univ.exam.reevaluation</field>
        <field name="arch" type="xml">
            <tree string="Re-evaluations">
                <field name="name"/>
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="original_marks"/>
                <field name="revised_marks"/>
                <field name="needs_third"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>
    <record id="action_univ_reevaluation" model="ir.actions.act_window">
        <field name="name">Re-evaluation</field>
        <field name="res_model">univ.exam.reevaluation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MARKS ENTRY (result lines direct) -->
    <record id="view_univ_result_line_list" model="ir.ui.view">
        <field name="name">univ.exam.result.line.list</field>
        <field name="model">univ.exam.result.line</field>
        <field name="arch" type="xml">
            <tree string="Marks" editable="bottom">
                <field name="exam_id" readonly="1"/>
                <field name="student_id" readonly="1"/>
                <field name="subject_id" readonly="1"/>
                <field name="max_marks"/>
                <field name="obtained"/>
                <field name="second_obtained" string="Eval 2"/>
                <field name="moderated"/>
                <field name="final_marks"/>
                <field name="grade"/>
                <field name="is_pass"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_univ_result_line_search" model="ir.ui.view">
        <field name="name">univ.exam.result.line.search</field>
        <field name="model">univ.exam.result.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="exam_id"/>
                <filter name="fail" string="Failed"
                        domain="[('is_pass', '=', False)]"/>
                <group>
                    <filter name="g_subject" string="Subject"
                            context="{'group_by': 'subject_id'}"/>
                    <filter name="g_exam" string="Exam"
                            context="{'group_by': 'exam_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_univ_result_line" model="ir.actions.act_window">
        <field name="name">Marks Entry</field>
        <field name="res_model">univ.exam.result.line</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
