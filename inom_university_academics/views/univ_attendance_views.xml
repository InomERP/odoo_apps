<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ATTENDANCE SHEET -->
    <record id="view_univ_attendance_sheet_form" model="ir.ui.view">
        <field name="name">univ.attendance.sheet.form</field>
        <field name="model">univ.attendance.sheet</field>
        <field name="arch" type="xml">
            <form string="Attendance Sheet">
                <header>
                    <button name="action_generate_lines" string="Load Students"
                            type="object" invisible="state not in ('draft', 'open')"/>
                    <button name="action_mark_all_present" string="Mark All Present"
                            type="object" class="oe_highlight"
                            invisible="state not in ('draft', 'open')"/>
                    <button name="%(action_univ_attendance_import_wizard)d"
                            string="Biometric Import" type="action"
                            invisible="state not in ('draft', 'open')"
                            context="{'default_sheet_id': id}"/>
                    <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight"
                            invisible="state not in ('draft', 'open')"/>
                    <button name="action_lock" string="Lock" type="object"
                            invisible="state != 'submitted'"/>
                    <button name="action_request_unlock" string="Reopen (HOD)"
                            type="object" invisible="state != 'locked'"
                            groups="inom_university_core.group_univ_hod,inom_university_academics.group_univ_academic_admin"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="session_id" readonly="state != 'draft'"/>
                            <field name="subject_id"/>
                            <field name="faculty_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="slot_id"/>
                            <field name="present_count"/>
                            <field name="absent_count"/>
                            <field name="total_count"/>
                            <field name="marked_by" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state == 'locked'">
                        <tree editable="bottom">
                            <field name="student_id"
                                   readonly="parent.state != 'draft'"/>
                            <field name="state"/>
                            <field name="remark"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_univ_attendance_sheet_list" model="ir.ui.view">
        <field name="name">univ.attendance.sheet.list</field>
        <field name="model">univ.attendance.sheet</field>
        <field name="arch" type="xml">
            <tree string="Attendance Sheets">
                <field name="date"/>
                <field name="section_id"/>
                <field name="subject_id"/>
                <field name="faculty_id"/>
                <field name="present_count"/>
                <field name="absent_count"/>
                <field name="total_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'submitted'"
                       decoration-muted="state == 'locked'"/>
            </tree>
        </field>
    </record>
    <record id="view_univ_attendance_sheet_kanban" model="ir.ui.view">
        <field name="name">univ.attendance.sheet.kanban</field>
        <field name="model">univ.attendance.sheet</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="subject_id"/></strong>
                            <div><field name="section_id"/></div>
                            <div class="text-muted">
                                <field name="date"/> · <field name="slot_id"/>
                            </div>
                            <div>P: <field name="present_count"/> /
                                A: <field name="absent_count"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_univ_attendance_sheet_search" model="ir.ui.view">
        <field name="name">univ.attendance.sheet.search</field>
        <field name="model">univ.attendance.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="section_id"/>
                <field name="subject_id"/>
                <field name="faculty_id"/>
                <field name="date"/>
                <filter name="open" string="Marking Open"
                        domain="[('state', '=', 'open')]"/>
                <filter name="locked" string="Locked"
                        domain="[('state', '=', 'locked')]"/>
                <group>
                    <filter name="g_subject" string="Subject"
                            context="{'group_by': 'subject_id'}"/>
                    <filter name="g_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_univ_attendance_sheet" model="ir.actions.act_window">
        <field name="name">Attendance Sheets</field>
        <field name="res_model">univ.attendance.sheet</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <!-- ATTENDANCE SUMMARY -->
    <record id="view_univ_attendance_summary_list" model="ir.ui.view">
        <field name="name">univ.attendance.summary.list</field>
        <field name="model">univ.attendance.summary</field>
        <field name="arch" type="xml">
            <tree string="Attendance Summary"
                  decoration-warning="shortage_band == 'w75'"
                  decoration-danger="shortage_band == 'w65'">
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="held"/>
                <field name="attended"/>
                <field name="percent"/>
                <field name="shortage_band" widget="badge"
                       decoration-success="shortage_band == 'ok'"
                       decoration-warning="shortage_band in ('w85', 'w75')"
                       decoration-danger="shortage_band == 'w65'"/>
            </tree>
        </field>
    </record>
    <record id="view_univ_attendance_summary_search" model="ir.ui.view">
        <field name="name">univ.attendance.summary.search</field>
        <field name="model">univ.attendance.summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="subject_id"/>
                <filter name="shortage" string="Shortage (&lt;75%)"
                        domain="[('shortage_band', 'in', ('w75', 'w65'))]"/>
                <group>
                    <filter name="g_subject" string="Subject"
                            context="{'group_by': 'subject_id'}"/>
                    <filter name="g_band" string="Shortage Band"
                            context="{'group_by': 'shortage_band'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_univ_attendance_summary" model="ir.actions.act_window">
        <field name="name">Attendance Shortage</field>
        <field name="res_model">univ.attendance.summary</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
