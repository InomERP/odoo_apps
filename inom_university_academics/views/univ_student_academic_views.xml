<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_univ_student_form_academics" model="ir.ui.view">
        <field name="name">univ.student.form.academics</field>
        <field name="model">univ.student</field>
        <field name="inherit_id"
               ref="inom_university_core.view_univ_student_form"/>
        <field name="arch" type="xml">
            <!-- Smart buttons appended to the existing button box -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_attendance" type="object"
                        class="oe_stat_button" icon="fa-check-square-o">
                    <field name="overall_attendance" widget="statinfo"
                           string="Attendance %"/>
                </button>
                <button name="action_view_results" type="object"
                        class="oe_stat_button" icon="fa-graduation-cap">
                    <field name="current_cgpa" widget="statinfo" string="CGPA"/>
                </button>
            </xpath>

            <!-- Shortage ribbon -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <widget name="web_ribbon" title="Attendance Shortage"
                        bg_color="text-bg-danger"
                        invisible="not has_attendance_shortage"/>
                <field name="has_attendance_shortage" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
