<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_fee_account_document">
    <t t-call="inom_portal.report_frame">
      <t t-set="institution" t-value="doc._inom_institution()"/>
      <t t-set="kind" t-value="'Fee statement'"/>
      <t t-set="reference" t-value="doc.student_id.enrolment_no"/>
      <t t-set="issued_on" t-value="context_timestamp(datetime.datetime.now()).strftime('%d %b %Y')"/>

      <h2><t t-out="doc.student_id.name"/></h2>
      <div class="kv">
        <div><span>Enrolment number</span><span t-out="doc.student_id.enrolment_no"/></div>
        <div><span>Programme</span><span t-out="doc.student_id.programme_id.name"/></div>
        <div t-if="doc.department_id"><span>Department</span>
          <span t-out="doc.department_id.name"/></div>
        <div><span>Academic year</span><span t-out="doc.year_id.name"/></div>
        <div><span>Fee structure</span><span t-out="doc.structure_id.name"/></div>
        <div t-if="doc.scholarship_id"><span>Scholarship</span>
          <span t-out="doc.scholarship_id.name"/></div>
        <div><span>Status</span>
          <span t-out="dict(doc._fields['state'].selection).get(doc.state, doc.state)"/></div>
      </div>

      <table>
        <thead>
          <tr>
            <th>Instalment</th>
            <th>Due</th>
            <th>Invoice</th>
            <th style="text-align:right">Amount</th>
            <th style="text-align:right">Paid</th>
            <th style="text-align:right">Balance</th>
          </tr>
        </thead>
        <tbody>
          <tr t-if="not doc.line_ids">
            <td colspan="6">No instalment schedule has been generated yet.</td>
          </tr>
          <tr t-foreach="doc.line_ids" t-as="line">
            <td><t t-out="line.name"/></td>
            <td><t t-out="line.due_date"/></td>
            <!-- sudo for the same reason the line's own computes use it: a
                 student reading their own statement has no rights on
                 account.move, and the number printed here is already on the
                 instalment in front of them. -->
            <td><t t-out="line.move_id.sudo().name or '—'"/></td>
            <td class="num"><t t-out="'%.2f' % line.amount"/></td>
            <td class="num"><t t-out="'%.2f' % line.amount_paid"/></td>
            <td class="num"><t t-out="'%.2f' % line.amount_due"/></td>
          </tr>
        </tbody>
      </table>

      <table>
        <tbody>
          <tr t-if="doc.amount_discount">
            <td>Gross fee</td>
            <td class="num"><t t-out="'%.2f' % doc.amount_gross"/></td>
          </tr>
          <tr t-if="doc.amount_discount">
            <td>Scholarship applied</td>
            <td class="num">-<t t-out="'%.2f' % doc.amount_discount"/></td>
          </tr>
          <tr class="tot">
            <td>Total payable</td>
            <td class="num"><t t-out="'%.2f' % doc.amount_billed"/></td>
          </tr>
          <tr>
            <td>Paid</td>
            <td class="num">-<t t-out="'%.2f' % doc.amount_paid"/></td>
          </tr>
          <tr class="tot">
            <td>Balance outstanding</td>
            <td class="num"><t t-out="'%.2f' % doc.amount_due"/></td>
          </tr>
        </tbody>
      </table>

      <!-- A statement is not a receipt. Printing one on a settled account
           without saying which it is, is how a parent files the wrong
           document and arrives believing the year is paid for. -->
      <p t-if="doc.amount_due &lt;= 0" style="margin-top:18px">
        Nothing is outstanding on this account. This is a statement of position,
        not a receipt — receipts are issued per instalment.
      </p>
      <p t-else="" style="margin-top:18px;color:#5c6480">
        This is a statement of the position on the date shown. Amounts already
        invoiced are payable against the invoice numbers listed above.
      </p>
    </t>
  </template>

  <template id="report_fee_account">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="web.basic_layout">
          <t t-call="inom_fee.report_fee_account_document"/>
        </t>
      </t>
    </t>
  </template>

  <record id="action_report_fee_account" model="ir.actions.report">
    <field name="name">Fee statement</field>
    <field name="model">inom.fee.account</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">inom_fee.report_fee_account</field>
    <field name="print_report_name">'Fee statement - %s' % (object.student_id.enrolment_no)</field>
    <field name="binding_model_id" eval="False"/>
  </record>
</odoo>
