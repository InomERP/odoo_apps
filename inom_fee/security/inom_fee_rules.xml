<odoo>
  <data noupdate="0">

    <!-- Issuing a fee invoice writes account.move. UMS roles are not in
         Odoo's own accounting groups, so without this the Issue button raises
         AccessError at the moment it matters. Granted by implying the stock
         billing group rather than by hand-writing ACL rows for the accounting
         models, which would drift from Odoo's own on every upgrade. -->
    <record id="inom_base.group_inom_accounts" model="res.groups">
      <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="inom_base.group_inom_registrar" model="res.groups">
      <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

  </data>
</odoo>
