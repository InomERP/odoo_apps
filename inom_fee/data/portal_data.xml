    <!-- The Pay button used to live in inom_fee_online, and the record below
         would collide with the copy an existing database still holds.

         The real fix is migrations/20.0.1.0.90/pre-migrate.py, which runs
         before any data is loaded — this call runs during the load, which on
         some paths is already too late. Kept as a second line of defence for
         databases that skip the migration, not as the mechanism. -->
    <function model="inom.portal.action" name="_inom_release_key">
      <value>fee.line.pay</value>
      <value>inom_fee.action_fee_line_pay</value>
    </function>

    <record id="action_fee_line_pay" model="inom.portal.action">
      <field name="key">fee.line.pay</field>
      <field name="name">Pay this instalment</field>
      <field name="model_name">inom.fee.account.line</field>
      <field name="method">_inom_action_pay_link</field>
      <field name="done_message">Opening the payment page\u2026</field>
      <field name="icon">rupee</field>
      <field name="group_ids" eval="[(6, 0, [ref('inom_base.group_inom_registrar'), ref('inom_base.group_inom_accounts'), ref('inom_base.group_inom_student'), ref('inom_base.group_inom_guardian')])]"/>
      <!-- Offered whenever there is something to pay against. The method
           explains what is missing — no invoice yet, still a draft, online
           payment not installed — rather than the button quietly not being
           there, which reads as the system having no way to pay at all. -->
      <field name="condition">record.amount_due &gt; 0</field>
      <field name="primary" eval="True"/>
    </record>

