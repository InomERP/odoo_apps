      <field name="icon">print</field>
      <field name="group_ids" eval="[(6, 0, [
        ref('inom_base.group_inom_registrar'), ref('inom_base.group_inom_accounts'),
        ref('inom_base.group_inom_dean'), ref('inom_base.group_inom_student'),
        ref('inom_base.group_inom_guardian')])]"/>
