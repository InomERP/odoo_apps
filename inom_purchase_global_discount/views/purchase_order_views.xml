<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_purchase_order_discount_form" model="ir.ui.view">
        <field name="name">purchase.order.form.discount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            
            <xpath expr="//page[@name='products']//field[@name='order_line']" position="after">

                <group string="Global Discount">

                    <field name="discount_type"/>
                    <field name="discount_rate"/>
                    <field name="global_discount_amount" readonly="1"/>

                </group>

            </xpath>

        </field>
    </record>

</odoo>