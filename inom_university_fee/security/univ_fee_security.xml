<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============ GROUPS ============ -->
        <record id="group_univ_accounts_officer" model="res.groups">
            <field name="name">Accounts Officer</field>
            <field name="category_id" ref="inom_university_core.module_category_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user'), ref('account.group_account_invoice')])]"/>
            <field name="comment">Full CRUD on fees, refunds and scholarships; can record payments.</field>
        </record>

        <record id="group_univ_counter_staff" model="res.groups">
            <field name="name">Fee Counter Staff</field>
            <field name="category_id" ref="inom_university_core.module_category_university"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="comment">Records payments and prints receipts only.</field>
        </record>

        <!-- Admin inherits accounts officer rights -->
        <record id="inom_university_core.group_univ_admin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_univ_accounts_officer'))]"/>
        </record>

        <!-- ============ MULTI-COMPANY RULES ============ -->
        <record id="rule_fee_structure_company" model="ir.rule">
            <field name="name">Fee structure multi-company</field>
            <field name="model_id" ref="model_univ_fee_structure"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_fee_invoice_company" model="ir.rule">
            <field name="name">Fee invoice multi-company</field>
            <field name="model_id" ref="model_univ_fee_invoice"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_fee_installment_company" model="ir.rule">
            <field name="name">Installment plan multi-company</field>
            <field name="model_id" ref="model_univ_fee_installment_plan"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_fee_refund_company" model="ir.rule">
            <field name="name">Refund multi-company</field>
            <field name="model_id" ref="model_univ_fee_refund_request"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_scholarship_award_company" model="ir.rule">
            <field name="name">Scholarship award multi-company</field>
            <field name="model_id" ref="model_univ_scholarship_award"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_fee_head_company" model="ir.rule">
            <field name="name">Fee head multi-company</field>
            <field name="model_id" ref="model_univ_fee_head"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_fee_waiver_company" model="ir.rule">
            <field name="name">Fee waiver multi-company</field>
            <field name="model_id" ref="model_univ_fee_waiver"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- ============ PORTAL OWN-ONLY ============ -->
        <record id="rule_fee_invoice_portal" model="ir.rule">
            <field name="name">Fee invoice: portal own</field>
            <field name="model_id" ref="model_univ_fee_invoice"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('inom_university_core.group_univ_portal_student')), (4, ref('inom_university_core.group_univ_portal_parent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_fee_installment_portal" model="ir.rule">
            <field name="name">Installment plan: portal own</field>
            <field name="model_id" ref="model_univ_fee_installment_plan"/>
            <field name="domain_force">[('invoice_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('inom_university_core.group_univ_portal_student')), (4, ref('inom_university_core.group_univ_portal_parent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
