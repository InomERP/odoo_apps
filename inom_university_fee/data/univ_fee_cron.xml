<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_fee_late_fee" model="ir.cron">
            <field name="name">Fees: Accrue late fees</field>
            <field name="model_id" ref="inom_university_core.model_univ_student"/>
            <field name="state">code</field>
            <field name="code">model._cron_accrue_late_fees()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_fee_defaulter" model="ir.cron">
            <field name="name">Fees: Flag defaulters</field>
            <field name="model_id" ref="inom_university_core.model_univ_student"/>
            <field name="state">code</field>
            <field name="code">model._cron_flag_defaulters()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_fee_reminders" model="ir.cron">
            <field name="name">Fees: Send overdue reminders</field>
            <field name="model_id" ref="inom_university_core.model_univ_student"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_fee_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_installment_defaults" model="ir.cron">
            <field name="name">Fees: Detect installment defaults</field>
            <field name="model_id" ref="model_univ_fee_installment_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_detect_defaults()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
