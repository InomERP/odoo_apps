<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_univ_fee_bulk_invoice_wizard_form" model="ir.ui.view">
        <field name="name">univ.fee.bulk.invoice.wizard.form</field>
        <field name="model">univ.fee.bulk.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Fee Invoices">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Select a confirmed fee structure. Invoices are generated for
                        every matching student (duplicates are skipped).
                    </div>
                    <group>
                        <group>
                            <field name="structure_id"/>
                            <field name="program_id"/>
                            <field name="batch_id"/>
                            <field name="semester_id"/>
                        </group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                            <field name="only_active_students"/>
                            <field name="post_invoices"/>
                            <field name="student_count"/>
                        </group>
                    </group>
                    <field name="result_summary" readonly="1"
                           invisible="not result_summary"/>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Generate"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_univ_fee_bulk_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Generate Fee Invoices</field>
        <field name="res_model">univ.fee.bulk.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_univ_fee_installment_wizard_form" model="ir.ui.view">
        <field name="name">univ.fee.installment.wizard.form</field>
        <field name="model">univ.fee.installment.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Installment Plan">
                <group>
                    <field name="invoice_id" readonly="1"/>
                    <field name="frequency"/>
                    <field name="count"/>
                    <field name="start_date"/>
                    <field name="amount_total"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_create_plan" type="object"
                            string="Create Plan" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_univ_fee_refund_wizard_form" model="ir.ui.view">
        <field name="name">univ.fee.refund.wizard.form</field>
        <field name="model">univ.fee.refund.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Refund">
                <group>
                    <field name="invoice_id" readonly="1"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_create_request" type="object"
                            string="Create Request" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_univ_scholarship_assign_wizard_form" model="ir.ui.view">
        <field name="name">univ.scholarship.assign.wizard.form</field>
        <field name="model">univ.scholarship.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Scholarship">
                <group>
                    <field name="scheme_id"/>
                    <field name="student_id"/>
                    <field name="invoice_id"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_univ_scholarship_assign_wizard" model="ir.actions.act_window">
        <field name="name">Assign Scholarship</field>
        <field name="res_model">univ.scholarship.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
