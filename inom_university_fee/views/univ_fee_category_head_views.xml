<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== CATEGORY ===== -->
    <record id="view_univ_fee_category_list" model="ir.ui.view">
        <field name="name">univ.fee.category.list</field>
        <field name="model">univ.fee.category</field>
        <field name="arch" type="xml">
            <list string="Fee Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_univ_fee_category" model="ir.actions.act_window">
        <field name="name">Fee Categories</field>
        <field name="res_model">univ.fee.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== HEAD ===== -->
    <record id="view_univ_fee_head_list" model="ir.ui.view">
        <field name="name">univ.fee.head.list</field>
        <field name="model">univ.fee.head</field>
        <field name="arch" type="xml">
            <list string="Fee Heads">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="group_id" optional="hide"/>
                <field name="product_id"/>
                <field name="account_id"/>
                <field name="refundable"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_univ_fee_head_form" model="ir.ui.view">
        <field name="name">univ.fee.head.form</field>
        <field name="model">univ.fee.head</field>
        <field name="arch" type="xml">
            <form string="Fee Head">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Tuition Fee"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category_id"/>
                            <field name="group_id"/>
                            <field name="refundable"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="account_id"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_univ_fee_head" model="ir.actions.act_window">
        <field name="name">Fee Heads</field>
        <field name="res_model">univ.fee.head</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
