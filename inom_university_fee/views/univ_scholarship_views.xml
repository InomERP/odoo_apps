<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== SCHEME ===== -->
    <record id="view_univ_scholarship_scheme_list" model="ir.ui.view">
        <field name="name">univ.scholarship.scheme.list</field>
        <field name="model">univ.scholarship.scheme</field>
        <field name="arch" type="xml">
            <list string="Scholarship Schemes">
                <field name="code"/>
                <field name="name"/>
                <field name="aid_type"/>
                <field name="amount_type"/>
                <field name="amount"/>
                <field name="award_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_univ_scholarship_scheme_form" model="ir.ui.view">
        <field name="name">univ.scholarship.scheme.form</field>
        <field name="model">univ.scholarship.scheme</field>
        <field name="arch" type="xml">
            <form string="Scholarship Scheme">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_awards" type="object"
                                class="oe_stat_button" icon="fa-trophy">
                            <field name="award_count" widget="statinfo" string="Awards"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Merit Scholarship"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="aid_type"/>
                            <field name="min_category"/>
                        </group>
                        <group>
                            <field name="amount_type"/>
                            <field name="amount"/>
                            <field name="fund_account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="eligibility" placeholder="Eligibility criteria..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_univ_scholarship_scheme" model="ir.actions.act_window">
        <field name="name">Scholarship Schemes</field>
        <field name="res_model">univ.scholarship.scheme</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== AWARD ===== -->
    <record id="view_univ_scholarship_award_list" model="ir.ui.view">
        <field name="name">univ.scholarship.award.list</field>
        <field name="model">univ.scholarship.award</field>
        <field name="arch" type="xml">
            <list string="Scholarship Awards"
                  decoration-success="state == 'disbursed'"
                  decoration-danger="state == 'refused'">
                <field name="name"/>
                <field name="student_id"/>
                <field name="scheme_id"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'disbursed'"
                       decoration-danger="state == 'refused'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_univ_scholarship_award_form" model="ir.ui.view">
        <field name="name">univ.scholarship.award.form</field>
        <field name="model">univ.scholarship.award</field>
        <field name="arch" type="xml">
            <form string="Scholarship Award">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="state != 'submitted'"
                            groups="inom_university_core.group_univ_registrar,inom_university_fee.group_univ_accounts_officer"/>
                    <button name="action_disburse" type="object" string="Disburse"
                            class="oe_highlight" invisible="state != 'approved'"
                            groups="inom_university_fee.group_univ_accounts_officer"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state in ('draft', 'disbursed', 'refused')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state in ('draft', 'disbursed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,disbursed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_adjustment" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not credit_note_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Adjustment</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="scheme_id"/>
                            <field name="student_id"/>
                        </group>
                        <group>
                            <field name="invoice_id"/>
                            <field name="amount"/>
                            <field name="credit_note_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_univ_scholarship_award" model="ir.actions.act_window">
        <field name="name">Scholarship Awards</field>
        <field name="res_model">univ.scholarship.award</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
