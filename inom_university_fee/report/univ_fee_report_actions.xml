<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== PDF REPORTS ===== -->
    <record id="action_report_fee_receipt" model="ir.actions.report">
        <field name="name">Fee Receipt</field>
        <field name="model">univ.fee.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">inom_university_fee.report_fee_receipt</field>
        <field name="report_file">inom_university_fee.report_fee_receipt</field>
        <field name="binding_model_id" ref="model_univ_fee_invoice"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Fee Receipt - %s' % (object.name)</field>
    </record>

    <record id="action_report_fee_statement" model="ir.actions.report">
        <field name="name">Fee Statement / Ledger</field>
        <field name="model">univ.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">inom_university_fee.report_fee_statement</field>
        <field name="report_file">inom_university_fee.report_fee_statement</field>
        <field name="binding_model_id" ref="inom_university_core.model_univ_student"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Fee Statement - %s' % (object.name)</field>
    </record>

    <record id="action_report_fee_ledger" model="ir.actions.report">
        <field name="name">Student Ledger</field>
        <field name="model">univ.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">inom_university_fee.report_fee_ledger</field>
        <field name="report_file">inom_university_fee.report_fee_ledger</field>
        <field name="binding_model_id" ref="inom_university_core.model_univ_student"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Ledger - %s' % (object.name)</field>
    </record>

    <!-- ===== ANALYTIC REPORT WINDOWS ===== -->
    <record id="action_univ_fee_outstanding_report" model="ir.actions.act_window">
        <field name="name">Outstanding Dues (Aging)</field>
        <field name="res_model">univ.fee.invoice</field>
        <field name="view_mode">pivot,tree,graph</field>
        <field name="domain">[('amount_residual', '&gt;', 0), ('move_state', '=', 'posted')]</field>
        <field name="context">{'search_default_group_aging': 1, 'search_default_group_program': 1}</field>
    </record>

    <record id="action_univ_fee_refund_register" model="ir.actions.act_window">
        <field name="name">Refund Register</field>
        <field name="res_model">univ.fee.refund.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <record id="action_univ_scholarship_disbursement_report" model="ir.actions.act_window">
        <field name="name">Scholarship Disbursement</field>
        <field name="res_model">univ.scholarship.award</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'disbursed')]</field>
    </record>

    <record id="action_univ_fee_waiver_report" model="ir.actions.act_window">
        <field name="name">Waiver Report</field>
        <field name="res_model">univ.fee.waiver</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <record id="action_univ_fee_collection_report" model="ir.actions.act_window">
        <field name="name">Fee Collection</field>
        <field name="res_model">univ.fee.invoice</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="domain">[('move_state', '=', 'posted')]</field>
        <field name="context">{'search_default_paid': 1, 'search_default_group_program': 1}</field>
    </record>

    <record id="action_univ_fee_collection_program" model="ir.actions.act_window">
        <field name="name">Program-wise Collection</field>
        <field name="res_model">univ.fee.invoice</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('move_state', '=', 'posted')]</field>
        <field name="context">{'search_default_group_program': 1}</field>
    </record>

    <record id="action_univ_fee_collection_semester" model="ir.actions.act_window">
        <field name="name">Semester-wise Collection</field>
        <field name="res_model">univ.fee.invoice</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('move_state', '=', 'posted')]</field>
        <field name="context">{'search_default_group_semester': 1}</field>
    </record>

    <record id="action_univ_fee_collection_batch" model="ir.actions.act_window">
        <field name="name">Batch-wise Collection</field>
        <field name="res_model">univ.fee.invoice</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('move_state', '=', 'posted')]</field>
        <field name="context">{'search_default_group_batch': 1}</field>
    </record>

</odoo>
