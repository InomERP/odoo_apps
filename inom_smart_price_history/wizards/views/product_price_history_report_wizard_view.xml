<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_price_history_report_wizard_form" model="ir.ui.view">
        <field name="name">product.price.history.report.wizard.form</field>
        <field name="model">product.price.history.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Price History Report">
                <group>
                    <group>
                        <field name="supplier_id"/>
                        <field name="product_id"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf"
                            type="object"
                            string="Print PDF"
                            class="btn-primary"/>
                    <button name="action_download_xls"
                            type="object"
                            string="Download XLS"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_price_history_report_wizard" model="ir.actions.act_window">
        <field name="name">Product Price History Report</field>
        <field name="res_model">product.price.history.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
