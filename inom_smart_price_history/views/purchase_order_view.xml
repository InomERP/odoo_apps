<odoo>

    <record id="purchase_order_view_inom_price_history" model="ir.ui.view">
    <field name="name">purchase.order.form.inom.price.history</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
            <button name="action_view_bill_price_history" type="object" icon="fa-history" title="Bill Price History" invisible="not id"/>
        </xpath>

        <xpath expr="//field[@name='order_line']/tree/button[@name='action_purchase_history']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>

    </field>
    </record>

</odoo>