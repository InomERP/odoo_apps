<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vendor_import_result_form" model="ir.ui.view">
        <field name="name">vendor.import.result.form</field>
        <field name="model">vendor.import.result</field>
        <field name="arch" type="xml">
            <form string="Import Results">
                <field name="has_errors" invisible="1"/>
                <field name="summary" readonly="1"/>
                <group string="Errors" invisible="not has_errors">
                    <field name="error_details" readonly="1" nolabel="1"
                           widget="text"/>
                </group>
                <footer>
                    <button string="Close" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
