<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vendor_product_import_wizard_form" model="ir.ui.view">
        <field name="name">vendor.product.import.wizard.form</field>
        <field name="model">vendor.product.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Vendor Products">
                <group>
                    <field name="vendor_id"/>
                    <field name="import_filename" invisible="1"/>
                    <field name="import_file" filename="import_filename"
                           string="Table to import"/>
                </group>
                <notebook>
                    <page string="Settings" name="settings">
                        <group>
                            <field name="import_only_chosen_lines"/>
                            <field name="archive_other_products"/>
                            <field name="mark_previous_prices_outdated"/>
                        </group>
                    </page>
                    <page string="Help" name="help">
                        <div class="text-muted">
                            <p>
                                Download the predefined template, fill it in for
                                <b>one vendor at a time</b>, then upload it above.
                            </p>
                            <field name="help_html" nolabel="1" readonly="1"/>
                            <button name="action_download_template" type="object"
                                    string="Download Template" class="btn-link"
                                    icon="download"/>
                        </div>
                    </page>
                </notebook>
                <footer>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vendor_product_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Vendor Products</field>
        <field name="res_model">vendor.product.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_vendor_product"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
