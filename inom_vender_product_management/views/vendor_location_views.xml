<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vendor_location_list" model="ir.ui.view">
        <field name="name">vendor.location.list</field>
        <field name="model">vendor.location</field>
        <field name="arch" type="xml">
            <list string="Vendor Locations">
                <field name="vendor_id"/>
                <field name="name"/>
                <field name="delivery_lead_time"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_location_form" model="ir.ui.view">
        <field name="name">vendor.location.form</field>
        <field name="model">vendor.location</field>
        <field name="arch" type="xml">
            <form string="Vendor Location">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Main Warehouse"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="delivery_lead_time"/>
                        </group>
                        <group>
                            <field name="address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stock" name="stock">
                            <field name="stock_ids" readonly="1">
                                <list>
                                    <field name="vendor_product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="quantity_product_uom"/>
                                    <field name="uom_mismatch" widget="boolean_toggle" readonly="1"/>
                                    <field name="last_updated"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vendor_location_search" model="ir.ui.view">
        <field name="name">vendor.location.search</field>
        <field name="model">vendor.location</field>
        <field name="arch" type="xml">
            <search string="Vendor Locations">
                <field name="vendor_id"/>
                <field name="name"/>
                <group>
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vendor_location" model="ir.actions.act_window">
        <field name="name">Vendor Locations</field>
        <field name="res_model">vendor.location</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vendor_location_search"/>
        <field name="context">{'search_default_group_vendor': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vendor location
            </p>
            <p>
                Vendor locations represent a supplier's own warehouses. Assign
                an unlimited number of locations per vendor, each with its own
                address and average delivery time.
            </p>
        </field>
    </record>

</odoo>
