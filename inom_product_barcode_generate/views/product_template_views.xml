<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	
	<!-- form view-->
	<record id="view_product_template_form_barcode" model="ir.ui.view">
		<field name="name">product.template.form.barcode</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="product.product_template_form_view"/>
		<field name="arch" type="xml">

			<!--add button-->
			<xpath expr="//sheet" position="before">
				<header>
					<button name="action_regenerate_barcode"
					        type="object"
					        string="Regenerate Barcode"/>
				</header>
			</xpath>
        </field>
	</record>

	<!-- list view action menu: generate barcode for selected products -->
	<record id="action_product_template_generate_barcode" model="ir.actions.server">
		<field name="name">Generate Barcode</field>
		<field name="model_id" ref="product.model_product_template"/>
		<field name="binding_model_id" ref="product.model_product_template"/>
		<field name="binding_view_types">list,kanban</field>
		<field name="state">code</field>
		<field name="code">records.action_regenerate_barcode()</field>
	</record>
</odoo>