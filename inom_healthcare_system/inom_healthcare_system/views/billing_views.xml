<odoo>

    <record id="billing_tree" model="ir.ui.view">
        <field name="name">billing.tree</field>
        <field name="model">oeh.billing</field>
        <field name="arch" type="xml">

            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="bill_date"/>
                <field name="total_amount"/>
                <field name="paid_amount"/>
                <field name="balance"/>
                <field name="state"/>
                <field name="status"/>
            </list>

        </field>
    </record>


    <record id="billing_form" model="ir.ui.view">
        <field name="name">billing.form</field>
        <field name="model">oeh.billing</field>

        <field name="arch" type="xml">

            <form>

                <header>

                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_invoice"
                            type="object"
                            string="Create Invoice"
                            invisible="invoice_id"/>
                    <button name="action_post_bill" type="object" string="Post"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_open_invoice"
                            type="object"
                            string="Open Invoice"
                            class="btn-info"
                            invisible="not invoice_id"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid"
                            class="btn-primary" invisible="state != 'posted'"/>
                    <button name="action_refund" type="object" string="Refund"
                            invisible="state != 'paid'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state in ('draft','refund')"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,posted,paid"/>
                    <field name="status" widget="statusbar"/>

                </header>


                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>

                    <group>

                        <group>
                            <field name="name" readonly="1"/>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="bill_date"/>
                        </group>

                        <group>
                            <field name="total_amount"/>
                            <field name="tax_amount"/>
                            <field name="insurance_claim_id"/>
                            <field name="insurance_coverage"/>
                            <field name="patient_payable" readonly="1"/>
                            <field name="paid_amount" readonly="1"/>
                            <field name="balance" readonly="1"/>
                            <field name="invoice_id" readonly="1"/>
                        </group>

                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <record id="action_billing" model="ir.actions.act_window">
        <field name="name">Billing</field>
        <field name="res_model">oeh.billing</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
