<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Root -->
    <menuitem id="health_root"
              name="Health"/>


    <!-- ================= PATIENT MANAGEMENT ================= -->

    <menuitem id="patient_menu"
              name="Patients"
              parent="health_root"
              sequence="10"/>

    <!-- YE IMPORTANT HAI -->
    <menuitem id="submenu_patient_registration"
              name="Patient Registration"
              parent="patient_menu"
              action="patient_action"
              sequence="1"/>

    <menuitem id="menu_doctor"
              name="Doctors"
              parent="patient_menu"
              action="doctor_action"
              sequence="2"/>

    <menuitem id="menu_queue"
              name="Queue"
              parent="patient_menu"
              action="queue_action"
              sequence="3"/>



    <!-- ================= APPOINTMENTS ================= -->

    <menuitem id="menu_appointment"
              name="Appointments"
              parent="health_root"
              action="appointment_action"
              sequence="20"/>



    <!-- ================= CLINICAL ================= -->

    <menuitem id="menu_clinical"
              name="Clinical"
              parent="health_root"
              sequence="50"/>

    <menuitem id="menu_prescription"
              name="Prescriptions"
              parent="menu_clinical"
              action="prescription_action"/>

    <menuitem id="menu_treatment"
              name="Treatments"
              parent="menu_clinical"
              action="treatment_action"/>

    <menuitem id="menu_certificate"
              name="Medical Certificates"
              parent="menu_clinical"
              action="certificate_action"/>

    <menuitem id="menu_icd"
              name="ICD 10/11"
              parent="menu_clinical"
              action="icd_action"/>

    <menuitem id="menu_consent"
              name="Digital Consent"
              parent="menu_clinical"
              action="consent_action"/>



    <!-- ================= DIAGNOSTICS ================= -->

    <menuitem id="menu_diagnostics"
              name="Diagnostics"
              parent="health_root"
              sequence="80"/>

    <menuitem id="menu_laboratory"
              name="Laboratory"
              parent="menu_diagnostics"
              action="laboratory_action"/>

    <menuitem id="menu_sample"
              name="Sample Tracking"
              parent="menu_diagnostics"
              action="sample_action"/>

    <menuitem id="menu_radiology"
              name="Radiology"
              parent="menu_diagnostics"
              action="radiology_action"/>



    <!-- ================= SURGERY ================= -->

    <menuitem id="menu_surgery"
              name="Surgery"
              parent="health_root"
              sequence="140"/>

    <menuitem id="submenu_surgery_management"
              name="Surgery Management"
              parent="menu_surgery"
              action="action_surgery"/>

    <menuitem id="submenu_ot_schedule"
              name="OT Scheduling"
              parent="menu_surgery"
              action="action_ot_schedule"/>

    <menuitem id="submenu_anesthesia"
              name="Anesthesia Records"
              parent="menu_surgery"
              action="action_anesthesia"/>



    <!-- ================= PHARMACY ================= -->

    <menuitem id="menu_pharmacy"
              name="Pharmacy"
              parent="health_root"
              sequence="150"/>

    <menuitem id="submenu_pharmacy"
              name="Pharmacy Management"
              parent="menu_pharmacy"
              action="pharmacy_action"/>

    <menuitem id="submenu_batch"
              name="Batch &amp; Expiry Tracking"
              parent="menu_pharmacy"
              action="batch_action"/>



    <!-- ================= SPECIALTY ================= -->

    <menuitem id="menu_specialty"
              name="Specialty Care"
              parent="health_root"
              sequence="170"/>

    <menuitem id="submenu_pediatric"
              name="Pediatric"
              parent="menu_specialty"
              action="action_pediatric"/>

    <menuitem id="submenu_therapy"
              name="Physical Therapy"
              parent="menu_specialty"
              action="action_therapy"/>

    <menuitem id="submenu_dental"
              name="Dental Practice"
              parent="menu_specialty"
              action="action_dental"/>

    <menuitem id="submenu_gynecology"
              name="Gynecology"
              parent="menu_specialty"
              action="action_gynecology"/>



    <!-- ================= HOSPITAL ================= -->

    <menuitem id="menu_hospital"
              name="Hospital Operations"
              parent="health_root"
              sequence="200"/>

    <menuitem id="submenu_building"
              name="Buildings"
              parent="menu_hospital"
              action="action_building"/>

    <menuitem id="submenu_ward"
              name="Wards"
              parent="menu_hospital"
              action="action_ward"/>

    <menuitem id="submenu_bed"
              name="Beds"
              parent="menu_hospital"
              action="action_bed"/>

    <menuitem id="submenu_ipd"
              name="IPD Admissions"
              parent="menu_hospital"
              action="action_ipd"/>

    <menuitem id="submenu_icu"
              name="ICU Critical Care"
              parent="menu_hospital"
              action="action_icu"/>

    <menuitem id="submenu_emergency"
              name="Emergency &amp; Triage"
              parent="menu_hospital"
              action="action_emergency"/>

    <menuitem id="submenu_nursing"
              name="Nursing Plans"
              parent="menu_hospital"
              action="action_nursing"/>

    <menuitem id="submenu_campus"
              name="Multi Campus"
              parent="menu_hospital"
              action="action_campus"/>



    <!-- ================= FINANCE ================= -->

    <menuitem id="menu_finance"
              name="Finance &amp; Insurance"
              parent="health_root"
              groups="inom_healthcare_system.group_hospital_billing,inom_healthcare_system.group_hospital_insurance"
              sequence="220"/>

    <menuitem id="submenu_billing"
              name="Billing"
              parent="menu_finance"
              action="action_billing"/>

    <menuitem id="submenu_payment"
              name="Payments"
              parent="menu_finance"
              action="action_payment"/>

    <menuitem id="submenu_claim"
              name="Insurance Claims"
              parent="menu_finance"
              action="action_insurance_claim"/>

    <menuitem id="submenu_hcfa"
              name="HCFA / EDI"
              parent="menu_finance"
              action="action_hcfa"/>

    <menuitem id="submenu_preauth"
              name="Pre Authorization"
              parent="menu_finance"
              action="action_preauthorization"/>


    <!-- ================= COMMUNICATION ================= -->

    <menuitem id="menu_communication"
              name="Communication"
              parent="health_root"
              action="action_communication"
              sequence="240"/>

</odoo>



