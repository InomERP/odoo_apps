<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="building_tree" model="ir.ui.view">
        <field name="name">building.tree</field>
        <field name="model">oeh.building</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="campus_id"/>
                <field name="ward_count"/>
                <field name="bed_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="building_form" model="ir.ui.view">
        <field name="name">building.form</field>
        <field name="model">oeh.building</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_wards" type="object"
                                class="oe_stat_button" icon="fa-hospital-o">
                            <field name="ward_count" widget="statinfo" string="Wards"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-bed" disabled="1">
                            <field name="bed_count" widget="statinfo" string="Beds"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="campus_id"/>
                        </group>
                        <group>
                            <field name="floors"/>
                            <field name="capacity"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Wards">
                            <field name="ward_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">oeh.building</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
