<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="nursing_tree" model="ir.ui.view">
        <field name="name">nursing.tree</field>
        <field name="model">oeh.nursing</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'done'" decoration-info="state == 'in_progress'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="nurse"/>
                <field name="plan_date"/>
                <field name="shift"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="nursing_form" model="ir.ui.view">
        <field name="name">nursing.form</field>
        <field name="model">oeh.nursing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Completed"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="patient_id"/>
                            <field name="nurse"/>
                        </group>
                        <group>
                            <field name="plan_date"/>
                            <field name="shift"/>
                        </group>
                    </group>
                    <group string="Task Checklist">
                        <field name="vitals_checked"/>
                        <field name="medication_given"/>
                        <field name="hygiene_done"/>
                    </group>
                    <notebook>
                        <page string="Care Plan">
                            <field name="care_plan"/>
                        </page>
                        <page string="Medication Administration">
                            <field name="medication_notes"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_nursing" model="ir.actions.act_window">
        <field name="name">Nursing Plans</field>
        <field name="res_model">oeh.nursing</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
