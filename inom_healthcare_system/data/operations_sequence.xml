    <record id="nursing_seq" model="ir.sequence">
        <field name="name">Nursing Plan Sequence</field>
        <field name="code">inom.nursing</field>
        <field name="prefix">NRS/</field>
        <field name="padding">5</field>
    </record>

</odoo>
