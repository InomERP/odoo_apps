    <record id="bed_seq" model="ir.sequence">
        <field name="name">Bed Sequence</field>
        <field name="code">inom.bed</field>
        <field name="prefix">BED/</field>
        <field name="padding">5</field>
    </record>

    <record id="icu_seq" model="ir.sequence">
        <field name="name">ICU Sequence</field>
        <field name="code">inom.icu</field>
        <field name="prefix">ICU/</field>
        <field name="padding">5</field>
