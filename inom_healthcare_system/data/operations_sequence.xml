<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="campus_seq" model="ir.sequence">
        <field name="name">Campus Sequence</field>
        <field name="code">inom.campus</field>
        <field name="prefix">CMP/</field>
        <field name="padding">4</field>
    </record>

    <record id="building_seq" model="ir.sequence">
        <field name="name">Building Sequence</field>
        <field name="code">inom.building</field>
        <field name="prefix">BLD/</field>
