<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="inom_healthcare_system.Dashboard">
        <div class="o_inom_dashboard">

            <!-- Loading -->
            <div t-if="this.state.loading" class="o_inom_loading">
                <i class="oi oi-spin oi-2x" data-icon="progress_activity"/>
                <span class="ms-2">Loading dashboard…</span>
            </div>

            <t t-else="">
                <!-- Header -->
                <div class="o_inom_header">
                    <div>
                        <h1 class="o_inom_title">Hospital Dashboard</h1>
                        <span class="o_inom_subtitle" t-out="this.state.data.company"/>
                    </div>
                    <button class="btn btn-primary o_inom_refresh" t-on-click="this.onRefresh">
                        <i class="oi me-1" data-icon="refresh"/> Refresh
                    </button>
                </div>

                <!-- ============ KPI CARDS ============ -->
                <div class="o_inom_kpi_grid">
                    <div class="o_inom_kpi o_kpi_blue" t-on-click="() => this.openModel('inom.patient', 'Patients')">
                        <div class="o_kpi_icon"><i class="oi" data-icon="medical_services"/></div>
                        <div class="o_kpi_body">
                            <div class="o_kpi_value" t-out="this.state.data.kpis.patients"/>
                            <div class="o_kpi_label">Patients</div>
                        </div>
                    </div>

                    <div class="o_inom_kpi o_kpi_teal" t-on-click="() => this.openModel('inom.doctor', 'Doctors')">
                        <div class="o_kpi_icon"><i class="oi" data-icon="stethoscope"/></div>
                        <div class="o_kpi_body">
                            <div class="o_kpi_value" t-out="this.state.data.kpis.doctors"/>
                            <div class="o_kpi_label">Doctors</div>
                        </div>
                    </div>

                    <div class="o_inom_kpi o_kpi_indigo" t-on-click="() => this.openModel('inom.appointment', 'Appointments')">
                        <div class="o_kpi_icon"><i class="oi" data-icon="event_available"/></div>
                        <div class="o_kpi_body">
                            <div class="o_kpi_value" t-out="this.state.data.kpis.appointments"/>
                            <div class="o_kpi_label">Appointments
                                <span class="o_kpi_badge" t-out="this.state.data.kpis.appointments_today + ' today'"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_inom_kpi o_kpi_purple" t-on-click="() => this.openModel('inom.surgery', 'Surgeries')">
                        <div class="o_kpi_icon"><i class="oi" data-icon="content_cut"/></div>
                        <div class="o_kpi_body">
                            <div class="o_kpi_value" t-out="this.state.data.kpis.surgeries"/>
                            <div class="o_kpi_label">Surgeries</div>
                        </div>
                    </div>

                    <div class="o_inom_kpi o_kpi_green" t-on-click="() => this.openModel('inom.laboratory', 'Laboratory')">
                        <div class="o_kpi_icon"><i class="oi" data-icon="science"/></div>
                        <div class="o_kpi_body">
                            <div class="o_kpi_value" t-out="this.state.data.kpis.lab_tests"/>
                            <div class="o_kpi_label">Lab Tests</div>
                        </div>
                    </div>

                    <div class="o_inom_kpi o_kpi_cyan" t-on-click="() => this.openModel('inom.radiology', 'Radiology')">
                        <div class="o_kpi_icon"><i class="oi" data-icon="image"/></div>
                        <div class="o_kpi_body">
                            <div class="o_kpi_value" t-out="this.state.data.kpis.radiology"/>
                            <div class="o_kpi_label">Radiology</div>
                        </div>
                    </div>

                    <div class="o_inom_kpi o_kpi_orange" t-on-click="() => this.openModel('inom.ipd', 'IPD Admissions')">
                        <div class="o_kpi_icon"><i class="oi" data-icon="bed"/></div>
                        <div class="o_kpi_body">
                            <div class="o_kpi_value" t-out="this.state.data.kpis.ipd_admitted"/>
                            <div class="o_kpi_label">Admitted (IPD)</div>
                        </div>
                    </div>

                    <div class="o_inom_kpi o_kpi_red" t-on-click="() => this.openModel('inom.emergency', 'Emergency')">
                        <div class="o_kpi_icon"><i class="oi" data-icon="emergency"/></div>
                        <div class="o_kpi_body">
                            <div class="o_kpi_value" t-out="this.state.data.kpis.emergency"/>
                            <div class="o_kpi_label">Emergency Cases</div>
                        </div>
                    </div>
                </div>

                <!-- ============ FINANCE STRIP ============ -->
                <div class="o_inom_finance">
                    <div class="o_inom_fin_card">
                        <div class="o_fin_label">Total Billed</div>
                        <div class="o_fin_value" t-out="this.formatMoney(this.state.data.billing.total_billed)"/>
                    </div>
                    <div class="o_inom_fin_card o_fin_paid">
                        <div class="o_fin_label">Collected</div>
                        <div class="o_fin_value" t-out="this.formatMoney(this.state.data.billing.total_paid)"/>
                    </div>
                    <div class="o_inom_fin_card o_fin_due">
                        <div class="o_fin_label">Outstanding</div>
                        <div class="o_fin_value" t-out="this.formatMoney(this.state.data.billing.total_balance)"/>
                    </div>
                    <div class="o_inom_fin_card">
                        <div class="o_fin_label">Payments Received</div>
                        <div class="o_fin_value" t-out="this.formatMoney(this.state.data.payments_total)"/>
                    </div>
                    <div class="o_inom_fin_card">
                        <div class="o_fin_label">Insurance Approved</div>
                        <div class="o_fin_value" t-out="this.formatMoney(this.state.data.insurance.approved_amount)"/>
                    </div>
                </div>

                <!-- ============ BREAKDOWN PANELS ============ -->
                <div class="o_inom_panels">

                    <t t-set="panels" t-value="[
                        {title: 'Appointments by Status', icon: 'calendar_today', list: this.state.data.appointments_by_state, model: 'inom.appointment'},
                        {title: 'Surgeries by Status', icon: 'content_cut', list: this.state.data.surgery_by_status, model: 'inom.surgery'},
                        {title: 'Billing by Status', icon: 'payments', list: this.state.data.billing.by_status, model: 'inom.billing'},
                        {title: 'Insurance Claims', icon: 'security', list: this.state.data.insurance.by_status, model: 'inom.insurance.claim'},
                        {title: 'Emergency by Triage', icon: 'cardiology', list: this.state.data.emergency_by_triage, model: 'inom.emergency'},
                        {title: 'Bed Occupancy', icon: 'bed', list: this.state.data.bed_status, model: 'inom.bed'}
                    ]"/>

                    <div class="o_inom_panel" t-foreach="panels" t-as="panel" t-key="panel.title">
                        <div class="o_panel_head">
                            <span><i class="oi me-2" t-att-data-icon="panel.icon"/><t t-out="panel.title"/></span>
                            <a class="o_panel_link" t-on-click="() => this.openModel(panel.model, panel.title)">View ›</a>
                        </div>
                        <div class="o_panel_body">
                            <div class="o_bar_row" t-foreach="panel.list" t-as="item" t-key="item.key">
                                <div class="o_bar_label" t-out="item.label"/>
                                <div class="o_bar_track">
                                    <div class="o_bar_fill" t-attf-class="o_bar_{{item.key}}"
                                         t-att-style="'width:' + this.barWidth(item, panel.list)"/>
                                </div>
                                <div class="o_bar_count" t-out="item.count"/>
                            </div>
                        </div>
                    </div>

                    <!-- Pharmacy / Stock panel -->
                    <div class="o_inom_panel">
                        <div class="o_panel_head">
                            <span><i class="oi me-2" data-icon="medical_services"/>Pharmacy</span>
                            <a class="o_panel_link" t-on-click="() => this.openModel('inom.pharmacy', 'Pharmacy')">View ›</a>
                        </div>
                        <div class="o_panel_body o_pharmacy_body">
                            <div class="o_mini_stat">
                                <div class="o_mini_value" t-out="this.state.data.pharmacy.medicines"/>
                                <div class="o_mini_label">Medicines</div>
                            </div>
                            <div class="o_mini_stat">
                                <div class="o_mini_value" t-out="this.state.data.pharmacy.batches"/>
                                <div class="o_mini_label">Batches</div>
                            </div>
                            <div class="o_mini_stat o_mini_warn">
                                <div class="o_mini_value" t-out="this.state.data.pharmacy.low_stock"/>
                                <div class="o_mini_label">Low Stock</div>
                            </div>
                            <div class="o_mini_stat">
                                <div class="o_mini_value" t-out="this.state.data.kpis.queue_waiting"/>
                                <div class="o_mini_label">Queue Waiting</div>
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </div>
    </t>

</templates>
