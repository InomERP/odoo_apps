<odoo>

    <record id="icd_tree" model="ir.ui.view">
        <field name="name">icd.tree</field>
        <field name="model">oeh.icd</field>
        <field name="arch" type="xml">
            <list decoration-muted="active == False">
                <field name="code"/>
                <field name="name"/>
                <field name="type"/>
                <field name="category"/>
                <field name="treatment_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="icd_form" model="ir.ui.view">
        <field name="name">icd.form</field>
        <field name="model">oeh.icd</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_treatments" type="object"
                                class="oe_stat_button" icon="fa-stethoscope">
                            <field name="treatment_count" widget="statinfo" string="Treatments"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="icd_action" model="ir.actions.act_window">
        <field name="name">ICD 10 / ICD 11</field>
        <field name="res_model">oeh.icd</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
