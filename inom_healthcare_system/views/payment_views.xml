<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="payment_tree" model="ir.ui.view">
        <field name="name">payment.tree</field>
        <field name="model">oeh.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="billing_id"/>
                <field name="payment_date"/>
                <field name="amount"/>
                <field name="payment_method"/>
                <field name="payment_kind"/>
                <field name="reference"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="payment_form" model="ir.ui.view">
        <field name="name">payment.form</field>
        <field name="model">oeh.payment</field>
        <field name="arch" type="xml">

            <form>

                <header>
                    <button name="action_post" type="object" string="Confirm Payment"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="state != 'cancel'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>

                <sheet>

                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="billing_id"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="payment_date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="payment_method"/>
                            <field name="payment_kind"/>
                            <field name="reference"/>
                        </group>
                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <!-- Action -->
    <record id="action_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">oeh.payment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
