<odoo>

    <!-- Doctor Tree View -->
    <record id="doctor_tree" model="ir.ui.view">
        <field name="name">doctor.tree</field>
        <field name="model">oeh.doctor</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>

    </record>


    <!-- Doctor Form View -->
    <record id="doctor_form" model="ir.ui.view">
        <field name="name">doctor.form</field>
        <field name="model">oeh.doctor</field>

        <field name="arch" type="xml">

            <form>

                <!-- Smart buttons -->
                <header>

                    <button
                        name="action_view_attendance"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar">

                        <field
                            name="attendance_count"
                            widget="statinfo"
                            string="Attendance"/>

                    </button>


                    <button
                        name="action_view_leave"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clock-o">

                        <field
                            name="leave_count"
                            widget="statinfo"
                            string="Leave"/>

                    </button>

                </header>

                <sheet>

                    <group>

                        <group>
                            <field name="name"/>
                            <field name="specialization"/>
                        </group>

                        <group>
                            <field name="phone"/>
                            <field name="email"/>

                            <!-- Community HR link -->
                            <field name="employee_id"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Schedule">

                            <field name="schedule_ids">

                                <list editable="bottom">
                                    <field name="day"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <!-- Chatter -->
                <chatter/>

            </form>

        </field>
    </record>


    <!-- Action -->
    <record id="doctor_action"
            model="ir.actions.act_window">

        <field name="name">Doctors</field>
        <field name="res_model">oeh.doctor</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>