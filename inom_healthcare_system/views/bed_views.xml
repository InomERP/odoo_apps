<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="bed_tree" model="ir.ui.view">
        <field name="name">bed.tree</field>
        <field name="model">oeh.bed</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'free'" decoration-danger="status == 'occupied'"
                  decoration-warning="status in ('cleaning','maintenance')" decoration-info="status == 'reserved'">
                <field name="code"/>
                <field name="name"/>
                <field name="ward_id"/>
                <field name="bed_type"/>
                <field name="current_patient_id"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="bed_form" model="ir.ui.view">
        <field name="name">bed.form</field>
        <field name="model">oeh.bed</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reserve" type="object" string="Reserve"
                            invisible="status in ('reserved','occupied')"/>
                    <button name="action_occupy" type="object" string="Occupy"
                            class="btn-primary" invisible="status == 'occupied'"/>
                    <button name="action_cleaning" type="object" string="Send to Cleaning"
                            invisible="status == 'cleaning'"/>
                    <button name="action_maintenance" type="object" string="Maintenance"
                            invisible="status == 'maintenance'"/>
                    <button name="action_free" type="object" string="Mark Free"
                            class="btn-primary" invisible="status == 'free'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="free,reserved,occupied,cleaning"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="name"/>
                            <field name="ward_id"/>
                        </group>
                        <group>
                            <field name="bed_type"/>
                            <field name="current_patient_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bed_kanban" model="ir.ui.view">
        <field name="name">bed.kanban</field>
        <field name="model">oeh.bed</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status">
                <field name="name"/>
                <field name="ward_id"/>
                <field name="status"/>
                <field name="current_patient_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <strong><field name="name"/></strong>
                            <div><field name="ward_id"/></div>
                            <div t-if="record.current_patient_id.raw_value">
                                <i class="fa fa-user"/> <field name="current_patient_id"/>
                            </div>
                            <span class="badge text-bg-secondary"><field name="status"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_bed" model="ir.actions.act_window">
        <field name="name">Beds</field>
        <field name="res_model">oeh.bed</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

</odoo>
