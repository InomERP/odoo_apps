<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="campus_tree" model="ir.ui.view">
        <field name="name">campus.tree</field>
        <field name="model">oeh.campus</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="location"/>
                <field name="phone"/>
                <field name="building_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="campus_form" model="ir.ui.view">
        <field name="name">campus.form</field>
        <field name="model">oeh.campus</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_buildings" type="object"
                                class="oe_stat_button" icon="fa-building">
                            <field name="building_count" widget="statinfo" string="Buildings"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="name"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_campus" model="ir.actions.act_window">
        <field name="name">Multi Campus</field>
        <field name="res_model">oeh.campus</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
