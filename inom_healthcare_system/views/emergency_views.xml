<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="emergency_tree" model="ir.ui.view">
        <field name="name">emergency.tree</field>
        <field name="model">oeh.emergency</field>
        <field name="arch" type="xml">
            <list decoration-danger="triage_level == 'high'" decoration-warning="triage_level == 'medium'"
                  decoration-success="triage_level == 'low'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="arrival_time"/>
                <field name="triage_level"/>
                <field name="attending_doctor_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="emergency_form" model="ir.ui.view">
        <field name="name">emergency.form</field>
        <field name="model">oeh.emergency</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_treatment" type="object" string="Start Treatment"
                            class="btn-primary" invisible="state != 'waiting'"/>
                    <button name="action_admit_ipd" type="object" string="Admit to IPD"
                            class="btn-primary" invisible="state in ('admitted','discharged')"/>
                    <button name="action_discharge" type="object" string="Discharge"
                            invisible="state in ('admitted','discharged')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="waiting,in_treatment,admitted,discharged"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="patient_id"/>
                            <field name="arrival_time"/>
                            <field name="attending_doctor_id"/>
                        </group>
                        <group>
                            <field name="triage_level"/>
                            <field name="triage_color"/>
                            <field name="ipd_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="symptoms" placeholder="Presenting symptoms..."/>
                        <field name="notes" placeholder="Emergency notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="emergency_kanban" model="ir.ui.view">
        <field name="name">emergency.kanban</field>
        <field name="model">oeh.emergency</field>
        <field name="arch" type="xml">
            <kanban default_group_by="triage_level">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="triage_level"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <strong><field name="patient_id"/></strong>
                            <div><field name="name"/></div>
                            <span class="badge text-bg-secondary"><field name="state"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_emergency" model="ir.actions.act_window">
        <field name="name">Emergency &amp; Triage</field>
        <field name="res_model">oeh.emergency</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

</odoo>
