<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Anesthesia Tree View -->
    <record id="view_anesthesia_tree" model="ir.ui.view">
        <field name="name">oehealth.anesthesia.record.tree</field>
        <field name="model">oehealth.anesthesia.record</field>
        <field name="arch" type="xml">
            <list string="Anesthesia Records">
                <field name="surgery_id"/>
                <field name="anesthesia_type"/>
                <field name="anesthetist"/>
            </list>
        </field>
    </record>


    <!-- Anesthesia Form View -->
    <record id="view_anesthesia_form" model="ir.ui.view">
        <field name="name">oehealth.anesthesia.record.form</field>
        <field name="model">oehealth.anesthesia.record</field>
        <field name="arch" type="xml">

            <form string="Anesthesia Record">

                <sheet>

                    <group>
                        <group>
                            <field name="surgery_id"/>
                            <field name="anesthesia_type"/>
                        </group>

                        <group>
                            <field name="anesthetist"/>
                        </group>
                    </group>

                    <group>
                        <field name="medication"/>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- Action -->
    <record id="action_anesthesia" model="ir.actions.act_window">
        <field name="name">Anesthesia Records</field>
        <field name="res_model">oehealth.anesthesia.record</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>