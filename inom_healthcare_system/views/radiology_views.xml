<odoo>

    <!-- TREE VIEW -->
    <record id="radiology_tree" model="ir.ui.view">
        <field name="name">radiology.tree</field>
        <field name="model">inom.radiology</field>

        <field name="arch" type="xml">

            <tree>
                <field name="patient_id"/>
                <field name="scan_type"/>
            </tree>

        </field>
    </record>


    <!-- FORM VIEW -->
    <record id="radiology_form" model="ir.ui.view">
        <field name="name">radiology.form</field>
        <field name="model">inom.radiology</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>
                        <field name="patient_id"/>
                        <field name="scan_type"/>
                        <field name="image" widget="image"/>
                    </group>

                    <group>
                        <field name="report" widget="html"/>
                    </group>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>

        </field>
    </record>


    <!-- ACTION -->
    <record id="radiology_action" model="ir.actions.act_window">
        <field name="name">Radiology</field>
        <field name="res_model">inom.radiology</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>