<odoo>

    <!-- TREE VIEW -->
    <record id="radiology_tree" model="ir.ui.view">
        <field name="name">radiology.tree</field>
        <field name="model">oeh.radiology</field>

        <field name="arch" type="xml">

            <list>
                <field name="patient_id"/>
                <field name="scan_type"/>
            </list>

        </field>
    </record>


    <!-- FORM VIEW -->
    <record id="radiology_form" model="ir.ui.view">
        <field name="name">radiology.form</field>
        <field name="model">oeh.radiology</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>
                        <field name="patient_id"/>
                        <field name="scan_type"/>
                        <field name="image" widget="image"/>
                    </group>

                    <group>
                        <field name="report" widget="html"/>
                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <!-- ACTION -->
    <record id="radiology_action" model="ir.actions.act_window">
        <field name="name">Radiology</field>
        <field name="res_model">oeh.radiology</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>