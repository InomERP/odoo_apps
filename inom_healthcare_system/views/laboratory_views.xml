<odoo>

    <!-- TREE VIEW -->
    <record id="laboratory_tree" model="ir.ui.view">
        <field name="name">laboratory.tree</field>
        <field name="model">inom.laboratory</field>
        <field name="arch" type="xml">

            <tree>
                <field name="patient_id"/>
                <field name="test_name"/>
                <field name="test_date"/>
                <field name="status"/>
            </tree>

        </field>
    </record>


    <!-- FORM VIEW -->
    <record id="laboratory_form" model="ir.ui.view">
        <field name="name">laboratory.form</field>
        <field name="model">inom.laboratory</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>
                        <field name="patient_id"/>
                        <field name="test_name"/>
                        <field name="test_date"/>
                        <field name="status"/>
                    </group>

                    <group>
                        <field name="result"/>
                    </group>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>

        </field>
    </record>


    <!-- ACTION -->
    <record id="laboratory_action" model="ir.actions.act_window">
        <field name="name">Laboratory</field>
        <field name="res_model">inom.laboratory</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>