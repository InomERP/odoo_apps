<odoo>

    <!-- Queue Tree View -->
    <record id="queue_tree" model="ir.ui.view">
        <field name="name">queue.tree</field>
        <field name="model">oeh.queue</field>

        <field name="arch" type="xml">
            <list>
                <field name="token_no"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <!-- Queue Form View -->
    <record id="queue_form" model="ir.ui.view">
        <field name="name">queue.form</field>
        <field name="model">oeh.queue</field>

        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>

                        <field name="token_no"/>

                        <field name="patient_id"/>

                        <field name="doctor_id"/>

                        <field name="state"/>

                    </group>

                </sheet>
            </form>
        </field>

    </record>


    <!-- Queue Action -->
    <record id="queue_action"
            model="ir.actions.act_window">

        <field name="name">Queue</field>

        <field name="res_model">oeh.queue</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>