<odoo>

    <!-- TREE VIEW -->
    <record id="insurance_claim_tree" model="ir.ui.view">
        <field name="name">insurance.claim.tree</field>
        <field name="model">oeh.insurance.claim</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="insurance_company"/>
                <field name="policy_number"/>
                <field name="claim_amount"/>
                <field name="approved_amount"/>
                <field name="claim_status"/>
            </list>
        </field>
    </record>


    <!-- FORM VIEW -->
    <record id="insurance_claim_form" model="ir.ui.view">
        <field name="name">insurance.claim.form</field>
        <field name="model">oeh.insurance.claim</field>
        <field name="arch" type="xml">

            <form>

                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="claim_status != 'draft'"/>
                    <button name="action_review" type="object" string="Start Review"
                            class="btn-primary" invisible="claim_status != 'submitted'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="claim_status not in ('submitted','under_review')"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="claim_status not in ('submitted','under_review')"/>
                    <button name="action_settle" type="object" string="Settle"
                            class="btn-primary" invisible="claim_status != 'approved'"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="claim_status in ('draft','settled')"/>

                    <button class="oe_stat_button" type="object"
                            name="action_view_claims" icon="fa-file-text-o">
                        <field name="claim_count" widget="statinfo" string="Claims"/>
                    </button>

                    <field name="claim_status" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,approved,settled"/>
                </header>

                <sheet>

                    <group>

                        <group>
                            <field name="name" readonly="1"/>
                            <field name="patient_id"/>
                            <field name="insurance_company"/>
                            <field name="insurance_partner_id"/>
                            <field name="policy_number"/>
                        </group>

                        <group>
                            <field name="claim_amount"/>
                            <field name="approved_amount"/>
                            <field name="coverage_percentage"/>
                            <field name="patient_responsibility" readonly="1"/>
                            <field name="claim_status"/>
                        </group>

                    </group>

                    <notebook>
                        <page string="Settlement">
                            <group>
                                <field name="settlement_date"/>
                                <field name="settled_amount"/>
                            </group>
                            <field name="approval_notes" placeholder="Approval notes..."/>
                            <field name="rejection_reason" placeholder="Rejection reason..."/>
                        </page>
                        <page string="Documents">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Other">
                            <group>
                                <field name="edi_number"/>
                                <field name="remarks"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <!-- ACTION -->
    <record id="action_insurance_claim" model="ir.actions.act_window">
        <field name="name">Insurance Claims</field>
        <field name="res_model">oeh.insurance.claim</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
