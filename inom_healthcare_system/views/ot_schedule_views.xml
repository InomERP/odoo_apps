<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- OT Schedule Tree View -->
    <record id="view_ot_schedule_tree" model="ir.ui.view">
        <field name="name">oehealth.ot.schedule.tree</field>
        <field name="model">oehealth.ot.schedule</field>
        <field name="arch" type="xml">
            <list string="OT Schedule">
                <field name="surgery_id"/>
                <field name="ot_room"/>
                <field name="start_time"/>
                <field name="end_time"/>
            </list>
        </field>
    </record>


    <!-- OT Schedule Form View -->
    <record id="view_ot_schedule_form" model="ir.ui.view">
        <field name="name">oehealth.ot.schedule.form</field>
        <field name="model">oehealth.ot.schedule</field>
        <field name="arch" type="xml">
            <form string="OT Schedule">

                <sheet>

                    <group>
                        <group>
                            <field name="surgery_id"/>
                            <field name="ot_room"/>
                        </group>

                        <group>
                            <field name="start_time"/>
                            <field name="end_time"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- OT Schedule Action -->
    <record id="action_ot_schedule" model="ir.actions.act_window">
        <field name="name">OT Scheduling</field>
        <field name="res_model">oehealth.ot.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>