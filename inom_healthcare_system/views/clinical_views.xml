<odoo>

    <record id="clinical_tree" model="ir.ui.view">
        <field name="name">clinical.tree</field>
        <field name="model">inom.clinical</field>

        <field name="arch" type="xml">
            <tree>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_id"/>
            </tree>
        </field>
    </record>


    <record id="clinical_form" model="ir.ui.view">
        <field name="name">clinical.form</field>
        <field name="model">inom.clinical</field>

        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                        <field name="appointment_id"/>
                        <field name="symptoms"/>
                        <field name="diagnosis"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="clinical_action" model="ir.actions.act_window">
        <field name="name">Clinical Evaluation</field>
        <field name="res_model">inom.clinical</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>