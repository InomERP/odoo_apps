<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="0">

    <!--
        Hospital role foundation (Odoo 19).
        Odoo 19 replaced res.groups.category_id with privilege_id, a
        many2one to the new res.groups.privilege model (which carries the
        module category). Roles are grouped under one hospital privilege.

        These records are ADDITIVE: defining groups/privileges does not
        remove anyone's access. Existing model access (ir.model.access.csv)
        stays global, so current users keep working exactly as before.
        Per-role access tightening (record rules, menu/model permissions)
        is deferred to a later phase so it can be tested safely.
    -->

    <!-- App category shown in Settings > Users -->
    <record id="module_category_hospital" model="ir.module.category">
        <field name="name">Hospital Management</field>
        <field name="description">Roles for the Hospital / Clinic ERP.</field>
        <field name="sequence">20</field>
    </record>

    <!-- Odoo 19: the privilege carries the category; groups link to it -->
    <record id="privilege_hospital" model="res.groups.privilege">
        <field name="name">Hospital Role</field>
        <field name="category_id" ref="module_category_hospital"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_hospital_receptionist" model="res.groups">
        <field name="name">Receptionist / Front Desk</field>
        <field name="privilege_id" ref="privilege_hospital"/>
    </record>

    <record id="group_hospital_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="privilege_id" ref="privilege_hospital"/>
    </record>

    <record id="group_hospital_nurse" model="res.groups">
        <field name="name">Nurse</field>
        <field name="privilege_id" ref="privilege_hospital"/>
    </record>

    <record id="group_hospital_pharmacist" model="res.groups">
        <field name="name">Pharmacist</field>
        <field name="privilege_id" ref="privilege_hospital"/>
    </record>

    <record id="group_hospital_lab" model="res.groups">
        <field name="name">Lab Technician</field>
        <field name="privilege_id" ref="privilege_hospital"/>
    </record>

    <record id="group_hospital_radiology" model="res.groups">
        <field name="name">Radiology Staff</field>
        <field name="privilege_id" ref="privilege_hospital"/>
    </record>

    <record id="group_hospital_billing" model="res.groups">
        <field name="name">Billing Staff</field>
        <field name="privilege_id" ref="privilege_hospital"/>
        <!-- Cashiers can create/post customer invoices and register payments -->
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_hospital_insurance" model="res.groups">
        <field name="name">Insurance / TPA Staff</field>
        <field name="privilege_id" ref="privilege_hospital"/>
    </record>

    <!-- Manager / Admin implies every operational role -->
    <record id="group_hospital_manager" model="res.groups">
        <field name="name">Hospital Manager / Admin</field>
        <field name="privilege_id" ref="privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('group_hospital_receptionist')),
                                          (4, ref('group_hospital_doctor')),
                                          (4, ref('group_hospital_nurse')),
                                          (4, ref('group_hospital_pharmacist')),
                                          (4, ref('group_hospital_lab')),
                                          (4, ref('group_hospital_radiology')),
                                          (4, ref('group_hospital_billing')),
                                          (4, ref('group_hospital_insurance'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
