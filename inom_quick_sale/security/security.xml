<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <!-- Privilege (Odoo 20 replaces group categories with privileges) -->
        <record id="res_groups_privilege_quick_sale"
                model="res.groups.privilege">

            <field name="name">Inom Quick Sale</field>

            <field name="description">Manage Inom Quick Sale automation rights</field>

            <field name="sequence">100</field>

            <field name="category_id" ref="base.module_category_sales"/>

        </record>

        <!-- User Group -->
        <record id="group_quick_sale_user"
                model="res.groups">

            <field name="name">Quick Sale User</field>

            <field name="sequence">10</field>

            <field name="privilege_id" ref="res_groups_privilege_quick_sale"/>

            <field name="implied_ids"
                   eval="[(4, ref('sales_team.group_sale_salesman'))]"/>

        </record>

        <!-- Manager Group -->
        <record id="group_quick_sale_manager"
                model="res.groups">

            <field name="name">Quick Sale Manager</field>

            <field name="sequence">20</field>

            <field name="privilege_id" ref="res_groups_privilege_quick_sale"/>

            <field name="implied_ids"
                   eval="[
                       (4, ref('group_quick_sale_user')),
                       (4, ref('base.group_system'))
                   ]"/>

        </record>

    </data>
</odoo>
