<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- ============ PAYMENT METHODS ============ -->
    <record id="pm_cash" model="healthcare.pos.payment.method">
        <field name="name">Cash</field>
        <field name="method_type">cash</field>
        <field name="icon">money</field>
        <field name="sequence">1</field>
    </record>
    <record id="pm_card" model="healthcare.pos.payment.method">
        <field name="name">Card</field>
        <field name="method_type">card</field>
        <field name="icon">credit-card</field>
        <field name="sequence">2</field>
    </record>
    <record id="pm_upi" model="healthcare.pos.payment.method">
        <field name="name">UPI</field>
        <field name="method_type">upi</field>
        <field name="icon">mobile</field>
        <field name="sequence">3</field>
    </record>
    <record id="pm_insurance" model="healthcare.pos.payment.method">
        <field name="name">Insurance</field>
        <field name="method_type">insurance</field>
        <field name="icon">shield</field>
        <field name="sequence">4</field>
    </record>

    <!-- ============ CATEGORIES ============ -->
    <record id="cat_consultation" model="healthcare.pos.category">
        <field name="name">Consultation</field>
        <field name="icon">user-md</field>
        <field name="color">#0d9488</field>
        <field name="sequence">1</field>
    </record>
    <record id="cat_laboratory" model="healthcare.pos.category">
        <field name="name">Laboratory</field>
        <field name="icon">flask</field>
        <field name="color">#7c3aed</field>
        <field name="sequence">2</field>
    </record>
    <record id="cat_radiology" model="healthcare.pos.category">
        <field name="name">Radiology</field>
        <field name="icon">camera</field>
        <field name="color">#2563eb</field>
        <field name="sequence">3</field>
    </record>
    <record id="cat_pharmacy" model="healthcare.pos.category">
        <field name="name">Pharmacy</field>
        <field name="icon">medkit</field>
        <field name="color">#dc2626</field>
        <field name="sequence">4</field>
    </record>
    <record id="cat_treatment" model="healthcare.pos.category">
        <field name="name">Treatment</field>
        <field name="icon">heartbeat</field>
        <field name="color">#ea580c</field>
        <field name="sequence">5</field>
    </record>
    <record id="cat_procedure" model="healthcare.pos.category">
        <field name="name">Procedure</field>
        <field name="icon">scissors</field>
        <field name="color">#0891b2</field>
        <field name="sequence">6</field>
    </record>

    <!-- ============ SAMPLE SERVICES ============ -->
    <record id="svc_gp" model="healthcare.pos.service">
        <field name="name">General Consultation</field>
        <field name="category_id" ref="cat_consultation"/>
        <field name="service_type">consultation</field>
        <field name="list_price">300.0</field>
    </record>
    <record id="svc_specialist" model="healthcare.pos.service">
        <field name="name">Specialist Consultation</field>
        <field name="category_id" ref="cat_consultation"/>
        <field name="service_type">consultation</field>
        <field name="list_price">700.0</field>
    </record>
    <record id="svc_followup" model="healthcare.pos.service">
        <field name="name">Follow-up Visit</field>
        <field name="category_id" ref="cat_consultation"/>
        <field name="service_type">consultation</field>
        <field name="list_price">150.0</field>
    </record>

    <record id="svc_cbc" model="healthcare.pos.service">
        <field name="name">Complete Blood Count (CBC)</field>
        <field name="category_id" ref="cat_laboratory"/>
        <field name="service_type">lab</field>
        <field name="list_price">250.0</field>
    </record>
    <record id="svc_lipid" model="healthcare.pos.service">
        <field name="name">Lipid Profile</field>
        <field name="category_id" ref="cat_laboratory"/>
        <field name="service_type">lab</field>
        <field name="list_price">450.0</field>
    </record>
    <record id="svc_sugar" model="healthcare.pos.service">
        <field name="name">Blood Sugar (Fasting)</field>
        <field name="category_id" ref="cat_laboratory"/>
        <field name="service_type">lab</field>
        <field name="list_price">120.0</field>
    </record>

    <record id="svc_xray" model="healthcare.pos.service">
        <field name="name">X-Ray (Single View)</field>
        <field name="category_id" ref="cat_radiology"/>
        <field name="service_type">radiology</field>
        <field name="list_price">600.0</field>
    </record>
    <record id="svc_usg" model="healthcare.pos.service">
        <field name="name">Ultrasound (USG)</field>
        <field name="category_id" ref="cat_radiology"/>
        <field name="service_type">radiology</field>
        <field name="list_price">900.0</field>
    </record>

    <record id="svc_dressing" model="healthcare.pos.service">
        <field name="name">Wound Dressing</field>
        <field name="category_id" ref="cat_treatment"/>
        <field name="service_type">treatment</field>
        <field name="list_price">200.0</field>
    </record>
    <record id="svc_nebulization" model="healthcare.pos.service">
        <field name="name">Nebulization</field>
        <field name="category_id" ref="cat_treatment"/>
        <field name="service_type">treatment</field>
        <field name="list_price">180.0</field>
    </record>

    <record id="svc_injection" model="healthcare.pos.service">
        <field name="name">IM / IV Injection</field>
        <field name="category_id" ref="cat_procedure"/>
        <field name="service_type">procedure</field>
        <field name="list_price">100.0</field>
    </record>
    <record id="svc_suture" model="healthcare.pos.service">
        <field name="name">Suturing (Minor)</field>
        <field name="category_id" ref="cat_procedure"/>
        <field name="service_type">procedure</field>
        <field name="list_price">800.0</field>
    </record>

    <!-- ============ DEFAULT POS CONFIG ============ -->
    <record id="pos_config_main" model="healthcare.pos.config">
        <field name="name">Main Reception POS</field>
        <field name="pos_type">reception</field>
        <field name="payment_method_ids" eval="[(6, 0, [
            ref('pm_cash'), ref('pm_card'), ref('pm_upi'), ref('pm_insurance')])]"/>
        <field name="allow_create_patient" eval="True"/>
        <field name="require_patient" eval="True"/>
        <field name="generate_billing" eval="True"/>
        <field name="generate_clinical_records" eval="True"/>
    </record>

    <record id="pos_config_clinic" model="healthcare.pos.config">
        <field name="name">Clinic POS</field>
        <field name="pos_type">clinic</field>
        <field name="sequence">20</field>
        <field name="payment_method_ids" eval="[(6, 0, [
            ref('pm_cash'), ref('pm_card'), ref('pm_upi'), ref('pm_insurance')])]"/>
        <field name="require_patient" eval="True"/>
        <field name="generate_billing" eval="True"/>
        <field name="generate_clinical_records" eval="True"/>
    </record>

    <record id="pos_config_pharmacy" model="healthcare.pos.config">
        <field name="name">Pharmacy POS</field>
        <field name="pos_type">pharmacy</field>
        <field name="sequence">30</field>
        <field name="payment_method_ids" eval="[(6, 0, [
            ref('pm_cash'), ref('pm_card'), ref('pm_upi'), ref('pm_insurance')])]"/>
        <field name="require_patient" eval="False"/>
        <field name="generate_billing" eval="True"/>
        <field name="generate_clinical_records" eval="False"/>
    </record>

    <record id="pos_config_laboratory" model="healthcare.pos.config">
        <field name="name">Laboratory POS</field>
        <field name="pos_type">laboratory</field>
        <field name="sequence">40</field>
        <field name="payment_method_ids" eval="[(6, 0, [
            ref('pm_cash'), ref('pm_card'), ref('pm_upi'), ref('pm_insurance')])]"/>
        <field name="require_patient" eval="True"/>
        <field name="generate_billing" eval="True"/>
        <field name="generate_clinical_records" eval="True"/>
    </record>

    <record id="pos_config_emergency" model="healthcare.pos.config">
        <field name="name">Emergency POS</field>
        <field name="pos_type">emergency</field>
        <field name="sequence">50</field>
        <field name="payment_method_ids" eval="[(6, 0, [
            ref('pm_cash'), ref('pm_card'), ref('pm_upi'), ref('pm_insurance')])]"/>
        <field name="require_patient" eval="False"/>
        <field name="generate_billing" eval="True"/>
        <field name="generate_clinical_records" eval="True"/>
    </record>

</odoo>
