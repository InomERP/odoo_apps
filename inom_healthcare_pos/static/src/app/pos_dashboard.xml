<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="inom_healthcare_pos.Dashboard">
        <div class="o_hcpos_dashboard">

            <!-- Header -->
            <div class="o_hcpos_dash_header">
                <div class="o_hcpos_dash_title">
                    <i class="fa fa-heartbeat"/> Healthcare Point of Sale
                </div>
                <button class="o_hcpos_btn_new" t-on-click="() => this.newConfig()">
                    <i class="fa fa-plus"/> New POS
                </button>
            </div>

            <!-- Loading -->
            <div t-if="state.loading" class="o_hcpos_dash_state">
                <i class="fa fa-circle-o-notch fa-spin"/>
                <p>Loading point of sale terminals…</p>
            </div>

            <!-- Empty -->
            <div t-elif="!state.cards.length" class="o_hcpos_dash_state">
                <i class="fa fa-shopping-basket o_big"/>
                <p>No Point of Sale terminals yet.</p>
                <button class="o_hcpos_btn_new" t-on-click="() => this.newConfig()">
                    <i class="fa fa-plus"/> Create your first POS
                </button>
            </div>

            <!-- Card grid -->
            <div t-else="" class="o_hcpos_dash_grid">
                <t t-foreach="state.cards" t-as="card" t-key="card.id">
                    <div class="o_hcpos_card" t-att-class="{ 'o_is_open': card.is_open }">

                        <!-- Top: name + kebab -->
                        <div class="o_hcpos_card_top">
                            <div class="o_hcpos_card_name" t-on-click="() => this.openPos(card)">
                                <span class="o_hcpos_type_ico"
                                      t-att-style="'background:' + card.pos_type_color">
                                    <i class="fa" t-att-class="card.pos_type_icon"/>
                                </span>
                                <t t-esc="card.name"/>
                            </div>
                            <div class="o_hcpos_kebab">
                                <button class="o_hcpos_kebab_btn"
                                        t-on-click="() => this.toggleMenu(card.id)">
                                    <i class="fa fa-ellipsis-v"/>
                                </button>
                                <div class="o_hcpos_kebab_menu" t-if="state.menuOpenId === card.id">
                                    <a t-on-click="() => this.viewOrders(card)">
                                        <i class="fa fa-list-ul"/> Orders
                                        <span class="o_count" t-esc="card.order_count"/>
                                    </a>
                                    <a t-on-click="() => this.viewSessions(card)">
                                        <i class="fa fa-history"/> Sessions
                                        <span class="o_count" t-esc="card.session_count"/>
                                    </a>
                                    <a t-on-click="() => this.editConfig(card)">
                                        <i class="fa fa-cog"/> Settings
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Meta chips: company / branch / currency -->
                        <div class="o_hcpos_card_meta">
                            <span class="o_hcpos_chip o_type"
                                  t-att-style="'color:' + card.pos_type_color + ';background:' + card.pos_type_color + '1a'">
                                <i class="fa" t-att-class="card.pos_type_icon"/> <t t-esc="card.pos_type_label"/>
                            </span>
                            <span class="o_hcpos_chip">
                                <i class="fa fa-building-o"/> <t t-esc="card.company"/>
                            </span>
                            <span class="o_hcpos_chip" t-if="card.branch">
                                <i class="fa fa-map-marker"/> <t t-esc="card.branch"/>
                            </span>
                            <span class="o_hcpos_chip o_cur">
                                <i class="fa fa-money"/> <t t-esc="card.currency_name"/>
                            </span>
                        </div>

                        <!-- Status -->
                        <div class="o_hcpos_card_status">
                            <t t-if="card.is_open">
                                <div class="o_hcpos_status_badge o_open">
                                    <span class="o_dot"/> Opened
                                    <t t-if="card.opened_by"> · <t t-esc="card.opened_by"/></t>
                                </div>
                                <div class="o_hcpos_status_line">
                                    <i class="fa fa-shopping-cart"/>
                                    <t t-esc="card.session_orders"/> orders this session
                                </div>
                                <div class="o_hcpos_status_line" t-if="card.started">
                                    <i class="fa fa-clock-o"/> Since <t t-esc="card.started.slice(0, 16)"/>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="o_hcpos_status_badge o_closed">
                                    <span class="o_dot"/> Closed
                                </div>
                                <div class="o_hcpos_status_line" t-if="card.last_closing_date">
                                    <i class="fa fa-clock-o"/> Last closed <t t-esc="card.last_closing_date.slice(0, 16)"/>
                                </div>
                                <div class="o_hcpos_status_line">
                                    <i class="fa fa-list-ul"/> <t t-esc="card.order_count"/> orders total
                                </div>
                            </t>
                        </div>

                        <!-- Primary action -->
                        <button class="o_hcpos_card_btn"
                                t-att-class="card.is_open ? 'o_continue' : 'o_new'"
                                t-on-click="() => this.openPos(card)">
                            <t t-if="card.is_open">
                                <i class="fa fa-shopping-cart"/> Continue Selling
                            </t>
                            <t t-else="">
                                <i class="fa fa-play"/> New Session
                            </t>
                        </button>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
