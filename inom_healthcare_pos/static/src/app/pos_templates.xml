<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- ================= ROOT ================= -->
<t t-name="inom_healthcare_pos.App">
    <div class="o_hcpos">
        <t t-if="state.screen === 'loading'">
            <div class="o_hcpos_loading">
                <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
                <span>Loading Point of Sale…</span>
            </div>
        </t>

        <t t-elif="state.screen === 'config'">
            <ConfigScreen store="store"/>
        </t>

        <t t-else="">
            <!-- Top bar -->
            <div class="o_hcpos_topbar">
                <div class="o_hcpos_brand">
                    <i class="fa fa-plus-square"/>
                    <span class="o_hcpos_brand_name">Healthcare POS</span>
                    <span class="o_hcpos_terminal" t-esc="state.config.name"/>
                    <span class="o_hcpos_typebadge"
                          t-att-style="'background:' + state.config.pos_type_color">
                        <i class="fa" t-att-class="state.config.pos_type_icon"/>
                        <t t-esc="state.config.pos_type_label"/>
                    </span>
                </div>
                <div class="o_hcpos_topinfo">
                    <span t-if="state.config.campus" class="o_hcpos_chip">
                        <i class="fa fa-map-marker"/> <t t-esc="state.config.campus"/>
                    </span>
                    <span class="o_hcpos_chip">
                        <i class="fa fa-building-o"/> <t t-esc="state.company.name"/>
                    </span>
                    <span class="o_hcpos_chip">
                        <i class="fa fa-money"/> <t t-esc="state.currency.name"/>
                    </span>
                    <span t-if="state.session" class="o_hcpos_chip o_hcpos_chip_live">
                        <i class="fa fa-circle"/> <t t-esc="state.session.name"/>
                    </span>
                    <button class="o_hcpos_exit" t-on-click="exit" title="Back to terminals">
                        <i class="fa fa-sign-out"/>
                    </button>
                </div>
            </div>

            <div class="o_hcpos_body">
                <t t-if="state.screen === 'opening'"><OpeningScreen store="store"/></t>
                <t t-if="state.screen === 'product'"><ProductScreen store="store"/></t>
                <t t-if="state.screen === 'payment'"><PaymentScreen store="store"/></t>
                <t t-if="state.screen === 'receipt'"><ReceiptScreen store="store"/></t>
                <t t-if="state.screen === 'closing'"><ClosingScreen store="store"/></t>
            </div>

            <t t-if="state.patientModalOpen"><PatientModal store="store"/></t>
        </t>
    </div>
</t>

<!-- ================= CONFIG PICKER ================= -->
<t t-name="inom_healthcare_pos.ConfigScreen">
    <div class="o_hcpos_config">
        <div class="o_hcpos_config_head">
            <h1>Healthcare Point of Sale</h1>
            <p>Select a terminal to open a session. Each terminal runs independently — its own branch, company and currency — so several can be live at once.</p>
        </div>
        <div class="o_hcpos_config_grid">
            <div class="o_hcpos_config_card" t-foreach="store.configList" t-as="cfg" t-key="cfg.id"
                 t-on-click="() => store.loadConfig(cfg.id)">
                <div class="o_hcpos_config_icon"><i class="fa fa-desktop"/></div>
                <div class="o_hcpos_config_name" t-esc="cfg.name"/>
                <div class="o_hcpos_config_meta">
                    <span t-if="cfg.company_id"><i class="fa fa-building-o"/> <t t-esc="cfg.company_id[1]"/></span>
                    <span t-if="cfg.currency_id"><i class="fa fa-money"/> <t t-esc="cfg.currency_id[1]"/></span>
                </div>
                <div class="o_hcpos_config_state"
                     t-att-class="cfg.current_session_state === 'opened' ? 'is_open' : ''">
                    <t t-if="cfg.current_session_state === 'opened'">Session in progress</t>
                    <t t-else="">Closed</t>
                </div>
            </div>
            <div t-if="!store.configList.length" class="o_hcpos_empty">
                No POS terminals configured yet. Create one under Healthcare POS &gt; Configuration &gt; Terminals.
            </div>
        </div>
    </div>
</t>

<!-- ================= OPENING ================= -->
<t t-name="inom_healthcare_pos.OpeningScreen">
    <div class="o_hcpos_centered">
        <div class="o_hcpos_panel">
            <h2><i class="fa fa-unlock-alt"/> Opening Control</h2>
            <p class="o_hcpos_muted">Confirm the cash float in the drawer before you start selling.</p>
            <label>Opening cash balance</label>
            <div class="o_hcpos_money_input">
                <span t-esc="store.currency.symbol"/>
                <input type="number" step="0.01" t-model.number="store.openingBalance"/>
            </div>
            <button class="o_hcpos_btn o_hcpos_btn_primary o_hcpos_btn_block"
                    t-on-click="() => store.openSession()">
                <i class="fa fa-play"/> Open Session
            </button>
        </div>
    </div>
</t>

<!-- ================= PRODUCT (MAIN) ================= -->
<t t-name="inom_healthcare_pos.ProductScreen">
    <div class="o_hcpos_main">
        <!-- LEFT: cart -->
        <div class="o_hcpos_cart">
            <div class="o_hcpos_patientbar">
                <button class="o_hcpos_patientbtn" t-on-click="() => store.openPatientModal()">
                    <i class="fa fa-user"/>
                    <span t-if="store.order.patient">
                        <t t-esc="store.order.patient.name"/>
                        <small t-if="store.order.patient.ref" t-esc="' · ' + store.order.patient.ref"/>
                    </span>
                    <span t-else="">Select Patient</span>
                </button>
                <button t-if="store.order.patient" class="o_hcpos_iconbtn"
                        t-on-click="() => store.clearPatient()" title="Remove patient">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <div class="o_hcpos_doctorbar" t-if="store.features.show_doctor">
                <i class="fa fa-stethoscope"/>
                <select t-on-change="(ev) => store.setDoctor(ev.target.value)">
                    <option value="">— No doctor —</option>
                    <option t-foreach="store.doctors" t-as="doc" t-key="doc.id"
                            t-att-value="doc.id"
                            t-att-selected="store.order.doctor and store.order.doctor.id === doc.id">
                        <t t-esc="doc.name"/>
                        <t t-if="doc.specialization" t-esc="' (' + doc.specialization + ')'"/>
                    </option>
                </select>
            </div>

            <div class="o_hcpos_lines">
                <div t-if="!store.order.lines.length" class="o_hcpos_emptycart">
                    <i class="fa fa-shopping-cart"/>
                    <span>No items yet. Tap a service to add it.</span>
                </div>
                <div t-foreach="store.order.lines" t-as="line" t-key="line.id"
                     class="o_hcpos_line"
                     t-att-class="store.order.selectedLineId === line.id ? 'is_selected' : ''"
                     t-on-click="() => store.selectLine(line.id)">
                    <div class="o_hcpos_line_main">
                        <div class="o_hcpos_line_name" t-esc="line.name"/>
                        <div class="o_hcpos_line_sub">
                            <t t-esc="line.qty"/> ×
                            <t t-esc="store.fmt(line.priceUnit)"/>
                            <span t-if="line.discount"> · -<t t-esc="line.discount"/>%</span>
                        </div>
                    </div>
                    <div class="o_hcpos_line_total" t-esc="store.fmt(store.lineTotal(line))"/>
                    <button class="o_hcpos_line_del"
                            t-on-click.stop="() => store.removeLine(line.id)">
                        <i class="fa fa-trash-o"/>
                    </button>
                </div>
            </div>

            <div class="o_hcpos_totals">
                <div class="o_hcpos_total_row">
                    <span>Subtotal</span><span t-esc="store.fmt(store.amountUntaxed)"/>
                </div>
                <div class="o_hcpos_total_row">
                    <span>Tax</span><span t-esc="store.fmt(store.amountTax)"/>
                </div>
                <div class="o_hcpos_total_row o_hcpos_grand">
                    <span>Total</span><span t-esc="store.fmt(store.amountTotal)"/>
                </div>
            </div>

            <!-- numpad -->
            <div class="o_hcpos_numpad">
                <div class="o_hcpos_numpad_modes">
                    <button t-att-class="store.numpadMode === 'qty' ? 'active' : ''"
                            t-on-click="() => store.setNumpadMode('qty')">Qty</button>
                    <button t-att-class="store.numpadMode === 'price' ? 'active' : ''"
                            t-on-click="() => store.setNumpadMode('price')">Price</button>
                    <button t-att-class="store.numpadMode === 'disc' ? 'active' : ''"
                            t-on-click="() => store.setNumpadMode('disc')">Disc%</button>
                </div>
                <div class="o_hcpos_numpad_keys">
                    <button t-foreach="numpadKeys" t-as="key" t-key="key"
                            t-on-click="() => store.numpadInput(key)">
                        <t t-if="key === 'backspace'"><i class="fa fa-long-arrow-left"/></t>
                        <t t-else="" t-esc="key"/>
                    </button>
                </div>
            </div>

            <button class="o_hcpos_btn o_hcpos_btn_primary o_hcpos_btn_pay"
                    t-on-click="() => store.goToPayment()">
                <span><i class="fa fa-credit-card"/> Payment</span>
                <span t-esc="store.fmt(store.amountTotal)"/>
            </button>
        </div>

        <!-- RIGHT: catalogue -->
        <div class="o_hcpos_catalogue">
            <div class="o_hcpos_workflowbar" t-if="store.workflowActions.length">
                <button t-foreach="store.workflowActions" t-as="wf" t-key="wf.key"
                        class="o_hcpos_wfbtn"
                        t-on-click="() => store.runWorkflowAction(wf)">
                    <i class="fa" t-att-class="wf.icon"/>
                    <span t-esc="wf.label"/>
                </button>
            </div>
            <div class="o_hcpos_search">
                <i class="fa fa-search"/>
                <input type="text" placeholder="Search services…" t-model="store.searchTerm"/>
            </div>
            <div class="o_hcpos_cats">
                <button t-foreach="store.categories" t-as="cat" t-key="cat.id"
                        class="o_hcpos_cat"
                        t-att-class="store.activeCategoryId === cat.id ? 'active' : ''"
                        t-att-style="store.activeCategoryId === cat.id ? ('background:' + cat.color + ';border-color:' + cat.color) : ''"
                        t-on-click="() => store.activeCategoryId = cat.id">
                    <i t-att-class="'fa fa-' + cat.icon"/>
                    <span t-esc="cat.name"/>
                </button>
            </div>
            <div class="o_hcpos_products">
                <div t-foreach="store.visibleServices" t-as="svc" t-key="svc.id"
                     class="o_hcpos_product" t-on-click="() => store.addService(svc)">
                    <div class="o_hcpos_product_icon"
                         t-att-style="'color:' + (svc.color || '#0d9488')">
                        <i t-att-class="'fa fa-' + iconFor(svc.service_type)"/>
                    </div>
                    <div class="o_hcpos_product_name" t-esc="svc.name"/>
                    <div class="o_hcpos_product_foot">
                        <span class="o_hcpos_product_price" t-esc="store.fmt(svc.price)"/>
                        <span t-if="svc.track_stock and svc.stock !== false"
                              class="o_hcpos_stock"
                              t-att-class="svc.stock &lt;= 0 ? 'out' : ''">
                            <i class="fa fa-cubes"/> <t t-esc="svc.stock"/>
                        </span>
                    </div>
                </div>
                <div t-if="!store.visibleServices.length" class="o_hcpos_empty">
                    No services in this category.
                </div>
            </div>
        </div>
    </div>
</t>

<!-- ================= PAYMENT ================= -->
<t t-name="inom_healthcare_pos.PaymentScreen">
    <div class="o_hcpos_payment">
        <div class="o_hcpos_pay_left">
            <button class="o_hcpos_back" t-on-click="() => store.screen = 'product'">
                <i class="fa fa-angle-left"/> Back to order
            </button>
            <h3>Tender</h3>
            <div class="o_hcpos_methods">
                <button t-foreach="store.paymentMethods" t-as="m" t-key="m.id"
                        class="o_hcpos_method" t-on-click="() => store.addPayment(m)">
                    <i t-att-class="'fa fa-' + m.icon"/>
                    <span t-esc="m.name"/>
                </button>
            </div>

            <div class="o_hcpos_paylines">
                <div t-foreach="store.payments" t-as="p" t-key="p_index" class="o_hcpos_payline">
                    <span class="o_hcpos_payline_name" t-esc="p.name"/>
                    <div class="o_hcpos_money_input small">
                        <span t-esc="store.currency.symbol"/>
                        <input type="number" step="0.01" t-model.number="p.amount"/>
                    </div>
                    <button class="o_hcpos_iconbtn" t-on-click="() => store.removePayment(p_index)">
                        <i class="fa fa-times"/>
                    </button>
                </div>
                <div t-if="!store.payments.length" class="o_hcpos_muted o_hcpos_pad">
                    Choose a payment method to begin.
                </div>
            </div>
        </div>

        <div class="o_hcpos_pay_right">
            <div class="o_hcpos_pay_summary">
                <div class="o_hcpos_pay_patient" t-if="store.order.patient">
                    <i class="fa fa-user"/> <t t-esc="store.order.patient.name"/>
                </div>
                <div class="o_hcpos_pay_row">
                    <span>Total Due</span><strong t-esc="store.fmt(store.amountTotal)"/>
                </div>
                <div class="o_hcpos_pay_row">
                    <span>Paid</span><span t-esc="store.fmt(store.amountPaid)"/>
                </div>
                <div class="o_hcpos_pay_row" t-if="store.amountDue &gt; 0.0001">
                    <span>Remaining</span><span class="o_hcpos_due" t-esc="store.fmt(store.amountDue)"/>
                </div>
                <div class="o_hcpos_pay_row" t-if="store.changeDue &gt; 0.0001">
                    <span>Change</span><span class="o_hcpos_change" t-esc="store.fmt(store.changeDue)"/>
                </div>
            </div>
            <button class="o_hcpos_btn o_hcpos_btn_primary o_hcpos_btn_block o_hcpos_validate"
                    t-att-disabled="store.amountPaid + 0.0001 &lt; store.amountTotal"
                    t-on-click="() => store.validateOrder()">
                <i class="fa fa-check-circle"/> Validate
            </button>
        </div>
    </div>
</t>

<!-- =================================================================
     RECEIPT  —  exact replica of Odoo's point_of_sale.OrderReceipt
     (same QWeb structure, same classes, same Bootstrap utilities),
     bound to this module's `store.receipt` data.
     ================================================================= -->
<t t-name="inom_healthcare_pos.ReceiptScreen">
    <div class="o_hcpos_centered">
        <div class="o_hcpos_receipt_wrapper">

            <!-- printable receipt -->
            <div class="pos-receipt-container">
                <div class="pos-receipt p-2">

                    <!-- ============ ReceiptHeader ============ -->
                    <img t-if="store.company.logo" t-att-src="store.company.logo"
                         alt="Logo" class="pos-receipt-logo"/>
                    <div class="text-center pt-3" style="font-size: 75%;">
                        <span class="pos-receipt-vat">
                            <span class="ticket-name-prefix">Ticket</span>
                            <t t-out="store.receipt.name"/>
                        </span>
                        <div t-if="store.receipt.date_order" id="order-date"
                             t-out="store.receipt.date_order"/>
                    </div>
                    <div class="d-flex flex-column align-items-center">
                        <div class="pos-receipt-contact">
                            <div class="cashier">
                                <div>Served by: <t t-esc="store.receipt.cashier"/></div>
                            </div>
                        </div>
                        <div t-if="store.receipt.patient" class="pos-receipt-customer mt-2">
                            <div>
                                <span t-esc="store.receipt.patient"/>
                                <t t-if="store.receipt.patient_ref"> (<t t-esc="store.receipt.patient_ref"/>)</t>
                            </div>
                            <div t-if="store.receipt.doctor">Doctor: <t t-esc="store.receipt.doctor"/></div>
                        </div>
                    </div>

                    <div class="pt-3"/>

                    <!-- ============ Order lines ============ -->
                    <ul class="orderlines list-unstyled mb-0">
                        <t t-foreach="store.receipt.lines" t-as="line" t-key="line_index">
                            <li class="orderline">
                                <div class="d-flex flex-column w-100">
                                    <div class="line-details d-flex justify-content-between align-items-center">
                                        <div class="product-name d-flex flex-grow-1 pe-2 text-truncate align-items-center">
                                            <span class="qty d-inline-block fw-bolder pe-2" t-esc="line.qty"/>
                                            <span class="text-wrap d-inline" t-esc="line.name"/>
                                        </div>
                                        <div class="product-price price font-monospace"
                                             t-out="store.fmt(line.total)"/>
                                    </div>
                                    <ul class="info-list d-flex flex-column mb-0 ms-2" style="font-size: 75%;">
                                        <li class="price-per-unit">
                                            <t t-out="store.fmt(line.price_unit)"/> / Units
                                        </li>
                                        <li t-if="line.discount" class="price-per-unit">
                                            <i class="fa fa-tag pe-1"/><em><t t-esc="line.discount"/>% </em>
                                            discount off on <t t-out="store.fmt(line.price_unit * line.qty)"/>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                        </t>
                    </ul>

                    <!-- ============ Taxes / Totals ============ -->
                    <div class="pos-receipt-taxes pt-3">
                        <div class="d-flex">
                            <span class="text-nowrap mw-100">Subtotal</span>
                            <span t-out="store.fmt(store.receipt.amount_untaxed)" class="ms-auto font-monospace"/>
                        </div>
                        <div t-if="store.receipt.amount_tax" class="d-flex">
                            <span>Taxes</span>
                            <span t-out="store.fmt(store.receipt.amount_tax)" class="ms-auto font-monospace"/>
                        </div>
                    </div>

                    <div class="pos-receipt-amount receipt-total fw-bolder">
                        <span class="label-total">Total</span>
                        <span t-out="store.fmt(store.receipt.amount_total)" class="pos-receipt-right-align font-monospace"/>
                    </div>

                    <!-- ============ Payment lines ============ -->
                    <t t-set="paid" t-value="store.receipt.payments.reduce((s, p) => s + p.amount, 0)"/>
                    <div class="paymentlines text-start pt-1" t-foreach="store.receipt.payments" t-as="line" t-key="line_index">
                        <t t-esc="line.method"/>
                        <span t-out="store.fmt(line.amount)" class="pos-receipt-right-align font-monospace"/>
                    </div>

                    <div t-if="(paid - store.receipt.amount_total) &gt; 0.0001" class="pos-receipt-amount receipt-change">
                        <span class="label-change">Change</span>
                        <span t-out="store.fmt(paid - store.receipt.amount_total)" class="pos-receipt-right-align font-monospace"/>
                    </div>

                    <div t-if="store.receipt.bill_ref" class="text-start">
                        <span>Bill</span>
                        <span t-out="store.receipt.bill_ref" class="pos-receipt-right-align font-monospace"/>
                    </div>

                    <!-- handle xpath using before-footer! -->
                    <div class="before-footer"/>

                    <!-- Footer -->
                    <div t-if="store.config and store.config.receipt_footer"
                         class="pos-receipt-center-align pt-3 text-center" style="white-space:pre-line">
                        <t t-esc="store.config.receipt_footer"/>
                    </div>

                    <div class="after-footer"/>

                    <!-- Company address (two-column, like Odoo) -->
                    <div class="d-flex gap-2 pt-3">
                        <div class="w-50 text-break text-start" style="font-size: 75%;">
                            <div class="pos-config-name" t-out="store.config and store.config.name"/>
                            <div>
                                <t t-if="store.company.street" t-out="store.company.street"/>
                                <t t-if="store.company.city" t-out="', ' + store.company.city"/>
                                <t t-if="store.company.state_code" t-out="', ' + store.company.state_code"/>
                                <t t-if="store.company.zip" t-out="', ' + store.company.zip"/>
                            </div>
                        </div>
                        <div class="w-50 text-break text-end" style="font-size: 75%;">
                            <div>
                                <div t-if="store.company.vat">VAT: <t t-out="store.company.vat"/></div>
                                <div t-if="store.company.phone">
                                    Tel: <span dir="ltr"><t t-out="store.company.phone"/></span>
                                </div>
                                <div t-if="store.company.email" t-out="store.company.email"/>
                                <div t-if="store.company.website" t-out="store.company.website"/>
                            </div>
                        </div>
                    </div>

                    <div class="pos-receipt-order-data text-center pt-3 footer-powered-by">
                        <span>Powered by <b> Odoo </b></span>
                    </div>
                </div>
            </div>

            <!-- on-screen actions (never printed) -->
            <div class="o_hcpos_receipt_actions">
                <button class="o_hcpos_btn" t-on-click="print"><i class="fa fa-print"/> Print</button>
                <button class="o_hcpos_btn o_hcpos_btn_primary" t-on-click="() => store.newOrder()">
                    <i class="fa fa-plus"/> New Order
                </button>
            </div>
        </div>
    </div>
</t>

<!-- ================= CLOSING ================= -->
<t t-name="inom_healthcare_pos.ClosingScreen">
    <div class="o_hcpos_centered">
        <div class="o_hcpos_panel">
            <h2><i class="fa fa-flag-checkered"/> Session Closed</h2>
            <div class="o_hcpos_closesummary">
                <div><span>Session</span><b t-esc="store.closingReport.name"/></div>
                <div><span>Orders</span><b t-esc="store.closingReport.order_count"/></div>
                <div><span>Total Sales</span><b t-esc="store.fmt(store.closingReport.total_sales)"/></div>
                <div><span>Opening Cash</span><b t-esc="store.fmt(store.closingReport.opening_balance)"/></div>
                <div><span>Cash Sales</span><b t-esc="store.fmt(store.closingReport.cash_sales)"/></div>
                <div><span>Expected Cash</span><b t-esc="store.fmt(store.closingReport.theoretical_cash)"/></div>
                <div><span>Counted Cash</span><b t-esc="store.fmt(store.closingReport.closing_balance)"/></div>
                <div class="diff" t-att-class="Math.abs(store.closingReport.cash_difference) &gt; 0.0001 ? 'bad' : 'ok'">
                    <span>Difference</span><b t-esc="store.fmt(store.closingReport.cash_difference)"/>
                </div>
            </div>
            <button class="o_hcpos_btn o_hcpos_btn_primary o_hcpos_btn_block" t-on-click="() => store.loadConfigList()">
                <i class="fa fa-th-large"/> Back to Terminals
            </button>
        </div>
    </div>
</t>

<!-- ================= PATIENT MODAL ================= -->
<t t-name="inom_healthcare_pos.PatientModal">
    <div class="o_hcpos_modal_backdrop" t-on-click.self="() => store.closePatientModal()">
        <div class="o_hcpos_modal">
            <div class="o_hcpos_modal_head">
                <h3 t-if="!store.patientCreateMode"><i class="fa fa-users"/> Select Patient</h3>
                <h3 t-else=""><i class="fa fa-user-plus"/> New Patient</h3>
                <button class="o_hcpos_iconbtn" t-on-click="() => store.closePatientModal()">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <!-- SELECT MODE -->
            <t t-if="!store.patientCreateMode">
                <div class="o_hcpos_modal_search">
                    <i class="fa fa-search"/>
                    <input type="text" placeholder="Search name, ID or phone…"
                           t-model="store.patientSearch"/>
                    <button t-if="store.config.allow_create_patient"
                            class="o_hcpos_btn o_hcpos_btn_primary"
                            t-on-click="() => store.patientCreateMode = true">
                        <i class="fa fa-plus"/> New
                    </button>
                </div>
                <div class="o_hcpos_patientlist">
                    <div t-foreach="store.filteredPatients" t-as="p" t-key="p.id"
                         class="o_hcpos_patientrow" t-on-click="() => store.selectPatient(p)">
                        <div class="o_hcpos_avatar"><i class="fa fa-user"/></div>
                        <div class="o_hcpos_patientinfo">
                            <div class="o_hcpos_patientname" t-esc="p.name"/>
                            <div class="o_hcpos_patientmeta">
                                <span t-if="p.ref" t-esc="p.ref"/>
                                <span t-if="p.phone"><i class="fa fa-phone"/> <t t-esc="p.phone"/></span>
                                <span t-if="p.gender" t-esc="p.gender"/>
                            </div>
                        </div>
                        <i class="fa fa-angle-right"/>
                    </div>
                    <div t-if="!store.filteredPatients.length" class="o_hcpos_empty">
                        No matching patients.
                    </div>
                </div>
            </t>

            <!-- CREATE MODE -->
            <t t-else="">
                <div class="o_hcpos_form">
                    <label>Full name *</label>
                    <input type="text" t-model="store.newPatient.name" placeholder="Patient name"/>
                    <div class="o_hcpos_form_row">
                        <div>
                            <label>Phone</label>
                            <input type="text" t-model="store.newPatient.phone"/>
                        </div>
                        <div>
                            <label>Email</label>
                            <input type="text" t-model="store.newPatient.email"/>
                        </div>
                    </div>
                    <div class="o_hcpos_form_row">
                        <div>
                            <label>Gender</label>
                            <select t-model="store.newPatient.gender">
                                <option value="">—</option>
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div>
                            <label>Age</label>
                            <input type="number" t-model.number="store.newPatient.age"/>
                        </div>
                        <div>
                            <label>Blood group</label>
                            <select t-model="store.newPatient.blood_group">
                                <option value="">—</option>
                                <option value="a+">A+</option><option value="a-">A-</option>
                                <option value="b+">B+</option><option value="b-">B-</option>
                                <option value="o+">O+</option><option value="o-">O-</option>
                                <option value="ab+">AB+</option><option value="ab-">AB-</option>
                            </select>
                        </div>
                    </div>
                    <label>Address</label>
                    <textarea t-model="store.newPatient.address" rows="2"/>
                    <div class="o_hcpos_form_actions">
                        <button class="o_hcpos_btn" t-on-click="() => store.patientCreateMode = false">Cancel</button>
                        <button class="o_hcpos_btn o_hcpos_btn_primary" t-on-click="() => store.createPatient()">
                            <i class="fa fa-check"/> Create &amp; Select
                        </button>
                    </div>
                </div>
            </t>
        </div>
    </div>
</t>

</templates>
