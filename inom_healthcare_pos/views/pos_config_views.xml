<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_pos_config_list" model="ir.ui.view">
        <field name="name">healthcare.pos.config.list</field>
        <field name="model">healthcare.pos.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="pos_type"/>
                <field name="campus_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id"/>
                <field name="current_session_state"/>
                <field name="session_count"/>
                <field name="order_count"/>
            </tree>
        </field>
    </record>

    <record id="view_pos_config_form" model="ir.ui.view">
        <field name="name">healthcare.pos.config.form</field>
        <field name="model">healthcare.pos.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="open_session_cb" type="object" string="Open POS"
                            class="btn-primary" icon="fa-play"/>
                    <button name="action_sync_pharmacy_services" type="object"
                            string="Sync Pharmacy" icon="fa-refresh"/>
                    <field name="current_session_state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sessions" type="object"
                                class="oe_stat_button" icon="fa-clock-o">
                            <field name="session_count" widget="statinfo" string="Sessions"/>
                        </button>
                        <button name="action_view_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Main Reception POS"/></h1>
                        <field name="pos_type"/>
                    </div>
                    <group>
                        <group string="Branch / Company">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="campus_id"/>
                            <field name="location_note"/>
                            <field name="active"/>
                        </group>
                        <group string="Behaviour">
                            <field name="allow_create_patient"/>
                            <field name="require_patient"/>
                            <field name="generate_billing"/>
                            <field name="generate_clinical_records"/>
                            <field name="set_opening_balance"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Catalogue &amp; Tenders">
                            <group>
                                <field name="category_ids" widget="many2many_tags"
                                       placeholder="Empty = all categories"/>
                                <field name="payment_method_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_config" model="ir.actions.act_window">
        <field name="name">Point of Sale</field>
        <field name="res_model">healthcare.pos.config</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
