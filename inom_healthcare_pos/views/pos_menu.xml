<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- The custom POS UI (OWL client action) -->
    <record id="action_healthcare_pos_app" model="ir.actions.client">
        <field name="name">Healthcare POS</field>
        <field name="tag">inom_healthcare_pos.app</field>
    </record>

    <!-- The Odoo-POS-style dashboard / session launcher (OWL client action) -->
    <record id="action_healthcare_pos_dashboard" model="ir.actions.client">
        <field name="name">Point of Sale</field>
        <field name="tag">inom_healthcare_pos.dashboard</field>
    </record>

    <!-- ================= MENUS ================= -->
    <menuitem id="menu_healthcare_pos_root"
              name="Healthcare POS"
              web_icon="inom_healthcare_pos,static/description/icon.png"
              sequence="6"/>

    <!-- Odoo-POS-style dashboard: grid of terminal cards -->
    <menuitem id="menu_pos_dashboard"
              name="Point of Sale"
              parent="menu_healthcare_pos_root"
              action="action_healthcare_pos_dashboard"
              sequence="1"/>

    <menuitem id="menu_pos_orders"
              name="Orders"
              parent="menu_healthcare_pos_root"
              sequence="10"/>
    <menuitem id="menu_pos_orders_orders"
              name="Orders"
              parent="menu_pos_orders"
              action="action_pos_order"
              sequence="1"/>
    <menuitem id="menu_pos_orders_sessions"
              name="Sessions"
              parent="menu_pos_orders"
              action="action_pos_session"
              sequence="2"/>

    <menuitem id="menu_pos_catalogue"
              name="Catalogue"
              parent="menu_healthcare_pos_root"
              sequence="20"/>
    <menuitem id="menu_pos_catalogue_services"
              name="Services"
              parent="menu_pos_catalogue"
              action="action_pos_service"
              sequence="1"/>
    <menuitem id="menu_pos_catalogue_categories"
              name="Categories"
              parent="menu_pos_catalogue"
              action="action_pos_category"
              sequence="2"/>

    <menuitem id="menu_pos_configuration"
              name="Configuration"
              parent="menu_healthcare_pos_root"
              sequence="30"
              groups="group_healthcare_pos_manager"/>
    <menuitem id="menu_pos_config_terminals"
              name="Terminals"
              parent="menu_pos_configuration"
              action="action_pos_config"
              sequence="1"/>
    <menuitem id="menu_pos_config_payment"
              name="Payment Methods"
              parent="menu_pos_configuration"
              action="action_pos_payment_method"
              sequence="2"/>

</odoo>
