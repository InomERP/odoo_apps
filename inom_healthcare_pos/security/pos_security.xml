<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="0">

    <!--
        Healthcare POS roles (Odoo 17 / 18).
        On these versions res.groups carries the module category directly via
        category_id (a many2one to ir.module.category); the res.groups.privilege
        model only exists from Odoo 19 onward. Additive only: granting these
        groups does not revoke any existing access.
    -->

    <!-- App category shown in Settings > Users -->
    <record id="module_category_healthcare_pos" model="ir.module.category">
        <field name="name">Healthcare POS</field>
        <field name="description">Roles for the custom Healthcare Point of Sale.</field>
        <field name="sequence">21</field>
    </record>

    <record id="group_healthcare_pos_user" model="res.groups">
        <field name="name">Healthcare POS / Cashier</field>
        <field name="category_id" ref="module_category_healthcare_pos"/>
        <field name="implied_ids" eval="[(4, ref('inom_healthcare_system.group_hospital_receptionist'))]"/>
    </record>

    <record id="group_healthcare_pos_manager" model="res.groups">
        <field name="name">Healthcare POS Manager</field>
        <field name="category_id" ref="module_category_healthcare_pos"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_pos_user')),
                                          (4, ref('inom_healthcare_system.group_hospital_billing'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- A cashier only sees / settles the sessions they personally opened. -->
    <record id="pos_session_own_rule" model="ir.rule">
        <field name="name">POS: cashier sees own sessions</field>
        <field name="model_id" ref="model_healthcare_pos_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_pos_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Managers see every session. -->
    <record id="pos_session_manager_rule" model="ir.rule">
        <field name="name">POS: manager sees all sessions</field>
        <field name="model_id" ref="model_healthcare_pos_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_pos_manager'))]"/>
    </record>

    <!-- Multi-company record rules -->
    <record id="pos_config_company_rule" model="ir.rule">
        <field name="name">POS Config: multi-company</field>
        <field name="model_id" ref="model_healthcare_pos_config"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="pos_order_company_rule" model="ir.rule">
        <field name="name">POS Order: multi-company</field>
        <field name="model_id" ref="model_healthcare_pos_order"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
