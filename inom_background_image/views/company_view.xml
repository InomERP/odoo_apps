<odoo>
	<record id="view_company_form_login_image_bg" model="ir.ui.view">
	    <field name="name">company.login.image.background</field>
	    <field name="model">res.company</field>
	    <field name="inherit_id" ref="base.view_company_form"/>
	    <field name="arch" type="xml">
	        <xpath expr="//sheet/notebook" position="inside">
	            <page string="Login Background">
	                <field name="login_background" widget="image"/>
	            </page>
	        </xpath>
	    </field>
	</record>
</odoo>