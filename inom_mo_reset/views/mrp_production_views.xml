<odoo>

    <record id="view_mrp_production_form_inom_reset" model="ir.ui.view">
        <field name="name">mrp.production.form.inom.mo.reset</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!--
                F1 / F2 - One-click "Set to Draft" button.
                * Placed just before the standard Cancel button in the header.
                * Visible ONLY when the order is cancelled (state == 'cancel').
                * Restricted to the dedicated reset group (defense-in-depth is
                  also enforced server-side in action_set_to_draft).
            -->
            <button name="action_cancel" position="before">
                <button name="action_set_to_draft"
                        type="object"
                        string="Set to Draft"
                        class="oe_highlight"
                        data-hotkey="r"
                        groups="base.group_system,inom_mo_reset.group_mo_reset_user"
                        invisible="state != 'cancel'"
                        confirm="Reset this cancelled Manufacturing Order back to Draft? All data, raw material moves and work orders will be preserved."/>
            </button>

            <!-- F9 - expose the (read-only) reset flag as a status decoration. -->
            <field name="state" position="before">
                <field name="set_to_draft" invisible="1"/>
            </field>

        </field>
    </record>

</odoo>
