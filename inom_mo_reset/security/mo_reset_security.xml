<odoo noupdate="0">

    <!--
        Dedicated category so the reset capability appears as its OWN checkbox in
        the user form (Settings > Users > Access Rights), independent of the
        Manufacturing User/Administrator selection. A category that contains a
        single group renders as a simple on/off checkbox - this is the pre-19
        equivalent of the res.groups.privilege used on Odoo 19.
    -->
    <record id="module_category_mo_reset" model="ir.module.category">
        <field name="name">Manufacturing Order Reset</field>
        <field name="description">Permission to reset cancelled Manufacturing Orders back to Draft.</field>
        <field name="sequence">30</field>
    </record>

    <!--
        Opt-in reset group.

        * It is NOT implied by mrp.group_mrp_user or mrp.group_mrp_manager, so a
          plain Manufacturing user/manager does NOT receive it and does NOT see
          the "Set to Draft" button.
        * The button is shown (and the action allowed) only for:
            (1) the System administrator  -> handled in the view via base.group_system, and
            (2) any user explicitly granted this group.
        * It implies mrp.group_mrp_user so that granting ONLY this group to a
          non-manufacturing user still yields a coherent capability (they can
          open MOs). This direction never grants reset to ordinary MRP users.
    -->
    <record id="group_mo_reset_user" model="res.groups">
        <field name="name">Reset Manufacturing Orders to Draft</field>
        <field name="category_id" ref="module_category_mo_reset"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        <field name="comment">Allows resetting a cancelled Manufacturing Order back to the Draft state.</field>
    </record>

    <!--
        CLEANUP / safety: ensure neither standard MRP group implies the reset
        group (a no-op on a clean install). Keeps behaviour identical to the
        Odoo 19 build, where this also undoes any stale implication from an
        earlier version of the module.
    -->
    <record id="mrp.group_mrp_user" model="res.groups">
        <field name="implied_ids" eval="[(3, ref('group_mo_reset_user'))]"/>
    </record>
    <record id="mrp.group_mrp_manager" model="res.groups">
        <field name="implied_ids" eval="[(3, ref('group_mo_reset_user'))]"/>
    </record>

</odoo>
