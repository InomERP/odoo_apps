<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_transport_subscription" model="ir.sequence">
            <field name="name">Transport Subscription</field>
            <field name="code">univ.transport.subscription</field>
            <field name="prefix">TRN-P/%(year)s/</field>
            <field name="padding">5</field>
        </record>
    </data>
    <data noupdate="0">
        <record id="cron_transport_doc_expiry" model="ir.cron">
            <field name="name">Transport: Vehicle document expiry alerts</field>
            <field name="model_id" ref="model_univ_transport_vehicle"/>
            <field name="state">code</field>
            <field name="code">model._cron_document_expiry_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
