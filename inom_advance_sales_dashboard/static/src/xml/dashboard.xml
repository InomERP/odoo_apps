<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="inom_advance_sales_dashboard.Dashboard">
        <div class="o_inom_dashboard" t-attf-class="{{ state.theme === 'dark' ? 'o_inom-theme-dark' : '' }}" t-ref="root">

            <!-- ===================== Header ===================== -->
            <div class="o_inom_header">
                <div class="o_inom_header__left">
                    <div class="o_inom_header__brand">InomERP</div>
                    <h1 class="o_inom_header__title">Advanced Sales Dashboard</h1>
                    <p class="o_inom_header__subtitle">Real-time Sales Analytics for Odoo 18 Community</p>
                </div>
                <div class="o_inom_meta">
                    <span t-if="companyName" class="o_inom_chip"><i class="fa fa-building-o"/><t t-esc="companyName"/></span>
                    <span class="o_inom_chip"><i class="fa fa-calendar"/><t t-esc="periodLabel"/></span>
                    <span class="o_inom_chip"><i class="fa fa-clock-o"/>Updated <t t-esc="lastUpdated"/></span>
                    <div class="o_inom_theme_toggle" t-on-click="toggleTheme" title="Toggle light / dark theme">
                        <i class="fa" t-att-class="state.theme === 'dark' ? 'fa-moon-o' : 'fa-sun-o'"/>
                        <span class="o_inom_theme_toggle__label" t-esc="state.theme === 'dark' ? 'Dark' : 'Light'"/>
                        <span class="o_inom_theme_toggle__track"><span class="o_inom_theme_toggle__thumb"/></span>
                    </div>
                </div>
            </div>

            <!-- ===================== Toolbar ===================== -->
            <div class="o_inom_toolbar">
                <div class="o_inom_toolbar__filters">
                    <div class="o_inom_field">
                        <label>Period</label>
                        <select t-on-change="onPresetChange">
                            <option value="all" t-att-selected="state.preset === 'all'">All Time</option>
                            <option value="month" t-att-selected="state.preset === 'month'">This Month</option>
                            <option value="quarter" t-att-selected="state.preset === 'quarter'">This Quarter</option>
                            <option value="year" t-att-selected="state.preset === 'year'">This Year</option>
                            <option value="custom" t-att-selected="state.preset === 'custom'">Custom Range</option>
                        </select>
                    </div>
                    <t t-if="state.preset === 'custom'">
                        <div class="o_inom_field"><label>From</label><input type="date" t-att-value="state.dateFrom" t-on-change="onDateFromChange"/></div>
                        <div class="o_inom_field"><label>To</label><input type="date" t-att-value="state.dateTo" t-on-change="onDateToChange"/></div>
                    </t>
                    <div class="o_inom_field">
                        <label>Salesperson</label>
                        <select t-on-change="(ev) => this.onFilterChange('salesperson', ev)">
                            <option value="">All</option>
                            <t t-foreach="state.options.salespersons" t-as="opt" t-key="opt.id">
                                <option t-att-value="opt.id" t-att-selected="state.filters.salesperson === opt.id"><t t-esc="opt.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="o_inom_field">
                        <label>Sales Team</label>
                        <select t-on-change="(ev) => this.onFilterChange('team', ev)">
                            <option value="">All</option>
                            <t t-foreach="state.options.teams" t-as="opt" t-key="opt.id">
                                <option t-att-value="opt.id" t-att-selected="state.filters.team === opt.id"><t t-esc="opt.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="o_inom_field">
                        <label>Category</label>
                        <select t-on-change="(ev) => this.onFilterChange('category', ev)">
                            <option value="">All</option>
                            <t t-foreach="state.options.categories" t-as="opt" t-key="opt.id">
                                <option t-att-value="opt.id" t-att-selected="state.filters.category === opt.id"><t t-esc="opt.display_name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="o_inom_field">
                        <label>Customer</label>
                        <select t-on-change="(ev) => this.onFilterChange('customer', ev)">
                            <option value="">All</option>
                            <t t-foreach="state.options.customers" t-as="opt" t-key="opt.id">
                                <option t-att-value="opt.id" t-att-selected="state.filters.customer === opt.id"><t t-esc="opt.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="o_inom_field">
                        <label>Company</label>
                        <select t-on-change="(ev) => this.onFilterChange('company', ev)">
                            <option value="">All</option>
                            <t t-foreach="state.options.companies" t-as="opt" t-key="opt.id">
                                <option t-att-value="opt.id" t-att-selected="state.filters.company === opt.id"><t t-esc="opt.name"/></option>
                            </t>
                        </select>
                    </div>
                </div>
                <div class="o_inom_toolbar__actions">
                    <div class="o_inom_field">
                        <label>Auto Refresh</label>
                        <select t-on-change="onRefreshChange">
                            <option value="manual">Manual</option>
                            <option value="30">30 Seconds</option>
                            <option value="60">1 Minute</option>
                            <option value="300">5 Minutes</option>
                        </select>
                    </div>
                    <button class="o_inom_btn o_inom_btn--ghost" t-on-click="manualRefresh" title="Refresh now"><i class="fa fa-refresh"/></button>
                    <button class="o_inom_btn o_inom_btn--ghost" t-on-click="toggleFullscreen" title="Full screen"><i class="fa fa-expand"/></button>
                    <div class="o_inom_export">
                        <button class="o_inom_btn o_inom_btn--ghost" t-on-click="toggleCustomize" title="Customize"><i class="fa fa-sliders"/></button>
                        <div t-if="state.customizeOpen" class="o_inom_export__menu o_inom_customize">
                            <div class="o_inom_customize__title">Show / Hide &amp; Drag to Reorder</div>
                            <t t-foreach="state.layout" t-as="w" t-key="w.key">
                                <label class="o_inom_customize__row">
                                    <input type="checkbox" t-att-checked="w.visible" t-on-change="() => this.toggleWidget(w.key)"/>
                                    <span t-esc="widgetLabel(w.key)"/>
                                </label>
                            </t>
                            <button class="o_inom_customize__reset" t-on-click="resetLayout"><i class="fa fa-undo"/> Reset Layout</button>
                        </div>
                    </div>
                    <div class="o_inom_export">
                        <button class="o_inom_btn" t-on-click="toggleExport"><i class="fa fa-download"/> Export <i class="fa fa-caret-down"/></button>
                        <div t-if="state.exportOpen" class="o_inom_export__menu">
                            <button t-on-click="exportPDF"><i class="fa fa-file-pdf-o"/> PDF</button>
                            <button t-on-click="exportExcel"><i class="fa fa-file-excel-o"/> Excel</button>
                            <button t-on-click="exportCSV"><i class="fa fa-file-text-o"/> CSV</button>
                            <button t-on-click="exportImage"><i class="fa fa-image"/> Image</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===================== Skeleton ===================== -->
            <t t-if="state.loading">
                <div class="o_inom_row o_inom_row--kpi">
                    <t t-foreach="[1,2,3,4,5]" t-as="s" t-key="s">
                        <div class="o_inom_skel"><div class="o_inom_skel__line w40"/><div class="o_inom_skel__line w80"/></div>
                    </t>
                </div>
                <div class="o_inom_row"><div class="o_inom_skel o_inom_card--full"><div class="o_inom_skel__block"/></div></div>
                <div class="o_inom_row o_inom_row--3">
                    <t t-foreach="[1,2,3]" t-as="s" t-key="s"><div class="o_inom_skel"><div class="o_inom_skel__block"/></div></t>
                </div>
            </t>

            <!-- ===================== Content ===================== -->
            <t t-else="">
                <!-- KPI row (fixed) -->
                <div class="o_inom_row o_inom_row--kpi">
                    <div class="o_inom_card o_inom_kpi o_inom_kpi--revenue o_inom_clickable" t-on-click="openTotalRevenue">
                        <div class="o_inom_kpi__icon"><i class="fa fa-usd"/></div>
                        <div class="o_inom_kpi__body">
                            <div class="o_inom_kpi__label">Total Revenue</div>
                            <div class="o_inom_kpi__value" data-countup="1" data-format="amount" t-att-data-value="state.data.summary.total_revenue" t-esc="formatAmount(state.data.summary.total_revenue)"/>
                            <div class="o_inom_kpi__trend" t-if="revenueTrend">
                                <span t-attf-class="o_inom_trend is-{{revenueTrend.dir}}"><i t-attf-class="fa fa-arrow-{{revenueTrend.dir}}"/> <t t-esc="revenueTrend.pct"/>%</span>
                                <span class="o_inom_kpi__vs">vs previous</span>
                            </div>
                            <div t-if="state.data.monthly_revenue.length &gt; 1" class="o_inom_kpi__spark"><canvas id="inom_spark_revenue"/></div>
                        </div>
                    </div>
                    <div class="o_inom_card o_inom_kpi o_inom_kpi--orders o_inom_clickable" t-on-click="openTotalOrders">
                        <div class="o_inom_kpi__icon"><i class="fa fa-shopping-cart"/></div>
                        <div class="o_inom_kpi__body">
                            <div class="o_inom_kpi__label">Total Sale Orders</div>
                            <div class="o_inom_kpi__value" data-countup="1" data-format="int" t-att-data-value="state.data.summary.total_orders" t-esc="state.data.summary.total_orders"/>
                            <div class="o_inom_kpi__trend" t-if="ordersTrend">
                                <span t-attf-class="o_inom_trend is-{{ordersTrend.dir}}"><i t-attf-class="fa fa-arrow-{{ordersTrend.dir}}"/> <t t-esc="ordersTrend.pct"/>%</span>
                                <span class="o_inom_kpi__vs">vs previous</span>
                            </div>
                        </div>
                    </div>
                    <div class="o_inom_card o_inom_kpi--mix">
                        <div class="o_inom_card__title"><i class="fa fa-users"/>% New vs Repeat Customers</div>
                        <div t-if="state.data.customer_mix.total_customers &gt; 0" class="o_inom_canvas o_inom_canvas--sm"><canvas id="inom_chart_mix"/></div>
                        <div t-else="" class="o_inom_empty"><i class="fa fa-users"/><span class="o_inom_empty__text">No customer data</span></div>
                    </div>
                    <div class="o_inom_card o_inom_kpi o_inom_kpi--newpct o_inom_clickable" t-on-click="openNewRepeat">
                        <div class="o_inom_kpi__icon"><i class="fa fa-user-plus"/></div>
                        <div class="o_inom_kpi__body">
                            <div class="o_inom_kpi__label">% Orders from New Customers</div>
                            <div class="o_inom_kpi__value" data-countup="1" data-format="percent" t-att-data-value="state.data.orders_from_new_pct" t-esc="formatPercent(state.data.orders_from_new_pct)"/>
                            <div class="o_inom_kpi__trend" t-if="newCustTrend">
                                <span t-attf-class="o_inom_trend is-{{newCustTrend.dir}}"><i t-attf-class="fa fa-arrow-{{newCustTrend.dir}}"/> <t t-esc="newCustTrend.pct"/>%</span>
                                <span class="o_inom_kpi__vs">new customers</span>
                            </div>
                        </div>
                    </div>
                    <div class="o_inom_card o_inom_kpi o_inom_kpi--repeatpct o_inom_clickable" t-on-click="openNewRepeat">
                        <div class="o_inom_kpi__icon"><i class="fa fa-refresh"/></div>
                        <div class="o_inom_kpi__body">
                            <div class="o_inom_kpi__label">% Orders from Repeat Customers</div>
                            <div class="o_inom_kpi__value" data-countup="1" data-format="percent" t-att-data-value="state.data.orders_from_repeat_pct" t-esc="formatPercent(state.data.orders_from_repeat_pct)"/>
                            <div class="o_inom_kpi__trend" t-if="repeatCustTrend">
                                <span t-attf-class="o_inom_trend is-{{repeatCustTrend.dir}}"><i t-attf-class="fa fa-arrow-{{repeatCustTrend.dir}}"/> <t t-esc="repeatCustTrend.pct"/>%</span>
                                <span class="o_inom_kpi__vs">repeat customers</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Reorderable / hideable widget grid -->
                <div class="o_inom_grid">
                    <t t-foreach="state.layout" t-as="w" t-key="w.key">
                        <t t-if="isVisible(w.key)">
                            <div t-att-class="'o_inom_gcard o_inom_card ' + sizeClass(w.key) + ' ' + widgetCardClass(w.key)"
                                 t-att-style="widgetAccentStyle(w.key)" t-att-data-charttype="widgetChartType(w.key)" draggable="true"
                                 t-on-dragstart="() => this.onDragStart(w.key)" t-on-dragover="onDragOver" t-on-drop="() => this.onDrop(w.key)">

                                <!-- Top Performers -->
                                <t t-if="w.key === 'performers'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('performers','fa-star')}} o_inom_card__icon"/>
                                        <span>Top Performers</span>
                                        <InomWidgetMenu widgetKey="'performers'" defaultIcon="'fa-star'"/>
                                    </div>
                                    <div class="o_inom_perf">
                                        <div class="o_inom_perf__card is-gold">
                                            <div class="o_inom_perf__ic"><i class="fa fa-trophy"/></div>
                                            <div><div class="o_inom_perf__label">Best Salesperson</div>
                                                <div class="o_inom_perf__value" t-esc="bestSalesperson ? bestSalesperson.salesperson : '-'"/>
                                                <div class="o_inom_perf__sub" t-if="bestSalesperson" t-esc="formatAmount(bestSalesperson.revenue)"/></div>
                                        </div>
                                        <div class="o_inom_perf__card is-blue">
                                            <div class="o_inom_perf__ic"><i class="fa fa-star"/></div>
                                            <div><div class="o_inom_perf__label">Top Customer</div>
                                                <div class="o_inom_perf__value" t-esc="topCustomer ? topCustomer.customer : '-'"/>
                                                <div class="o_inom_perf__sub" t-if="topCustomer" t-esc="formatAmount(topCustomer.revenue)"/></div>
                                        </div>
                                        <div class="o_inom_perf__card is-orange">
                                            <div class="o_inom_perf__ic"><i class="fa fa-fire"/></div>
                                            <div><div class="o_inom_perf__label">Best Selling Product</div>
                                                <div class="o_inom_perf__value" t-esc="bestProduct ? bestProduct.product_name : '-'"/>
                                                <div class="o_inom_perf__sub" t-if="bestProduct">Qty <t t-esc="formatQuantity(bestProduct.quantity)"/></div></div>
                                        </div>
                                        <div class="o_inom_perf__card is-purple">
                                            <div class="o_inom_perf__ic"><i class="fa fa-pie-chart"/></div>
                                            <div><div class="o_inom_perf__label">Top Revenue Category</div>
                                                <div class="o_inom_perf__value" t-esc="topCategory ? topCategory.category_name : '-'"/>
                                                <div class="o_inom_perf__sub" t-if="topCategory" t-esc="formatAmount(topCategory.revenue)"/></div>
                                        </div>
                                    </div>
                                </t>

                                <!-- Period Comparison -->
                                <t t-if="w.key === 'comparison'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('comparison','fa-exchange')}} o_inom_card__icon"/>
                                        <span>Current vs Previous Period</span>
                                        <InomWidgetMenu widgetKey="'comparison'" defaultIcon="'fa-exchange'"/>
                                    </div>
                                    <div t-if="comparison" class="o_inom_cmp__wrap">
                                        <div class="o_inom_cmp__charts">
                                            <div class="o_inom_cmp__chart"><div class="o_inom_cmp__ctitle">Revenue</div><div class="o_inom_canvas o_inom_canvas--sm"><canvas id="inom_chart_cmp_rev"/></div></div>
                                            <div class="o_inom_cmp__chart"><div class="o_inom_cmp__ctitle">Orders</div><div class="o_inom_canvas o_inom_canvas--sm"><canvas id="inom_chart_cmp_ord"/></div></div>
                                        </div>
                                        <div class="o_inom_cmp">
                                        <div class="o_inom_cmp__box">
                                            <div class="o_inom_cmp__h">Revenue</div>
                                            <div class="o_inom_cmp__row"><span>Current</span><b t-esc="formatAmount(comparison.curRevenue)"/></div>
                                            <div class="o_inom_cmp__row"><span>Previous</span><b t-esc="formatAmount(comparison.prevRevenue)"/></div>
                                            <div class="o_inom_cmp__row"><span>Difference</span><b t-esc="formatAmount(comparison.revDiff)"/></div>
                                            <div class="o_inom_cmp__row"><span>Growth</span>
                                                <b t-attf-class="o_inom_cmp__growth {{(comparison.revGrowth !== null &amp;&amp; comparison.revGrowth >= 0) ? 'is-up' : 'is-down'}}" t-esc="formatSignedPercent(comparison.revGrowth)"/></div>
                                        </div>
                                        <div class="o_inom_cmp__box">
                                            <div class="o_inom_cmp__h">Orders</div>
                                            <div class="o_inom_cmp__row"><span>Current</span><b t-esc="comparison.curOrders"/></div>
                                            <div class="o_inom_cmp__row"><span>Previous</span><b t-esc="comparison.prevOrders"/></div>
                                            <div class="o_inom_cmp__row"><span>Difference</span><b t-esc="comparison.ordDiff"/></div>
                                            <div class="o_inom_cmp__row"><span>Growth</span>
                                                <b t-attf-class="o_inom_cmp__growth {{(comparison.ordGrowth !== null &amp;&amp; comparison.ordGrowth >= 0) ? 'is-up' : 'is-down'}}" t-esc="formatSignedPercent(comparison.ordGrowth)"/></div>
                                        </div>
                                        </div>
                                    </div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-exchange"/><span class="o_inom_empty__text">Select a period (not All Time) to compare</span></div>
                                </t>

                                <!-- Alerts -->
                                <t t-if="w.key === 'alerts'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('alerts','fa-bell')}} o_inom_card__icon"/>
                                        <span>Alerts</span>
                                        <InomWidgetMenu widgetKey="'alerts'" defaultIcon="'fa-bell'"/>
                                    </div>
                                    <div t-if="state.alerts.length" class="o_inom_alerts">
                                        <t t-foreach="state.alerts" t-as="al" t-key="al_index">
                                            <div t-attf-class="o_inom_alert is-{{al.level}}"><i t-attf-class="fa {{al.icon}}"/><span t-esc="al.label"/></div>
                                        </t>
                                    </div>
                                    <div t-else="" class="o_inom_alert is-ok"><i class="fa fa-check-circle"/><span>All healthy — no alerts</span></div>
                                </t>

                                <!-- Monthly Revenue Trend -->
                                <t t-if="w.key === 'monthly'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('monthly','fa-line-chart')}} o_inom_card__icon"/>
                                        <span>Monthly Revenue Trend</span>
                                        <InomWidgetMenu widgetKey="'monthly'" defaultIcon="'fa-line-chart'" chartTypes="['line','area','bar','horizontalBar']"/>
                                    </div>
                                    <div t-if="state.data.monthly_revenue.length" class="o_inom_canvas o_inom_canvas--md"><canvas id="inom_chart_monthly"/></div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-line-chart"/><span class="o_inom_empty__text">No revenue data available</span></div>
                                </t>

                                <!-- Top Products by Revenue -->
                                <t t-if="w.key === 'products_rev'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('products_rev','fa-trophy')}} o_inom_card__icon"/>
                                        <span>Top 5 Products by Revenue</span>
                                        <InomWidgetMenu widgetKey="'products_rev'" defaultIcon="'fa-trophy'" canCsv="true"/>
                                    </div>
                                    <div t-if="state.data.top_products_revenue.length" class="o_inom_ranked">
                                        <t t-foreach="state.data.top_products_revenue" t-as="product" t-key="product.product_id">
                                            <div class="o_inom_ranked__row o_inom_clickable" t-on-click="() => this.openProduct(product)">
                                                <div class="o_inom_rank" t-esc="product_index + 1"/>
                                                <div class="o_inom_ranked__main">
                                                    <div class="o_inom_ranked__head"><span class="o_inom_ranked__name" t-esc="product.product_name"/><span class="o_inom_ranked__value" t-esc="formatAmount(product.revenue)"/></div>
                                                    <div class="o_inom_bar"><div class="o_inom_bar__fill" t-att-style="'width:' + barWidth(product.revenue, maxProductRevenue) + '%'"/></div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-cube"/><span class="o_inom_empty__text">No product revenue data</span></div>
                                </t>

                                <!-- Top Products by Volume -->
                                <t t-if="w.key === 'products_vol'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('products_vol','fa-sort-amount-desc')}} o_inom_card__icon"/>
                                        <span>Top 5 Products by Volume</span>
                                        <InomWidgetMenu widgetKey="'products_vol'" defaultIcon="'fa-sort-amount-desc'" canCsv="true"/>
                                    </div>
                                    <div t-if="state.data.top_products_volume.length" class="o_inom_ranked">
                                        <t t-foreach="state.data.top_products_volume" t-as="product" t-key="product.product_id">
                                            <div class="o_inom_ranked__row o_inom_clickable" t-on-click="() => this.openProduct(product)">
                                                <div class="o_inom_rank" t-esc="product_index + 1"/>
                                                <div class="o_inom_ranked__main">
                                                    <div class="o_inom_ranked__head"><span class="o_inom_ranked__name" t-esc="product.product_name"/><span class="o_inom_ranked__value" t-esc="formatQuantity(product.quantity)"/></div>
                                                    <div class="o_inom_bar"><div class="o_inom_bar__fill o_inom_bar__fill--alt" t-att-style="'width:' + barWidth(product.quantity, maxProductVolume) + '%'"/></div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-cube"/><span class="o_inom_empty__text">No product volume data</span></div>
                                </t>

                                <!-- Revenue by Category -->
                                <t t-if="w.key === 'category'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('category','fa-pie-chart')}} o_inom_card__icon"/>
                                        <span>Revenue by Product Category</span>
                                        <InomWidgetMenu widgetKey="'category'" defaultIcon="'fa-pie-chart'" chartTypes="['doughnut','pie','bar','horizontalBar']"/>
                                    </div>
                                    <div t-if="state.data.revenue_by_category.length" class="o_inom_canvas o_inom_canvas--sm"><canvas id="inom_chart_category"/></div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-pie-chart"/><span class="o_inom_empty__text">No category data</span></div>
                                </t>

                                <!-- Sales by Salesperson -->
                                <t t-if="w.key === 'salesperson'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('salesperson','fa-user-circle-o')}} o_inom_card__icon"/>
                                        <span>Sales by Salesperson</span>
                                        <InomWidgetMenu widgetKey="'salesperson'" defaultIcon="'fa-user-circle-o'" chartTypes="['bar','horizontalBar','doughnut','pie']"/>
                                    </div>
                                    <div t-if="state.data.sales_by_salesperson.length" class="o_inom_canvas o_inom_canvas--md"><canvas id="inom_chart_salesperson"/></div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-user-circle-o"/><span class="o_inom_empty__text">No salesperson data</span></div>
                                </t>

                                <!-- Sales by Country -->
                                <t t-if="w.key === 'country'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('country','fa-globe')}} o_inom_card__icon"/>
                                        <span>Sales by Country</span>
                                        <InomWidgetMenu widgetKey="'country'" defaultIcon="'fa-globe'" chartTypes="['bar','horizontalBar','doughnut','pie']"/>
                                    </div>
                                    <div t-if="state.data.sales_by_country.length" class="o_inom_canvas o_inom_canvas--md"><canvas id="inom_chart_country"/></div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-globe"/><span class="o_inom_empty__text">No country data</span></div>
                                </t>

                                <!-- Revenue Target Achievement -->
                                <t t-if="w.key === 'target'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('target','fa-bullseye')}} o_inom_card__icon"/>
                                        <span>Revenue Target Achievement</span>
                                        <InomWidgetMenu widgetKey="'target'" defaultIcon="'fa-bullseye'" canCsv="true"/>
                                    </div>
                                    <div t-if="state.data.sales_by_team.length">
                                        <t t-foreach="state.data.sales_by_team" t-as="team" t-key="team.team_id">
                                            <div class="o_inom_team o_inom_clickable" t-on-click="() => this.openTeam(team)">
                                                <div class="o_inom_team__head">
                                                    <span class="o_inom_team__name" t-esc="team.team"/>
                                                    <span t-att-class="'o_inom_badge ' + achievementClass(team.achievement_pct, team.has_target)">
                                                        <t t-if="team.has_target" t-esc="formatPercent(team.achievement_pct)"/><t t-else="">No target</t>
                                                    </span>
                                                </div>
                                                <div class="o_inom_bar"><div t-att-class="'o_inom_bar__fill ' + achievementClass(team.achievement_pct, team.has_target)" t-att-style="'width:' + barWidth(team.achievement_pct, 100) + '%'"/></div>
                                                <div class="o_inom_team__meta">
                                                    <span class="o_inom_team__metric">Actual <b t-esc="formatAmount(team.actual_revenue)"/></span>
                                                    <span class="o_inom_team__metric">Target <b><t t-if="team.has_target" t-esc="formatAmount(team.target_amount)"/><t t-else="">-</t></b></span>
                                                    <span class="o_inom_team__metric">Remaining <b><t t-if="team.has_target" t-esc="formatAmount(remaining(team))"/><t t-else="">-</t></b></span>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-bullseye"/><span class="o_inom_empty__text">No sales team data</span></div>
                                </t>

                                <!-- Top Customers -->
                                <t t-if="w.key === 'customers'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('customers','fa-star')}} o_inom_card__icon"/>
                                        <span>Top 5 Customers by Revenue</span>
                                        <InomWidgetMenu widgetKey="'customers'" defaultIcon="'fa-star'" canCsv="true"/>
                                    </div>
                                    <div t-if="state.data.top_customers.length" class="o_inom_ranked">
                                        <t t-foreach="state.data.top_customers" t-as="customer" t-key="customer.partner_id">
                                            <div class="o_inom_ranked__row o_inom_clickable" t-on-click="() => this.openCustomer(customer)">
                                                <div class="o_inom_rank" t-esc="customer_index + 1"/>
                                                <div class="o_inom_ranked__main">
                                                    <div class="o_inom_ranked__head"><span class="o_inom_ranked__name" t-esc="customer.customer"/><span class="o_inom_ranked__value" t-esc="formatAmount(customer.revenue)"/></div>
                                                    <div class="o_inom_bar"><div class="o_inom_bar__fill" t-att-style="'width:' + barWidth(customer.revenue, maxCustomerRevenue) + '%'"/></div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-star"/><span class="o_inom_empty__text">No customer data</span></div>
                                </t>

                                <!-- Sales Funnel -->
                                <t t-if="w.key === 'funnel'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('funnel','fa-filter')}} o_inom_card__icon"/>
                                        <span>Sales Funnel</span>
                                        <InomWidgetMenu widgetKey="'funnel'" defaultIcon="'fa-filter'"/>
                                    </div>
                                    <div t-if="funnel.length" class="o_inom_funnel">
                                        <t t-foreach="funnel" t-as="stage" t-key="stage.key">
                                            <div class="o_inom_funnel__row o_inom_clickable" t-on-click="() => this.openFunnelStage(stage)">
                                                <div class="o_inom_funnel__info">
                                                    <span class="o_inom_funnel__label"><i t-attf-class="fa {{funnelIcon(stage.key)}} o_inom_funnel__ic"/><t t-esc="stage.label"/></span>
                                                    <span class="o_inom_funnel__count"><t t-esc="stage.count"/> &#183; <t t-esc="formatAmount(stage.amount)"/></span>
                                                </div>
                                                <div class="o_inom_funnel__bar">
                                                    <div class="o_inom_funnel__fill" t-att-style="'width:' + barWidth(stage.conversion, 100) + '%'">
                                                        <span t-esc="stage.conversion + '%'"/>
                                                    </div>
                                                </div>
                                                <div class="o_inom_funnel__drop" t-if="stage_index > 0"><i class="fa fa-caret-down"/> <t t-esc="stage.dropoff"/>% drop-off</div>
                                            </div>
                                        </t>
                                    </div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-filter"/><span class="o_inom_empty__text">No funnel data</span></div>
                                </t>

                                <!-- Salesperson Performance -->
                                <t t-if="w.key === 'leaderboard'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('leaderboard','fa-trophy')}} o_inom_card__icon"/>
                                        <span>Salesperson Performance</span>
                                        <InomWidgetMenu widgetKey="'leaderboard'" defaultIcon="'fa-trophy'"/>
                                    </div>
                                    <div t-if="leaderboard.length" class="o_inom_lb">
                                        <div class="o_inom_lb__head">
                                            <span>#</span><span>Salesperson</span><span>Revenue</span><span>Orders</span><span>AOV</span><span>Win %</span><span>Target %</span>
                                        </div>
                                        <t t-foreach="leaderboard" t-as="row" t-key="row.user_id">
                                            <div class="o_inom_lb__row o_inom_clickable" t-on-click="() => this.openLeaderboardRow(row)">
                                                <span class="o_inom_lb__rank"><t t-if="medal(row.rank)"><span class="o_inom_lb__medal" t-esc="medal(row.rank)"/></t><t t-else="" t-esc="row.rank"/></span>
                                                <span class="o_inom_lb__name"><span t-attf-class="o_inom_dot {{leaderClass(row)}}"/><t t-esc="row.salesperson"/></span>
                                                <span t-esc="formatAmount(row.revenue)"/>
                                                <span t-esc="row.orders"/>
                                                <span t-esc="formatAmount(row.avg_order_value)"/>
                                                <span t-esc="row.win_rate + '%'"/>
                                                <span class="o_inom_lb__ach">
                                                    <t t-if="row.has_target">
                                                        <span class="o_inom_lb__achval" t-esc="row.achievement + '%'"/>
                                                        <span class="o_inom_lb__achbar"><span t-attf-class="o_inom_lb__achfill {{leaderClass(row)}}" t-att-style="'width:' + barWidth(row.achievement, 100) + '%'"/></span>
                                                    </t>
                                                    <t t-else="">-</t>
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-trophy"/><span class="o_inom_empty__text">No salesperson data</span></div>
                                </t>

                                <!-- Product Performance -->
                                <t t-if="w.key === 'product_analytics'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('product_analytics','fa-cubes')}} o_inom_card__icon"/>
                                        <span>Product Performance</span>
                                        <InomWidgetMenu widgetKey="'product_analytics'" defaultIcon="'fa-cubes'"/>
                                    </div>
                                    <div t-if="productAnalytics" class="o_inom_pa">
                                        <div class="o_inom_pa__col">
                                            <div class="o_inom_pa__h"><i class="fa fa-line-chart"/> Top Selling</div>
                                            <t t-foreach="productAnalytics.top_selling" t-as="p" t-key="p.product_id">
                                                <div class="o_inom_pa__item o_inom_clickable" t-on-click="() => this.openProduct(p)"><span class="o_inom_pa__rank" t-esc="p_index + 1"/><span class="o_inom_pa__name" t-esc="p.product_name"/><span class="o_inom_pa__val" t-esc="formatQuantity(p.quantity)"/></div>
                                            </t>
                                        </div>
                                        <div class="o_inom_pa__col">
                                            <div class="o_inom_pa__h"><i class="fa fa-money"/> Highest Revenue</div>
                                            <t t-foreach="productAnalytics.highest_revenue" t-as="p" t-key="p.product_id">
                                                <div class="o_inom_pa__item o_inom_clickable" t-on-click="() => this.openProduct(p)"><span class="o_inom_pa__rank" t-esc="p_index + 1"/><span class="o_inom_pa__name" t-esc="p.product_name"/><span class="o_inom_pa__val" t-esc="formatAmount(p.revenue)"/></div>
                                            </t>
                                        </div>
                                        <div class="o_inom_pa__col">
                                            <div class="o_inom_pa__h"><i class="fa fa-percent"/> Highest Margin</div>
                                            <t t-foreach="productAnalytics.highest_margin" t-as="p" t-key="p.product_id">
                                                <div class="o_inom_pa__item o_inom_clickable" t-on-click="() => this.openProduct(p)"><span class="o_inom_pa__rank" t-esc="p_index + 1"/><span class="o_inom_pa__name" t-esc="p.product_name"/><span class="o_inom_pa__val" t-esc="formatAmount(p.margin)"/></div>
                                            </t>
                                        </div>
                                        <div class="o_inom_pa__col">
                                            <div class="o_inom_pa__h"><i class="fa fa-arrow-down"/> Least Selling</div>
                                            <t t-foreach="productAnalytics.least_selling" t-as="p" t-key="p.product_id">
                                                <div class="o_inom_pa__item o_inom_clickable" t-on-click="() => this.openProduct(p)"><span class="o_inom_pa__rank" t-esc="p_index + 1"/><span class="o_inom_pa__name" t-esc="p.product_name"/><span class="o_inom_pa__val" t-esc="formatQuantity(p.quantity)"/></div>
                                            </t>
                                        </div>
                                        <div class="o_inom_pa__col">
                                            <div class="o_inom_pa__h"><i class="fa fa-bolt"/> Fast Moving</div>
                                            <t t-foreach="productAnalytics.fast_moving" t-as="p" t-key="p.product_id">
                                                <div class="o_inom_pa__item o_inom_clickable" t-on-click="() => this.openProduct(p)"><span class="o_inom_pa__rank" t-esc="p_index + 1"/><span class="o_inom_pa__name" t-esc="p.product_name"/><span class="o_inom_pa__val" t-esc="p.frequency"/></div>
                                            </t>
                                        </div>
                                        <div class="o_inom_pa__col">
                                            <div class="o_inom_pa__h"><i class="fa fa-hourglass-half"/> Slow Moving</div>
                                            <t t-foreach="productAnalytics.slow_moving" t-as="p" t-key="p.product_id">
                                                <div class="o_inom_pa__item o_inom_clickable" t-on-click="() => this.openProduct(p)"><span class="o_inom_pa__rank" t-esc="p_index + 1"/><span class="o_inom_pa__name" t-esc="p.product_name"/><span class="o_inom_pa__val" t-esc="p.frequency"/></div>
                                            </t>
                                        </div>
                                    </div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-cubes"/><span class="o_inom_empty__text">No product data</span></div>
                                </t>

                                <!-- Target vs Achievement -->
                                <t t-if="w.key === 'target_achievement'">
                                    <div class="o_inom_card__title">
                                        <i class="fa fa-bars o_inom_drag"/>
                                        <i t-attf-class="fa {{widgetIcon('target_achievement','fa-line-chart')}} o_inom_card__icon"/>
                                        <span>Target vs Achievement</span>
                                        <InomWidgetMenu widgetKey="'target_achievement'" defaultIcon="'fa-line-chart'"/>
                                    </div>
                                    <div t-if="targetAchievement" class="o_inom_ta">
                                        <div class="o_inom_ta__overall">
                                            <div class="o_inom_ta__metrics">
                                                <span class="o_inom_team__metric">Actual <b t-esc="formatAmount(targetAchievement.overall.actual)"/></span>
                                                <span class="o_inom_team__metric">Target <b t-esc="formatAmount(targetAchievement.overall.target)"/></span>
                                                <span class="o_inom_team__metric">Remaining <b t-esc="formatAmount(targetAchievement.overall.remaining)"/></span>
                                                <span class="o_inom_team__metric">Achievement <b t-esc="targetAchievement.overall.achievement + '%'"/></span>
                                            </div>
                                            <div class="o_inom_bar"><div t-att-class="'o_inom_bar__fill ' + achievementClass(targetAchievement.overall.achievement, targetAchievement.overall.target > 0)" t-att-style="'width:' + barWidth(targetAchievement.overall.achievement, 100) + '%'"/></div>
                                        </div>
                                        <div t-if="targetAchievement.monthly.length" class="o_inom_ta__months">
                                            <t t-foreach="targetAchievement.monthly" t-as="m" t-key="m.period">
                                                <div class="o_inom_ta__month o_inom_clickable" t-on-click="openTargetRecords">
                                                    <div class="o_inom_ta__mhead"><span t-esc="m.period"/><span t-esc="m.achievement + '%'"/></div>
                                                    <div class="o_inom_bar"><div t-att-class="'o_inom_bar__fill ' + achievementClass(m.achievement, m.target > 0)" t-att-style="'width:' + barWidth(m.achievement, 100) + '%'"/></div>
                                                    <div class="o_inom_ta__mmeta">Actual <t t-esc="formatAmount(m.actual)"/> / Target <t t-esc="formatAmount(m.target)"/></div>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                    <div t-else="" class="o_inom_empty"><i class="fa fa-line-chart"/><span class="o_inom_empty__text">No target data</span></div>
                                </t>

                            </div>
                        </t>
                    </t>
                </div>
            </t>

        </div>
    </t>

</templates>
