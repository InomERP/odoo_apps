<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!--
        Reusable widget tools (three-dot menu + collapse + full screen).
        Drop into any widget card as:
          <InomWidgetMenu widgetKey="'key'" defaultIcon="'fa-star'"
                          chartTypes="['line','area','bar']" canCsv="true"/>
    -->
    <t t-name="inom_advance_sales_dashboard.WidgetMenu">
        <div class="o_inom_widget_menu" t-ref="menuRoot">

            <!-- Collapse / expand -->
            <button type="button" class="o_inom_widget_menu__tool"
                    t-on-click="toggleCollapse"
                    t-att-title="isCollapsed ? 'Expand widget' : 'Collapse widget'">
                <i t-attf-class="fa {{ isCollapsed ? 'fa-chevron-down' : 'fa-chevron-up' }}"/>
            </button>

            <!-- Full screen -->
            <button type="button" class="o_inom_widget_menu__tool"
                    t-on-click="toggleFullscreen" title="Full screen">
                <i class="fa fa-expand"/>
            </button>

            <!-- Three-dot trigger -->
            <button type="button"
                    class="o_inom_widget_menu__trigger"
                    t-on-click="toggle"
                    title="Widget options"
                    aria-haspopup="true"
                    t-att-aria-expanded="state.open ? 'true' : 'false'">
                <i class="fa fa-ellipsis-v"/>
            </button>

            <div t-if="state.open" class="o_inom_widget_menu__dropdown" t-on-click="(ev) => ev.stopPropagation()">

                <!-- Root menu -->
                <t t-if="state.panel === 'root'">
                    <button type="button" class="o_inom_widget_menu__item" t-on-click="() => this.openPanel('color')">
                        <i class="fa fa-paint-brush"/>
                        <span>Change Accent Color</span>
                        <i class="fa fa-angle-right o_inom_widget_menu__chevron"/>
                    </button>
                    <button type="button" class="o_inom_widget_menu__item" t-on-click="() => this.openPanel('icon')">
                        <i class="fa fa-icons"/>
                        <span>Change Icon</span>
                        <i class="fa fa-angle-right o_inom_widget_menu__chevron"/>
                    </button>
                    <button t-if="hasChartTypes" type="button" class="o_inom_widget_menu__item" t-on-click="() => this.openPanel('chart')">
                        <i class="fa fa-bar-chart"/>
                        <span>Chart Type</span>
                        <i class="fa fa-angle-right o_inom_widget_menu__chevron"/>
                    </button>
                    <button type="button" class="o_inom_widget_menu__item" t-on-click="() => this.openPanel('export')">
                        <i class="fa fa-download"/>
                        <span>Export Widget</span>
                        <i class="fa fa-angle-right o_inom_widget_menu__chevron"/>
                    </button>
                    <button t-if="hasCustomStyle" type="button" class="o_inom_widget_menu__item o_inom_widget_menu__item--reset" t-on-click="resetStyle">
                        <i class="fa fa-undo"/>
                        <span>Reset to Default</span>
                    </button>
                </t>

                <!-- Accent color panel -->
                <t t-if="state.panel === 'color'">
                    <div class="o_inom_widget_menu__header">
                        <button type="button" class="o_inom_widget_menu__back" t-on-click="backToRoot" title="Back"><i class="fa fa-angle-left"/></button>
                        <span>Accent Color</span>
                    </div>
                    <div class="o_inom_widget_menu__colorpicker">
                        <input type="color" class="o_inom_widget_menu__colorinput" t-att-value="colorInputValue" t-on-input="onColorInput" title="Pick any color"/>
                        <div class="o_inom_widget_menu__colorinfo">
                            <span class="o_inom_widget_menu__colorlabel">Pick any color</span>
                            <span class="o_inom_widget_menu__colorhex" t-esc="colorInputValue"/>
                        </div>
                    </div>
                </t>

                <!-- Icon panel -->
                <t t-if="state.panel === 'icon'">
                    <div class="o_inom_widget_menu__header">
                        <button type="button" class="o_inom_widget_menu__back" t-on-click="backToRoot" title="Back"><i class="fa fa-angle-left"/></button>
                        <span>Widget Icon</span>
                    </div>
                    <div class="o_inom_widget_menu__iconsearch">
                        <i class="fa fa-search"/>
                        <input type="text" placeholder="Search icons..." t-att-value="state.iconSearch" t-on-input="onIconSearchInput"/>
                    </div>
                    <div class="o_inom_widget_menu__icons">
                        <t t-if="filteredIcons.length === 0">
                            <div class="o_inom_widget_menu__iconsempty">No icons match "<t t-esc="state.iconSearch"/>"</div>
                        </t>
                        <t t-foreach="filteredIcons" t-as="ic" t-key="ic">
                            <button type="button" t-attf-class="o_inom_widget_menu__iconbtn {{ currentIcon === ic ? 'is-active' : '' }}" t-att-title="ic" t-on-click="() => this.selectIcon(ic)">
                                <i t-attf-class="fa {{ic}}"/>
                            </button>
                        </t>
                    </div>
                </t>

                <!-- Chart type panel -->
                <t t-if="state.panel === 'chart'">
                    <div class="o_inom_widget_menu__header">
                        <button type="button" class="o_inom_widget_menu__back" t-on-click="backToRoot" title="Back"><i class="fa fa-angle-left"/></button>
                        <span>Chart Type</span>
                    </div>
                    <t t-foreach="props.chartTypes" t-as="ct" t-key="ct">
                        <button type="button" t-attf-class="o_inom_widget_menu__item {{ currentChartType === ct ? 'is-active' : '' }}" t-on-click="() => this.selectChartType(ct)">
                            <i t-attf-class="fa {{ chartTypeIcons[ct] || 'fa-bar-chart' }}"/>
                            <span t-esc="chartTypeLabels[ct] || ct"/>
                            <i t-if="currentChartType === ct" class="fa fa-check o_inom_widget_menu__chevron"/>
                        </button>
                    </t>
                </t>

                <!-- Export panel -->
                <t t-if="state.panel === 'export'">
                    <div class="o_inom_widget_menu__header">
                        <button type="button" class="o_inom_widget_menu__back" t-on-click="backToRoot" title="Back"><i class="fa fa-angle-left"/></button>
                        <span>Export Widget</span>
                    </div>
                    <button type="button" class="o_inom_widget_menu__item" t-on-click="exportPng">
                        <i class="fa fa-image"/>
                        <span>Download PNG</span>
                    </button>
                    <button t-if="props.canCsv" type="button" class="o_inom_widget_menu__item" t-on-click="exportCsv">
                        <i class="fa fa-file-text-o"/>
                        <span>Download CSV</span>
                    </button>
                </t>

            </div>
        </div>
    </t>

</templates>
