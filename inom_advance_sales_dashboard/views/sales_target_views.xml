<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- List view -->
    <record id="view_inom_sales_target_list" model="ir.ui.view">
        <field name="name">inom.sales.target.tree</field>
        <field name="model">inom.sales.target</field>
        <field name="arch" type="xml">
            <tree string="Sales Revenue Targets">
                <field name="team_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="target_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_inom_sales_target_form" model="ir.ui.view">
        <field name="name">inom.sales.target.form</field>
        <field name="model">inom.sales.target</field>
        <field name="arch" type="xml">
            <form string="Sales Revenue Target">
                <sheet>
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="target_amount"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_inom_sales_target" model="ir.actions.act_window">
        <field name="name">Sales Revenue Targets</field>
        <field name="res_model">inom.sales.target</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first sales revenue target
            </p>
            <p>
                Define a revenue target per sales team and period. Targets are used
                by the Revenue Target Achievement widget in a later phase.
            </p>
        </field>
    </record>

</odoo>
