<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Dashboard client action (empty branded shell for Phase 1) -->
    <record id="action_inom_sales_dashboard" model="ir.actions.client">
        <field name="name">Sales Dashboard</field>
        <field name="tag">inom_advance_sales_dashboard.dashboard</field>
    </record>

    <!-- Root menu -->
    <menuitem
        id="menu_inom_sales_dashboard_root"
        name="Sales Dashboard"
        web_icon="inom_advance_sales_dashboard,static/description/icon.png"
        sequence="55"
        groups="sales_team.group_sale_salesman"/>

    <!-- Dashboard -->
    <menuitem
        id="menu_inom_sales_dashboard_main"
        name="Dashboard"
        parent="menu_inom_sales_dashboard_root"
        action="action_inom_sales_dashboard"
        sequence="10"/>

    <!-- Dashboard Reports (single menu holding all report screens) -->
    <menuitem
        id="menu_inom_dashboard_reports_root"
        name="Dashboard Reports"
        parent="menu_inom_sales_dashboard_root"
        sequence="20"/>

    <!-- Configuration -->
    <menuitem
        id="menu_inom_sales_dashboard_config"
        name="Configuration"
        parent="menu_inom_sales_dashboard_root"
        sequence="30"/>

    <!-- Configuration > Sales Revenue Targets -->
    <menuitem
        id="menu_inom_sales_target"
        name="Sales Revenue Targets"
        parent="menu_inom_sales_dashboard_config"
        action="action_inom_sales_target"
        sequence="10"/>

</odoo>
