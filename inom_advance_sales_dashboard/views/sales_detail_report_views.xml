<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ============================================================= -->
    <!-- Detailed sales report - views                                 -->
    <!-- ============================================================= -->

    <record id="view_inom_sales_report_detail_list" model="ir.ui.view">
        <field name="name">inom.sales.report.detail.tree</field>
        <field name="model">inom.sales.report.detail</field>
        <field name="arch" type="xml">
            <tree string="Sales Report" create="false" edit="false" delete="false">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id" optional="show"/>
                <field name="categ_id" optional="show"/>
                <field name="company_id" optional="hide"/>
                <field name="country_id" optional="hide"/>
                <field name="state_id" optional="hide"/>
                <field name="city" optional="hide"/>
                <field name="team_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="warehouse_id" optional="hide"/>
                <field name="date_order" optional="hide"/>
                <field name="invoice_status" optional="hide"/>
                <field name="quantity" sum="Quantity"/>
                <field name="amount" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="view_inom_sales_report_detail_graph" model="ir.ui.view">
        <field name="name">inom.sales.report.detail.graph</field>
        <field name="model">inom.sales.report.detail</field>
        <field name="arch" type="xml">
            <graph string="Sales Report" type="bar" sample="1">
                <field name="product_id"/>
                <field name="amount" type="measure"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_inom_sales_report_detail_pivot" model="ir.ui.view">
        <field name="name">inom.sales.report.detail.pivot</field>
        <field name="model">inom.sales.report.detail</field>
        <field name="arch" type="xml">
            <pivot string="Sales Report" sample="1">
                <field name="categ_id" type="row"/>
                <field name="date_order" type="col" interval="month"/>
                <field name="amount" type="measure"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Filter wizard                                                 -->
    <!-- ============================================================= -->

    <record id="view_inom_sales_report_wizard_form" model="ir.ui.view">
        <field name="name">inom.sales.report.wizard.form</field>
        <field name="model">inom.sales.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Sales Revenue Breakdown by Product Category">
                <group string="Choose Dates to Calculate Sales">
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <group>
                    <group string="Products &amp; Categories">
                        <field name="category_ids" widget="many2many_tags"/>
                        <field name="product_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Companies &amp; Warehouses">
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="warehouse_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_data" type="object" string="View Data" class="btn-primary"/>
                    <button name="action_view_graph" type="object" string="View Graph" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Actions                                                       -->
    <!-- ============================================================= -->

    <record id="action_inom_report_wizard" model="ir.actions.act_window">
        <field name="name">Sales Revenue Breakdown by Product Category</field>
        <field name="res_model">inom.sales.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_inom_detail_monthly" model="ir.actions.act_window">
        <field name="name">Monthly Sales Revenue Trends</field>
        <field name="res_model">inom.sales.report.detail</field>
        <field name="view_mode">tree,graph,pivot</field>
        <field name="context">{'group_by': ['date_order:month']}</field>
    </record>

    <record id="action_inom_detail_product" model="ir.actions.act_window">
        <field name="name">Product-wise Sales Analysis</field>
        <field name="res_model">inom.sales.report.detail</field>
        <field name="view_mode">tree,graph,pivot</field>
        <field name="context">{'group_by': ['product_id']}</field>
    </record>

    <record id="action_inom_detail_salesperson" model="ir.actions.act_window">
        <field name="name">Sales by Salesperson</field>
        <field name="res_model">inom.sales.report.detail</field>
        <field name="view_mode">tree,graph,pivot</field>
        <field name="context">{'group_by': ['user_id']}</field>
    </record>

    <record id="action_inom_detail_country" model="ir.actions.act_window">
        <field name="name">Sales by Country</field>
        <field name="res_model">inom.sales.report.detail</field>
        <field name="view_mode">tree,graph,pivot</field>
        <field name="context">{'group_by': ['country_id']}</field>
    </record>

    <record id="action_inom_detail_all" model="ir.actions.act_window">
        <field name="name">Sales Detail Report</field>
        <field name="res_model">inom.sales.report.detail</field>
        <field name="view_mode">tree,graph,pivot</field>
    </record>

    <!-- ============================================================= -->
    <!-- Dashboard Reports menu items (parent defined in dashboard_menus) -->
    <!-- ============================================================= -->

    <menuitem id="menu_inom_detail_monthly"
              name="Monthly Sales Revenue Trends"
              parent="menu_inom_dashboard_reports_root"
              action="action_inom_detail_monthly"
              sequence="10"/>

    <menuitem id="menu_inom_report_wizard"
              name="Sales Revenue Breakdown by Product Category"
              parent="menu_inom_dashboard_reports_root"
              action="action_inom_report_wizard"
              sequence="20"/>

    <menuitem id="menu_inom_detail_product"
              name="Product-wise Sales Analysis"
              parent="menu_inom_dashboard_reports_root"
              action="action_inom_detail_product"
              sequence="30"/>

    <menuitem id="menu_inom_detail_salesperson"
              name="Sales by Salesperson"
              parent="menu_inom_dashboard_reports_root"
              action="action_inom_detail_salesperson"
              sequence="40"/>

    <menuitem id="menu_inom_detail_country"
              name="Sales by Country"
              parent="menu_inom_dashboard_reports_root"
              action="action_inom_detail_country"
              sequence="50"/>

    <menuitem id="menu_inom_detail_all"
              name="Sales Detail Report"
              parent="menu_inom_dashboard_reports_root"
              action="action_inom_detail_all"
              sequence="60"/>

</odoo>
