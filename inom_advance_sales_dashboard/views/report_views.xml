<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ============ R-01 Monthly Sales Growth ============ -->
    <record id="view_inom_report_monthly_growth_list" model="ir.ui.view">
        <field name="name">inom.sales.report.monthly.growth.tree</field>
        <field name="model">inom.sales.report.monthly.growth</field>
        <field name="arch" type="xml">
            <tree string="Monthly Sales Growth" create="false" edit="false" delete="false">
                <field name="month_date"/>
                <field name="product_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="revenue" sum="Revenue"/>
                <field name="previous_revenue" sum="Previous-Month Revenue"/>
                <field name="growth_pct" avg="Avg Growth %"/>
            </tree>
        </field>
    </record>

    <record id="view_inom_report_monthly_growth_pivot" model="ir.ui.view">
        <field name="name">inom.sales.report.monthly.growth.pivot</field>
        <field name="model">inom.sales.report.monthly.growth</field>
        <field name="arch" type="xml">
            <pivot string="Monthly Sales Growth" sample="1">
                <field name="month_date" type="row" interval="month"/>
                <field name="revenue" type="measure"/>
                <field name="previous_revenue" type="measure"/>
                <field name="growth_pct" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_inom_report_monthly_growth_graph" model="ir.ui.view">
        <field name="name">inom.sales.report.monthly.growth.graph</field>
        <field name="model">inom.sales.report.monthly.growth</field>
        <field name="arch" type="xml">
            <graph string="Monthly Sales Growth" type="line" sample="1">
                <field name="month_date" interval="month"/>
                <field name="revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_inom_report_monthly_growth" model="ir.actions.act_window">
        <field name="name">Monthly Sales Growth</field>
        <field name="res_model">inom.sales.report.monthly.growth</field>
        <field name="view_mode">tree,pivot,graph</field>
    </record>

    <menuitem id="menu_inom_report_monthly_growth"
              name="Monthly Sales Growth"
              parent="menu_inom_dashboard_reports_root"
              action="action_inom_report_monthly_growth"
              sequence="70"/>

    <!-- ============ R-02 Revenue by Product Category ============ -->
    <record id="view_inom_report_category_list" model="ir.ui.view">
        <field name="name">inom.sales.report.category.tree</field>
        <field name="model">inom.sales.report.category</field>
        <field name="arch" type="xml">
            <tree string="Revenue by Product Category" create="false" edit="false" delete="false">
                <field name="categ_id"/>
                <field name="revenue" sum="Revenue"/>
                <field name="revenue_pct" avg="Avg % of Total"/>
            </tree>
        </field>
    </record>

    <record id="view_inom_report_category_pivot" model="ir.ui.view">
        <field name="name">inom.sales.report.category.pivot</field>
        <field name="model">inom.sales.report.category</field>
        <field name="arch" type="xml">
            <pivot string="Revenue by Product Category" sample="1">
                <field name="categ_id" type="row"/>
                <field name="revenue" type="measure"/>
                <field name="revenue_pct" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_inom_report_category_graph" model="ir.ui.view">
        <field name="name">inom.sales.report.category.graph</field>
        <field name="model">inom.sales.report.category</field>
        <field name="arch" type="xml">
            <graph string="Revenue by Product Category" type="pie" sample="1">
                <field name="categ_id"/>
                <field name="revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_inom_report_category" model="ir.actions.act_window">
        <field name="name">Revenue by Product Category</field>
        <field name="res_model">inom.sales.report.category</field>
        <field name="view_mode">tree,pivot,graph</field>
    </record>

    <menuitem id="menu_inom_report_category"
              name="Revenue by Product Category"
              parent="menu_inom_dashboard_reports_root"
              action="action_inom_report_category"
              sequence="80"/>

    <!-- ============ R-03 Top 5 Selling Products ============ -->
    <record id="view_inom_report_top_products_list" model="ir.ui.view">
        <field name="name">inom.sales.report.top.products.tree</field>
        <field name="model">inom.sales.report.top.products</field>
        <field name="arch" type="xml">
            <tree string="Top 5 Selling Products" create="false" edit="false" delete="false" default_order="rank_no">
                <field name="rank_no"/>
                <field name="product_id"/>
                <field name="quantity" sum="Quantity Sold"/>
                <field name="revenue" sum="Revenue"/>
            </tree>
        </field>
    </record>

    <record id="view_inom_report_top_products_pivot" model="ir.ui.view">
        <field name="name">inom.sales.report.top.products.pivot</field>
        <field name="model">inom.sales.report.top.products</field>
        <field name="arch" type="xml">
            <pivot string="Top 5 Selling Products" sample="1">
                <field name="product_id" type="row"/>
                <field name="quantity" type="measure"/>
                <field name="revenue" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_inom_report_top_products_graph" model="ir.ui.view">
        <field name="name">inom.sales.report.top.products.graph</field>
        <field name="model">inom.sales.report.top.products</field>
        <field name="arch" type="xml">
            <graph string="Top 5 Selling Products" type="bar" sample="1">
                <field name="product_id"/>
                <field name="quantity" type="measure"/>
                <field name="revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_inom_report_top_products" model="ir.actions.act_window">
        <field name="name">Top 5 Selling Products</field>
        <field name="res_model">inom.sales.report.top.products</field>
        <field name="view_mode">tree,pivot,graph</field>
    </record>

    <menuitem id="menu_inom_report_top_products"
              name="Top 5 Selling Products"
              parent="menu_inom_dashboard_reports_root"
              action="action_inom_report_top_products"
              sequence="90"/>

    <!-- ============ R-04 Customer Lifetime Value ============ -->
    <record id="view_inom_report_clv_list" model="ir.ui.view">
        <field name="name">inom.sales.report.clv.tree</field>
        <field name="model">inom.sales.report.clv</field>
        <field name="arch" type="xml">
            <tree string="Customer Lifetime Value" create="false" edit="false" delete="false">
                <field name="partner_id"/>
                <field name="first_order_date"/>
                <field name="total_orders" sum="Total Orders"/>
                <field name="lifetime_revenue" sum="Lifetime Revenue"/>
                <field name="avg_order_value" avg="Avg Order Value"/>
            </tree>
        </field>
