    <record id="view_inom_report_clv_pivot" model="ir.ui.view">
        <field name="name">inom.sales.report.clv.pivot</field>
        <field name="model">inom.sales.report.clv</field>
        <field name="arch" type="xml">
            <pivot string="Customer Lifetime Value" sample="1">
                <field name="partner_id" type="row"/>
                <field name="total_orders" type="measure"/>
                <field name="lifetime_revenue" type="measure"/>
                <field name="avg_order_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_inom_report_clv_graph" model="ir.ui.view">
        <field name="name">inom.sales.report.clv.graph</field>
        <field name="model">inom.sales.report.clv</field>
        <field name="arch" type="xml">
            <graph string="Customer Lifetime Value" type="bar" sample="1">
                <field name="partner_id"/>
                <field name="lifetime_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_inom_report_clv" model="ir.actions.act_window">
        <field name="name">Customer Lifetime Value</field>
        <field name="res_model">inom.sales.report.clv</field>
        <field name="view_mode">tree,pivot,graph</field>
    </record>

    <menuitem id="menu_inom_report_clv"
              name="Customer Lifetime Value"
              parent="menu_inom_dashboard_reports_root"
              action="action_inom_report_clv"
              sequence="100"/>

    <!-- ============ R-05 New vs Repeat Performance ============ -->
