        <field name="name">inom.sales.report.new.repeat.tree</field>
        <field name="model">inom.sales.report.new.repeat</field>
        <field name="arch" type="xml">
            <tree string="New vs Repeat Performance" create="false" edit="false" delete="false">
                <field name="segment"/>
                <field name="customers" sum="Customers"/>
                <field name="orders" sum="Orders"/>
                <field name="revenue" sum="Revenue"/>
                <field name="avg_order_value" avg="Avg Order Value"/>
            </tree>
        </field>
    </record>

    <record id="view_inom_report_new_repeat_pivot" model="ir.ui.view">
        <field name="name">inom.sales.report.new.repeat.pivot</field>
        <field name="model">inom.sales.report.new.repeat</field>
        <field name="arch" type="xml">
            <pivot string="New vs Repeat Performance" sample="1">
                <field name="segment" type="row"/>
                <field name="customers" type="measure"/>
                <field name="orders" type="measure"/>
                <field name="revenue" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_inom_report_new_repeat_graph" model="ir.ui.view">
        <field name="name">inom.sales.report.new.repeat.graph</field>
        <field name="model">inom.sales.report.new.repeat</field>
        <field name="arch" type="xml">
            <graph string="New vs Repeat Performance" type="bar" sample="1">
                <field name="segment"/>
                <field name="revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_inom_report_new_repeat" model="ir.actions.act_window">
        <field name="name">New vs Repeat Performance</field>
        <field name="res_model">inom.sales.report.new.repeat</field>
        <field name="view_mode">tree,pivot,graph</field>
