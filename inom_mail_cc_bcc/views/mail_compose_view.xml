<odoo>
    <record id="mail_compose_message_form_cc_bcc" model="ir.ui.view">
        <field name="name">mail.compose.message.form.cc.bcc</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='subject']" position="after">

                <field name="email_cc"
                    placeholder="CC"
                    class="cc_field_style" />
                <field name="show_bcc"
                    class="bcc_checkbox_style" />
                <field name="email_bcc"
                    placeholder="BCC"
                    class="bcc_field_style"
                    invisible="not show_bcc" />

            </xpath>

        </field>
    </record>
</odoo>