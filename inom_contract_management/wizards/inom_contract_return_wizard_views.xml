<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_inom_contract_return_wizard_form" model="ir.ui.view">
        <field name="name">inom.contract.return.wizard.form</field>
        <field name="model">inom.contract.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return for Correction">
                <field name="contract_id" invisible="1"/>
                <group>
                    <field name="comment" nolabel="1"
                           placeholder="Describe what needs to be corrected..."/>
                </group>
                <footer>
                    <button name="action_return" type="object"
                            string="Return" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>