<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="inom_multi_company_email_signatures.SignatureWidget">
    <div class="inom-signature-root">

        <!-- Tabs -->
        <div class="inom-sig-tabs">
            <button type="button"
                    t-att-class="'inom-sig-tab' + (this.state.activeTab === 'draw' ? ' active' : '')"
                    t-on-click="() => this.switchTab('draw')">
                <i class="oi" data-icon="edit"/> Draw
            </button>
            <button type="button"
                    t-att-class="'inom-sig-tab' + (this.state.activeTab === 'type' ? ' active' : '')"
                    t-on-click="() => this.switchTab('type')">
                <i class="oi" data-icon="keyboard"/> Type
            </button>
            <button type="button"
                    t-att-class="'inom-sig-tab' + (this.state.activeTab === 'upload' ? ' active' : '')"
                    t-on-click="() => this.switchTab('upload')">
                <i class="oi" data-icon="upload"/> Upload
            </button>
        </div>

        <!-- Draw Panel -->
        <div t-if="this.state.activeTab === 'draw'" class="inom-sig-panel">
            <canvas class="inom-sig-canvas"
                    width="600" height="180"
                    t-ref="this.canvasRef"/>
            <div class="inom-sig-hint">Use your mouse or finger to sign above.</div>
        </div>

        <!-- Type Panel -->
        <div t-if="this.state.activeTab === 'type'" class="inom-sig-panel">
            <input type="text"
                   class="inom-sig-typed o_input"
                   placeholder="Type your full name..."
                   maxlength="80"
                   t-att-value="this.state.typedText"
                   t-on-input="this.onTyped"/>
            <div class="inom-sig-typed-preview">
                <t t-if="this.currentValue.startsWith('typed:') and this.displaySrc">
                    <img t-att-src="this.displaySrc" style="max-height:100px;"/>
                </t>
            </div>
        </div>

        <!-- Upload Panel -->
        <div t-if="this.state.activeTab === 'upload'" class="inom-sig-panel">
            <input type="file"
                   class="inom-sig-upload"
                   accept="image/png,image/jpeg"
                   t-on-change="this.onUpload"/>
            <div class="inom-sig-upload-preview">
                <t t-if="this.currentValue.startsWith('upload:') and this.displaySrc">
                    <img t-att-src="this.displaySrc" alt="signature"/>
                </t>
                <t t-else="">
                    <span class="inom-sig-hint">No file selected.</span>
                </t>
            </div>
        </div>

        <!-- Controls -->
        <div class="inom-sig-controls">
            <button type="button"
                    class="btn btn-sm btn-secondary"
                    t-on-click="this.clearSignature">
                <i class="oi" data-icon="ink_eraser"/> Clear
            </button>
            <t t-if="this.hasSavedValue">
                <span class="inom-sig-status inom-sig-status-success">
                    ✓ Signature saved
                </span>
            </t>
        </div>

    </div>
</t>

</templates>
