<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <!-- Module Category -->
        <record id="module_category_instant_sale" model="ir.module.category">
            <field name="name">Instant Sales</field>
            <field name="description">
                Manage Instant Sales automation rights
            </field>
            <field name="sequence">100</field>
        </record>

        <!-- User Group -->
        <record id="group_instant_sale_user" model="res.groups">
            <field name="name">Instant Sale User</field>
        </record>

        <!-- Manager Group -->
        <record id="group_instant_sale_manager" model="res.groups">
            <field name="name">Instant Sale Manager</field>

            <field name="implied_ids"
                   eval="[(4, ref('group_instant_sale_user'))]"/>
        </record>

    </data>
</odoo>