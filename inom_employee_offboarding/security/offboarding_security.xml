<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Group privilege (Odoo 19 structure: res.groups -> privilege_id) -->
        <record id="offboarding_privilege" model="res.groups.privilege">
            <field name="name">Employee Offboarding</field>
            <field name="sequence">90</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
        </record>

        <!-- Offboarding Coordinator: day-to-day handling -->
        <record id="inom_group_offboarding_officer" model="res.groups">
            <field name="name">Offboarding Coordinator</field>
            <field name="privilege_id" ref="offboarding_privilege"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Offboarding HR Manager: full control including relieving -->
        <record id="inom_group_offboarding_hr" model="res.groups">
            <field name="name">Offboarding HR Manager</field>
            <field name="privilege_id" ref="offboarding_privilege"/>
            <field name="implied_ids" eval="[(4, ref('inom_group_offboarding_officer'))]"/>
        </record>

    </data>
</odoo>