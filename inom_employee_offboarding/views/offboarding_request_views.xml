<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_offboarding_request_list" model="ir.ui.view">
        <field name="name">inom.offboarding.request.list</field>
        <field name="model">inom.offboarding.request</field>
        <field name="arch" type="xml">
            <list string="Offboarding Requests"
                  decoration-muted="state in ('rejected','cancelled')"
                  decoration-success="state == 'relieved'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="offboarding_type"/>
                <field name="request_date"/>
                <field name="relieving_date"/>
                <field name="checklist_progress" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('manager_approval','hr_approval')"
                       decoration-success="state in ('approved','relieved')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_offboarding_request_form" model="ir.ui.view">
        <field name="name">inom.offboarding.request.form</field>
        <field name="model">inom.offboarding.request</field>
        <field name="arch" type="xml">
            <form string="Offboarding Request">
                <header>
                    <button name="action_submit_to_manager" type="object"
                            string="Submit to Manager" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_manager_approve" type="object"
                            string="Manager Approve" class="btn-primary"
                            invisible="state != 'manager_approval'"
                            groups="inom_employee_offboarding.inom_group_offboarding_officer"/>
                    <button name="action_hr_approve" type="object"
                            string="HR Approve" class="btn-primary"
                            invisible="state != 'hr_approval'"
                            groups="inom_employee_offboarding.inom_group_offboarding_hr"/>
                    <button name="action_relieve_employee" type="object"
                            string="Relieve Employee" class="btn-primary"
                            invisible="state != 'approved'"
                            groups="inom_employee_offboarding.inom_group_offboarding_hr"
                            confirm="This will archive the employee record. Continue?"/>
                    <button name="action_open_reject_wizard" type="object"
                            string="Reject"
                            invisible="state in ('draft','relieved','rejected','cancelled')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('rejected','cancelled')"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('relieved','rejected','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,manager_approval,hr_approval,approved,relieved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="offboarding_type"/>
                            <field name="reason_id" options="{'no_create_edit': True}"/>
                            <field name="request_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notice and Relieving">
                        <group>
                            <field name="proposed_last_day"/>
                            <field name="notice_period_days"/>
                        </group>
                        <group>
                            <field name="relieving_date"
                                   groups="inom_employee_offboarding.inom_group_offboarding_hr"/>
                            <field name="checklist_progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clearance Checklist" name="checklist">
                            <field name="checklist_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="responsible"/>
                                    <field name="is_done" widget="boolean_toggle"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Remarks" name="remarks">
                            <group>
                                <field name="employee_remarks"/>
                                <field name="hr_remarks"
                                       groups="inom_employee_offboarding.inom_group_offboarding_hr"/>
                            </group>
                        </page>
                        <page string="Rejection" name="rejection"
                              invisible="state != 'rejected'">
                            <group>
                                <field name="rejection_reason" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_offboarding_request_search" model="ir.ui.view">
        <field name="name">inom.offboarding.request.search</field>
        <field name="model">inom.offboarding.request</field>
        <field name="arch" type="xml">
            <search string="Offboarding Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_in_progress" string="In Progress"
                        domain="[('state', 'in', ('manager_approval','hr_approval','approved'))]"/>
                <filter name="filter_relieved" string="Relieved"
                        domain="[('state', '=', 'relieved')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <separator string="Group By"/>
                <group>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_type" string="Offboarding Type"
                            context="{'group_by': 'offboarding_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_offboarding_request" model="ir.actions.act_window">
        <field name="name">Offboarding Requests</field>
        <field name="res_model">inom.offboarding.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_offboarding_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first offboarding request
            </p>
            <p>
                Track employee resignations and relieving through a
                structured multi-level approval workflow.
            </p>
        </field>
    </record>

</odoo>