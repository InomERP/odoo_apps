    <!-- Action -->
    <record id="action_website_wallet_transaction" model="ir.actions.act_window">
        <field name="name">Wallet Transactions</field>
        <field name="res_model">website.wallet.transaction</field>
        <field name="view_mode">tree,form</field>
        <!-- <field name="search_view_id" ref="view_website_wallet_transaction_search"/>
        <field name="context">{'search_default_filter_confirmed': 1}</field> -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No wallet transactions yet
            </p>
            <p>
                Wallet transactions are created automatically when customers
                recharge their wallet via the website or use it to pay an
                order. You can also add money manually to a customer's wallet
                from their contact form.
            </p>
        </field>
    </record>

