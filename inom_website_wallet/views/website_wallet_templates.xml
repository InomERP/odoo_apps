<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The "Wallet" website menu is created programmatically by the
         post-install hook (see _post_install_hook in __init__.py).
         This makes the module compatible with multi-website setups and
         insulates it from changes in Odoo's main-menu XML id. -->

    <!-- =========================================================
         Wallet landing page (/shop/wallet)
         ========================================================= -->
    <template id="wallet_landing_page" name="Wallet Landing Page">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="'Your Wallet'"/>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="o_website_wallet_hero py-5">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-7">
                                <h2 class="o_wallet_title mb-3">
                                    Your Wallet Details
                                </h2>
                                <p class="lead mb-4 text-white">
                                    Top up your wallet and enjoy faster checkout
                                    with a single click. Your balance can be used
                                    to pay any future order on this shop.
                                </p>
                                <p class="o_wallet_balance_label fs-5 text-white">
                                    You have
                                    <span class="badge text-bg-warning fs-4 align-middle">
                                        <span t-out="wallet_balance"
                                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </span>
                                    balance in your account.
                                </p>
                            </div>
                            <div class="col-lg-5 text-center">
                                <div class="o_wallet_illustration p-3 d-inline-block">
                                    <i class="fa fa-shopping-cart fa-5x text-warning"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="container py-5">
                    <!-- "Use Wallet on current cart" CTA, shown only if
                         the customer has both a positive balance AND an
                         active non-empty cart. -->
                    <t t-if="active_cart and wallet_balance and wallet_balance &gt; 0">
                        <div class="card o_wallet_payment_card border-primary mb-4">
                            <div class="card-body d-flex flex-wrap justify-content-between align-items-center">
                                <div>
                                    <h5 class="card-title mb-1">
                                        <i class="fa fa-credit-card-alt me-2"/>
                                        Pay your current cart with the wallet
                                    </h5>
                                    <p class="mb-0 small text-muted">
                                        Cart total:
                                        <strong>
                                            <span t-out="active_cart.amount_total"
                                                  t-options='{"widget":"monetary","display_currency":active_cart.currency_id}'/>
                                        </strong>
                                        <t t-if="active_cart.wallet_amount_used and active_cart.wallet_amount_used &gt; 0">
                                            &amp;mdash; already paid by wallet:
                                            <span t-out="active_cart.wallet_amount_used"
                                                  t-options='{"widget":"monetary","display_currency":active_cart.currency_id}'/>
                                        </t>
                                    </p>
                                </div>
                                <form action="/shop/wallet/use" method="post" class="mb-0">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa fa-money me-2"/>
                                        Use Wallet
                                    </button>
                                </form>
                            </div>
                        </div>
                    </t>

                    <t t-if="not recharge_product">
                        <div class="alert alert-warning">
                            The wallet recharge product has not been configured
                            yet. Please ask the administrator to set it from
                            <em>Website &#8250; Configuration &#8250; Settings</em>.
                        </div>
                    </t>
                    <t t-if="recharge_product">
                        <div class="row justify-content-center">
                            <div class="col-md-8">
                                <div class="card shadow-sm">
                                    <div class="card-body">
                                        <h3 class="card-title text-center mb-4">
                                            Add Wallet Balance
                                        </h3>
                                        <t t-if="request.params.get('error') == 'invalid_amount'">
                                            <div class="alert alert-danger">
                                                Please enter an amount between
                                                <span t-out="request.params.get('min')"/>
                                                and
                                                <span t-out="request.params.get('max')"/>.
                                            </div>
                                        </t>
                                        <t t-if="request.params.get('error') == 'no_product'">
                                            <div class="alert alert-danger">
                                                Wallet recharge is currently unavailable.
                                            </div>
                                        </t>
                                        <form action="/shop/wallet/recharge"
                                              method="post" class="o_wallet_recharge_form">
                                            <input type="hidden" name="csrf_token"
                                                   t-att-value="request.csrf_token()"/>
                                            <div class="mb-3">
                                                <label for="amount" class="form-label">
                                                    Amount
                                                    (<span t-out="currency.symbol or currency.name"/>)
                                                </label>
                                                <input type="number"
                                                       step="0.01"
                                                       name="amount"
                                                       id="amount"
                                                       class="form-control form-control-lg"
                                                       t-att-min="min_amount"
                                                       t-att-max="max_amount"
                                                       required="required"
                                                       placeholder="0.00"/>
                                                <small class="form-text text-muted">
                                                    Min:
                                                    <span t-out="min_amount"
                                                          t-options='{"widget":"float","precision":2}'/>
                                                    -- Max:
                                                    <span t-out="max_amount"
                                                          t-options='{"widget":"float","precision":2}'/>
                                                </small>
                                            </div>
                                            <div class="text-center">
                                                <button type="submit"
                                                        class="btn btn-primary btn-lg px-5">
                                                    <i class="fa fa-plus-circle me-2"/>
                                                    Add Wallet Balance
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                                <div class="text-center mt-4">
                                    <a href="/my/wallet/transactions"
                                       class="btn btn-link">
                                        View my Wallet Transactions &#8250;
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </section>
            </div>
        </t>
    </template>

</odoo>
