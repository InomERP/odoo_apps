<odoo>

    <record id="view_global_mail_config_tree" model="ir.ui.view">
        <field name="name">global.mail.config.tree</field>
        <field name="model">global.mail.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="model_id"/>
                <field name="days_after"/>
                <field name="template_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_global_mail_config_form" model="ir.ui.view">
        <field name="name">global.mail.config.form</field>
        <field name="model">global.mail.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_id"/>
                        <field name="days_after"/>
                        <field name="template_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_global_mail_config" model="ir.actions.act_window">
        <field name="name">Global Auto Mail</field>
        <field name="res_model">global.mail.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_global_mail_root"
          name="Global Auto Mail"
          parent="base.menu_administration"
          sequence="50"/>

    <menuitem id="menu_global_mail_config"
          name="Configurations"
          parent="menu_global_mail_root"
          action="action_global_mail_config"/>
</odoo>
