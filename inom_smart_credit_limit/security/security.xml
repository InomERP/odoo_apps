<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_smart_credit" model="ir.module.category">
            <field name="name">Smart Credit Limit</field>
            <field name="description">Customer credit control, scoring and credit holds.</field>
            <field name="sequence">40</field>
        </record>

        <record id="group_smart_credit_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_smart_credit"/>
            <field name="comment">See credit information and request approvals when a limit is exceeded.</field>
        </record>

        <record id="group_smart_credit_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_smart_credit"/>
            <field name="implied_ids" eval="[(4, ref('group_smart_credit_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Configure limits, hold or release customers and override credit blocks.</field>
        </record>

        <!-- Sensible defaults: sales users get credit visibility,
             sales administrators get full credit management rights. -->
        <record id="sales_team.group_sale_salesman" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_smart_credit_user'))]"/>
        </record>
        <record id="sales_team.group_sale_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_smart_credit_manager'))]"/>
        </record>

        <!-- Multi-company scoping: access rights alone do not isolate
             credit data between companies. -->
        <record id="rule_inom_credit_extension_company" model="ir.rule">
            <field name="name">Credit Extension: multi-company</field>
            <field name="model_id" ref="model_inom_credit_extension"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_inom_credit_audit_company" model="ir.rule">
            <field name="name">Credit Audit Log: multi-company</field>
            <field name="model_id" ref="model_inom_credit_audit"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
