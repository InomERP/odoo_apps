<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_inom_credit_audit_list" model="ir.ui.view">
        <field name="name">inom.credit.audit.list</field>
        <field name="model">inom.credit.audit</field>
        <field name="arch" type="xml">
            <tree string="Credit Audit Log" create="false" edit="false"
                  decoration-danger="event in ('block', 'manual_hold', 'auto_hold')"
                  decoration-warning="event == 'warn'"
                  decoration-info="event in ('override', 'approval_request', 'suggestion')"
                  decoration-success="event in ('manual_release', 'auto_release')">
                <field name="create_date" string="Date"/>
                <field name="partner_id"/>
                <field name="event" widget="badge"
                       decoration-danger="event in ('block', 'manual_hold', 'auto_hold')"
                       decoration-warning="event == 'warn'"
                       decoration-success="event in ('manual_release', 'auto_release')"/>
                <field name="document_ref"/>
                <field name="amount"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="note" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_inom_credit_audit_form" model="ir.ui.view">
        <field name="name">inom.credit.audit.form</field>
        <field name="model">inom.credit.audit</field>
        <field name="arch" type="xml">
            <form string="Credit Audit Entry" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="event"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="create_date" string="Date"/>
                            <field name="document_ref"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_inom_credit_audit_search" model="ir.ui.view">
        <field name="name">inom.credit.audit.search</field>
        <field name="model">inom.credit.audit</field>
        <field name="arch" type="xml">
            <search string="Credit Audit Log">
                <field name="partner_id"/>
                <field name="document_ref"/>
                <filter name="filter_blocks" string="Blocks"
                        domain="[('event', '=', 'block')]"/>
                <filter name="filter_overrides" string="Overrides"
                        domain="[('event', '=', 'override')]"/>
                <filter name="filter_holds" string="Holds"
                        domain="[('event', 'in', ('manual_hold', 'auto_hold'))]"/>
                <group name="group_by">
                    <filter name="group_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_event" string="Event"
                            context="{'group_by': 'event'}"/>
                    <filter name="group_user" string="User"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_inom_credit_audit" model="ir.actions.act_window">
        <field name="name">Credit Audit Log</field>
        <field name="res_model">inom.credit.audit</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_inom_credit_audit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No credit events recorded yet
            </p>
            <p>
                Every warning, block, hold, release, override and scoring
                suggestion is recorded here automatically.
            </p>
        </field>
    </record>

</odoo>
