<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Core sequences provided for the suite. Consuming models are
             delivered in their own phases; the sequences exist from Phase 1. -->
        <record id="seq_law_client" model="ir.sequence">
            <field name="name">Law Firm Client Reference</field>
            <field name="code">law.client</field>
            <field name="prefix">CLI/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_law_case" model="ir.sequence">
            <field name="name">Law Firm Case Number</field>
            <field name="code">law.case</field>
            <field name="prefix">CASE/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_law_matter" model="ir.sequence">
            <field name="name">Law Firm Matter Number</field>
            <field name="code">law.matter</field>
            <field name="prefix">MAT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
