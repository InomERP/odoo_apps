<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default case lifecycle stages (global; editable by admins). -->
        <record id="stage_draft" model="law.case.stage">
            <field name="name">Draft</field><field name="sequence">1</field>
        </record>
        <record id="stage_conflict_check" model="law.case.stage">
            <field name="name">Conflict Check</field><field name="sequence">5</field>
        </record>
        <record id="stage_open" model="law.case.stage">
            <field name="name">Open</field><field name="sequence">10</field>
        </record>
        <record id="stage_active" model="law.case.stage">
            <field name="name">Active</field><field name="sequence">20</field>
        </record>
        <record id="stage_hearing" model="law.case.stage">
            <field name="name">Hearing Scheduled</field><field name="sequence">30</field>
        </record>
        <record id="stage_trial" model="law.case.stage">
            <field name="name">Under Trial</field><field name="sequence">40</field>
        </record>
        <record id="stage_judgment" model="law.case.stage">
            <field name="name">Judgment</field><field name="sequence">50</field>
        </record>
        <record id="stage_appeal" model="law.case.stage">
            <field name="name">Appeal</field><field name="sequence">60</field>
        </record>
        <record id="stage_settled" model="law.case.stage">
            <field name="name">Settled</field><field name="sequence">70</field>
            <field name="fold" eval="True"/>
        </record>
        <record id="stage_closed" model="law.case.stage">
            <field name="name">Closed</field><field name="sequence">80</field>
            <field name="is_closing" eval="True"/><field name="fold" eval="True"/>
        </record>
        <record id="stage_archived" model="law.case.stage">
            <field name="name">Archived</field><field name="sequence">90</field>
            <field name="is_closing" eval="True"/><field name="fold" eval="True"/>
        </record>
    </data>
</odoo>
