<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_law_practice_area_list" model="ir.ui.view">
        <field name="name">law.practice.area.list</field>
        <field name="model">law.practice.area</field>
        <field name="arch" type="xml">
            <list string="Practice Areas">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_law_practice_area_form" model="ir.ui.view">
        <field name="name">law.practice.area.form</field>
        <field name="model">law.practice.area</field>
        <field name="arch" type="xml">
            <form string="Practice Area">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="color" widget="color_picker"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Notes about this practice area..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_law_practice_area_search" model="ir.ui.view">
        <field name="name">law.practice.area.search</field>
        <field name="model">law.practice.area</field>
        <field name="arch" type="xml">
            <search string="Practice Areas">
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_law_practice_area" model="ir.actions.act_window">
        <field name="name">Practice Areas</field>
        <field name="res_model">law.practice.area</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first practice area</p>
            <p>Practice areas classify the legal domains your firm works in, e.g. Litigation, Corporate, IP.</p>
        </field>
    </record>
</odoo>
