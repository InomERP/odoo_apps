<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_law_case_type_list" model="ir.ui.view">
        <field name="name">law.case.type.list</field>
        <field name="model">law.case.type</field>
        <field name="arch" type="xml">
            <list string="Case Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="practice_area_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_law_case_type_form" model="ir.ui.view">
        <field name="name">law.case.type.form</field>
        <field name="model">law.case.type</field>
        <field name="arch" type="xml">
            <form string="Case Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="practice_area_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_law_case_type_search" model="ir.ui.view">
        <field name="name">law.case.type.search</field>
        <field name="model">law.case.type</field>
        <field name="arch" type="xml">
            <search string="Case Types">
                <field name="name"/>
                <field name="code"/>
                <field name="practice_area_id"/>
                <group>
                    <filter name="group_practice_area" string="Practice Area"
                            context="{'group_by': 'practice_area_id'}"/>
                </group>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_law_case_type" model="ir.actions.act_window">
        <field name="name">Case Types</field>
        <field name="res_model">law.case.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first case type</p>
            <p>Case types classify matters, e.g. Civil, Criminal, Arbitration, Corporate Advisory.</p>
        </field>
    </record>
</odoo>
