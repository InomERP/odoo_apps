<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_law_case_list" model="ir.ui.view">
        <field name="name">law.case.list</field>
        <field name="model">law.case</field>
        <field name="arch" type="xml">
            <tree string="Cases">
                <field name="case_number"/>
                <field name="name"/>
                <field name="client_id"/>
                <field name="case_type_id" optional="show"/>
                <field name="lawyer_id" optional="show"/>
                <field name="stage_id"/>
                <field name="date_opened" optional="hide"/>
                <field name="priority" widget="priority" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_law_case_kanban" model="ir.ui.view">
        <field name="name">law.case.kanban</field>
        <field name="model">law.case</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="stage_id"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="fw-bold fs-6"><field name="case_number"/></div>
                            <div><field name="name"/></div>
                            <div class="text-muted"><field name="client_id"/></div>
                            <div><field name="lawyer_id"/></div>
                            <div class="mt-1">
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_law_case_form" model="ir.ui.view">
        <field name="name">law.case.form</field>
        <field name="model">law.case</field>
        <field name="arch" type="xml">
            <form string="Case">
                <header>
                    <button name="action_close_case" type="object" string="Close Case"
                            class="btn-primary" invisible="is_closed"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <!-- Odoo 17 requires every field used in a modifier to be
                         declared in the same view. -->
                    <field name="is_closed" invisible="1"/>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Closed" bg_color="text-bg-danger"
                            invisible="not is_closed"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Matter title..."/></h1>
                        <h3><field name="case_number" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="case_type_id"/>
                            <field name="practice_area_id"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="lawyer_id"/>
                            <field name="user_id"/>
                            <field name="branch_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="date_opened"/>
                            <field name="date_closed" invisible="not date_closed"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Opposing Party" name="opposing">
                            <group>
                                <field name="opposing_party_name"/>
                                <field name="opposing_counsel_name"/>
                            </group>
                        </page>
                        <page string="Closure" name="closure">
                            <field name="closure_ids" readonly="1">
                                <tree>
                                    <field name="closure_date"/>
                                    <field name="state"/>
                                    <field name="closed_by_id"/>
                                    <field name="closure_reason"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_law_case_search" model="ir.ui.view">
        <field name="name">law.case.search</field>
        <field name="model">law.case</field>
        <field name="arch" type="xml">
            <search string="Cases">
                <field name="name" string="Case"
                       filter_domain="['|', ('name', 'ilike', self), ('case_number', 'ilike', self)]"/>
                <field name="client_id"/>
                <field name="lawyer_id"/>
                <field name="case_type_id"/>
                <field name="tag_ids"/>
                <filter name="my_cases" string="My Cases" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="open" string="Open" domain="[('is_closed', '=', False)]"/>
                <filter name="closed" string="Closed" domain="[('is_closed', '=', True)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="g_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="g_lawyer" string="Responsible Lawyer" context="{'group_by': 'lawyer_id'}"/>
                    <filter name="g_type" string="Case Type" context="{'group_by': 'case_type_id'}"/>
                    <filter name="g_practice" string="Practice Area" context="{'group_by': 'practice_area_id'}"/>
                    <filter name="g_client" string="Client" context="{'group_by': 'client_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_law_case_pivot" model="ir.ui.view">
        <field name="name">law.case.pivot</field>
        <field name="model">law.case</field>
        <field name="arch" type="xml">
            <pivot string="Cases">
                <field name="practice_area_id" type="row"/>
                <field name="stage_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_law_case" model="ir.actions.act_window">
        <field name="name">Cases</field>
        <field name="res_model">law.case</field>
        <field name="view_mode">kanban,tree,form,pivot</field>
        <field name="search_view_id" ref="view_law_case_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Open your first case</p>
            <p>Track matters through their lifecycle from intake to closure, with a full chatter history.</p>
        </field>
    </record>

    <!-- Case closure checklist (opened from the case) -->
    <record id="view_law_case_closure_form" model="ir.ui.view">
        <field name="name">law.case.closure.form</field>
        <field name="model">law.case.closure</field>
        <field name="arch" type="xml">
            <form string="Case Closure Checklist">
                <header>
                    <button name="action_confirm" type="object" string="Confirm Closure"
                            class="btn-primary" invisible="state == 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="case_id" readonly="1"/>
                        <field name="closure_date"/>
                        <field name="closed_by_id"/>
                    </group>
                    <group string="Checklist (all required to close)">
                        <field name="final_hearing_done"/>
                        <field name="documents_archived"/>
                        <field name="final_invoice_generated"/>
                        <field name="outstanding_checked"/>
                        <field name="trust_settled"/>
                        <field name="client_notified"/>
                    </group>
                    <group string="Closure Reason">
                        <field name="closure_reason" nolabel="1"
                               placeholder="Reason for closing this case..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
