<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_law_profile" model="ir.ui.view">
        <field name="name">hr.employee.form.law.profile</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Legal Profile" name="legal_profile">
                    <group>
                        <group>
                            <field name="is_lawyer"/>
                            <field name="lawyer_role"/>
                            <field name="law_availability"/>
                        </group>
                        <group>
                            <field name="billing_rate"/>
                            <field name="specialization_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Bar Registrations &amp; Licenses">
                        <field name="bar_registration_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="bar_council"/>
                                <field name="registration_date"/>
                                <field name="expiry_date"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'valid'"
                                       decoration-danger="state == 'expired'"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_law_lawyer_list" model="ir.ui.view">
        <field name="name">hr.employee.law.lawyer.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <tree string="Lawyers">
                <field name="name"/>
                <field name="lawyer_role"/>
                <field name="job_title" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="billing_rate" optional="show"/>
                <field name="law_availability" optional="show"/>
                <field name="work_email" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_law_lawyer_kanban" model="ir.ui.view">
        <field name="name">hr.employee.law.lawyer.kanban</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="lawyer_role"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="fw-bold fs-6"><field name="name"/></div>
                            <div class="text-muted"><field name="lawyer_role"/></div>
                            <div><field name="work_email"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_law_lawyer_search" model="ir.ui.view">
        <field name="name">hr.employee.law.lawyer.search</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <search string="Lawyers">
                <field name="name"/>
                <field name="specialization_ids"/>
                <field name="lawyer_role"/>
                <filter name="available" string="Available"
                        domain="[('law_availability', '=', 'available')]"/>
                <group>
                    <filter name="g_role" string="Legal Role" context="{'group_by': 'lawyer_role'}"/>
                    <filter name="g_dept" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_law_lawyer" model="ir.actions.act_window">
        <field name="name">Lawyers</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('is_lawyer', '=', True)]</field>
        <field name="context">{'default_is_lawyer': True}</field>
        <field name="search_view_id" ref="view_law_lawyer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first lawyer</p>
            <p>Maintain advocate/paralegal profiles, specializations, bar registration and billing rates.</p>
        </field>
    </record>

    <record id="act_law_lawyer_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_law_lawyer_kanban"/>
        <field name="act_window_id" ref="action_law_lawyer"/>
    </record>
    <record id="act_law_lawyer_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_law_lawyer_list"/>
        <field name="act_window_id" ref="action_law_lawyer"/>
    </record>
    <record id="act_law_lawyer_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr.view_employee_form"/>
        <field name="act_window_id" ref="action_law_lawyer"/>
    </record>
</odoo>
