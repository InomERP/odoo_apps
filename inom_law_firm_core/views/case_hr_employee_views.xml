<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Workload widget: active case count per lawyer -->
    <record id="view_employee_form_law_cases" model="ir.ui.view">
        <field name="name">hr.employee.form.law.cases</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_lawyer_cases"
                        icon="fa-gavel" invisible="not is_lawyer">
                    <field name="active_case_count" widget="statinfo" string="Active Cases"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
