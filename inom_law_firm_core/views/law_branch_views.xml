<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_law_branch_list" model="ir.ui.view">
        <field name="name">law.branch.list</field>
        <field name="model">law.branch</field>
        <field name="arch" type="xml">
            <tree string="Branches">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_law_branch_form" model="ir.ui.view">
        <field name="name">law.branch.form</field>
        <field name="model">law.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Delhi Office"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="manager_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_law_branch_search" model="ir.ui.view">
        <field name="name">law.branch.search</field>
        <field name="model">law.branch</field>
        <field name="arch" type="xml">
            <search string="Branches">
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_law_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">law.branch</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first branch</p>
            <p>Branches let a multi-office firm scope master data and, later, cases and hearings.</p>
        </field>
    </record>
</odoo>
