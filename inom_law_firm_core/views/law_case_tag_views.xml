<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_law_case_tag_list" model="ir.ui.view">
        <field name="name">law.case.tag.list</field>
        <field name="model">law.case.tag</field>
        <field name="arch" type="xml">
            <tree string="Case Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="action_law_case_tag" model="ir.actions.act_window">
        <field name="name">Case Tags</field>
        <field name="res_model">law.case.tag</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first case tag</p>
            <p>Tags let you label and filter cases freely across practice areas.</p>
        </field>
    </record>
</odoo>
