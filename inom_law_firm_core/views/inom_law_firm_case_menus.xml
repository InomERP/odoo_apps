<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Filtered case actions for the Matters section -->
    <record id="action_law_case_my" model="ir.actions.act_window">
        <field name="name">My Cases</field>
        <field name="res_model">law.case</field>
        <field name="view_mode">kanban,tree,form,pivot</field>
        <field name="domain">['|', ('user_id', '=', uid), ('lawyer_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cases assigned to you yet</p>
            <p>Cases where you are the responsible user or the responsible lawyer appear here.</p>
        </field>
    </record>

    <record id="action_law_case_active" model="ir.actions.act_window">
        <field name="name">Active Cases</field>
        <field name="res_model">law.case</field>
        <field name="view_mode">kanban,tree,form,pivot</field>
        <field name="domain">[('is_closed', '=', False)]</field>
    </record>

    <record id="action_law_case_closed" model="ir.actions.act_window">
        <field name="name">Closed Cases</field>
        <field name="res_model">law.case</field>
        <field name="view_mode">tree,kanban,form,pivot</field>
        <field name="domain">[('is_closed', '=', True)]</field>
    </record>

    <!-- Matters section -->
    <menuitem id="menu_law_case"
              name="All Cases"
              parent="inom_law_firm_core.menu_law_sec_matters"
              action="action_law_case"
              sequence="10"
              groups="inom_law_firm_core.group_law_firm_user"/>
    <menuitem id="menu_law_case_my"
              name="My Cases"
              parent="inom_law_firm_core.menu_law_sec_matters"
              action="action_law_case_my"
              sequence="20"
              groups="inom_law_firm_core.group_law_firm_user"/>
    <menuitem id="menu_law_case_active"
              name="Active Cases"
              parent="inom_law_firm_core.menu_law_sec_matters"
              action="action_law_case_active"
              sequence="30"
              groups="inom_law_firm_core.group_law_firm_user"/>
    <menuitem id="menu_law_case_closed"
              name="Closed Cases"
              parent="inom_law_firm_core.menu_law_sec_matters"
              action="action_law_case_closed"
              sequence="40"
              groups="inom_law_firm_core.group_law_firm_user"/>

    <!-- Reports section: case analysis -->
    <record id="action_law_case_report" model="ir.actions.act_window">
        <field name="name">Case Analysis</field>
        <field name="res_model">law.case</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cases to analyse yet</p>
            <p>Analyse cases by practice area, stage, lawyer and more.</p>
        </field>
    </record>
    <menuitem id="menu_law_report_cases" name="Case Analysis"
              parent="inom_law_firm_core.menu_law_sec_reports"
              action="action_law_case_report" sequence="10"
              groups="inom_law_firm_core.group_law_firm_user"/>
</odoo>
