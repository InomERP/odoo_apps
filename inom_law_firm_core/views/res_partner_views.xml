<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact form: add a Legal Client page + Client 360 contacts button -->
    <record id="view_partner_form_law_client" model="ir.ui.view">
        <field name="name">res.partner.form.law.client</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_law_contacts"
                        icon="fa-users" invisible="not is_law_client">
                    <field name="law_contact_count" widget="statinfo" string="Contacts"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_law_client"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Legal Client" name="legal_client" invisible="not is_law_client">
                    <group>
                        <group>
                            <field name="client_ref"/>
                            <field name="client_type"/>
                        </group>
                        <group>
                            <field name="client_category_id"/>
                            <field name="law_client_since"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        This is the Client 360 record. As later phases install, case, hearing,
                        document, timesheet, invoice, payment and trust smart buttons appear above.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_law_client_list" model="ir.ui.view">
        <field name="name">res.partner.law.client.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Clients">
                <field name="client_ref"/>
                <field name="name"/>
                <field name="client_type"/>
                <field name="client_category_id" optional="show"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="city" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_law_client_kanban" model="ir.ui.view">
        <field name="name">res.partner.law.client.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="client_type"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold fs-5"><field name="name"/></div>
                        <div class="text-muted"><field name="client_ref"/></div>
                        <div><field name="email"/></div>
                        <div><field name="client_category_id"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_law_client_search" model="ir.ui.view">
        <field name="name">res.partner.law.client.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Clients">
                <field name="name" string="Client"
                       filter_domain="['|', '|', '|', ('name', 'ilike', self), ('client_ref', 'ilike', self), ('email', 'ilike', self), ('phone', 'ilike', self)]"/>
                <field name="client_category_id"/>
                <filter name="individuals" string="Individuals" domain="[('client_type', '=', 'individual')]"/>
                <filter name="corporate" string="Corporate" domain="[('client_type', '=', 'corporate')]"/>
                <group>
                    <filter name="g_category" string="Category" context="{'group_by': 'client_category_id'}"/>
                    <filter name="g_type" string="Client Type" context="{'group_by': 'client_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_law_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_law_client', '=', True)]</field>
        <field name="context">{'default_is_law_client': True}</field>
        <field name="search_view_id" ref="view_law_client_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first client</p>
            <p>Individual or corporate clients. Each is a Client 360 record aggregating all related activity.</p>
        </field>
    </record>

    <record id="act_law_client_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_law_client_kanban"/>
        <field name="act_window_id" ref="action_law_client"/>
    </record>
    <record id="act_law_client_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_law_client_list"/>
        <field name="act_window_id" ref="action_law_client"/>
    </record>
    <record id="act_law_client_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="base.view_partner_form"/>
        <field name="act_window_id" ref="action_law_client"/>
    </record>
</odoo>
