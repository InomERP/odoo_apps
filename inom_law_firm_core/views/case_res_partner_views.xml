<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_law_case" model="ir.ui.view">
        <field name="name">res.partner.form.law.case</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" icon="fa-briefcase"
                        name="action_view_client_cases" invisible="not is_law_client">
                    <field name="law_case_count" widget="statinfo" string="Cases"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
