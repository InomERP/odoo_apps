<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security / module category for the Law Firm suite -->
    <record id="module_category_law_firm" model="ir.module.category">
        <field name="name">Law Firm</field>
        <field name="description">Access rights for the INOM Law Firm Management Suite.</field>
        <field name="sequence">20</field>
    </record>

    <!-- Base groups. The full 15-role matrix is delivered in
         inom_law_firm_security (Phase 24); these two are the foundation. -->
    <record id="group_law_firm_user" model="res.groups">
        <field name="name">Law Firm / User</field>
        <field name="category_id" ref="module_category_law_firm"/>
        <field name="comment">Read access to Law Firm master data and records.</field>
    </record>

    <record id="group_law_firm_admin" model="res.groups">
        <field name="name">Law Firm / Administrator</field>
        <field name="category_id" ref="module_category_law_firm"/>
        <field name="implied_ids" eval="[(4, ref('group_law_firm_user'))]"/>
        <field name="comment">Full access to Law Firm configuration and master data.</field>
    </record>

    <!-- Grant the default administrator the Law Firm admin role -->
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_law_firm_admin'))]"/>
    </record>

    <!-- Multi-company record rules on company-scoped master data -->
    <record id="law_branch_company_rule" model="ir.rule">
        <field name="name">Law Branch: multi-company</field>
        <field name="model_id" ref="model_law_branch"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="law_practice_area_company_rule" model="ir.rule">
        <field name="name">Law Practice Area: multi-company</field>
        <field name="model_id" ref="model_law_practice_area"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="law_case_type_company_rule" model="ir.rule">
        <field name="name">Law Case Type: multi-company</field>
        <field name="model_id" ref="model_law_case_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="law_case_stage_company_rule" model="ir.rule">
        <field name="name">Law Case Stage: multi-company</field>
        <field name="model_id" ref="model_law_case_stage"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
