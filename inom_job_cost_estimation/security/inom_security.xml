<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_inom_costing" model="ir.module.category">
        <field name="name">Job Costing</field>
        <field name="description">Manage job cost estimates.</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_inom_costing" model="res.groups.privilege">
        <field name="name">Job Costing</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_inom_costing"/>
    </record>

    <record id="group_inom_cost_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_inom_costing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Create and edit job cost estimates.</field>
    </record>

    <record id="group_inom_cost_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_inom_costing"/>
        <field name="implied_ids" eval="[(4, ref('group_inom_cost_user'))]"/>
    </record>

    <record id="group_inom_cost_director" model="res.groups">
        <field name="name">Job Costing Director</field>
        <field name="privilege_id" ref="privilege_inom_costing"/>
        <field name="implied_ids" eval="[(4, ref('group_inom_cost_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Approve estimates above the threshold and manage templates.</field>
    </record>

    <record id="rule_inom_cost_estimate_company" model="ir.rule">
        <field name="name">Job Cost Estimate: multi-company</field>
        <field name="model_id" ref="model_inom_cost_estimate"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_inom_cost_estimate_portal" model="ir.rule">
        <field name="name">Job Cost Estimate: portal read own</field>
        <field name="model_id" ref="model_inom_cost_estimate"/>
        <field name="domain_force">[('partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_inom_cost_material_line_portal" model="ir.rule">
        <field name="name">Job Cost Material Line: portal read own</field>
        <field name="model_id" ref="model_inom_cost_material_line"/>
        <field name="domain_force">[('estimate_id.partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_inom_cost_labour_line_portal" model="ir.rule">
        <field name="name">Job Cost Manpower Line: portal read own</field>
        <field name="model_id" ref="model_inom_cost_labour_line"/>
        <field name="domain_force">[('estimate_id.partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_inom_cost_overhead_line_portal" model="ir.rule">
        <field name="name">Job Cost Indirect Line: portal read own</field>
        <field name="model_id" ref="model_inom_cost_overhead_line"/>
        <field name="domain_force">[('estimate_id.partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_inom_cost_equipment_line_portal" model="ir.rule">
        <field name="name">Equipment Line: portal read own</field>
        <field name="model_id" ref="model_inom_cost_equipment_line"/>
        <field name="domain_force">[('estimate_id.partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
