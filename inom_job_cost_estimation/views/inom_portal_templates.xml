<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add an entry on the portal home -->
    <template id="portal_my_home_estimate" name="Portal My Home : Estimates"
              inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/inom_job_cost_estimation/static/description/icon.png'"/>
                <t t-set="title">Estimates</t>
                <t t-set="text">Follow your job cost estimates</t>
                <t t-set="url" t-value="'/my/estimates'"/>
                <t t-set="placeholder_count" t-value="'estimate_count'"/>
            </t>
        </xpath>
    </template>

    <!-- List page -->
    <template id="portal_my_estimates" name="My Estimates">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Estimate</th>
                        <th>Date</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-if="not estimates">
                        <tr><td colspan="4">There are currently no estimates for your account.</td></tr>
                    </t>
                    <tr t-foreach="estimates" t-as="estimate">
                        <td>
                            <a t-att-href="estimate.get_portal_url()">
                                <t t-esc="estimate.name"/>
                            </a>
                        </td>
                        <td><span t-field="estimate.date_estimate"/></td>
                        <td class="text-end"><span t-field="estimate.amount_total"/></td>
                        <td class="text-center">
                            <span t-field="estimate.state" class="badge rounded-pill text-bg-info"/>
                        </td>
                    </tr>
                </tbody>
            </t>
            <div t-if="pager" class="o_portal_pager text-center">
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>

    <!-- Detail page -->
    <template id="portal_estimate_page" name="Estimate">
        <t t-call="portal.portal_layout">
            <div class="row o_portal_sidebar">
                <div class="col-12">
                    <div class="card mt-3">
                        <div class="card-body">
                            <h4>
                                Estimate <span t-field="estimate.name"/>
                                <span t-if="estimate.revision" class="text-muted">
                                    (Rev. <span t-field="estimate.revision"/>)</span>
                                <span t-field="estimate.state"
                                      class="badge rounded-pill text-bg-secondary float-end"/>
                            </h4>
                            <div class="text-end mb-3">
                                <a class="btn btn-secondary btn-sm"
                                   t-attf-href="/my/estimate/#{estimate.id}?report_type=pdf&amp;download=true#{token and ('&amp;access_token=' + token) or ''}">
                                    <i class="fa fa-download me-1"/>Download PDF
                                </a>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <strong>Customer:</strong>
                                    <div t-field="estimate.partner_id"
                                         t-options='{"widget": "contact"}'/>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Date:</strong> <span t-field="estimate.date_estimate"/></p>
                                    <p t-if="estimate.category_id">
                                        <strong>Category:</strong> <span t-field="estimate.category_id"/></p>
                                </div>
                            </div>

                            <t t-if="estimate.material_line_ids">
                                <h5 class="mt-3">Materials</h5>
                                <table class="table table-sm">
                                    <thead><tr>
                                        <th>Description</th><th class="text-end">Qty</th>
                                        <th class="text-end">Unit Price</th>
                                        <th class="text-end">Disc. %</th><th class="text-end">Amount</th>
                                    </tr></thead>
                                    <tbody>
                                        <tr t-foreach="estimate.material_line_ids" t-as="l">
                                            <td><span t-field="l.name"/></td>
                                            <td class="text-end"><span t-field="l.quantity"/></td>
                                            <td class="text-end"><span t-field="l.price_unit_sell"/></td>
                                            <td class="text-end">
                                                <span t-esc="'%.2f' % l._get_effective_discount()"/></td>
                                            <td class="text-end"><span t-field="l.price_sell"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>

                            <t t-if="estimate.labour_line_ids">
                                <h5 class="mt-3">Manpower</h5>
                                <table class="table table-sm">
                                    <tbody>
                                        <tr t-foreach="estimate.labour_line_ids" t-as="l">
                                            <td><span t-field="l.name"/></td>
                                            <td class="text-end"><span t-field="l.price_sell"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>

                            <t t-if="estimate.equipment_line_ids">
                                <h5 class="mt-3">Equipment</h5>
                                <table class="table table-sm">
                                    <tbody>
                                        <tr t-foreach="estimate.equipment_line_ids" t-as="l">
                                            <td><span t-field="l.name"/></td>
                                            <td class="text-end"><span t-field="l.price_sell"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>

                            <t t-if="estimate.overhead_line_ids">
                                <h5 class="mt-3">Indirect Cost</h5>
                                <table class="table table-sm">
                                    <tbody>
                                        <tr t-foreach="estimate.overhead_line_ids" t-as="l">
                                            <td><span t-field="l.name"/></td>
                                            <td class="text-end"><span t-field="l.price_sell"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>

                            <div class="row justify-content-end mt-3">
                                <div class="col-md-5">
                                    <table class="table table-sm">
                                        <tr><td>Subtotal</td>
                                            <td class="text-end"><span t-field="estimate.amount_sell"/></td></tr>
                                        <tr><td>Taxes</td>
                                            <td class="text-end"><span t-field="estimate.amount_tax"/></td></tr>
                                        <tr t-if="estimate.amount_rounding"><td>Rounding</td><td class="text-end"><span t-field="estimate.amount_rounding"/></td></tr>
                                        <tr class="border-top">
                                            <td><strong>Total</strong></td>
                                            <td class="text-end"><strong t-field="estimate.amount_total"/></td></tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Online approval -->
                            <div t-if="estimate.signed_on" class="alert alert-success mt-3">
                                Approved online by <strong t-field="estimate.signed_by"/>
                                on <span t-field="estimate.signed_on"/>.
                                <div t-if="estimate.signature" class="mt-2">
                                    <img t-att-src="image_data_uri(estimate.signature)"
                                         alt="Signature" style="max-height:80px;"/>
                                </div>
                            </div>
                            <div t-elif="estimate.state in ('draft', 'confirmed', 'approved')"
                                 class="mt-3">
                                <form t-attf-action="/my/estimate/#{estimate.id}/accept"
                                      method="post" class="row g-2 align-items-end">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="access_token" t-att-value="token"/>
                                    <div class="col-md-6">
                                        <label class="form-label">Type your full name to approve</label>
                                        <input type="text" name="signer_name"
                                               class="form-control" required="required"/>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="submit" class="btn btn-primary">
                                            Accept &amp; Approve
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
