<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inom_cost_dashboard_form" model="ir.ui.view">
        <field name="name">inom.cost.dashboard.form</field>
        <field name="model">inom.cost.dashboard</field>
        <field name="arch" type="xml">
            <form string="Job Costing Dashboard" create="false" delete="false" edit="false">
                <sheet>
                    <div class="oe_title mb-3">
                        <h1>Job Costing Dashboard</h1>
                    </div>
                    <group>
                        <field name="period" widget="radio"
                               options="{'horizontal': true}"/>
                        <field name="trend_range" widget="radio"
                               options="{'horizontal': true}"/>
                    </group>
                    <field name="dashboard_html" nolabel="1" readonly="1"
                           options="{'safe': True}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_inom_cost_dashboard_main" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">inom.cost.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_inom_cost_dashboard_form"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_inom_cost_dashboard_main"
              name="Dashboard"
              parent="menu_inom_cost_dashboard"
              action="action_inom_cost_dashboard_main"
              sequence="5"/>
</odoo>
