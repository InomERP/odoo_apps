<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_inom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inom</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Job Costing" name="inom_job_cost_estimation">
                    <block title="Approvals" name="inom_approval_block">
                        <setting string="Approval Threshold"
                                 help="Estimates above this total require a Job Costing Manager to approve. Set 0 to disable.">
                            <field name="inom_approval_threshold"/>
                        </setting>
                        <setting string="Director Threshold"
                                 help="Estimates above this total require a Job Costing Director to approve. Set 0 to require only a Manager above the first threshold.">
                            <field name="inom_approval_threshold_high"/>
                        </setting>
                    </block>
                    <block title="Pricing" name="inom_pricing_block">
                        <setting string="Round Final Price To"
                                 help="Round the final price to the nearest multiple. 0 disables rounding.">
                            <field name="inom_rounding_step"/>
                        </setting>
                    </block>
                    <block title="Quotation Conversion" name="inom_conversion_block">
                        <setting string="Material Fallback Product"
                                 help="Used for material lines that carry no product of their own.">
                            <field name="inom_material_product_id"/>
                        </setting>
                        <setting string="Manpower Product"
                                 help="Carries manpower / labour cost onto the quotation.">
                            <field name="inom_labour_product_id"/>
                        </setting>
                        <setting string="Equipment Product"
                                 help="Carries equipment cost onto the quotation.">
                            <field name="inom_equipment_product_id"/>
                        </setting>
                        <setting string="Indirect Cost Product"
                                 help="Carries indirect / overhead cost onto the quotation.">
                            <field name="inom_overhead_product_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_inom_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'inom_job_cost_estimation'}</field>
    </record>
</odoo>
