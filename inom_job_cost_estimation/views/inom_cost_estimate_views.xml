<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST -->
    <record id="view_inom_cost_estimate_list" model="ir.ui.view">
        <field name="name">inom.cost.estimate.list</field>
        <field name="model">inom.cost.estimate</field>
        <field name="arch" type="xml">
            <list string="Cost Estimates"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="partner_id" readonly="state in ('approved', 'converted')"/>
                <field name="category_id" optional="show"/>
                <field name="date_estimate"/>
                <field name="user_id" optional="hide"/>
                <field name="amount_cost" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <!-- KANBAN -->
    <record id="view_inom_cost_estimate_kanban" model="ir.ui.view">
        <field name="name">inom.cost.estimate.kanban</field>
        <field name="model">inom.cost.estimate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold fs-5">
                            <field name="name"/>
                        </div>
                        <field name="partner_id"/>
                        <div class="text-muted">
                            <field name="category_id"/>
                        </div>
                        <field name="progress" widget="progressbar"/>
                        <div class="d-flex justify-content-between mt-2">
                            <field name="state" widget="label_selection"
                                   options="{'classes': {'draft': 'info', 'approved': 'success', 'rejected': 'danger'}}"/>
                            <strong><field name="amount_total" widget="monetary"/></strong>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- CALENDAR -->
    <record id="view_inom_cost_estimate_calendar" model="ir.ui.view">
        <field name="name">inom.cost.estimate.calendar</field>
        <field name="model">inom.cost.estimate</field>
        <field name="arch" type="xml">
            <calendar string="Estimates" date_start="date_estimate"
                      color="category_id" mode="month">
                <field name="partner_id"/>
                <field name="amount_total"/>
            </calendar>
        </field>
    </record>

    <!-- PIVOT -->
    <record id="view_inom_cost_estimate_pivot" model="ir.ui.view">
        <field name="name">inom.cost.estimate.pivot</field>
        <field name="model">inom.cost.estimate</field>
        <field name="arch" type="xml">
            <pivot string="Estimate Analysis">
                <field name="category_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="amount_margin" type="measure"/>
                <field name="amount_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- GRAPH -->
    <record id="view_inom_cost_estimate_graph" model="ir.ui.view">
        <field name="name">inom.cost.estimate.graph</field>
        <field name="model">inom.cost.estimate</field>
        <field name="arch" type="xml">
            <graph string="Estimate Analysis" type="bar">
                <field name="category_id"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ACTIVITY -->
    <record id="view_inom_cost_estimate_activity" model="ir.ui.view">
        <field name="name">inom.cost.estimate.activity</field>
        <field name="model">inom.cost.estimate</field>
        <field name="arch" type="xml">
            <activity string="Estimates">
                <templates>
                    <div t-name="activity-box">
                        <div>
                            <field name="name" display="full"/>
                            <field name="partner_id" muted="1"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_inom_cost_estimate_search" model="ir.ui.view">
        <field name="name">inom.cost.estimate.search</field>
        <field name="model">inom.cost.estimate</field>
        <field name="arch" type="xml">
            <search string="Cost Estimates">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="user_id"/>
                <filter string="My Estimates" name="my"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Expired" name="expired"
                        domain="[('date_expiry', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('state', 'in', ['draft', 'confirmed', 'approved'])]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('date_estimate', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date_estimate', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Year" name="this_year"
                        domain="[('date_estimate', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Converted" name="converted" domain="[('state', '=', 'converted')]"/>
                <separator/>
                <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Job Category" name="group_category" context="{'group_by': 'category_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Estimate Month" name="group_month"
                        context="{'group_by': 'date_estimate:month'}"/>
                <filter string="Responsible" name="group_user" context="{'group_by': 'user_id'}"/>
                <filter string="Loss Reason" name="group_loss" context="{'group_by': 'loss_reason_id'}"/>
            </search>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_inom_cost_estimate_form" model="ir.ui.view">
        <field name="name">inom.cost.estimate.form</field>
        <field name="model">inom.cost.estimate</field>
        <field name="arch" type="xml">
            <form string="Cost Estimate">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_convert_to_quotation" type="object"
                            string="Convert to Quotation" class="btn-primary"
                            invisible="state != 'approved' or sale_order_id"/>
                    <button name="action_send_email" type="object"
                            string="Send by Email" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_create_revision" type="object"
                            string="New Revision" class="btn-secondary"
                            invisible="state in ('draft', 'confirmed')"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            invisible="state in ('rejected', 'converted')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,approved,converted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <field name="sale_count" widget="statinfo" string="Quotation"/>
                        </button>
                        <button name="action_open_documents" type="object"
                                class="oe_stat_button" icon="fa-paperclip"
                                invisible="document_count == 0">
                            <field name="document_count" widget="statinfo"
                                   string="Documents"/>
                        </button>
                        <button name="action_view_similar" type="object"
                                class="oe_stat_button" icon="fa-clone"
                                invisible="similar_count == 0">
                            <field name="similar_count" widget="statinfo"
                                   string="Similar Jobs"/>
                        </button>
                        <button name="action_view_revisions" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="revision_count == 0">
                            <field name="revision_count" widget="statinfo" string="Revisions"/>
                        </button>
                        <button name="action_view_analytic_lines" type="object"
                                class="oe_stat_button" icon="fa-bar-chart"
                                invisible="not analytic_account_id">
                            <field name="analytic_line_count" widget="statinfo"
                                   string="Analytic Items"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="cost_sheet_html" nolabel="1" readonly="1"
                           options="{'safe': True}"/>
                    <group name="pricing_controls">
                        <group>
                            <field name="markup_percent"
                                   help="Default markup on total cost. Lines can override it." readonly="state in ('approved', 'converted')"/>
                            <div class="text-muted" invisible="not suggestion_hint">
                                <field name="suggested_markup" nolabel="1"
                                       class="oe_inline" readonly="1"/>% -
                                <field name="suggestion_hint" nolabel="1"
                                       class="oe_inline" readonly="1"/>
                                <button name="action_apply_suggested_markup"
                                        type="object" string="Apply"
                                        class="btn-link p-0"
                                        invisible="state in ('approved', 'converted')"/>
                            </div>
                        </group>
                        <group>
                            <field name="discount_percent"
                                   help="Default discount off the marked-up price. Lines can override it." readonly="state in ('approved', 'converted')"/>
                            <field name="tax_ids" widget="many2many_tags" readonly="state in ('approved', 'converted')"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="category_id"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="date_estimate"/>
                            <field name="date_expiry"/>
                            <field name="duration_days"/>
                            <field name="revision_note" placeholder="Why this revision was raised..."
                                   invisible="not revision"/>
                            <field name="loss_reason_id" readonly="1"
                                   invisible="state != 'rejected'"/>
                            <field name="loss_note" readonly="1"
                                   invisible="state != 'rejected'"/>
                            <field name="signature" widget="image" readonly="1"
                                   options="{'size': [0, 90]}"
                                   invisible="not signature"/>
                            <field name="user_id"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="rate_card_id"
                                   options="{'no_create_edit': True}"/>
                            <label for="template_id" string="Quick Fill"/>
                            <div class="o_row">
                                <field name="template_id" nolabel="1"/>
                                <button name="action_load_template" type="object"
                                        string="Load" class="btn-link"
                                        invisible="not template_id or state != 'draft'"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials" name="materials">
                            <field name="material_line_ids" readonly="state in ('approved', 'converted')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="use_takeoff" optional="hide"/>
                                    <button name="action_open_takeoff" type="object"
                                            icon="fa-calculator" title="Measurement sheet"/>
                                    <field name="quantity" readonly="use_takeoff"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" sum="Material Cost"/>
                                    <field name="has_custom_markup" optional="hide"/>
                                    <field name="has_custom_discount" optional="hide"/>
                                    <field name="discount_percent" optional="hide"
                                           column_invisible="not parent.id"/>
                                    <field name="markup_percent" optional="hide"
                                           readonly="not has_custom_markup"/>
                                    <field name="price_sell" optional="show" sum="Material Sell"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Manpower" name="labour">
                            <field name="labour_line_ids" readonly="state in ('approved', 'converted')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="employee_id" optional="show"/>
                                    <field name="job_id" optional="hide"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="hours"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" sum="Manpower Cost"/>
                                    <field name="has_custom_markup" optional="hide"/>
                                    <field name="has_custom_discount" optional="hide"/>
                                    <field name="discount_percent" optional="hide"
                                           column_invisible="not parent.id"/>
                                    <field name="markup_percent" optional="hide"
                                           readonly="not has_custom_markup"/>
                                    <field name="price_sell" optional="show" sum="Manpower Sell"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Equipment" name="equipment">
                            <field name="equipment_line_ids" readonly="state in ('approved', 'converted')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="duration"/>
                                    <field name="rate_unit"/>
                                    <field name="price_unit"/>
                                    <field name="has_custom_markup" optional="hide"/>
                                    <field name="has_custom_discount" optional="hide"/>
                                    <field name="discount_percent" optional="hide"
                                           column_invisible="not parent.id"/>
                                    <field name="markup_percent" optional="hide"
                                           column_invisible="not parent.id"/>
                                    <field name="price_subtotal" sum="Total"/>
                                    <field name="price_sell" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Indirect Cost" name="overhead">
                            <field name="overhead_line_ids" readonly="state in ('approved', 'converted')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="amount" sum="Indirect Cost"/>
                                    <field name="has_custom_markup" optional="hide"/>
                                    <field name="has_custom_discount" optional="hide"/>
                                    <field name="discount_percent" optional="hide"
                                           column_invisible="not parent.id"/>
                                    <field name="markup_percent" optional="hide"
                                           readonly="not has_custom_markup"/>
                                    <field name="price_sell" optional="show" sum="Indirect Sell"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cost Control" name="cost_control">
                            <group>
                                <group string="Tracking">
                                    <field name="project_id"/>
                                    <label for="analytic_account_id"/>
                                    <div class="o_row">
                                        <field name="analytic_account_id" nolabel="1"/>
                                        <button name="action_create_analytic_account"
                                                type="object" string="Create"
                                                class="btn-link"
                                                invisible="analytic_account_id"/>
                                    </div>
                                </group>
                            </group>
                            <group string="Budget">
                                <field name="budget_amount"/>
                                <field name="budget_variance"
                                       decoration-danger="budget_variance &lt; 0"
                                       decoration-success="budget_variance &gt;= 0"/>
                                <field name="budget_variance_percent" widget="percentage"/>
                            </group>
                            <group invisible="not analytic_account_id">
                                <group string="Estimated">
                                    <field name="amount_cost"/>
                                    <field name="amount_sell"/>
                                </group>
                                <group string="Actual">
                                    <field name="actual_cost"/>
                                    <field name="actual_revenue"/>
                                </group>
                                <group string="Variance">
                                    <field name="variance_amount"
                                           decoration-danger="variance_amount &lt; 0"
                                           decoration-success="variance_amount &gt;= 0"/>
                                    <field name="variance_percent" widget="percentage"/>
                                </group>
                            </group>
                            <div class="text-muted" invisible="analytic_account_id">
                                Link an analytic account to compare the estimated cost
                                against what is actually posted from timesheets, vendor
                                bills and invoices.
                            </div>
                        </page>
                        <page string="Other Info" name="other">
                            <group>
                                <field name="origin_estimate_id" readonly="1"
                                       invisible="not origin_estimate_id"/>
                                <field name="revision" readonly="1"/>
                                <field name="signed_by" readonly="1"
                                       invisible="not signed_by"/>
                                <field name="signed_on" readonly="1"
                                       invisible="not signed_on"/>
                            </group>
                            <separator string="Terms &amp; Conditions"/>
                            <field name="terms" placeholder="Payment terms, validity, assumptions..."/>
                        </page>
                        <page string="Approval History" name="approval_history">
                            <field name="approval_log_ids" nolabel="1" readonly="1">
                                <list create="false" delete="false">
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="state_from"/>
                                    <field name="state_to"/>
                                    <field name="amount_total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documents" name="documents">
                            <div class="text-muted mb-2">
                                Drawings, site photos, specifications and any
                                file the customer should receive with this
                                estimate. Copied onto new revisions.
                            </div>
                            <field name="document_ids" widget="many2many_binary"
                                   nolabel="1"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes and remarks..."/>
                        </page>
                    </notebook>
                    <group name="cost_summary" invisible="1">
                        <field name="amount_material"/>
                        <field name="amount_labour"/>
                        <field name="amount_equipment"/>
                        <field name="amount_discount"/>
                        <field name="amount_rounding"/>
                        <field name="amount_overhead"/>
                        <field name="amount_cost"/>
                        <field name="amount_margin"/>
                        <field name="margin_percent"/>
                        <field name="amount_sell"/>
                        <field name="amount_tax"/>
                        <field name="amount_total"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- MAIN ACTION -->
    <record id="action_inom_cost_estimate" model="ir.actions.act_window">
        <field name="name">Cost Estimates</field>
        <field name="res_model">inom.cost.estimate</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="context">{'search_default_my': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first job cost estimate</p>
            <p>Prepare material, manpower and overhead costs, add margin and convert
               approved estimates into sales quotations.</p>
        </field>
    </record>

    <!-- DASHBOARD ACTION -->
    <record id="action_inom_cost_dashboard" model="ir.actions.act_window">
        <field name="name">Estimate Analysis</field>
        <field name="res_model">inom.cost.estimate</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>

    <!-- DASHBOARD VIEWS -->
    <record id="view_inom_estimate_graph_trend" model="ir.ui.view">
        <field name="name">inom.cost.estimate.graph.trend</field>
        <field name="model">inom.cost.estimate</field>
        <field name="arch" type="xml">
            <graph string="Estimate Trend" type="line">
                <field name="date_estimate" interval="month"/>
                <field name="amount_sell" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_inom_estimate_graph_customer" model="ir.ui.view">
        <field name="name">inom.cost.estimate.graph.customer</field>
        <field name="model">inom.cost.estimate</field>
        <field name="arch" type="xml">
            <graph string="Top Customers" type="bar" order="desc">
                <field name="partner_id"/>
                <field name="amount_sell" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_inom_estimate_graph_state" model="ir.ui.view">
        <field name="name">inom.cost.estimate.graph.state</field>
        <field name="model">inom.cost.estimate</field>
        <field name="arch" type="xml">
            <graph string="Estimates by Status" type="pie">
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_inom_estimate_pivot_margin" model="ir.ui.view">
        <field name="name">inom.cost.estimate.pivot.margin</field>
        <field name="model">inom.cost.estimate</field>
        <field name="arch" type="xml">
            <pivot string="Margin Analysis">
                <field name="category_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_cost" type="measure"/>
                <field name="amount_sell" type="measure"/>
                <field name="amount_margin" type="measure"/>
                <field name="margin_percent" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- DASHBOARD ACTIONS -->
    <record id="action_inom_dashboard_trend" model="ir.actions.act_window">
        <field name="name">Estimate Trend</field>
        <field name="res_model">inom.cost.estimate</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="view_id" ref="view_inom_estimate_graph_trend"/>
    </record>

    <record id="action_inom_dashboard_margin" model="ir.actions.act_window">
        <field name="name">Margin Analysis</field>
        <field name="res_model">inom.cost.estimate</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="view_id" ref="view_inom_estimate_pivot_margin"/>
    </record>

    <record id="action_inom_dashboard_customer" model="ir.actions.act_window">
        <field name="name">Top Customers</field>
        <field name="res_model">inom.cost.estimate</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="view_id" ref="view_inom_estimate_graph_customer"/>
    </record>

    <record id="action_inom_dashboard_state" model="ir.actions.act_window">
        <field name="name">Approval Status</field>
        <field name="res_model">inom.cost.estimate</field>
        <field name="view_mode">graph,list,form</field>
        <field name="view_id" ref="view_inom_estimate_graph_state"/>
    </record>

    <record id="action_inom_dashboard_variance" model="ir.actions.act_window">
        <field name="name">Estimated vs Actual</field>
        <field name="res_model">inom.cost.estimate</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('analytic_account_id', '!=', False)]</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No estimate is tracking actuals yet</p>
            <p>Link an estimate to a project or analytic account to compare
               what you quoted against what the job really cost.</p>
        </field>
    </record>
</odoo>
