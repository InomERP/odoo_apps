<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inom_material_line_form" model="ir.ui.view">
        <field name="name">inom.cost.material.line.form</field>
        <field name="model">inom.cost.material.line</field>
        <field name="arch" type="xml">
            <form string="Measurement Sheet">
                <group>
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="name" readonly="1"/>
                    </group>
                    <group>
                        <field name="use_takeoff"/>
                        <field name="quantity" readonly="use_takeoff"/>
                        <field name="uom_id" readonly="1"/>
                    </group>
                </group>
                <field name="takeoff_line_ids" nolabel="1"
                       invisible="not use_takeoff">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="name"/>
                        <field name="measure_type"/>
                        <field name="count"/>
                        <field name="length"/>
                        <field name="width"/>
                        <field name="height"/>
                        <field name="is_deduction" widget="boolean_toggle"/>
                        <field name="quantity_signed" sum="Total" readonly="1"/>
                    </list>
                </field>
                <div class="text-muted mt-2" invisible="not use_takeoff">
                    Count uses Nos. only. Length uses Nos. x Length.
                    Area uses Nos. x Length x Width. Volume adds Height.
                    Tick Deduct for openings.
                </div>
                <footer>
                    <button string="Close" class="btn-primary" special="save"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
