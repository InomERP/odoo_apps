<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inom_cost_category_list" model="ir.ui.view">
        <field name="name">inom.cost.category.list</field>
        <field name="model">inom.cost.category</field>
        <field name="arch" type="xml">
            <list string="Job Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="default_markup"/>
                <field name="estimate_count"/>
            </list>
        </field>
    </record>

    <record id="view_inom_cost_category_form" model="ir.ui.view">
        <field name="name">inom.cost.category.form</field>
        <field name="model">inom.cost.category</field>
        <field name="arch" type="xml">
            <form string="Job Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="default_markup"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_inom_cost_category" model="ir.actions.act_window">
        <field name="name">Job Categories</field>
        <field name="res_model">inom.cost.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
