<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inom_rate_card_list" model="ir.ui.view">
        <field name="name">inom.rate.card.list</field>
        <field name="model">inom.rate.card</field>
        <field name="arch" type="xml">
            <list string="Rate Cards">
                <field name="name"/>
                <field name="line_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_inom_rate_card_form" model="ir.ui.view">
        <field name="name">inom.rate.card.form</field>
        <field name="model">inom.rate.card</field>
        <field name="arch" type="xml">
            <form string="Rate Card">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rates" name="rates">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kind"/>
                                    <field name="product_id"
                                           column_invisible="parent.id == False"
                                           invisible="kind != 'material'"/>
                                    <field name="name"/>
                                    <field name="rate"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_inom_rate_card" model="ir.actions.act_window">
        <field name="name">Rate Cards</field>
        <field name="res_model">inom.rate.card</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
