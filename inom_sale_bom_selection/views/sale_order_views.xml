<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inom_bom_selection" model="ir.ui.view">
        <field name="name">sale.order.form.inom.bom.selection</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Editable list of order lines -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_template_id']"
                   position="after">
                <field name="allowed_bom_ids"
                       column_invisible="1"/>
                <field name="bom_id"
                       string="Bill of Material"
                       optional="show"
                       column_invisible="parent.state == 'cancel'"
                       readonly="display_type or not product_id"/>
            </xpath>

            <!-- Per-line detailed form (opened from the list) -->
            <xpath expr="//field[@name='order_line']/form//div[@name='ordered_qty']"
                   position="after">
                <field name="allowed_bom_ids" invisible="1"/>
                <label for="bom_id" string="Bill of Material" invisible="display_type"/>
                <div name="inom_bom" invisible="display_type">
                    <field name="bom_id"
                           nolabel="1"
                           readonly="not product_id"/>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
