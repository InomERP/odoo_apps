<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_rounding_form" model="ir.ui.view">
        <field name="name">pos.config.rounding.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="after">
                <block title="Rounding Off" id="pos_rounding_section">
                    <setting string="Enable Rounding Off" help="POS mein payment ke waqt total amount ko round off karne ki facility">
                        <field name="pos_is_rounding_enabled"/>
                        <div class="content-group mt16" invisible="not pos_is_rounding_enabled">
                            <div class="row mb-2">
                                <label for="pos_rounding_type" string="Rounding Type" class="col-lg-3 o_light_label"/>
                                <field name="pos_rounding_type" widget="radio"/>
                            </div>
                            <div class="row mb-2">
                                <label for="pos_rounding_precision" string="Rounding Precision" class="col-lg-3 o_light_label"/>
                                <field name="pos_rounding_precision"/>
                            </div>
                            <div class="row mb-2">
                                <label for="pos_rounding_payment_method_id" string="Rounding Payment Method" class="col-lg-3 o_light_label"/>
                                <field name="pos_rounding_payment_method_id"/>
                            </div>
                            <div class="row mb-2">
                                <label for="pos_rounding_account_id" string="Rounding Account" class="col-lg-3 o_light_label"/>
                                <field name="pos_rounding_account_id"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>