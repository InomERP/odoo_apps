<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_method_rounding_form" model="ir.ui.view">
        <field name="name">pos.payment.method.rounding.form</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_rounding_method"/>
                <field name="is_auto_rounding"
                       invisible="not is_rounding_method"/>
            </xpath>
        </field>
    </record>
</odoo>
