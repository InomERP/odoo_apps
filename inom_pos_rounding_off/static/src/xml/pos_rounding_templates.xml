<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethods-container')]" position="after">
            <div t-if="this.isRoundingEnabled and this.isManualRounding and !this.isRoundingApplied"
                 class="mt-2">
                <button class="btn btn-outline-primary w-100 btn-lg"
                        t-on-click="() => this.applyManualRounding()">
                    <i class="fa fa-calculator me-2"/>
                    Apply Rounding
                </button>
            </div>
            <div t-if="this.isRoundingApplied" class="mt-1">
                <button class="btn btn-outline-secondary w-100 btn-lg"
                        t-on-click="() => this.refreshRounding()">
                    <i class="fa fa-refresh me-2"/>
                    Update Rounding
                </button>
            </div>
        </xpath>
    </t>
</templates>
